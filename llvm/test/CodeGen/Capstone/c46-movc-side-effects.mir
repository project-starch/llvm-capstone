# C-46: MOVC writes cnull into a LINEAR source (and, on silicon, an untagged
# one), so it is not a pure copy. It is marked hasSideEffects, and a dead MOVC
# is no longer deleted as if it were. This keeps the MOVC itself from being
# deleted or moved; it does not make a later read of the source depend on it.
# That read is guarded by CapstoneLiveSourceCopy (C-32). The integer copy is
# the control: it is still deleted.
# RUN: llc -mtriple=capstone64 -run-pass=dead-mi-elimination -o - %s | FileCheck %s
---
name: dead_movc
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10, $c11, $x14
    ; CHECK-LABEL: name: dead_movc
    ; CHECK: dead $c12 = MOVC killed $c11
    ; CHECK-NOT: ADDI
    ; CHECK: PseudoRET
    dead $c12 = MOVC killed $c11
    dead $x15 = ADDI killed $x14, 0
    PseudoRET implicit $c10
...
