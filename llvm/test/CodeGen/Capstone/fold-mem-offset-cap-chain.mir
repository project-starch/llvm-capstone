# CapstoneFoldMemOffset, capability forms: a constant cursor move DOWNSTREAM of
# the folded root stays in place with its own immediate, so only the root's
# delta flows through it (as through ADD). This is the shape of 538.imagick_r
# CloneImageInfo, where the pass once counted the intermediate's 0x3c twice and
# the store landed at s7+0x3c+0x238 instead of s7+0x40: a bounds fault
# (cause 28). The intermediate survives isel there; a MIR test pins it.
#
# @chain: integer root `ADDI 544` (base + 0x4220 = lui 4 + 0x220) walked
# through the register cincoffset; the direct load gets 60 + 544 = 604, the
# load through the surviving `CIncOffsetImm 60` gets 4 + 544 = 548.
# @cap_root_chain: capability root `CIncOffsetImm 112` (libm exp's shape) with
# a surviving `CIncOffsetImm 8` downstream: both loads get +112.
#
# @unbounded_intermediate (review P1): a surviving register cursor add that is
# NOT the base of any folded access is unbounded. With bounds [0x10000,0x10010)
# and cursor 0x10000, n = -3072, m = 1025, the original visits 0x107ff, 0xfbff,
# 0x10000, all inside the ~2 KiB representable window; the folded form would
# visit 0xf400 first, lose the tag, and the in-bounds LBU would fault. The fold
# is vetoed: the root stays and the load keeps its displacement. In
# @cap_root_chain the surviving register add IS a folded base (within 112 of
# an in-bounds access), which is why it may fold.
#
# @untaken_access (review 2, P1): an access that merely EXISTS does not bound
# a cursor. Same values as above; `LBU %p` sits in one successor and `LBU %q`
# (q derived from p) in the other. On the path through the second, the first
# never executes: originally p = 0xfbff, q = 0x10000 and the load succeeds;
# folded, p = 0xf400 loses its tag, q inherits the untagged state and the
# in-bounds load faults. The pass requires the FIRST use of every surviving
# cursor, in its defining block, to be a folded access through it (the path
# argument in the pass); here p's first use is the derived q, so no fold.
# @taken_access is the allowed shape: p's first use is `LBU %p` in its own
# block, before the branch, so on every path it executes before the derived
# q, whose own first use is its load. Both loads fold (+2047) and the other
# use of p in bb.1 (dominated, so after that access) folds too, -4 -> 2043
# (a +4 there would need 2051, outside simm12, and the all-or-nothing walk
# would veto the whole fold for that reason alone).
#
# @policy_boundary (review 3, P1): the representable window is not the only
# arithmetic tag-loss condition; a tagged cursor must also be a canonical
# address (isa.md, address policy: sv39 refuses [2^38, 2^64-2^38)), and a
# result that is refused is written untagged. With bounds [2^38-4096, 2^38),
# cursor 2^38-2048 and n = 2048, `CIncOffsetImm -1; CIncOffset n; LBU 0` reads
# 2^38-1, canonical and in bounds; folded, the cursor becomes 2^38, refused,
# and the `LBU -1` at the unchanged address faults. The fold moves each
# surviving cursor by minus its erased displacement, so the pass requires that
# displacement to be >= 0 (the cursor only moves down, which cannot reach a
# refused address: see the pass). @policy_boundary_pos is the same shape with
# a positive constant and folds.
# @unwind_bypass (review 3, P2): a call between the cursor's definition and
# its first-use access may leave the block through an unwind edge, with the
# derived cursor used in the landing pad; the bounding access never runs on
# that path. The first-use scan stops at a call or inline asm, and a block with
# an EH-pad successor is vetoed. (A non-returning trap is not a bypass: the
# launcher terminates through SIGSEGV.)
#
# MUTATION: `Offset = map[rs1] + imm` in the pass's CIncOffsetImm case ->
# `LW [[T]], 608` and `FLD [[U]], 120` (the fault); dropping CIncOffsetImm from
# the root test leaves @cap_root_chain's `CIncOffsetImm 112` and `FLD ..., 0`;
# dropping the first-use veto folds @unbounded_intermediate (`LBU ..., 2047`,
# no `CIncOffsetImm`); weakening it to "some folded access exists" folds
# @untaken_access the same way; dropping the delta >= 0 test folds
# @policy_boundary (`LBU ..., -1`); scanning past calls folds @unwind_bypass.
#
# RUN: llc -mtriple=capstone64 -mattr=+m,+f,+d -run-pass=capstone-fold-mem-offset -verify-machineinstrs -o - %s | FileCheck %s
--- |
  target triple = "capstone64"
  declare void @thrower()
  define void @chain() { ret void }
  define void @cap_root_chain() { ret void }
  define void @unbounded_intermediate() { ret void }
  define void @untaken_access() { ret void }
  define void @taken_access() { ret void }
  define void @policy_boundary() { ret void }
  define void @policy_boundary_pos() { ret void }
  define void @unwind_bypass() personality ptr null { ret void }
...
---
name: chain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10
    ; CHECK-LABEL: name: chain
    ; CHECK:      [[L:%[0-9]+]]:gpr = LUI 4
    ; CHECK-NEXT: [[S:%[0-9]+]]:gpcr = CIncOffset {{%[0-9]+}}, [[L]]
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LW [[S]], 604
    ; CHECK-NEXT: [[T:%[0-9]+]]:gpcr = CIncOffsetImm [[S]], 60
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LW [[T]], 548
    %0:gpcr = COPY $c10
    %1:gpr = LUI 4
    %2:gpr = ADDI %1, 544
    %3:gpcr = CIncOffset %0, %2
    %4:gpr = LW %3, 60
    %5:gpcr = CIncOffsetImm %3, 60
    %6:gpr = LW %5, 4
    %7:gpr = ADD %4, %6
    $x10 = COPY %7
    PseudoRET implicit $x10
...
---
name: cap_root_chain
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10, $x11
    ; CHECK-LABEL: name: cap_root_chain
    ; CHECK:      [[B:%[0-9]+]]:gpcr = COPY $c10
    ; CHECK-NOT:  CIncOffsetImm [[B]]
    ; CHECK:      [[P:%[0-9]+]]:gpcr = CIncOffset [[B]], {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:fpr64 = FLD [[P]], 112
    ; CHECK-NEXT: [[U:%[0-9]+]]:gpcr = CIncOffsetImm [[P]], 8
    ; CHECK-NEXT: {{%[0-9]+}}:fpr64 = FLD [[U]], 112
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpcr = CIncOffsetImm %0, 112
    %3:gpcr = CIncOffset %2, %1
    %4:fpr64 = FLD %3, 0
    %5:gpcr = CIncOffsetImm %3, 8
    %6:fpr64 = FLD %5, 0
    %7:fpr64 = FADD_D %4, %6, 7
    $f10_d = COPY %7
    PseudoRET implicit $f10_d
...
---
name: unbounded_intermediate
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10, $x11, $x12
    ; CHECK-LABEL: name: unbounded_intermediate
    ; CHECK:      [[R:%[0-9]+]]:gpcr = CIncOffsetImm {{%[0-9]+}}, 2047
    ; CHECK-NEXT: [[P:%[0-9]+]]:gpcr = CIncOffset [[R]], {{%[0-9]+}}
    ; CHECK-NEXT: [[Q:%[0-9]+]]:gpcr = CIncOffset [[P]], {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[Q]], 0
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x12
    %3:gpcr = CIncOffsetImm %0, 2047
    %4:gpcr = CIncOffset %3, %1
    %5:gpcr = CIncOffset %4, %2
    %6:gpr = LBU %5, 0
    $x10 = COPY %6
    PseudoRET implicit $x10
...
---
name: untaken_access
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $c10, $x11, $x12, $x13
    ; CHECK-LABEL: name: untaken_access
    ; CHECK:      [[R:%[0-9]+]]:gpcr = CIncOffsetImm {{%[0-9]+}}, 2047
    ; CHECK-NEXT: [[P:%[0-9]+]]:gpcr = CIncOffset [[R]], {{%[0-9]+}}
    ; CHECK-NEXT: [[Q:%[0-9]+]]:gpcr = CIncOffset [[P]], {{%[0-9]+}}
    ; CHECK:      LBU [[P]], 0
    ; CHECK:      LBU [[Q]], 0
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x12
    %3:gpr = COPY $x13
    %4:gpcr = CIncOffsetImm %0, 2047
    %5:gpcr = CIncOffset %4, %1
    %6:gpcr = CIncOffset %5, %2
    BNE %3, $x0, %bb.1
    PseudoBR %bb.2
  bb.1:
    %7:gpr = LBU %5, 0
    $x10 = COPY %7
    PseudoRET implicit $x10
  bb.2:
    %8:gpr = LBU %6, 0
    $x10 = COPY %8
    PseudoRET implicit $x10
...
---
name: taken_access
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $c10, $x11, $x12, $x13
    ; CHECK-LABEL: name: taken_access
    ; CHECK-NOT:  CIncOffsetImm
    ; CHECK:      [[P:%[0-9]+]]:gpcr = CIncOffset {{%[0-9]+}}, {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[P]], 2047
    ; CHECK:      bb.1:
    ; CHECK:      LBU [[P]], 2043
    ; CHECK:      bb.2:
    ; CHECK:      [[Q:%[0-9]+]]:gpcr = CIncOffset [[P]], {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[Q]], 2047
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x12
    %3:gpr = COPY $x13
    %4:gpcr = CIncOffsetImm %0, 2047
    %5:gpcr = CIncOffset %4, %1
    %6:gpr = LBU %5, 0
    BNE %3, $x0, %bb.1
    PseudoBR %bb.2
  bb.1:
    %7:gpr = LBU %5, -4
    %8:gpr = ADD %6, %7
    $x10 = COPY %8
    PseudoRET implicit $x10
  bb.2:
    %9:gpcr = CIncOffset %5, %2
    %10:gpr = LBU %9, 0
    %11:gpr = ADD %6, %10
    $x10 = COPY %11
    PseudoRET implicit $x10
...
---
name: policy_boundary
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10, $x11
    ; CHECK-LABEL: name: policy_boundary
    ; CHECK:      [[R:%[0-9]+]]:gpcr = CIncOffsetImm {{%[0-9]+}}, -1
    ; CHECK-NEXT: [[P:%[0-9]+]]:gpcr = CIncOffset [[R]], {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[P]], 0
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpcr = CIncOffsetImm %0, -1
    %3:gpcr = CIncOffset %2, %1
    %4:gpr = LBU %3, 0
    $x10 = COPY %4
    PseudoRET implicit $x10
...
---
name: policy_boundary_pos
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10, $x11
    ; CHECK-LABEL: name: policy_boundary_pos
    ; CHECK-NOT:  CIncOffsetImm
    ; CHECK:      [[P:%[0-9]+]]:gpcr = CIncOffset {{%[0-9]+}}, {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[P]], 1
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpcr = CIncOffsetImm %0, 1
    %3:gpcr = CIncOffset %2, %1
    %4:gpr = LBU %3, 0
    $x10 = COPY %4
    PseudoRET implicit $x10
...
---
name: unwind_bypass
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $c10, $x11, $x12
    ; CHECK-LABEL: name: unwind_bypass
    ; CHECK:      [[R:%[0-9]+]]:gpcr = CIncOffsetImm {{%[0-9]+}}, 2047
    ; CHECK-NEXT: [[P:%[0-9]+]]:gpcr = CIncOffset [[R]], {{%[0-9]+}}
    ; CHECK-NEXT: PseudoCALL
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[P]], 0
    ; CHECK:      landing-pad
    ; CHECK:      [[Q:%[0-9]+]]:gpcr = CIncOffset [[P]], {{%[0-9]+}}
    ; CHECK-NEXT: {{%[0-9]+}}:gpr = LBU [[Q]], 0
    %0:gpcr = COPY $c10
    %1:gpr = COPY $x11
    %2:gpr = COPY $x12
    %3:gpcr = CIncOffsetImm %0, 2047
    %4:gpcr = CIncOffset %3, %1
    PseudoCALL @thrower, csr_ilp32_lp64, implicit-def dead $x1, implicit-def $x2
    %5:gpr = LBU %4, 0
    PseudoBR %bb.1
  bb.1:
    $x10 = COPY %5
    PseudoRET implicit $x10
  bb.2 (landing-pad):
    %6:gpcr = CIncOffset %4, %2
    %7:gpr = LBU %6, 0
    $x10 = COPY %7
    PseudoRET implicit $x10
...
