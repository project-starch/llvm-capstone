# The S-12 movc/ldc workaround pass must RENAME the destination of a null
# capability move that is reloaded by an ldc within the window.  Today it does
# not fire at all on c128 code: isMovcZero() matches Capstone::X0 as the MOVC
# source (CapstoneS12MovcLdcHazard.cpp), but a null-capability move is
# `$cN = MOVC $c0` -- C0 and X0 are distinct register records -- and the rename
# candidates are X16..X31, which the verifier rejects on a GPCR def.  Measured
# 2026-09-04 by feeding exactly this MIR through -run-pass with the flag on: the
# body comes out unchanged.  (S-12 is fixed in RTL; the plan retires this pass
# after two more clean board draws.  Until that decision this file records
# what the pass would have to do to be a workaround at all.)
#
# XFAIL until the pass matches $c0 and renames into a C register; then lit
# reports XPASS and the marker comes off -- or the file is deleted with the pass.
#
# MUTATION: change `$c10 = LDC $c11, 0` to `$c12 = LDC $c11, 0` (no collision)
# -> the `$c16 = MOVC` CHECK fails even with a working pass, which shows the
# check requires the rename and not merely the flag.
#
# RUN: llc -mtriple=capstone64 -mattr=+m -x mir -run-pass=capstone-s12-movc-ldc -capstone-s12-movc-ldc-workaround=true -verify-machineinstrs -o - %s | FileCheck %s
# XFAIL: *
---
name: rename_basic
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10, $c11
    ; CHECK-LABEL: name: rename_basic
    ; CHECK: $c16 = MOVC $c0
    ; CHECK-NEXT: STC $c16, $c11, 0
    ; CHECK-NEXT: $c10 = LDC $c11, 0
    $c10 = MOVC $c0
    STC $c10, $c11, 0
    $c10 = LDC $c11, 0
    PseudoRET implicit $c10
...
