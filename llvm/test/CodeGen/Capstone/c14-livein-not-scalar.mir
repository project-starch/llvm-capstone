# C-14: the post-RA rule that rewrites a destructive `movc` into `mv` must never do
# so for a register that is LIVE-IN to the function.
#
# `mv` is ADDI, which drops a capability tag, so a wrong proof of scalar-ness is a
# miscompile and not a missed optimisation. The reaching-def rule proves scalar-ness
# by requiring every reaching definition to be an address materialisation -- but a
# live-in arrives with no defining MachineInstr and so cannot appear in that set at
# all. Combined with the rule that treats an already-visited definition as satisfied,
# a copy inside a loop proves itself:
#
#     $x9  = MOVC $x10        the copy being judged
#     $x10 = MOVC $x9         reaches it through the back-edge
#
# those being the only definitions of $x10, the proof closes over the cycle without
# ever reaching a materialisation.
#
# Reduced from mruby's mrb_method_search_vm, where the live-in is `mrb`: the
# rewritten `mv` dropped its tag and the domain halted with cause 24 at the next
# store through it, under both the default and the gp-captable ABI.
#
# WRITTEN IN MIR ON PURPOSE. An .ll version of this was tried first and passed with
# the fix reverted, i.e. it never reproduced -- the shape survives instruction
# selection and register allocation only by accident, so the test has to start after
# them.
#
# RUN: llc -mtriple=capstone64-unknown-elf -mattr=+m,+a \
# RUN:     -run-pass=capstone-post-ra-expand-pseudo -o - %s | FileCheck %s
--- |
  target datalayout = "e-m:e-p:64:128-p200:128:128:128-i64:64-i128:128-n32:64-S128-ni:200-A200-P200-G200"
  target triple = "capstone64-unknown-unknown-elf"
  define void @livein_cycle(ptr addrspace(200) %p) addrspace(200) { ret void }
  define void @counter_is_scalar(i64 %n) addrspace(200) { ret void }
...
---
name:            livein_cycle
tracksRegLiveness: true
liveins:
  - { reg: '$x10' }
body:             |
  bb.0:
    successors: %bb.1
    liveins: $x10
    PseudoBR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $x10

    ; The copy under test. $x10 is the function's incoming argument, so it may be a
    ; capability and this must stay a MOVC.
    ; CHECK-LABEL: name: livein_cycle
    ; CHECK: $x9 = MOVC killed renamable $x10
    $x9 = MOVC killed renamable $x10
    $x10 = MOVC killed renamable $x9
    BEQ renamable $x10, $x0, %bb.2
    PseudoBR %bb.1

  bb.2:
    liveins: $x10
    PseudoRET
...
---
# POSITIVE CONTROL, so a "fix" that simply switches the rule off fails this file.
# $x18 is not a live-in: every definition of it is a materialisation (an ADDI from
# $x0, and its own increment), which is the loop-counter shape the rule exists for.
# It must still be rewritten to the cheap ADDI.
name:            counter_is_scalar
tracksRegLiveness: true
liveins:
  - { reg: '$x11' }
body:             |
  bb.0:
    successors: %bb.1
    liveins: $x11
    renamable $x18 = ADDI $x0, 0
    PseudoBR %bb.1

  bb.1:
    successors: %bb.1, %bb.2
    liveins: $x11, $x18

    ; CHECK-LABEL: name: counter_is_scalar
    ; CHECK: $x10 = ADDI $x18, 0
    $x10 = MOVC killed renamable $x18
    renamable $x18 = ADDI renamable $x10, 1
    BEQ renamable $x18, renamable $x11, %bb.2
    PseudoBR %bb.1

  bb.2:
    PseudoRET
...
