# The check-only CapstoneLiveSourceCopy instance after MakeCompressible must refuse a MOVC
# whose source is still read. Starting the pipeline after the rewriting instance hands it one
# directly, which is how a later pass creating such a copy would look to it. With
# +movc-keeps-integer-source the same input is legal and compiles.
#
# RUN: not llc -mtriple=capstone64 -mattr=+m -O2 -start-after=capstone-live-source-copy \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s
# RUN: llc -mtriple=capstone64 -mattr=+m,+movc-keeps-integer-source -O2 \
# RUN:   -start-after=capstone-live-source-copy -o /dev/null %s
# CHECK: LLVM ERROR: capstone-live-source-copy: a live-source MOVC was created after the rewrite ran, in survivor
--- |
  target triple = "capstone64"
  define void @survivor() { ret void }
...
---
name: survivor
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $c10
    $c11 = MOVC $c10
    PseudoRET implicit $c10, implicit $c11
...
