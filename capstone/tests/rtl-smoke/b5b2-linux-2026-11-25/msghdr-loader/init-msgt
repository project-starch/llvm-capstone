#!/bin/sh
mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev 2>/dev/null
mkdir -p /tmp && mount -t tmpfs tmpfs /tmp
echo "TRAPTEST: up, kernel $(uname -r)"
/msgt.native; echo "TRAPTEST: native rc=$?"
mkdir -p /tmp/run && cp /msgt.dom /tmp/run/ && cd /tmp/run && ./msgt.dom; echo "TRAPTEST: protected rc=$?"; cd /
busybox dmesg | grep -E "sublet: (fault|call)" | sed 's/^/TRAPTEST: dmesg /'
echo "TRAPTEST: done"
busybox poweroff -f
