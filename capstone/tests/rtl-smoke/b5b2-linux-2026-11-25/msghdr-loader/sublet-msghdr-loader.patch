+/* struct msghdr in the protected user layout (16-byte pointers; musl's socklen_t and int
+ * fields): name +0x00, namelen +0x10, iov +0x20, iovlen +0x30, control +0x40, controllen +0x50,
+ * flags +0x58, size 0x60. sublet_copy_msghdr_from_user loads the three pointers with
+ * sublet_load_user_pointer, so each becomes a handle of the call, and reads the 32-bit fields,
+ * zero-extended as Linux reads musl's {int, pad} pairs. 0, -EFAULT or -E2BIG. */
+#define SUBLET_MSG_NAME		0x00
+#define SUBLET_MSG_NAMELEN	0x10
+#define SUBLET_MSG_IOV		0x20
+#define SUBLET_MSG_IOVLEN	0x30
+#define SUBLET_MSG_CONTROL	0x40
+#define SUBLET_MSG_CONTROLLEN	0x50
+#define SUBLET_MSG_FLAGS	0x58
+struct user_msghdr;
+int sublet_copy_msghdr_from_user(struct user_msghdr *msg, const void __user *umsg);
