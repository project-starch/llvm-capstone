+int sublet_copy_msghdr_from_user(struct user_msghdr *msg, const void __user *umsg)
+{
+	unsigned long at = (__force unsigned long)umsg, ptr;
+	u32 v;
+	int err;
+
+	err = sublet_load_user_pointer(at + SUBLET_MSG_NAME, &ptr);
+	if (err)
+		return err;
+	msg->msg_name = (void __user *)ptr;
+	err = sublet_load_user_pointer(at + SUBLET_MSG_IOV, &ptr);
+	if (err)
+		return err;
+	msg->msg_iov = (struct iovec __user *)ptr;
+	err = sublet_load_user_pointer(at + SUBLET_MSG_CONTROL, &ptr);
+	if (err)
+		return err;
+	msg->msg_control = (void __user *)ptr;
+	if (copy_from_user(&v, (const void __user *)(at + SUBLET_MSG_NAMELEN), sizeof(v)))
+		return -EFAULT;
+	msg->msg_namelen = v;
+	if (copy_from_user(&v, (const void __user *)(at + SUBLET_MSG_IOVLEN), sizeof(v)))
+		return -EFAULT;
+	msg->msg_iovlen = v;
+	if (copy_from_user(&v, (const void __user *)(at + SUBLET_MSG_CONTROLLEN), sizeof(v)))
+		return -EFAULT;
+	msg->msg_controllen = v;
+	if (copy_from_user(&v, (const void __user *)(at + SUBLET_MSG_FLAGS), sizeof(v)))
+		return -EFAULT;
+	msg->msg_flags = v;
+	return 0;
+}
