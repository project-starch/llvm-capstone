+/* gp = PCC(cursor 0) fabrication toggle (our non-canonical patch 7aca0540).
+ * The RTL never establishes gp this way -- an image-bounded cap forced to cursor
+ * 0 is unrepresentable -- so the gp-free domain ABI delivers gp from the monitor
+ * and turns this off (CAPSTONE_GP_FABRICATE=0). Default on preserves the legacy
+ * behaviour, so the existing corpus is unaffected. Cached once. */
+static bool capstone_gp_fabricate(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *e = getenv("CAPSTONE_GP_FABRICATE");
+        cached = (e && e[0] == '0') ? 0 : 1;
+    }
+    return cached;
+}
+
+/* Monitor stand-in for the gp-free QEMU proof. When CAPSTONE_GP_STANDIN=1 (and
+ * fabrication is off), helper_cscall delivers a *representable* image-covering gp
+ * -- PCC's bounds with an in-bounds cursor (= base) -- which is exactly what the
+ * monitor's C_GEN_CAP mint will hand a fresh domain on silicon. QEMU supplies it
+ * here so the gp-free scc codegen can be proven end to end without rebuilding the
+ * OpenSBI monitor + buildroot image. Default off. */
+static bool capstone_gp_standin(void) {
+    static int cached = -1;
+    if (cached < 0) {
+        const char *e = getenv("CAPSTONE_GP_STANDIN");
+        cached = (e && e[0] == '1') ? 1 : 0;
+    }
+    return cached;
+}
