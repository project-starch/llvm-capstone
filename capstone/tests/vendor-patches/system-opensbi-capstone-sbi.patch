+    C_SET_CURSOR(dom_data, dom_data, base_addr + tot_size - 16);
+    *(__linear void **)dom_data = dom_gp;
+    C_SET_CURSOR(dom_data, dom_data, base_addr + code_size + DOMAIN_DATA_SIZE);
