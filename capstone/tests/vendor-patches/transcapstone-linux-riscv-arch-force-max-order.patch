--- c/arch/riscv/Kconfig
+++ w/arch/riscv/Kconfig
@@ -188,6 +188,25 @@ config ARCH_SPARSEMEM_ENABLE
 config ARCH_SELECT_MEMORY_MODEL
 	def_bool ARCH_SPARSEMEM_ENABLE
 
+config ARCH_FORCE_MAX_ORDER
+	int "Maximum zone order"
+	default "11"
+	help
+	  The kernel memory allocator divides physically contiguous memory
+	  blocks into "zones", where each zone is a power of two number of
+	  pages.  This option selects the largest power of two that the kernel
+	  keeps in the memory allocator.  If you need to allocate very large
+	  blocks of physically contiguous memory, then you may need to
+	  increase this value.
+
+	  This config option is actually maximum order plus one. For example,
+	  a value of 11 means that the largest free memory block is 2^10 pages.
+
+	  Capstone raises this above the 11 default: a domain region is a single
+	  __get_free_pages() allocation sized to hold the image plus headroom, so
+	  the buddy allocator's maximum order is a hard ceiling on how large a
+	  domain image can be. See package/modcapstone/module/capstone.c.
+
 config ARCH_SUPPORTS_UPROBES
 	def_bool y
 
