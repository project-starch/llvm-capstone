+#ifndef CAP_REV_TRACE_H
+#define CAP_REV_TRACE_H
+
+/* NESTED-LANE MEASUREMENT ONLY (2026-11-20): the record-access trace.
+ *
+ * With $CAPSTONE_RECTRACE set to a path prefix, every access the model makes
+ * to a record of a guest lifetime table is appended to `<prefix>.<pid>`, in
+ * execution order, as one little-endian u64 per run of identical events:
+ *
+ *   bits 63:56  code = kind << 2 | op
+ *   bits 55:32  count, the number of consecutive identical events (1..2^24-1)
+ *   bits 31:0   slot (the record index), or for a header op the byte offset of
+ *               the header word from the table root
+ *
+ * A root marker (kind CAP_REV_TRACE_ROOT) carries root >> 4 in bits 55:0 and
+ * is written whenever the table an event belongs to is not the previous
+ * event's.
+ *
+ * kind: what the access is for.
+ *   CHECK_U  the liveness check of a data capability in protected code
+ *            (protected U, or a supervised virtual C context): every load,
+ *            store, LDC and STC through a capability, and the check of a
+ *            linear capability at the LDC that loads it. One event per
+ *            dereference: QEMU's own caches are bypassed for the count.
+ *   CHECK_S  the same check outside protected code (S on the process's table).
+ *   CHECK_PC a liveness check of the PCC, where the model makes one.
+ *   ALLOC    CDERIVE, CSMINT, and the legacy creating operations.
+ *   RELEASE  CREVOKE, CSRETIRE, REVOKE: the writing pass.
+ *   VERIFY   the read-only pass the model makes over a subtree before it
+ *            releases it. Hardware need not make it.
+ *   OTHER    every other table operation (DELIN, liveness tests inside the
+ *            supervisor paths).
+ * op: 0 record read, 1 record write, 2 header read, 3 header write.
+ *
+ * The header validation the model repeats when it opens a table is not an
+ * event. `<path>.stats` holds the event and run totals per code, rewritten at
+ * each flush. Completed runs are also flushed every 2 s of wall time (checked every
+ * 2^20 events), so a QEMU that is killed loses at most that interval and the open
+ * run; the flush never closes a run, so it does not change the trace's content. */
+
+#include <stdint.h>
+#include <stdbool.h>
+
+enum {
+    CAP_REV_TRACE_CHECK_U = 0,
+    CAP_REV_TRACE_CHECK_S = 1,
+    CAP_REV_TRACE_CHECK_PC = 2,
+    CAP_REV_TRACE_ALLOC = 3,
+    CAP_REV_TRACE_RELEASE = 4,
+    CAP_REV_TRACE_VERIFY = 5,
+    CAP_REV_TRACE_OTHER = 6,
+    CAP_REV_TRACE_ROOT = 7,
+    CAP_REV_TRACE_KINDS = 8,
+    /* Position in time: two marker words every CAP_REV_TRACE_MARK runs, and at
+     * the end. Bits 55:0 are the guest instructions executed so far, ICOUNT
+     * all of them (firmware, kernel, every process), ICOUNT_P those of
+     * protected code (the capability data mode of the translator). */
+    CAP_REV_TRACE_ICOUNT = 8,
+    CAP_REV_TRACE_ICOUNT_P = 9,
+    /* A context edge of protected code (protected U, or a supervised virtual C context):
+     * op 0 = a trap out of it (slot = cause, bit 31 set for an interrupt), op 2 = SRET into it,
+     * op 3 = MRET into it. One word each, never merged into a run with another edge. */
+    CAP_REV_TRACE_EDGE = 10,
+};
+enum { CAP_REV_TRACE_EDGE_TRAP = 0, CAP_REV_TRACE_EDGE_SRET = 2, CAP_REV_TRACE_EDGE_MRET = 3 };
+void cap_rev_trace_edge(uint64_t root, int op, uint64_t cause);
+#define CAP_REV_TRACE_MARK 1024
+
+extern uint64_t cap_rev_trace_icount[2];    /* all, protected: incremented by translated code */
+enum {
+    CAP_REV_TRACE_READ = 0,
+    CAP_REV_TRACE_WRITE = 1,
+    CAP_REV_TRACE_HREAD = 2,
+    CAP_REV_TRACE_HWRITE = 3,
+};
+
+extern bool cap_rev_trace_on;   /* fixed before the first instruction runs */
+extern int cap_rev_trace_kind;  /* the kind of the table operation in progress */
+extern int cap_rev_trace_mute;  /* > 0: table accesses are not events */
+
+void cap_rev_trace_event(uint64_t root, int kind, int op, uint64_t slot);
+
+/* A table access made by the operation in progress. */
+static inline void cap_rev_trace_access(uint64_t root, int op, uint64_t slot)
+{
+    if (cap_rev_trace_on && !cap_rev_trace_mute) {
+        cap_rev_trace_event(root, cap_rev_trace_kind, op, slot);
+    }
+}
+
+/* Scope of one table operation: sets the kind, returns the previous one. */
+static inline int cap_rev_trace_enter(int kind)
+{
+    int old = cap_rev_trace_kind;
+    cap_rev_trace_kind = kind;
+    return old;
+}
+
+static inline void cap_rev_trace_leave(int old)
+{
+    cap_rev_trace_kind = old;
+}
+
+#endif
diff --git a/target/riscv/cap_rev_trace.c b/target/riscv/cap_rev_trace.c
new file mode 100644
index 0000000000..004c877b45
--- /dev/null
+++ b/target/riscv/cap_rev_trace.c
@@ -0,0 +1,205 @@
+/* NESTED-LANE MEASUREMENT ONLY (2026-11-20): the record-access trace. See cap_rev_trace.h. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <time.h>
+#include "cap_rev_trace.h"
+
+bool cap_rev_trace_on;
+uint64_t cap_rev_trace_icount[2];
+int cap_rev_trace_kind = CAP_REV_TRACE_OTHER;
+int cap_rev_trace_mute;
+
+#define RT_BUF (1u << 17)           /* runs per write: 1 MiB */
+#define RT_COUNT_MAX 0xffffffu
+
+static int rt_fd = -1;
+static char rt_stats_path[4096];
+static uint64_t rt_buf[RT_BUF];
+static unsigned rt_n;
+static uint64_t rt_key;             /* code << 32 | slot of the open run */
+static uint64_t rt_count;           /* its length; 0 = no open run */
+static uint64_t rt_root;            /* the table of the previous event */
+static bool rt_root_set;
+static uint64_t rt_events[CAP_REV_TRACE_KINDS * 4], rt_runs[CAP_REV_TRACE_KINDS * 4];
+static uint64_t rt_roots, rt_written, rt_flushes, rt_marks, rt_edges[4];
+static unsigned rt_since_mark;
+static uint64_t rt_events_since_clock;
+static struct timespec rt_last_flush;
+#define RT_FLUSH_SECONDS 2          /* a killed QEMU loses at most this much of the trace, plus the open run */
+
+static void rt_stats(void)
+{
+    static const char *const kind[CAP_REV_TRACE_KINDS] = {
+        "check_u", "check_s", "check_pc", "alloc", "release", "verify", "other", "root" };
+    static const char *const op[4] = { "read", "write", "hread", "hwrite" };
+    char tmp[4200];
+    FILE *f;
+
+    snprintf(tmp, sizeof(tmp), "%s.tmp", rt_stats_path);
+    f = fopen(tmp, "w");
+    if (!f) {
+        return;
+    }
+    fprintf(f, "words_written %llu\nroot_markers %llu\nicount_markers %llu\n"
+               "instructions_all %llu\ninstructions_protected %llu\n",
+            (unsigned long long)rt_written, (unsigned long long)rt_roots,
+            (unsigned long long)rt_marks,
+            (unsigned long long)cap_rev_trace_icount[0],
+            (unsigned long long)cap_rev_trace_icount[1]);
+    fprintf(f, "edges_trap %llu\nedges_sret %llu\nedges_mret %llu\n",
+            (unsigned long long)rt_edges[0], (unsigned long long)rt_edges[2],
+            (unsigned long long)rt_edges[3]);
+    for (int k = 0; k < CAP_REV_TRACE_ROOT; k++) {
+        for (int o = 0; o < 4; o++) {
+            if (rt_events[k * 4 + o]) {
+                fprintf(f, "%s_%s events %llu runs %llu\n", kind[k], op[o],
+                        (unsigned long long)rt_events[k * 4 + o],
+                        (unsigned long long)rt_runs[k * 4 + o]);
+            }
+        }
+    }
+    fprintf(f, "END\n");
+    fclose(f);
+    rename(tmp, rt_stats_path);
+}
+
+static void rt_write(void)
+{
+    const char *p = (const char *)rt_buf;
+    size_t left = (size_t)rt_n * sizeof(rt_buf[0]);
+
+    while (left) {
+        ssize_t w = write(rt_fd, p, left);
+        if (w <= 0) {
+            /* A trace with a hole is worse than none: stop the run. */
+            fprintf(stderr, "cap_rev_trace: write failed, aborting\n");
+            abort();
+        }
+        p += w;
+        left -= (size_t)w;
+    }
+    rt_written += rt_n;
+    rt_n = 0;
+    if ((rt_flushes++ & 15) == 0) {
+        rt_stats();
+    }
+}
+
+static inline void rt_put(uint64_t word)
+{
+    rt_buf[rt_n++] = word;
+    if (rt_n == RT_BUF) {
+        rt_write();
+    }
+}
+
+static void rt_mark(void)
+{
+    rt_put((uint64_t)(CAP_REV_TRACE_ICOUNT << 2) << 56 | (cap_rev_trace_icount[0] & 0xffffffffffffffull));
+    rt_put((uint64_t)(CAP_REV_TRACE_ICOUNT_P << 2) << 56 | (cap_rev_trace_icount[1] & 0xffffffffffffffull));
+    rt_marks++;
+    rt_since_mark = 0;
+}
+
+static void rt_close_run(void)
+{
+    if (rt_count) {
+        rt_put((rt_key >> 32) << 56 | rt_count << 32 | (rt_key & 0xffffffffu));
+        rt_runs[rt_key >> 32]++;
+        rt_count = 0;
+        if (++rt_since_mark >= CAP_REV_TRACE_MARK) {
+            /* The counts are read when the NEXT run opens: they place it. */
+            rt_mark();
+        }
+    }
+}
+
+static void rt_exit(void)
+{
+    if (rt_fd >= 0) {
+        rt_close_run();
+        rt_mark();
+        rt_write();
+        rt_stats();
+        close(rt_fd);
+        rt_fd = -1;
+    }
+}
+
+void cap_rev_trace_edge(uint64_t root, int op, uint64_t cause)
+{
+    if (!cap_rev_trace_on) {
+        return;
+    }
+    if (!rt_root_set || root != rt_root) {
+        rt_close_run();
+        rt_put((uint64_t)(CAP_REV_TRACE_ROOT << 2) << 56 | (root >> 4));
+        rt_root = root;
+        rt_root_set = true;
+        rt_roots++;
+    }
+    rt_close_run();
+    rt_put((uint64_t)(CAP_REV_TRACE_EDGE << 2 | op) << 56 | 1ull << 32 | (cause & 0xffffffffu));
+    rt_edges[op]++;
+}
+
+/* Before main: the translator reads cap_rev_trace_on from its first block on. */
+static void __attribute__((constructor)) cap_rev_trace_init(void)
+{
+    const char *prefix = getenv("CAPSTONE_RECTRACE");
+    char path[4096];
+
+    if (!prefix || !*prefix || strlen(prefix) > sizeof(path) - 40) {
+        return;
+    }
+    /* One file per QEMU process (a runner may start more than one), never over an existing trace. */
+    snprintf(path, sizeof(path), "%s.%ld", prefix, (long)getpid());
+    rt_fd = open(path, O_WRONLY | O_CREAT | O_EXCL, 0644);
+    if (rt_fd < 0) {
+        fprintf(stderr, "cap_rev_trace: cannot create %s\n", path);
+        exit(1);
+    }
+    snprintf(rt_stats_path, sizeof(rt_stats_path), "%s.stats", path);
+    cap_rev_trace_on = true;
+    atexit(rt_exit);
+    rt_stats();
+}
+
+void cap_rev_trace_event(uint64_t root, int kind, int op, uint64_t slot)
+{
+    uint64_t code = (uint64_t)kind << 2 | (uint64_t)op;
+    uint64_t key = code << 32 | (slot & 0xffffffffu);
+
+    if (!rt_root_set || root != rt_root) {
+        rt_close_run();
+        rt_put((uint64_t)(CAP_REV_TRACE_ROOT << 2) << 56 | (root >> 4));
+        rt_root = root;
+        rt_root_set = true;
+        rt_roots++;
+    }
+    rt_events[code]++;
+    if (++rt_events_since_clock >= (1u << 20)) {
+        /* Timer flush: write the completed runs and the totals. The open run stays open, so the
+         * trace's content is the same as without it. */
+        struct timespec now;
+        rt_events_since_clock = 0;
+        clock_gettime(CLOCK_MONOTONIC_COARSE, &now);
+        if (now.tv_sec - rt_last_flush.tv_sec >= RT_FLUSH_SECONDS) {
+            rt_last_flush = now;
+            if (rt_n) {
+                rt_write();
+            }
+            rt_stats();
+        }
+    }
+    if (rt_count && key == rt_key && rt_count < RT_COUNT_MAX) {
+        rt_count++;
+        return;
+    }
+    rt_close_run();
+    rt_key = key;
+    rt_count = 1;
+}
