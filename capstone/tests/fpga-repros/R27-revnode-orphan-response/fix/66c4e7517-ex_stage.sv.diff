+    logic[0:0] rev_init_res_ack_node, rev_init_res_valid_dyn;
+    logic[0:0] rev_rev_res_ack_node, rev_rev_res_valid_dyn;
+    logic[0:0] rev_drop_res_ack_node, rev_drop_res_valid_dyn;
