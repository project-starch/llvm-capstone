+
+    // R-27 (2026-09-09): a pipeline flush resets the DYN unit (its flush endpoint below) but not the
+    // revocation node. A response the node produces for a request whose requester was flushed is never
+    // acknowledged; the node blocks in that send, never serves another request, and the next capability
+    // instruction that talks to it (CALL/RETURN/LDC/STC/REVOKE/SPLIT/TIGHTEN/LCC/DROP/DELIN/MREV) waits
+    // forever behind the DYN unit's ready. Measured in r26-v2-cscratch-fence and r27-fence-nost: the
+    // fence.i / fence flush landed one cycle after the query request; the response rose two cycles
+    // later and stayed asserted to the end of the run. Per response channel: remember a request the
+    // node accepted whose response is still owed; when a flush lands while one is owed, drain that
+    // response (acknowledge it to the node, hide it from the DYN unit) and hold the DYN unit's ready
+    // until it is gone, so a re-issued instruction can never consume its predecessor's answer.
+    // Assumptions, stated (2026-09-09 audit): (a) one DYN op in flight per channel -- the DYN unit's rtr
+    // handshake serialises ops (capstone_dyn_ready above), so one owed bit per channel suffices; (b)
+    // rev_drain_q is registered, so in the flush cycle itself ready is still ungated -- harmless, the same
+    // flush empties issue and no op can be dispatched in that cycle; (c) KNOWN CORNER, a design choice: the
+    // node deliberately never answers init/mrev when its pool is exhausted (capstone_rev_node.anvil,
+    // head == 16'hFFFF), so a SPLIT/MREV then stalls forever by design. Before this logic an interrupt
+    // could still be taken (the flush resets the DYN unit, the node is idle, the handler's capability ops
+    // work; the program itself never gets past the stalled op). With it, that flush latches the owed bit
+    // into a drain that no response will ever clear, and ready stays low for the life of the core: the
+    // handler's first capability op hangs too. Accepted here because the alternative -- leaving init/mrev
+    // out of the drain -- keeps the orphan deadlock alive for an interrupt during a SPLIT/MREV wait; the
+    // exhausted pool is a separate, already-registered condition (no slot reclamation).
+    localparam int unsigned REV_CH = 6;
+    logic [REV_CH-1:0] rev_req_hs, rev_res_hs_node, rev_res_valid_node, rev_res_ack_dyn;
+    logic [REV_CH-1:0] rev_res_ack_node, rev_res_valid_dyn;
+    logic [REV_CH-1:0] rev_owed_q, rev_drain_q;
+    assign rev_req_hs = {rev_query_req_valid & rev_query_req_ack, rev_mrev_req_valid & rev_mrev_req_ack,
+                         rev_delin_req_valid & rev_delin_req_ack, rev_drop_req_valid & rev_drop_req_ack,
+                         rev_rev_req_valid & rev_rev_req_ack, rev_init_req_valid & rev_init_req_ack};
+    assign rev_res_valid_node = {rev_query_res_valid, rev_mrev_res_valid, rev_delin_res_valid,
+                                 rev_drop_res_valid, rev_rev_res_valid, rev_init_res_valid};
+    assign rev_res_ack_dyn = {rev_query_res_ack, rev_mrev_res_ack, rev_delin_res_ack,
+                              rev_drop_res_ack, rev_rev_res_ack, rev_init_res_ack};
+    assign rev_res_ack_node  = rev_drain_q | rev_res_ack_dyn;
+    assign rev_res_valid_dyn = rev_res_valid_node & ~rev_drain_q;
+    assign rev_res_hs_node   = rev_res_valid_node & rev_res_ack_node;
+    assign {rev_query_res_ack_node, rev_mrev_res_ack_node, rev_delin_res_ack_node,
+            rev_drop_res_ack_node, rev_rev_res_ack_node, rev_init_res_ack_node} = rev_res_ack_node;
+    assign {rev_query_res_valid_dyn, rev_mrev_res_valid_dyn, rev_delin_res_valid_dyn,
+            rev_drop_res_valid_dyn, rev_rev_res_valid_dyn, rev_init_res_valid_dyn} = rev_res_valid_dyn;
+    always_ff @(posedge clk_i or negedge rst_ni) begin
+      if (!rst_ni) begin
+        rev_owed_q  <= '0;
+        rev_drain_q <= '0;
+      end else begin
+        rev_owed_q  <= (rev_owed_q | rev_req_hs) & ~rev_res_hs_node;
+        rev_drain_q <= (rev_drain_q | (flush_i ? (rev_owed_q | rev_req_hs) : {REV_CH{1'b0}})) & ~rev_res_hs_node;
+      end
+    end
 
