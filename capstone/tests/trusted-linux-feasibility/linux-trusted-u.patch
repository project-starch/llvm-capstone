--- a/arch/riscv/include/asm/ptrace.h
+++ b/arch/riscv/include/asm/ptrace.h
@@ -53,0 +54,4 @@ struct pt_regs {
+#ifdef CONFIG_CAPSTONE_TRUSTED_U
