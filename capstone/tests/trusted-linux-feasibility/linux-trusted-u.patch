diff --git a/arch/riscv/Kconfig b/arch/riscv/Kconfig
index 593cf09264d8..e792dde5d804 100644
--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -12,0 +13,8 @@ config 32BIT
+config CAPSTONE_TRUSTED_U
+	bool "Experimental trusted-Linux Capstone user context"
+	depends on 64BIT && MMU
+	help
+	  Enable the bounded single-process QEMU experiment for a tagged s2
+	  register across Linux syscalls and task switches.  This kernel requires
+	  the experimental Capstone CPU option and is not a general user ABI.
+
diff --git a/arch/riscv/include/asm/capstone_trusted_u.h b/arch/riscv/include/asm/capstone_trusted_u.h
new file mode 100644
index 000000000000..97aabfce8ba4
--- /dev/null
+++ b/arch/riscv/include/asm/capstone_trusted_u.h
@@ -0,0 +1,18 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_RISCV_CAPSTONE_TRUSTED_U_H
+#define _ASM_RISCV_CAPSTONE_TRUSTED_U_H
+
+#include <linux/types.h>
+
+struct pt_regs;
+struct task_struct;
+
+#ifdef CONFIG_CAPSTONE_TRUSTED_U
+long riscv_capstone_enable(unsigned long base, unsigned long end);
+long riscv_capstone_switch_count(void);
+void riscv_capstone_user_return(struct pt_regs *regs);
+void riscv_capstone_task_switch(struct task_struct *prev,
+				 struct task_struct *next);
+#endif
+
+#endif
