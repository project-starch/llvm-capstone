+/* Stage 2, before any protected process exists: write 1 and read it back. A hart with the mode
+ * reads bit 0; srevroot_q stays 0 throughout, so nothing decodes in the mode. Then write 0. */
+bool sublet_crvc_hw __ro_after_init;
+static int __init sublet_crvc_probe(void)
+{
+	unsigned long got;
+
+	csr_write(0x5c1, 1);
+	got = csr_read(0x5c1);
+	csr_write(0x5c1, 0);
+	sublet_crvc_hw = got & 1;
+	pr_info("sublet: CRVC probe read 0x%lx after writing 1: %s\n", got,
+		sublet_crvc_hw ? "the CRVC mode is present" : "no CRVC mode, flagged images are refused");
+	return 0;
+}
+core_initcall(sublet_crvc_probe);
 #endif
 
