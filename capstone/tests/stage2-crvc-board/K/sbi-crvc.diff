diff --git a/lib/sbi/sbi_misaligned_ldst.c b/lib/sbi/sbi_misaligned_ldst.c
index 4b91e072..d3f52a53 100644
--- a/lib/sbi/sbi_misaligned_ldst.c
+++ b/lib/sbi/sbi_misaligned_ldst.c
@@ -10,6 +10,7 @@
 #include <sbi/riscv_asm.h>
 #include <sbi/riscv_encoding.h>
 #include <sbi/riscv_fp.h>
+#include <sbi/sbi_console.h>
 #include <sbi/sbi_error.h>
 #include <sbi/sbi_misaligned_ldst.h>
 #include <sbi/sbi_pmu.h>
@@ -22,6 +23,56 @@ union reg_data {
 	u64 data_u64;
 };
 
+/*
+ * Capstone stage 2 (CRVC). In protected U with the CRVC mode on, the 16-bit slots Q0/Q2 funct3
+ * 001/101 are c.ldc, c.stc, c.ldcsp and c.stcsp, not C.FLD, C.FSD, C.FLDSP and C.FSDSP. A misaligned
+ * one is not emulated: it goes to S with its own cause. The mode is bit 0 of srevroot, read back,
+ * and protected U is srevroot[63:12] != 0 with MPP = U (the RTL's cap_data_ctx[0] less sup_active,
+ * which Line B never sets). The trap carries mtval 0 and mtinst 0 on the board's RTL, so only the
+ * instruction at mepc is read.
+ */
+static unsigned long crvc_redirects, crvc_u_emulations;
+
+static void crvc_report(unsigned long n)
+{
+	if (n && !(n & (n - 1)))
+		sbi_printf("FWCRVC redirect=%lu emulate-u=%lu\n", crvc_redirects,
+			   crvc_u_emulations);
+}
+
+static bool crvc_from_u(struct sbi_trap_regs *regs)
+{
+#if __riscv_xlen == 64
+	if (regs->mstatus & MSTATUS_MPV)
+		return false;
+#endif
+	return ((regs->mstatus & MSTATUS_MPP) >> MSTATUS_MPP_SHIFT) == PRV_U;
+}
+
+static bool crvc_decoded(struct sbi_trap_regs *regs, ulong insn, ulong tinst)
+{
+	ulong root, q, f3;
+
+	if (!crvc_from_u(regs))
+		return false;
+	root = csr_read(0x5c1);
+	if (!(root & 1) || !(root >> 12))
+		return false;
+	if (tinst & 0x1)	/* a transformed instruction: a 16-bit one's slot is unknown, so redirect */
+		return !(tinst & 0x2);
+	if ((insn & 3) == 3)
+		return false;
+	q  = insn & 3;
+	f3 = (insn >> 13) & 7;
+	return q != 1 && (f3 == 1 || f3 == 5);
+}
+
+static void crvc_count_emulation(struct sbi_trap_regs *regs)
+{
+	if (crvc_from_u(regs))
+		crvc_report(++crvc_u_emulations);
+}
+
 static ulong sbi_misaligned_tinst_fixup(ulong orig_tinst, ulong new_tinst,
 					ulong addr_offset)
 {
@@ -64,6 +115,17 @@ int sbi_misaligned_load_handler(ulong addr, ulong tval2, ulong tinst,
 		insn_len = INSN_LEN(insn);
 	}
 
+	if (crvc_decoded(regs, insn, tinst)) {
+		uptrap.epc = regs->mepc;
+		uptrap.cause = CAUSE_MISALIGNED_LOAD;
+		uptrap.tval = addr;
+		uptrap.tval2 = tval2;
+		uptrap.tinst = tinst;
+		uptrap.gva   = sbi_regs_gva(regs);
+		crvc_report(++crvc_redirects);
+		return sbi_trap_redirect(regs, &uptrap);
+	}
+
 	if ((insn & INSN_MASK_LW) == INSN_MATCH_LW) {
 		len   = 4;
 		shift = 8 * (sizeof(ulong) - len);
@@ -155,6 +217,7 @@ int sbi_misaligned_load_handler(ulong addr, ulong tval2, ulong tinst,
 #endif
 
 	regs->mepc += insn_len;
+	crvc_count_emulation(regs);
 
 	return 0;
 }
@@ -189,6 +252,17 @@ int sbi_misaligned_store_handler(ulong addr, ulong tval2, ulong tinst,
 		insn_len = INSN_LEN(insn);
 	}
 
+	if (crvc_decoded(regs, insn, tinst)) {
+		uptrap.epc = regs->mepc;
+		uptrap.cause = CAUSE_MISALIGNED_STORE;
+		uptrap.tval = addr;
+		uptrap.tval2 = tval2;
+		uptrap.tinst = tinst;
+		uptrap.gva   = sbi_regs_gva(regs);
+		crvc_report(++crvc_redirects);
+		return sbi_trap_redirect(regs, &uptrap);
+	}
+
 	val.data_ulong = GET_RS2(insn, regs);
 
 	if ((insn & INSN_MASK_SW) == INSN_MATCH_SW) {
@@ -261,6 +335,7 @@ int sbi_misaligned_store_handler(ulong addr, ulong tval2, ulong tinst,
 	}
 
 	regs->mepc += insn_len;
+	crvc_count_emulation(regs);
 
 	return 0;
 }
