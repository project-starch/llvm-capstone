--- a/components/opensbi
+++ b/components/opensbi
@@ -1 +1 @@
-Subproject commit 769939a735e2dfc35d2b6ddfc050242d8410e815
+Subproject commit 7a14a0e062de0478aecbc8f6c83a176160d4eb14
diff --git a/configs/kernel.config b/configs/kernel.config
index dd43704..086587c 100644
--- a/configs/kernel.config
+++ b/configs/kernel.config
@@ -30,10 +30,6 @@ CONFIG_SOC_SIFIVE=y
 CONFIG_SOC_STARFIVE=y
 CONFIG_SOC_VIRT=y
 CONFIG_SMP=y
-# Domain regions are one __get_free_pages() allocation, so the buddy allocator
-# caps the domain image size. 13 => largest block 2^12 pages = 16 MiB, which
-# lifts the maximum domain code_len from 1,376,256 to 5,570,560 bytes.
-CONFIG_ARCH_FORCE_MAX_ORDER=13
 CONFIG_HOTPLUG_CPU=y
 CONFIG_PM=y
 CONFIG_CPU_IDLE=y
diff --git a/package/modcapstone/include/capstone.h b/package/modcapstone/include/capstone.h
index c7be6eb..331bd7b 100644
--- a/package/modcapstone/include/capstone.h
+++ b/package/modcapstone/include/capstone.h
@@ -26,8 +26,14 @@ struct ioctl_dom_create_args {
     size_t s_load_len;
     size_t s_entry_offset;
     size_t s_size;
+    /* Declared requirement from the image's optional .capstone_domreq section.
+       dom_data_min is the whole dom_data need (initializer blob + cap table +
+       per-global storage + stack); stack_min is how much of that is stack and is
+       carried for diagnostics only. Both 0 => the image declares nothing and the
+       module keeps its historical max(2 * code_len, 512 KiB) rule. */
+    size_t dom_data_min;
+    size_t stack_min;
     dom_id_t dom_id;
-    // TODO: pass info about the required data region size
 };
 
 struct ioctl_dom_call_args {
diff --git a/package/modcapstone/module/capstone.c b/package/modcapstone/module/capstone.c
index c9e9f4c..9d0a2a9 100644
--- a/package/modcapstone/module/capstone.c
+++ b/package/modcapstone/module/capstone.c
@@ -113,12 +113,53 @@ static void ioctl_create_dom(struct ioctl_dom_create_args* __user args) {
 	 * the size it is on an ordinary target, and a recursive-descent compiler walking a nested
 	 * scope exhausted a 522 KB stack. The fault was the FIRST instruction of a callee, its
 	 * `cincoffsetimm sp, sp, -0x80` -- a frame that no longer fits. */
-	unsigned long dom_min_free = 2 * m_args.code_len;
-	if (dom_min_free < DOMAIN_MIN_FREE) {
-		dom_min_free = DOMAIN_MIN_FREE;
+	unsigned long dom_need;
+	unsigned long data_vaddr = 0, data_paddr = 0, data_size = 0;
+	unsigned long data_pages_log2 = 0;
+	if (m_args.dom_data_min) {
+		/* The image DECLARED what it needs (.capstone_domreq), so nothing here is
+		 * inferred: the code region holds align16(code_len) and the data region holds
+		 * the monitor's 1536-byte seal plus the declared dom_data. Note the seal, not
+		 * this module's far coarser DOMAIN_DATA_SIZE -- a declared requirement is only
+		 * worth having if the sizing around it is exact too. */
+		unsigned long code_size = (((m_args.code_len - 1) >> 4) + 1) << 4;
+		/* TWO regions, not one. The monitor splits a single capability into
+		 * code | seal | data, which is why everything had to be one contiguous
+		 * allocation and why the buddy allocator's maximum order became a ceiling on
+		 * image size -- it capped code_len at 1,376,256 bytes and the largest domain
+		 * that ever ran is 1,375,688 of them. Handing the monitor a separate data
+		 * region decouples the two: each is sized for its own role, and an image that
+		 * needed one 16 MiB block now needs two 4 MiB ones, which the stock allocator
+		 * gives without any kernel change at all.
+		 *
+		 * Both stay POWER-OF-TWO deliberately. Capability bounds are compressed
+		 * (cap_compress.c: base and length quantised to 2^(E+3), E = msb(len) - 12,
+		 * base rounding DOWN and end UP), so a 2^k-sized, 2^k-aligned region is exactly
+		 * representable by construction while an arbitrary byte length is not. QEMU
+		 * hides that by shadowing exact bounds in cap_mem_map; silicon cannot. Exact
+		 * sizing is worth having later, but it needs the granule arithmetic with it,
+		 * and it is not what this change is for. */
+		dom_need = code_size;
+		data_size = MONITOR_SEAL_SIZE + m_args.dom_data_min;
+		/* Restart the order search from what the CODE region needs. The value computed
+		 * above starts from code_len + DOMAIN_DATA_SIZE, which is right when one region
+		 * holds everything and one order too large here whenever that 64 KiB is what
+		 * crosses a power-of-two boundary. */
+		{
+			unsigned long cp = (code_size - 1) / PAGE_SIZE + 1;
+			dom_pages_log2 = cp == 1 ? 0 : (ilog2(cp - 1) + 1);
+		}
+		pr_info("domain declares dom_data >= %lu (stack %lu); code %lu + data %lu\n",
+			(unsigned long)m_args.dom_data_min, (unsigned long)m_args.stack_min,
+			dom_need, data_size);
+	} else {
+		unsigned long dom_min_free = 2 * m_args.code_len;
+		if (dom_min_free < DOMAIN_MIN_FREE) {
+			dom_min_free = DOMAIN_MIN_FREE;
+		}
+		dom_need = m_args.code_len + DOMAIN_DATA_SIZE + dom_min_free;
 	}
-	while (((1UL << dom_pages_log2) * PAGE_SIZE) <
-	       m_args.code_len + DOMAIN_DATA_SIZE + dom_min_free) {
+	while (((1UL << dom_pages_log2) * PAGE_SIZE) < dom_need) {
 		dom_pages_log2 += 1;
 	}
 	unsigned long dom_vaddr = (unsigned long)__get_free_pages(GFP_HIGHUSER, dom_pages_log2);
@@ -127,6 +168,21 @@ static void ioctl_create_dom(struct ioctl_dom_create_args* __user args) {
 		return;
 	}
 
+	if (data_size) {
+		unsigned long p = (data_size - 1) / PAGE_SIZE + 1;
+		data_pages_log2 = p == 1 ? 0 : (ilog2(p - 1) + 1);
+		data_vaddr = (unsigned long)__get_free_pages(GFP_HIGHUSER, data_pages_log2);
+		if (!data_vaddr) {
+			free_pages(dom_vaddr, dom_pages_log2);
+			pr_alert("Failed to allocate the domain's data region (%lu bytes).\n",
+				 data_size);
+			return;
+		}
+		data_paddr = __pa(data_vaddr);
+		pr_info("Domain data region vaddr = %lx, paddr = %lx, size = %lx\n",
+			data_vaddr, data_paddr, (1UL << data_pages_log2) * PAGE_SIZE);
+	}
+
 	unsigned long dom_paddr = __pa(dom_vaddr);
 	// TODO: do we still need to do this on page granularity?
 	pr_info("Domain memory region vaddr = %lx, paddr = %lx\n", dom_vaddr, dom_paddr);
@@ -144,20 +200,23 @@ static void ioctl_create_dom(struct ioctl_dom_create_args* __user args) {
 	 * gp_offset==0 (non-gp-captable domain), so all existing domains are unaffected. */
 	if (m_args.gp_offset > 0 && m_args.gp_offset < m_args.code_len) {
 		unsigned long code_size = (((m_args.code_len - 1) >> 4) + 1) << 4;
-		unsigned long dom_data_off = code_size + MONITOR_SEAL_SIZE;
 		unsigned long tmpl_len = m_args.code_len - m_args.gp_offset;
-		memcpy((void*)(dom_vaddr + dom_data_off),
-		       (void*)(dom_vaddr + m_args.gp_offset), tmpl_len);
-		pr_info("gp-captable: copied %lu-byte globals template from +%lx to dom_data +%lx\n",
-			tmpl_len, m_args.gp_offset, dom_data_off);
+		/* dom_data starts MONITOR_SEAL_SIZE into whichever region holds it: the data
+		 * region when there is one, otherwise just past the code as before. */
+		unsigned long dst = data_vaddr ? (data_vaddr + MONITOR_SEAL_SIZE)
+					       : (dom_vaddr + code_size + MONITOR_SEAL_SIZE);
+		memcpy((void*)dst, (void*)(dom_vaddr + m_args.gp_offset), tmpl_len);
+		pr_info("gp-captable: copied %lu-byte globals template from +%lx to %s dom_data\n",
+			tmpl_len, m_args.gp_offset, data_vaddr ? "the data region's" : "the code region's");
 	}
 
 	struct sbiret sbi_res = sbi_ecall(SBI_EXT_CAPSTONE, SBI_EXT_CAPSTONE_DOM_CREATE,
 		/* base paddr = */ dom_paddr,
 		/* code size = */ m_args.code_len,
-		/* tot size = */ (1 << dom_pages_log2) * PAGE_SIZE, 
+		/* tot size = */ (1UL << dom_pages_log2) * PAGE_SIZE,
 		/* entry offset = */ m_args.entry_offset,
-		0, 0);
+		/* data paddr = */ data_paddr,
+		/* data size = */ data_paddr ? (1UL << data_pages_log2) * PAGE_SIZE : 0);
 	if (sbi_res.error) {
 		pr_err("DOM_CREATE failed: paddr=%lx code_len=%lu tot_size=%lx entry_offset=%lx error=%ld value=%ld\n",
 			dom_paddr, m_args.code_len, (1 << dom_pages_log2) * PAGE_SIZE,
diff --git a/package/modcapstone/userspace/lib/libcapstone.c b/package/modcapstone/userspace/lib/libcapstone.c
index 6b693db..97c474d 100644
--- a/package/modcapstone/userspace/lib/libcapstone.c
+++ b/package/modcapstone/userspace/lib/libcapstone.c
@@ -9,6 +9,7 @@
 #include <sys/mman.h>
 #include <sys/stat.h>
 #include <elf.h>
+#include <stdint.h>
 #include <fcntl.h>
 #include "libcapstone.h"
 
@@ -30,6 +31,10 @@ struct ElfCode {
     unsigned long loadable_size;
     off_t size, entry_offset;
     size_t gp_offset;   /* offset of the gp-captable globals template in the image; 0 if none */
+    /* From the optional .capstone_domreq section. 0 => the image declares nothing and
+       the module falls back to its historical max(2 * code_len, 512 KiB) rule. */
+    unsigned long dom_data_min;
+    unsigned long stack_min;
 };
 
 static int dev_fd;
@@ -193,6 +198,11 @@ static int load_elf_code(const char *file_name, struct ElfCode *res) {
      * domain owns no gp-captable globals, so there is nothing to copy. MUST run before
      * the munmap below -- it reads the section headers from the mapped ELF. */
     res->gp_offset = 0;
+    /* struct ElfCode is an uninitialised stack variable in every caller, so these
+       MUST be cleared here. Left as-is, an image without .capstone_domreq would hand
+       the module a stack-garbage requirement and it would size the region from it. */
+    res->dom_data_min = 0;
+    res->stack_min = 0;
     {
         Elf64_Shdr *shdrs = (Elf64_Shdr *)(((void *)elf_header) + elf_header->e_shoff);
         Elf64_Half shnum = elf_header->e_shnum;
@@ -200,9 +210,31 @@ static int load_elf_code(const char *file_name, struct ElfCode *res) {
                           + shdrs[elf_header->e_shstrndx].sh_offset;
         int si;
         for (si = 0; si < shnum; si++) {
-            if (strcmp(shstr + shdrs[si].sh_name, ".capstone_gp_initdesc") == 0) {
+            const char *nm = shstr + shdrs[si].sh_name;
+            if (strcmp(nm, ".capstone_gp_initdesc") == 0) {
                 res->gp_offset = (size_t)(shdrs[si].sh_addr - loadable_start);
-                break;
+            } else if (strcmp(nm, ".capstone_domreq") == 0) {
+                /* Deliberately read through sh_OFFSET, not sh_addr: the section is
+                   non-alloc so it has no address, which is the point -- declaring a
+                   requirement must not perturb the loaded image. */
+                if (shdrs[si].sh_size >= 24
+                    && shdrs[si].sh_offset + 24 <= (Elf64_Off)file_stat.st_size) {
+                    const uint64_t *q = (const uint64_t *)
+                        ((const unsigned char *)elf_header + shdrs[si].sh_offset);
+                    if (q[0] == 0x5145524d4f445043ULL) {   /* "CPDOMREQ" */
+                        res->dom_data_min = (unsigned long)q[1];
+                        res->stack_min    = (unsigned long)q[2];
+                    } else {
+                        fprintf(stderr, "Ignoring .capstone_domreq: bad magic %llx\n",
+                                (unsigned long long)q[0]);
+                    }
+                } else {
+                    fprintf(stderr, "Ignoring .capstone_domreq: %llu bytes at %llu, "
+                            "want 24 within a %llu-byte file\n",
+                            (unsigned long long)shdrs[si].sh_size,
+                            (unsigned long long)shdrs[si].sh_offset,
+                            (unsigned long long)file_stat.st_size);
+                }
             }
         }
     }
@@ -221,6 +253,10 @@ static int load_elf_code(const char *file_name, struct ElfCode *res) {
 
     printf("Loadable size = %lu, gp_offset = %lx\n", res->loadable_size,
            (unsigned long)res->gp_offset);
+    if (res->dom_data_min) {
+        printf("Declared dom_data = %lu (stack %lu)\n",
+               res->dom_data_min, res->stack_min);
+    }
 
     return 0;
 
@@ -361,6 +397,8 @@ static dom_id_t create_dom_from_elf(const struct ElfCode *c_code,
         .code_len = c_code->code_len,
         .entry_offset = c_code->entry_offset,
         .gp_offset = c_code->gp_offset,
+        .dom_data_min = c_code->dom_data_min,
+        .stack_min = c_code->stack_min,
         .dom_id = -1
     };
     
