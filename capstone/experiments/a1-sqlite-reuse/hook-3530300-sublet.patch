# A1's instrument in the Capstone domain, on the Sublet port: the same calls as
# hook-3530300.patch at the same sites, with the contexts of the ported
# allocators.  Three lines differ in substance: the allocation the hook records
# is the alias the port hands out (sublet_take); the block a level takes
# linear (sqlite3MallocLinear, the lookaside's pool) is a memsys5 allocation
# like any other and is recorded at its address; and the lookaside free records
# the object's address (p), because pBuf is the entry beside the pool now, not
# the slot.  Applies after sublet-3530300.patch, with patch -F0 -p1, to the
# copies in the build directory.
--- a/sqlite3-capstone.c
+++ b/sqlite3-capstone.c
@@ -29737,9 +29737,16 @@
 /* The block goes out under a handle this level keeps: as an alias for the
 ** caller, or linear, to a level that carves it into objects of its own.
 */
+void a1_memsys5_realloc(void);
+void a1_memsys5_free(void*);
+void *a1_memsys5_alloc(void*, size_t);
+void a1_lookaside_escape(void);
+void a1_lookaside_free(void*);
+void *a1_lookaside_alloc(void*, size_t);
+/* A1: the levels recorded from inside, see memhook.c */
 static void *memsys5MallocUnsafe(int nByte){
   int i = memsys5CarveUnsafe(nByte);
-  return i<0 ? 0 : sublet_take(&mem5.aCap[i]);
+  return i<0 ? 0 : a1_memsys5_alloc(sublet_take(&mem5.aCap[i]), (size_t)nByte);
 }
 SQLITE_PRIVATE void *sqlite3MallocLinear(u64 nByte, sublet_cap *pBlock){
   int i;
@@ -29747,13 +29754,14 @@
   memsys5Enter();
   i = memsys5CarveUnsafe((int)nByte);
   memsys5Leave();
-  return i<0 ? 0 : (void*)sublet_take_linear(&mem5.aCap[i], pBlock);
+  return i<0 ? 0 : a1_memsys5_alloc((void*)sublet_take_linear(&mem5.aCap[i], pBlock), (size_t)nByte);
 }
 
 /*
 ** Free an outstanding memory allocation.
 */
 static void memsys5FreeUnsafe(void *pOld){
+  a1_memsys5_free(pOld);
   u32 size, iLogsize;
   int iBlock;
 
