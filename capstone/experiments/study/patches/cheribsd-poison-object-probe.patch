+		if (m != NULL) {
+			if (!vm_page_all_valid(m)) {
+				result = KERN_FAILURE;
+				break;
+			}
+			/* The source page may already be busy in this thread. */
+			vm_page_wire(m);
+			*mp = m;
+			break;
+		}
+		if (object->type != OBJT_SWAP) {
+			result = KERN_FAILURE;
+			break;
+		}
