+		goto out_map;
+	if ((entry->eflags & MAP_ENTRY_IS_SUB_MAP) != 0) {
+		result = KERN_FAILURE;
+		goto out_map;
+	}
+	object = entry->object.vm_object;
+	if (object == NULL)
+		goto out_map;
+	index = OFF_TO_IDX(entry->offset + vaddr - entry->start);
+	VM_OBJECT_WLOCK(object);
+	vm_object_pip_add(object, 1);
