+static int
+vm_cheri_revoke_poison_hold(struct vm_map *map, vm_offset_t vaddr,
+    vm_page_t *mp)
+{
+	vm_map_entry_t entry;
+	vm_object_t object, next;
+	vm_pindex_t index;
+	vm_page_t m;
