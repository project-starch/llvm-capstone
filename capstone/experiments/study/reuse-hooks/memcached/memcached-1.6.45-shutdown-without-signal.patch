+/* reuse study: what sig_handler does, called by the shutdown command instead of raise(SIGINT).
+ * On the trap route a delivered signal ends a protected program even when it has a handler. */
+void mc_request_stop(void) {
+    *(volatile int *)&stop_main_loop = EXIT_NORMALLY;
+}
