@@ -345,6 +365,12 @@
                                                REFCOUNT_OFFSET + pool->size);
     ret = (char *)entry->sublet_issued + REFCOUNT_OFFSET;
 
+#ifdef EXP_REUSE_GAP
+    reuse_gap_hook_issue_entry(&refstruct_pool_reuse_gap,
+                               (uint64_t)(uintptr_t)ret - REFCOUNT_OFFSET,
+                               REFCOUNT_OFFSET + (pool->size ? pool->size : 1),
