--- a/src/backend/port/sysv_shmem.c
+++ b/src/backend/port/sysv_shmem.c
@@ -734,6 +734,33 @@
 	/* Room for a header? */
 	Assert(size > MAXALIGN(sizeof(PGShmemHeader)));
 
+	/*
+	 * Reuse study: the single-user backend on Sublet.  A protected program
+	 * cannot map shared memory (the kernel refuses shared mappings, and a
+	 * protected task does not fork), and a single-user backend shares its
+	 * segment with nobody, so the whole segment is one private anonymous
+	 * mapping and no System V shim is created.
+	 */
+	memAddress = mmap(NULL, size, PROT_READ | PROT_WRITE,
+					  MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (memAddress == MAP_FAILED)
+		ereport(FATAL,
+				(errmsg("could not map private anonymous memory: %m"),
+				 errdetail("Failed system call was mmap(NULL, %zu, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0).",
+						   size)));
+	SetConfigOption("huge_pages_status", "off",
+					PGC_INTERNAL, PGC_S_DYNAMIC_DEFAULT);
+	hdr = (PGShmemHeader *) memAddress;
+	hdr->creatorPID = getpid();
+	hdr->magic = PGShmemMagic;
+	hdr->dsm_control = 0;
+	hdr->device = statbuf.st_dev;
+	hdr->inode = statbuf.st_ino;
+	hdr->totalsize = size;
+	hdr->freeoffset = MAXALIGN(sizeof(PGShmemHeader));
+	*shim = hdr;
+	return hdr;
+
 	if (shared_memory_type == SHMEM_TYPE_MMAP)
 	{
 		AnonymousShmem = CreateAnonymousSegment(&size);
