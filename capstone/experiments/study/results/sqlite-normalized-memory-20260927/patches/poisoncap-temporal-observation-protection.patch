+static inline uint64_t
+cheri_revoke_get_cyc(void)
+{
+#if defined(__riscv)
+	return (__builtin_readcyclecounter());
+#elif defined(__aarch64__)
+	uint64_t _val;
+	__asm __volatile("mrs %0, cntvct_el0" : "=&r" (_val));
+	return (_val);
+#else
+	return (0);
+#endif
+}
