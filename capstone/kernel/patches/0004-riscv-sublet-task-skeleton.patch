--- a/arch/riscv/Kconfig
+++ b/arch/riscv/Kconfig
@@ -694,3 +694,13 @@ source "drivers/cpuidle/Kconfig"
 endmenu # "CPU Power Management"
 
 source "arch/riscv/kvm/Kconfig"
+
+config RISCV_CAPSTONE_TASK
+	bool "Experimental Sublet protected programs"
+	depends on 64BIT && MMU && !SMP
+	default n
+	help
+	  Experimental, default-off kernel code for programs protected by the
+	  Sublet processor: lifetime tables, the root reference and the .dom
+	  loader. Requires the 63-bit Sublet format and the tag-aware memory
+	  patch. Root only.
--- /dev/null
+++ b/arch/riscv/include/asm/capstone_task.h
@@ -0,0 +1,15 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_RISCV_CAPSTONE_TASK_H
+#define _ASM_RISCV_CAPSTONE_TASK_H
+#include <linux/types.h>
+struct task_struct;
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+/* A task that runs a protected program carries TIF_CAPSTONE, and its mm carries the
+ * program's context in mm->context.capstone_namespace. The Sublet code releases a context
+ * through sublet_context_release. */
+void sublet_context_release(void *context);
+void riscv_capstone_release(struct task_struct *task);
+#else
+static inline void riscv_capstone_release(struct task_struct *task) { }
+#endif
+#endif
--- a/arch/riscv/include/asm/mmu.h
+++ b/arch/riscv/include/asm/mmu.h
@@ -16,6 +16,9 @@ typedef struct {
 	atomic_long_t id;
 #endif
 	void *vdso;
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	void *capstone_namespace;
+#endif
 #ifdef CONFIG_SMP
 	/* A local icache flush is needed before user execution can resume. */
 	cpumask_t icache_stale_mask;
--- a/arch/riscv/include/asm/mmu_context.h
+++ b/arch/riscv/include/asm/mmu_context.h
@@ -29,6 +29,9 @@ static inline int init_new_context(struct task_struct *tsk,
 {
 #ifdef CONFIG_MMU
 	atomic_long_set(&mm->context.id, 0);
+#endif
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	mm->context.capstone_namespace = NULL;
 #endif
 	return 0;
 }
--- a/arch/riscv/include/asm/thread_info.h
+++ b/arch/riscv/include/asm/thread_info.h
@@ -99,6 +99,8 @@ struct thread_info {
 #define TIF_SECCOMP		8	/* syscall secure computing */
 #define TIF_NOTIFY_SIGNAL	9	/* signal notifications exist */
 #define TIF_UPROBE		10	/* uprobe breakpoint or singlestep */
+#define TIF_CAPSTONE		12
+#define _TIF_CAPSTONE		(1 << TIF_CAPSTONE)
 #define TIF_32BIT		11	/* compat-mode 32bit process */
 
 #define _TIF_SYSCALL_TRACE	(1 << TIF_SYSCALL_TRACE)
--- a/arch/riscv/kernel/Makefile
+++ b/arch/riscv/kernel/Makefile
@@ -88,3 +88,5 @@ obj-$(CONFIG_EFI)		+= efi.o
 obj-$(CONFIG_COMPAT)		+= compat_syscall_table.o
 obj-$(CONFIG_COMPAT)		+= compat_signal.o
 obj-$(CONFIG_COMPAT)		+= compat_vdso/
+
+obj-$(CONFIG_RISCV_CAPSTONE_TASK) += capstone_task.o
--- /dev/null
+++ b/arch/riscv/kernel/capstone_task.c
@@ -0,0 +1,20 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <asm/capstone_task.h>
+
+/* Called at exec before exec_mmap and at exit before exit_mm, while task->mm is still the
+ * protected program's. Clears the task's flag and the mm's context, then ends the context. */
+void riscv_capstone_release(struct task_struct *task)
+{
+	void *context;
+
+	if (!test_tsk_thread_flag(task, TIF_CAPSTONE))
+		return;
+	WARN_ON_ONCE(task != current || !task->mm);
+	clear_tsk_thread_flag(task, TIF_CAPSTONE);
+	context = task->mm->context.capstone_namespace;
+	task->mm->context.capstone_namespace = NULL;
+	if (context)
+		sublet_context_release(context);
+}
--- a/arch/riscv/kernel/process.c
+++ b/arch/riscv/kernel/process.c
@@ -154,6 +154,9 @@ int arch_dup_task_struct(struct task_struct *dst, struct task_struct *src)
 {
 	fstate_save(src, task_pt_regs(src));
 	*dst = *src;
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	clear_tsk_thread_flag(dst, TIF_CAPSTONE);
+#endif
 	return 0;
 }
 
@@ -164,6 +167,9 @@ int copy_thread(struct task_struct *p, const struct kernel_clone_args *args)
 	unsigned long tls = args->tls;
 	struct pt_regs *childregs = task_pt_regs(p);
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	if (test_thread_flag(TIF_CAPSTONE)) return -EOPNOTSUPP;
+#endif
 	memset(&p->thread.s, 0, sizeof(p->thread.s));
 
 	/* p->thread holds context to be restored by __switch_to() */
--- a/fs/exec.c
+++ b/fs/exec.c
@@ -23,6 +23,9 @@
  * formats.
  */
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+#include <asm/capstone_task.h>
+#endif
 #include <linux/kernel_read_file.h>
 #include <linux/slab.h>
 #include <linux/file.h>
@@ -1291,6 +1294,9 @@ int begin_new_exec(struct linux_binprm * bprm)
 	 * Release all of the old mmap stuff
 	 */
 	acct_arg_size(bprm, 0);
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	riscv_capstone_release(current);
+#endif
 	retval = exec_mmap(bprm->mm);
 	if (retval)
 		goto out;
--- a/kernel/exit.c
+++ b/kernel/exit.c
@@ -5,6 +5,9 @@
  *  Copyright (C) 1991, 1992  Linus Torvalds
  */
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+#include <asm/capstone_task.h>
+#endif
 #include <linux/mm.h>
 #include <linux/slab.h>
 #include <linux/sched/autogroup.h>
@@ -804,6 +807,9 @@ void __noreturn do_exit(long code)
 	tsk->exit_code = code;
 	taskstats_exit(tsk, group_dead);
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	riscv_capstone_release(current);
+#endif
 	exit_mm();
 
 	if (group_dead)
--- a/kernel/ptrace.c
+++ b/kernel/ptrace.c
@@ -428,6 +428,14 @@ static int ptrace_attach(struct task_struct *task, long request,
 	if (mutex_lock_interruptible(&task->signal->cred_guard_mutex))
 		goto out;
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	/* Serialize publication by exec with debugger admission. */
+	if (test_tsk_thread_flag(task, TIF_CAPSTONE)) {
+		retval = -EOPNOTSUPP;
+		goto unlock_creds;
+	}
+#endif
+
 	task_lock(task);
 	retval = __ptrace_may_access(task, PTRACE_MODE_ATTACH_REALCREDS);
 	task_unlock(task);
