+++ b/arch/riscv/kernel/sublet/bind-core.c
@@ -0,0 +1,193 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The allow-list and the pure core of the binder (plan v5 step 5).
+ *
+ * A protected program may make about a hundred calls, the Linux calls of the libc's call
+ * table plus the mmap family, sockets and epoll. Every other call gets ENOSYS. For an allowed
+ * call the pointer positions come from the SYSCALL_DEFINE types (syscall-pointers.c,
+ * generated), plus the positions the types miss: the address arguments of the mmap family,
+ * which Linux declares as unsigned long, and the arguments whose meaning depends on a command
+ * (ioctl, fcntl, prctl). A command outside the allow-list is refused, so no integer position
+ * reaches a routine for user memory. Calls whose structures hold pointers (iovec, msghdr,
+ * argv, envp, the sigset pack of pselect6) carry SUBLET_EMBEDDED, and the compat-style loader
+ * serves them.
+ *
+ * In a pointer position a reference becomes a handle with the number of its slot (1 to 6 for
+ * a0 to a5). An integer with no bits above the address becomes a handle with number 0, which
+ * names no reference. An integer with bits above the address is a forged handle and the call
+ * fails with EFAULT, so a program cannot select another argument's reference by number.
+ * Integer positions pass unchanged.
+ */
+#ifdef __KERNEL__
+#include <linux/kernel.h>
+#include <linux/fcntl.h>
+#include <linux/prctl.h>
+#include <asm/ioctls.h>
+#else
+#include <stddef.h>
+#include <fcntl.h>
+#include <sys/ioctl.h>
+#include <linux/prctl.h>
+#define ARRAY_SIZE(a) (sizeof(a) / sizeof((a)[0]))
+#endif
+#include "bind.h"
+
+/* ioctl(fd, cmd, arg): the terminal and file commands the libc uses. */
+static long ioctl_command(const struct sublet_bind_args *a, unsigned int *pointers)
+{
+	switch ((unsigned int)a->arg[1]) {
+	case TCGETS:
+	case TCSETS:
+	case TCSETSW:
+	case TCSETSF:
+	case TIOCGWINSZ:
+	case TIOCSWINSZ:
+	case TIOCGPGRP:
+	case TIOCSPGRP:
+	case FIONREAD:
+	case FIONBIO:
+		*pointers |= 1u << 2;
+		return 0;
+	case FIOCLEX:
+	case FIONCLEX:
+		return 0;
+	default:
+		return -ENOTTY;
+	}
+}
+
+/* fcntl(fd, cmd, arg): the integer commands and the record locks, whose arg is a pointer. */
+static long fcntl_command(const struct sublet_bind_args *a, unsigned int *pointers)
+{
+	switch ((unsigned int)a->arg[1]) {
+	case F_DUPFD:
+	case F_DUPFD_CLOEXEC:
+	case F_GETFD:
+	case F_SETFD:
+	case F_GETFL:
+	case F_SETFL:
+	case F_GETOWN:
+	case F_SETOWN:
+		return 0;
+	case F_GETLK:
+	case F_SETLK:
+	case F_SETLKW:
+	case F_OFD_GETLK:
+	case F_OFD_SETLK:
+	case F_OFD_SETLKW:
+		*pointers |= 1u << 2;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+/* prctl(option, arg2, ...): the thread name only. */
+static long prctl_command(const struct sublet_bind_args *a, unsigned int *pointers)
+{
+	switch (a->arg[0]) {
+	case PR_SET_NAME:
+	case PR_GET_NAME:
+		*pointers |= 1u << 1;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+#define CALL(name)			{ __NR_##name, 0, 0, NULL }
+#define CALL_EXTRA(name, extra)		{ __NR_##name, extra, 0, NULL }
+#define CALL_EMBEDDED(name)		{ __NR_##name, 0, SUBLET_EMBEDDED, NULL }
+#define CALL_COMMAND(name, fn)		{ __NR_##name, 0, 0, fn }
+
+static const struct sublet_allowed allowed[] = {
+	/* Files and directories. */
+	CALL(getcwd), CALL(dup), CALL(dup3), CALL_COMMAND(fcntl, fcntl_command),
+	CALL_COMMAND(ioctl, ioctl_command), CALL(mkdirat), CALL(unlinkat), CALL(symlinkat),
+	CALL(linkat), CALL(renameat2), CALL(ftruncate), CALL(truncate), CALL(faccessat),
+	CALL(faccessat2), CALL(fchmodat), CALL(fchmod), CALL(fchown), CALL(fchownat), CALL(chdir),
+	CALL(fchdir), CALL(openat), CALL(close), CALL(pipe2), CALL(getdents64), CALL(lseek),
+	CALL(read), CALL(write), CALL(pread64), CALL(pwrite64), CALL_EMBEDDED(readv),
+	CALL_EMBEDDED(writev), CALL_EMBEDDED(preadv), CALL_EMBEDDED(pwritev), CALL(readlinkat),
+	CALL(newfstatat), CALL(fstat), CALL(statx), CALL(fsync), CALL(fdatasync), CALL(utimensat),
+	CALL(sync_file_range), CALL(flock), CALL(statfs), CALL(fstatfs), CALL(fallocate),
+	CALL(sendfile), CALL(copy_file_range), CALL(readahead), CALL(fadvise64), CALL(umask),
+	/* Time. */
+	CALL(nanosleep), CALL(clock_nanosleep), CALL(clock_gettime), CALL(clock_getres),
+	CALL(gettimeofday), CALL(times), CALL_EMBEDDED(pselect6), CALL(ppoll),
+	/* The process. */
+	CALL(getpid), CALL(getppid), CALL(getuid), CALL(geteuid), CALL(getgid), CALL(getegid),
+	CALL(gettid), CALL(getpgid), CALL(getsid), CALL(getresuid), CALL(getresgid),
+	CALL(getgroups), CALL(getrusage), CALL(getpriority), CALL(uname), CALL(sysinfo),
+	CALL(prlimit64), CALL(getrandom), CALL(sched_yield), CALL(sched_getaffinity),
+	CALL(sched_get_priority_max), CALL(sched_get_priority_min), CALL(sched_rr_get_interval),
+	CALL(rt_sigprocmask), CALL(exit), CALL(exit_group), CALL_COMMAND(prctl, prctl_command),
+	CALL_EMBEDDED(execve),
+	/* Mappings: the address arguments are pointers (mremap's new_addr too). */
+	CALL_EXTRA(mmap, 0x01), CALL_EXTRA(munmap, 0x01), CALL_EXTRA(mprotect, 0x01),
+	CALL_EXTRA(madvise, 0x01), CALL_EXTRA(mremap, 0x11), CALL_EXTRA(msync, 0x01),
+	CALL_EXTRA(mincore, 0x01),
+	/* Sockets. */
+	CALL(socket), CALL(socketpair), CALL(bind), CALL(listen), CALL(accept4), CALL(connect),
+	CALL(getsockname), CALL(getpeername), CALL(sendto), CALL(recvfrom), CALL(setsockopt),
+	CALL(getsockopt), CALL(shutdown), CALL_EMBEDDED(sendmsg), CALL_EMBEDDED(recvmsg),
+	/* Events. */
+	CALL(epoll_create1), CALL(epoll_ctl), CALL(epoll_pwait), CALL(eventfd2),
+	CALL(timerfd_create), CALL(timerfd_settime), CALL(timerfd_gettime),
+};
+
+const struct sublet_allowed *sublet_allowed_call(unsigned long nr)
+{
+	size_t i;
+
+	for (i = 0; i < ARRAY_SIZE(allowed); ++i)
+		if (allowed[i].nr == nr)
+			return &allowed[i];
+	return NULL;
+}
+
+long sublet_pointer_positions(const struct sublet_allowed *e, const struct sublet_bind_args *a)
+{
+	unsigned int pointers = sublet_syscall_pointers[e->nr] | e->extra;
+	long err;
+
+	if (e->command) {
+		err = e->command(a, &pointers);
+		if (err)
+			return err;
+	}
+	return pointers;
+}
+
+long sublet_bind_core(unsigned long nr, struct sublet_bind_args *a)
+{
+	const struct sublet_allowed *e = sublet_allowed_call(nr);
+	long pointers;
+	unsigned int i;
+
+	if (!e)
+		return -ENOSYS;
+	pointers = sublet_pointer_positions(e, a);
+	if (pointers < 0)
+		return pointers;
+
+	for (i = 0; i < SUBLET_HANDLE_ARGS; ++i) {
+		unsigned long v = a->arg[i];
+
+		if (!(pointers & (1u << i)))
+			continue;
+		if (a->tagged & (1u << i)) {
+			a->arg[i] = sublet_handle(v, SUBLET_HANDLE_FIRST_ARG + i);
+		} else if (v >> SUBLET_HANDLE_ADDR_BITS) {
+#ifdef SUBLET_MUTANT_KEEP_UPPER
+			/* Control: the program's upper bits stay and select a slot by number. */
+			continue;
+#else
+			return -EFAULT;
+#endif
+		} else {
+			a->arg[i] = sublet_handle(v, 0);
+		}
+	}
+	return 0;
+}
