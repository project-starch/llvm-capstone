+++ b/arch/riscv/kernel/sublet/bind.c
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The binder at the system call entry of a protected program (plan v5 step 5). It reads which
+ * of a0 to a5 held a reference from their saved slots, lets the core turn the pointer
+ * positions into handles, writes the handles into the integer view of pt_regs and calls the
+ * Linux implementation. The slots keep the references, so the routines for user memory find
+ * them by the handle's number, and the return to U loads the slots, not pt_regs.
+ */
+#include <linux/sched.h>
+#include <linux/slab.h>
+#include <linux/irqflags.h>
+#include <linux/build_bug.h>
+#include <asm/ptrace.h>
+#include <asm/syscall.h>
+#include <asm/sublet-trap.h>
+#include <asm/sublet-uaccess.h>
+#include "bind.h"
+
+static_assert(__NR_syscalls <= SUBLET_NR_SYSCALLS);
+static_assert(offsetof(struct pt_regs, a5) - offsetof(struct pt_regs, a0) == 5 * sizeof(long));
+
+typedef long (*sublet_syscall_fn)(unsigned long, unsigned long, unsigned long, unsigned long,
+				  unsigned long, unsigned long);
+
+/* Whether a kernel slot holds a reference: LDC into t0 and LCC selector 1, which answers 1 for
+ * a reference and 7 for an integer and never faults, in one run with interrupts off that
+ * clears t0 before it ends. */
+static bool sublet_slot_tagged(unsigned long *slot)
+{
+	unsigned long flags, kind;
+
+	local_irq_save(flags);
+	asm volatile(".insn i 0x5b, 3, t0, %[slot], 0\n\t"
+		     ".insn r 0x5b, 1, 4, %[kind], t0, x1\n\t"
+		     "li t0, 0"
+		     : [kind] "=&r"(kind) : [slot] "r"(slot) : "t0", "memory");
+	local_irq_restore(flags);
+	return kind == 1;
+}
+
+/* Clear the per-call list: plain stores clear each slot's tag. */
+static void sublet_call_refs_clear(struct sublet_call_refs *refs)
+{
+	if (!refs->slot)
+		return;
+	memset(refs->slot, 0, refs->count * sizeof(refs->slot[0]));
+	kfree(refs->slot);
+	refs->slot = NULL;
+	refs->count = 0;
+}
+
+long sublet_syscall_bound(struct pt_regs *regs, unsigned long nr)
+{
+	unsigned long *view = &regs->a0;
+	struct sublet_call_refs refs = { 0 };
+	struct sublet_bind_args a = { 0 };
+	const struct sublet_allowed *e;
+	unsigned int i;
+	long ret;
+
+	if (nr >= __NR_syscalls)
+		return -ENOSYS;
+	for (i = 0; i < SUBLET_HANDLE_ARGS; ++i) {
+		a.arg[i] = view[i];
+		if (sublet_slot_tagged(sublet_user_slot(current, 10 + i)))
+			a.tagged |= 1u << i;
+	}
+	ret = sublet_bind_core(nr, &a);
+	if (ret)
+		return ret;
+
+	e = sublet_allowed_call(nr);
+	if (e->flags & SUBLET_EMBEDDED) {
+		ret = sublet_load_embedded(nr, &a, &refs);
+		if (ret)
+			goto out;
+	}
+
+	for (i = 0; i < SUBLET_HANDLE_ARGS; ++i)
+		view[i] = a.arg[i];
+	regs->orig_a0 = a.arg[0];
+	current->thread.sublet_refs = &refs;
+	ret = ((sublet_syscall_fn)sys_call_table[nr])(a.arg[0], a.arg[1], a.arg[2], a.arg[3],
+						       a.arg[4], a.arg[5]);
+	current->thread.sublet_refs = NULL;
+out:
+	sublet_call_refs_clear(&refs);
+	return ret;
+}
--- /dev/null
+++ b/arch/riscv/kernel/sublet/bind.h
@@ -0,0 +1,75 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The binder of a protected program's system calls (plan v5 step 5). The core (bind-core.c)
+ * is pure: it takes the call number, the integer views of a0 to a5 and which of them held a
+ * reference, and turns every pointer position into a handle (asm/sublet-uaccess.h). It builds
+ * in the kernel and, for the unit test, on the host with the call numbers of a Linux tree.
+ */
+#ifndef _SUBLET_BIND_H
+#define _SUBLET_BIND_H
+
+#ifdef __KERNEL__
+#include <linux/errno.h>
+#include <linux/types.h>
+#include <asm/unistd.h>
+#include <asm/sublet-uaccess.h>
+#else
+#include <errno.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include "sublet-nr.h"	/* the riscv64 __NR_ constants, which the unit test generates */
+typedef uint8_t u8;
+typedef uint16_t u16;
+#define SUBLET_HANDLE_ADDR_BITS		38
+#define SUBLET_HANDLE_NUMBER_SHIFT	40
+#define SUBLET_HANDLE_FIRST_ARG		1
+#define SUBLET_HANDLE_ARGS		6
+#define SUBLET_HANDLE_ADDR_MASK		((1UL << SUBLET_HANDLE_ADDR_BITS) - 1)
+static inline unsigned long sublet_handle(unsigned long address, unsigned long number)
+{
+	return (address & SUBLET_HANDLE_ADDR_MASK) | (number << SUBLET_HANDLE_NUMBER_SHIFT);
+}
+#endif
+
+/* Room for every riscv64 call number of Linux 6.1 (__NR_syscalls is 451). */
+#define SUBLET_NR_SYSCALLS 512
+
+/* Bit i: argument i of the call is a pointer, by its SYSCALL_DEFINE type (generated). */
+extern const u8 sublet_syscall_pointers[SUBLET_NR_SYSCALLS];
+
+/* The arguments of one call: the integer views of a0 to a5, and bit i of tagged when the
+ * saved slot of ai holds a reference. */
+struct sublet_bind_args {
+	unsigned long arg[SUBLET_HANDLE_ARGS];
+	unsigned int tagged;
+};
+
+/* What the binder knows about an allowed call. */
+#define SUBLET_EMBEDDED	0x1	/* a structure behind a pointer holds pointers: the loader */
+struct sublet_allowed {
+	u16 nr;
+	u8 extra;	/* pointer positions the types miss (the mmap family) */
+	u8 flags;
+	/* For a command-dependent call: add the pointer positions of the command in a->arg, or
+	 * refuse it with an error. */
+	long (*command)(const struct sublet_bind_args *a, unsigned int *pointers);
+};
+
+/* The allowed call nr, or NULL. */
+const struct sublet_allowed *sublet_allowed_call(unsigned long nr);
+/* The pointer positions of an allowed call for these arguments, or a negative error. */
+long sublet_pointer_positions(const struct sublet_allowed *e, const struct sublet_bind_args *a);
+/* Bind call nr: 0 and handles in a->arg, or -ENOSYS (not allowed), -EFAULT (an integer with
+ * bits above the address in a pointer position) or the command's error. */
+long sublet_bind_core(unsigned long nr, struct sublet_bind_args *a);
+
+#ifdef __KERNEL__
+/* The compat-style loader (loader.c) for a call with SUBLET_EMBEDDED: read the structures in
+ * the user layout through the outer reference, load each embedded reference into refs and
+ * point the call's arguments at kernel copies whose pointers are handles numbered from
+ * SUBLET_HANDLE_FIRST_LIST. 0 or a negative error. */
+long sublet_load_embedded(unsigned long nr, struct sublet_bind_args *a,
+			  struct sublet_call_refs *refs);
+#endif
+
+#endif
--- /dev/null
+++ b/arch/riscv/kernel/sublet/loader.c
@@ -0,0 +1,18 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The compat-style loader of plan v5 step 5 for the calls whose structures hold pointers.
+ * Not built yet: only pselect6 without a sigset pack passes, every other call that needs the
+ * loader gets ENOSYS.
+ */
+#include <linux/errno.h>
+#include <asm/unistd.h>
+#include <asm/sublet-uaccess.h>
+#include "bind.h"
+
+long sublet_load_embedded(unsigned long nr, struct sublet_bind_args *a,
+			  struct sublet_call_refs *refs)
+{
+	if (nr == __NR_pselect6 && !a->arg[5])
+		return 0;
+	return -ENOSYS;
+}
