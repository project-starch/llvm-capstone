+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The trap route's routine for user memory of the test hook. Only code in the section
+ * .sublet.uaccess.text (between sublet_uaccess_start and sublet_uaccess_end, which the linker
+ * script defines) may hold a program reference in t6 across an instruction that can trap, and
+ * each routine clears t6 before it returns. Plan v5 step 5 adds the copy routines there.
+ */
+#include <linux/linkage.h>
+#include <asm/asm.h>
+#include <asm/csr.h>
+#include <asm/asm-extable.h>
+
+#define SUBLET_LDC(rd, base) .insn i 0x5b, 3, rd, base, 0
+#define SUBLET_INC(rd, src, offset) .insn r 0x5b, 1, 0x0c, rd, src, offset
+#define SUBLET_LCC_ID(rd, src) .insn r 0x5b, 1, 4, rd, src, x8
+
+	.section .sublet.uaccess.text, "ax"
+	.balign 64
+#ifdef CONFIG_RISCV_CAPSTONE_TRAP_TEST
+/*
+ * long sublet_test_hold_asm(unsigned long *slot, unsigned long *jiffies, unsigned long ticks)
+ *
+ * The test hook of plan v5 step 3. It loads the program reference in the kernel slot into t6,
+ * moves it one page on and loads through it from a page the program never touched, so the
+ * load page-faults (and the test fault hook sleeps). It then waits for ticks timer ticks
+ * with interrupts on, moves t6 back, reads its lifetime id with LCC selector 8, which faults
+ * with 24 unless t6 is still tagged, and returns the doubleword the program stored at the
+ * reference's address. -EFAULT if an instruction faults, with the cause
+ * recorded by do_trap_sublet. The QEMU rule that checks an S access through a reference
+ * (plan v5 step 1, rule 1) does not exist yet, so the loads are plain accesses at t6's address.
+ */
+ENTRY(sublet_test_hold_asm)
+	li t0, SR_SUM
+	csrs CSR_STATUS, t0
+	SUBLET_LDC(t6, a0)
+	li t1, 4096
+1:	SUBLET_INC(t6, t6, t1)
+2:	ld t2, 0(t6)
+	REG_L t3, 0(a1)
+	add t3, t3, a2
+3:	REG_L t4, 0(a1)
+	blt t4, t3, 3b
+	li t1, -4096
+4:	SUBLET_INC(t6, t6, t1)
+7:	SUBLET_LCC_ID(t5, t6)
+5:	ld a0, 0(t6)
+	li t6, 0
+	li t0, SR_SUM
+	csrc CSR_STATUS, t0
+	ret
+6:	li t6, 0
+	li t0, SR_SUM
+	csrc CSR_STATUS, t0
+	li a0, -14
+	ret
+	_asm_extable 1b, 6b
+	_asm_extable 2b, 6b
+	_asm_extable 4b, 6b
+	_asm_extable 5b, 6b
+	_asm_extable 7b, 6b
+ENDPROC(sublet_test_hold_asm)
+#endif
