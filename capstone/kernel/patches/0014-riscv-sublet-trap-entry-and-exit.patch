  * protected program's. Clears the task's flag and the mm's context, then ends the context. */
@@ -15,6 +43,10 @@ void riscv_capstone_release(struct task_struct *task)
 	clear_tsk_thread_flag(task, TIF_CAPSTONE);
 	context = task->mm->context.capstone_namespace;
 	task->mm->context.capstone_namespace = NULL;
+	/* No table stays selected once its context goes. */
+	if (task->mm->context.capstone_root && csr_read(0x5c1) == task->mm->context.capstone_root)
+		csr_write(0x5c1, 0);
