+#ifdef CONFIG_RISCV_CAPSTONE_TRAP
+/* Under cred_guard_mutex, as ptrace_attach, so no tracer admitted earlier keeps a protected
+ * task. The mm's context and root first, then the flag, then srevroot: from here on every
+ * return to U loads the task's slots and the guard expects this root. */
+int riscv_capstone_bind(void *context, unsigned long root)
+{
+	struct mm_struct *mm = current->mm;
+	int error = 0;
+
+	if (!context || !root || !mm)
+		return -EINVAL;
+	mutex_lock(&current->signal->cred_guard_mutex);
+	if (current->ptrace || (read_thread_flags() & _TIF_SYSCALL_WORK) ||
+	    mm->context.capstone_namespace || test_thread_flag(TIF_CAPSTONE)) {
+		error = -EOPNOTSUPP;
+	} else {
+		mm->context.capstone_namespace = context;
+		mm->context.capstone_root = root;
+		set_thread_flag(TIF_CAPSTONE);
+		csr_write(0x5c1, root);
+	}
+	mutex_unlock(&current->signal->cred_guard_mutex);
+	return error;
+}
+#endif
 
