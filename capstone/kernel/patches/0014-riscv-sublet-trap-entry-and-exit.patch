+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Test switches of the trap route. The tests of plan v5 step 3 build control kernels by
+ * adding one define here; a normal build defines none:
+ *   SUBLET_MUTANT_SKIP_STC_S7   the entry from U saves s7 without its tag
+ *   SUBLET_MUTANT_SKIP_CLEAR    the entry from U leaves the program's tags in kernel registers
+ *   SUBLET_MUTANT_T6_INTEGER    a trap from S saves t6 as an integer
+ *   SUBLET_MUTANT_LEAK_ROOT     switch_mm leaves srevroot set for an ordinary mm
+ *   SUBLET_MUTANT_NO_GUARD      the return to U skips the guard */
+#ifndef _ASM_RISCV_SUBLET_TEST_H
+#define _ASM_RISCV_SUBLET_TEST_H
+
+/* The test loader's and the test hook's call numbers, above every Linux call. */
+#define SUBLET_NR_TEST_ENTER	0x5b100
+#define SUBLET_NR_TEST_HOLD	0x5b101
+
+#endif
