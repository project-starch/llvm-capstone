--- /dev/null
+++ b/arch/riscv/kernel/sublet_trap.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The C side of the trap route (plan v5 step 3): the helpers that change a user register,
+ * the dispatch stub for a protected program's system calls, the handler of the Sublet causes
+ * 24 to 30, the guard's kill path and the debug sentinel. With CONFIG_RISCV_CAPSTONE_TRAP_TEST
+ * also the test loader and the test hook.
+ */
+#include <linux/delay.h>
+#include <linux/irqflags.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/syscalls.h>
+#include <asm/capstone_task.h>
+#include <asm/csr.h>
+#include <asm/extable.h>
+#include <asm/ptrace.h>
+#include <asm/sublet.h>
+#include <asm/sublet-test.h>
+#include <asm/sublet-trap.h>
+
+#define SUBLET_ADDR_MASK ((1UL << 38) - 1)
+
+static bool sublet_in_uaccess(unsigned long pc)
+{
+	return pc >= (unsigned long)sublet_uaccess_start && pc < (unsigned long)sublet_uaccess_end;
+}
+
+/* Set user register xn to an integer: pt_regs and both doublewords of its slot, with plain
+ * stores, which clear the slot's tag. */
+void sublet_set_user_int(struct pt_regs *regs, unsigned int n, unsigned long value)
+{
+	unsigned long *slot = sublet_user_slot(current, n);
+
+	if (WARN_ON_ONCE(n == 0 || n > 31))
+		return;
+	((unsigned long *)regs)[n] = value;
+	WRITE_ONCE(slot[1], 0UL);
+	WRITE_ONCE(slot[0], value);
+}
+
+/* Set user register xn to the reference in a kernel slot: LDC and STC in one run with
+ * interrupts off, and the reference's address into pt_regs. */
+void sublet_set_user_ref(struct pt_regs *regs, unsigned int n, unsigned long *kslot)
+{
+	unsigned long *slot = sublet_user_slot(current, n), flags;
+
+	if (WARN_ON_ONCE(n == 0 || n > 31))
+		return;
+	local_irq_save(flags);
+	asm volatile(".balign 64\n"
+		     ".insn i 0x5b, 3, t0, %[from], 0\n"
+		     ".insn s 0x5b, 4, t0, 0(%[to])\n"
+		     "li t0, 0\n"
+		     : : [from] "r"(kslot), [to] "r"(slot) : "t0", "memory");
+	local_irq_restore(flags);
+	((unsigned long *)regs)[n] = READ_ONCE(slot[0]) & SUBLET_ADDR_MASK;
+}
+
+#ifdef CONFIG_RISCV_CAPSTONE_TRAP_TEST
+/* The cause of the last Sublet fault from S, and whether the test hook's fault sleeps. */
+static unsigned long sublet_test_last_cause;
+static bool sublet_test_sleeping;
+
+long sublet_test_hold_asm(unsigned long *slot, unsigned long *ticks_at, unsigned long ticks);
+
+/* The page fault of the test hook sleeps 20 ms, so another task runs while t6 holds the
+ * program's reference in the trap frame's slot. */
+void sublet_test_fault(struct pt_regs *regs)
+{
+	if (READ_ONCE(sublet_test_sleeping) && sublet_in_uaccess(regs->epc))
+		msleep(20);
+}
+
+/* The program's reference in a0 held in t6 across a sleeping page fault and two timer
+ * ticks. The doubleword at the reference, or minus the cause of a reference fault. */
+static long sublet_test_hold(struct pt_regs *regs)
+{
+	long ret;
+
+	WRITE_ONCE(sublet_test_last_cause, 0);
+	WRITE_ONCE(sublet_test_sleeping, true);
+	ret = sublet_test_hold_asm(sublet_user_slot(current, 10),
+				   (unsigned long *)&jiffies, 2);
+	WRITE_ONCE(sublet_test_sleeping, false);
+	if (ret == -EFAULT && READ_ONCE(sublet_test_last_cause))
+		ret = -(long)READ_ONCE(sublet_test_last_cause);
+	return ret;
+}
+
+/*
+ * The test loader: it turns the calling process into a protected program. It creates the
+ * context with sublet_context_create, which mints R, derives one block over [a0, a0 + a1) and
+ * one over [a2, a2 + a3), both anonymous private mappings, puts their references into the
+ * caller's a0 and a1, and binds the context to the mm, which sets TIF_CAPSTONE and srevroot.
+ * Every other register of the caller keeps the integer its entry saved. Root only.
+ */
+asmlinkage long sublet_test_enter(struct pt_regs *regs)
+{
+	struct sublet_grant a = {.address = regs->a0, .bytes = regs->a1, .cursor = regs->a0, .reg = 10};
+	struct sublet_grant b = {.address = regs->a2, .bytes = regs->a3, .cursor = regs->a2, .reg = 11};
+	struct sublet_context *c;
+	unsigned long *slot_a, *slot_b;
+	long rc;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!sublet_ready() || test_thread_flag(TIF_CAPSTONE) || current->mm->context.capstone_namespace)
+		return -EBUSY;
+	rc = sublet_context_create(&c);
+	if (rc)
+		return rc;
+	mutex_lock(&sublet_lock);
+	rc = sublet_grant_slot(c, &a, &slot_a);
+	if (!rc)
+		rc = sublet_grant_slot(c, &b, &slot_b);
+	mutex_unlock(&sublet_lock);
+	if (!rc)
+		rc = riscv_capstone_bind(c, c->table_pa);
+	if (rc) {
+		sublet_context_destroy(c);
+		return rc;
+	}
+	sublet_set_user_ref(regs, 10, slot_a);
+	sublet_set_user_ref(regs, 11, slot_b);
+	pr_info("sublet: test loader: pid %d protected, table 0x%llx\n", task_pid_nr(current),
+		(unsigned long long)c->table_pa);
+	return 0;
+}
+#endif
+
+/*
+ * The dispatch stub. Until plan v5 step 5 binds the system calls, a protected program may
+ * call only the calls that take no pointer: the Linux number in a7, the result in a0 through
+ * the integer helper. Every other call returns ENOSYS.
+ */
+asmlinkage void sublet_syscall(struct pt_regs *regs)
+{
+	long ret;
+
+	switch (regs->a7) {
+	case __NR_getpid:
+		ret = task_tgid_vnr(current);
+		break;
+	case __NR_gettid:
+		ret = task_pid_vnr(current);
+		break;
+	case __NR_sched_yield:
+		yield();
+		ret = 0;
+		break;
+	case __NR_exit:
+		do_exit((regs->a0 & 0xff) << 8);
+	case __NR_exit_group:
+		do_group_exit((regs->a0 & 0xff) << 8);
+#ifdef CONFIG_RISCV_CAPSTONE_TRAP_TEST
+	case SUBLET_NR_TEST_HOLD:
+		ret = sublet_test_hold(regs);
+		break;
+#endif
+	default:
+		ret = -ENOSYS;
+	}
+	sublet_set_user_int(regs, 10, ret);
+}
+
+/*
+ * Causes 24 to 30. From U: cause 30 asks for a table slot, which ensure_nodes grows; every
+ * other cause kills the program with SIGSEGV and one fault line. From S: the exception table
+ * of the routine for user memory turns the fault into EFAULT; without an entry the kernel
+ * stops.
+ */
+asmlinkage __visible void do_trap_sublet(struct pt_regs *regs)
+{
+	unsigned long cause = regs->cause;
+
+	if (user_mode(regs)) {
