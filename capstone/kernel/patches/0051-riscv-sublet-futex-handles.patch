+static long thread_futex_command(const struct sublet_bind_args *a, unsigned int *pointers)
+{
+	switch (a->arg[1] & 127) {
+	case 0: case 9: /* WAIT, WAIT_BITSET: timeout reference */
+		*pointers = 0x09;
+		return 0;
+	case 1: case 10: /* WAKE, WAKE_BITSET: no memory read */
+		*pointers = 0x01;
+		return 0;
+	case 3: case 4: case 5: /* REQUEUE, CMP_REQUEUE, WAKE_OP: val2 is integer */
+		*pointers = 0x11;
+		return 0;
+	default:
+		return -ENOSYS;
+	}
+}
