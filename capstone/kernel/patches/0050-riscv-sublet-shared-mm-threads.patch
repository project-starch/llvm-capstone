+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/asm.h>
+#include <asm/csr.h>
+#include <asm/asm-extable.h>
+
+	.macro enter fail
+	li t0, SR_SUM
+	csrs CSR_STATUS, t0
+	.insn i 0x5b, 3, t6, a0, 0
+	.insn r 0x5b, 1, 4, t0, t6, x1
+	li t1, 1
+	bne t0, t1, \fail
+	ld t0, 0(a0)
+	slli t0, t0, 26
+	srli t0, t0, 26
+	sub t0, a1, t0
+99:	.insn r 0x5b, 1, 0x0c, t6, t6, t0
+	_asm_extable 99b, \fail
+	.endm
+
+	.macro leave
+	li t6, 0
+	li t0, SR_SUM
+	csrc CSR_STATUS, t0
+	ret
+	.endm
+
+	.section .sublet.uaccess.text, "ax"
+	.balign 4
+ENTRY(__sublet_word)
+	enter .Lword_fault
+	bltz a2, .Lread
+	beqz a2, .Lset
+	li t0, 1
+	beq a2, t0, .Ladd
+	li t0, 2
+	beq a2, t0, .Lor
+	li t0, 3
+	beq a2, t0, .Landn
+	li t0, 4
+	beq a2, t0, .Lxor
+6:	sw a3, 0(t6)
+	li t1, 0
+	j .Lword_done
+.Lread:
+1:	lw t1, 0(t6)
+	j .Lword_done
+.Lset:
+2:	amoswap.w.aqrl t1, a3, (t6)
+	j .Lword_done
+.Ladd:
+3:	amoadd.w.aqrl t1, a3, (t6)
+	j .Lword_done
+.Lor:
+4:	amoor.w.aqrl t1, a3, (t6)
+	j .Lword_done
+.Landn:
+	not a3, a3
+5:	amoand.w.aqrl t1, a3, (t6)
+	j .Lword_done
+.Lxor:
+7:	amoxor.w.aqrl t1, a3, (t6)
+.Lword_done:
+	li t6, 0
+	sw t1, 0(a4)
+	li a0, 0
+	leave
+.Lword_fault:
+	li a0, -14
+	leave
+	_asm_extable 1b, .Lword_fault
+	_asm_extable 2b, .Lword_fault
+	_asm_extable 3b, .Lword_fault
+	_asm_extable 4b, .Lword_fault
+	_asm_extable 5b, .Lword_fault
+	_asm_extable 6b, .Lword_fault
+	_asm_extable 7b, .Lword_fault
+ENDPROC(__sublet_word)
+
+ENTRY(__sublet_cmpxchg)
+	enter .Lcmp_fault
+	sext.w a2, a2
+1:	lr.w.aqrl t1, (t6)
+	bne t1, a2, 3f
+2:	sc.w.aqrl t2, a3, (t6)
+	bnez t2, 1b
+3:	li t6, 0
+	sw t1, 0(a4)
+	li a0, 0
+	leave
+.Lcmp_fault:
+	li a0, -14
+	leave
+	_asm_extable 1b, .Lcmp_fault
+	_asm_extable 2b, .Lcmp_fault
+ENDPROC(__sublet_cmpxchg)
