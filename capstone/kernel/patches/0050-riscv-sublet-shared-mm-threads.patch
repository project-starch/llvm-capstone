+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/errno.h>
+#include <linux/futex.h>
+#include <linux/irqflags.h>
+#include <linux/sched/task.h>
+#include <linux/sched/task_stack.h>
+#include <linux/uaccess.h>
+#include <asm/sublet-trap.h>
+#include <asm/sublet-uaccess.h>
+#include <asm/sublet-thread.h>
+
+/* op -1 reads one word, 0 to 4 are FUTEX_OP_*, 5 stores without reading. */
+int __sublet_word(unsigned long *, unsigned long, int, u32, u32 *);
+int __sublet_cmpxchg(unsigned long *, unsigned long, u32, u32, u32 *);
+
+static void copy_ref(unsigned long *to, unsigned long *from)
+{
+	unsigned long flags;
+	local_irq_save(flags);
+	asm volatile(".insn i 0x5b, 3, t0, %0, 0\n"
+		     ".insn s 0x5b, 4, t0, 0(%1)\n"
+		     "li t0, 0" : : "r"(from), "r"(to) : "t0", "memory");
+	local_irq_restore(flags);
+}
+
+int sublet_set_tid(struct task_struct *task, unsigned long handle)
+{
+	unsigned long *slot;
+
+	if (!handle) {
+		memset(task->thread.sublet_clear_tid, 0, 16);
+		task->clear_child_tid = NULL;
+		return 0;
+	}
+	slot = sublet_handle_slot(handle);
+	if (!slot || (sublet_handle_address(handle) & 3))
+		return -EFAULT;
+	copy_ref(task->thread.sublet_clear_tid, slot);
+	task->clear_child_tid = (int __user *)sublet_handle_address(handle);
+	return 0;
+}
+
+int sublet_copy_thread(struct task_struct *child, const struct kernel_clone_args *args)
+{
+	const unsigned long required = CLONE_VM | CLONE_SIGHAND | CLONE_THREAD | CLONE_SETTLS;
+	const unsigned long allowed = required | CLONE_FS | CLONE_FILES | CLONE_SYSVSEM |
+		CLONE_PARENT_SETTID | CLONE_CHILD_CLEARTID | CLONE_DETACHED;
+	struct pt_regs *regs = task_pt_regs(child);
+	unsigned long *stack, *tls;
+	unsigned char byte;
+	unsigned int i;
+	int error;
+
+	if ((args->flags & required) != required || (args->flags & ~allowed) ||
+	    args->exit_signal || args->fn || child->mm != current->mm)
+		return -EOPNOTSUPP;
+	stack = sublet_handle_slot(args->stack);
+	tls = sublet_handle_slot(args->tls);
+	if (!stack || !tls || (sublet_handle_address(args->stack) & 15))
+		return -EFAULT;
+	/* Check the actual references before publishing the child. The child still
+	 * checks every later stack/TLS access, including revocation after clone. */
+	if (sublet_get_user(&byte, (void __user *)args->stack, 1) ||
+	    sublet_get_user(&byte, (void __user *)args->tls, 1))
+		return -EFAULT;
+	for (i = 1; i < 32; ++i)
+		copy_ref(sublet_user_slot(child, i), sublet_user_slot(current, i));
+	copy_ref(sublet_user_slot(child, 2), stack);
+	copy_ref(sublet_user_slot(child, 4), tls);
+	regs->sp = sublet_handle_address(args->stack);
+	regs->tp = sublet_handle_address(args->tls);
+	memset(sublet_user_slot(child, 10), 0, 16);
+	regs->a0 = 0;
+	if (args->flags & CLONE_CHILD_CLEARTID) {
+		error = sublet_set_tid(child, (unsigned long)args->child_tid);
+		if (error)
+			return error;
+	}
+	set_tsk_thread_flag(child, TIF_CAPSTONE);
+	return 0;
+}
+
+void sublet_exit_tid(struct task_struct *task)
+{
+	u32 ignored;
+	unsigned long address = (unsigned long)task->clear_child_tid;
+
+	if (address) {
+		/* mm_release still has the mm, its table and the task flag. Drop a
+		 * failing store as Linux does, and wake by address without a read. */
+		__sublet_word(task->thread.sublet_clear_tid, address, 5, 0, &ignored);
+		do_futex((u32 __user *)address, FUTEX_WAKE | FUTEX_PRIVATE_FLAG,
+			 1, NULL, NULL, 0, 0);
+	}
+	task->clear_child_tid = NULL;
+	memset(task->thread.sublet_clear_tid, 0, 16);
+}
+
+int sublet_futex_read(u32 *value, u32 __user *word)
+{
+	unsigned long handle = (unsigned long)word, *slot = sublet_handle_slot(handle);
+	*value = 0;
+	if (!slot || (handle & 3))
+		return -EFAULT;
+	return __sublet_word(slot, sublet_handle_address(handle), -1, 0, value);
+}
+
+int sublet_futex_op(int op, int arg, int *old, u32 __user *word)
+{
+	unsigned long handle = (unsigned long)word, *slot = sublet_handle_slot(handle);
+	if (op < FUTEX_OP_SET || op > FUTEX_OP_XOR)
+		return -ENOSYS;
+	if (!slot || (handle & 3))
+		return -EFAULT;
+	return __sublet_word(slot, sublet_handle_address(handle), op, arg, (u32 *)old);
+}
+
+int sublet_futex_cmpxchg(u32 *value, u32 __user *word, u32 old, u32 new)
+{
+	unsigned long handle = (unsigned long)word, *slot = sublet_handle_slot(handle);
+	*value = 0;
+	if (!slot || (handle & 3))
+		return -EFAULT;
+	return __sublet_cmpxchg(slot, sublet_handle_address(handle), old, new, value);
+}
