+static const struct path *dom_device_path(struct dom_delegate *d, const char *name)
+{
+    for (unsigned i = 0; i < DOM_DEVICES; ++i)
+        if (d->devices[i].dentry && !strcmp(name, dom_device_names[i]))
+            return &d->devices[i];
+    return NULL;
