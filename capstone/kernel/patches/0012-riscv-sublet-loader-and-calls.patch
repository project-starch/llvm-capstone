+# SPDX-License-Identifier: GPL-2.0-only
+# The headers shared with the libc (capstone/, vm-abi.h) and the wire code (delegate-wire.c,
+# spawn-wire.c, native-syscall-table.c) are copied here by capstone/kernel/apply.sh.
