+/* The loader admits .dom images only with sublet.dom_binfmt=1 on a Sublet platform. */
+static int __init sublet_loader_init(void)
+{
+	if (dom_binfmt && sublet_ready())
+		insert_binfmt(&capstone_dom);
+	pr_info("sublet: .dom loader %s\n", dom_binfmt && sublet_ready() ? "registered" : "off");
+	return 0;
+}
+device_initcall(sublet_loader_init);
