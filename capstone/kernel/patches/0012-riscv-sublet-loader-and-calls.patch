+        file = native_directory_metadata_file(c, &e, call->buffer[1].data);
+        if (IS_ERR(file)) rc = PTR_ERR(file);
+        else {
+            rc = vfs_getattr(&file->f_path, &stat, STATX_BASIC_STATS, AT_STATX_SYNC_AS_STAT);
