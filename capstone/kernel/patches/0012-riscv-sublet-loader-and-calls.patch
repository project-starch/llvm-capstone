+// SPDX-License-Identifier: GPL-2.0-only
+/* The kernel's Sublet code, task side: the .dom loader, the resource capsule of a protected
+ * program, and the issue side of the system calls the kernel implements for it.
+ *
+ * The protected entry does not exist yet (plan v5 steps 3 and 4), so the loader builds a
+ * program and refuses, and nothing calls the system calls until plan v5 step 5 binds them. */
+#include <linux/fs.h>
+#include <linux/init.h>
+#include <linux/mm.h>
+#include <linux/moduleparam.h>
+#include <linux/mutex.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/capstone_native_helpers.h>
+#include <asm/capstone_task.h>
+#include <asm/sublet.h>
