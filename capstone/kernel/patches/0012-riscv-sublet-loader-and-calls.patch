+        e.args[0] = (u64)(s64)AT_FDCWD;
+        mutex_unlock(&sublet_lock);
+        file = dom_path_file_name(c, &e, call->buffer[0].data);
+        if (IS_ERR(file)) rc = PTR_ERR(file);
+        else {
+            rc = dom_disk_inode(file_inode(file)) ? vfs_truncate(&file->f_path, (s64)a[1]) : -EACCES;
