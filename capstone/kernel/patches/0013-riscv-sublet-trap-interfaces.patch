--- /dev/null
+++ b/arch/riscv/include/asm/sublet-trap.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * The interfaces of the trap route (plan v5 step 3) that the other parts of the kernel's
+ * Sublet code use:
+ *
+ *   - The user registers of a task, with their tags: one 16-byte slot per register, indexed
+ *     by register number (1 to 31, slot 0 unused), in thread_info within a 12-bit offset of
+ *     tp. Every entry from U writes all of them with STC, and every return to a protected
+ *     program loads them with LDC. pt_regs holds the integer view, which C code reads. Change
+ *     a user register only through sublet_set_user_int or sublet_set_user_ref.
+ *   - t6 with its tag across a trap from S: the 16-byte slot regs->capstone_t6 of the S trap
+ *     frame. The handler itself runs with t6 as an integer.
+ *   - The routines for user memory: code in the section .sublet.uaccess.text, between
+ *     sublet_uaccess_start and sublet_uaccess_end, may hold a program reference in t6 across an
+ *     instruction that can trap. Each such routine clears t6 before it returns.
+ *   - A task's Sublet context: mm->context.capstone_namespace while the task has TIF_CAPSTONE,
+ *     and mm->context.capstone_root, the table's physical root that srevroot holds while the
+ *     mm runs (0 for an ordinary mm).
+ */
+#ifndef _ASM_RISCV_SUBLET_TRAP_H
+#define _ASM_RISCV_SUBLET_TRAP_H
+#include <linux/mm_types.h>
+#include <linux/sched.h>
+#include <asm/ptrace.h>
+#include <asm/thread_info.h>
+
+#define SUBLET_CSR_SREVROOT 0x5c1
+
+struct sublet_context;
+
+/* The slot of user register xn of a task. */
+static inline unsigned long *sublet_user_slot(struct task_struct *task, unsigned int n)
+{
+	return task->thread_info.capstone_slots[n];
+}
+
+/* The t6 slot of an S trap frame. */
+static inline unsigned long *sublet_frame_t6(struct pt_regs *regs)
+{
+	return regs->capstone_t6;
+}
+
+/* The Sublet context of a task that runs a protected program, or NULL. */
+static inline struct sublet_context *sublet_task_context(struct task_struct *task)
+{
+	if (!test_tsk_thread_flag(task, TIF_CAPSTONE) || !task->mm)
+		return NULL;
+	return task->mm->context.capstone_namespace;
+}
+
+/* Set user register xn of the current task to an integer, or to the reference in a kernel
+ * slot. Each writes the register's slot and its integer view in pt_regs. */
+void sublet_set_user_int(struct pt_regs *regs, unsigned int n, unsigned long value);
+void sublet_set_user_ref(struct pt_regs *regs, unsigned int n, unsigned long *kslot);
+
+extern char sublet_uaccess_start[], sublet_uaccess_end[];
+
+#endif
--- a/arch/riscv/include/asm/sublet.h
+++ b/arch/riscv/include/asm/sublet.h
@@ -55,6 +55,10 @@ int sublet_context_create(struct sublet_context **out);
 void sublet_context_destroy(struct sublet_context *c);
 /* Make a block: check its range and mappings, derive P from R. Caller holds sublet_lock. */
 int sublet_grant(struct sublet_context *c, const struct sublet_grant *g);
+/* The same, and *slot receives the kernel slot that holds P, which the context owns. */
+int sublet_grant_slot(struct sublet_context *c, const struct sublet_grant *g, unsigned long **slot);
+/* Answer cause 30 of the context's program: at least one slot, or NOGROW. */
+int sublet_grow(struct sublet_context *c);
 
 /* The issue side of the system calls on kernel buffers, for the binder of plan v5 step 5,
  * which copies each argument through the program's reference. Caller holds sublet_lock. */
@@ -64,4 +68,8 @@ long sublet_wait(struct sublet_context *c, s64 number, u64 options, int *status,
 		 struct rusage *usage);
 void sublet_spawn_cancel(struct sublet_context *c, long number);
 
+#ifdef CONFIG_RISCV_CAPSTONE_TRAP_TEST
+void sublet_test_fault(struct pt_regs *regs);
+#endif
+
 #endif
