+/* The caller rechecks the handle's slot in the same non-preemptible window.
+ * A fault takes the fixup before any page or block state changes. */
+int sublet_ref_revoke(struct sublet_context *c, const unsigned long *slot)
+{
+	unsigned long old = select_root(c), faulted;
+	asm volatile("li %[faulted], 0\n" CV_RUN
+		CV_LDC("t0", "%[slot]")
+		"1:\n" CV_KILL("t0")
+		"li t0, 0\n j 3f\n"
+		"2:\n li t0, 0\n li %[faulted], 1\n 3:\n"
+		_ASM_EXTABLE(1b, 2b)
+		: [faulted] "=&r"(faulted) : [slot] "r"(slot)
+		: "t0", "memory");
+	restore_root(old);
+	return faulted ? -EFAULT : 0;
+}
