+#define SUBLET_BLOCKS_INTERNAL_H
+#include <asm/sublet.h>
+#include "sublet-block-state.h"
+struct arena {
+	struct rb_node node;
+	u64 id;
+	unsigned long address, bytes, rx_bytes;
+	/* Only the initial grant and a failed mmap rollback use this slot.
+	 * Requests always use the handle's slot, including after CRENEW. */
+	unsigned long *slot;
+	unsigned int reg;
+	struct sublet_block_state state;
+};
+struct arena *sublet_block_find(struct sublet_context *, unsigned long);
+struct arena *sublet_block_overlap(struct sublet_context *, unsigned long, unsigned long);
+int sublet_block_new(struct sublet_context *, const struct sublet_grant *, struct arena **);
+void sublet_block_drop(struct sublet_context *, struct arena *);
+void sublet_block_rollback(struct sublet_context *, struct arena *);
+/* Caller disables preemption and interrupts for inspection through revocation. */
+void sublet_ref_inspect(struct sublet_context *, const unsigned long *, struct sublet_ref_info *);
+int sublet_ref_revoke(struct sublet_context *, const unsigned long *);
