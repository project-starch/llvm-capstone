+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Shared by the kernel and the small host test. The includer provides bool,
+ * EINVAL, EFAULT, EPERM and PAGE_SHIFT. No stored reference is authority. */
+#ifndef SUBLET_BLOCK_STATE_H
+#define SUBLET_BLOCK_STATE_H
+struct sublet_ref_info {
+	unsigned long id, base, end, depth;
+	bool tagged, live, descendants;
+};
+struct sublet_block_state {
+	unsigned long address, bytes, mapped;
+	unsigned char *present;
+	bool kernel_owned, ended, quarantined;
+};
+static inline bool request_call(const struct sublet_block_state *b,
+		unsigned long address, unsigned long bytes)
+{
+	unsigned long mask = (1UL << PAGE_SHIFT) - 1;
+	return bytes && !((address | bytes) & mask) && address >= b->address &&
+		bytes <= b->bytes && address - b->address <= b->bytes - bytes;
+}
+static inline int request_operand(const struct sublet_block_state *b,
+		const struct sublet_ref_info *r, unsigned long address,
+		unsigned long bytes)
+{
+	if (b->kernel_owned)
+		return -EPERM;
+	if (b->ended || b->quarantined || !request_call(b, address, bytes))
+		return -EINVAL;
+	if (!r->tagged || !r->live)
+		return -EFAULT;
+	if (r->depth != 1)
+		return -EINVAL;
+	if (r->base > address || r->end < address + bytes)
+		return -EFAULT;
+	return 0;
+}
+static inline unsigned long pages_present(const struct sublet_block_state *b,
+		unsigned long address, unsigned long bytes)
+{
+	unsigned long first = (address - b->address) >> PAGE_SHIFT;
+	unsigned long count = bytes >> PAGE_SHIFT, n = 0, i;
+	for (i = first; i < first + count; ++i)
+		n += !!b->present[i];
+	return n;
+}
+static inline bool pages_last(const struct sublet_block_state *b,
+		unsigned long address, unsigned long bytes)
+{
+	unsigned long n = pages_present(b, address, bytes);
+	return n && n == b->mapped;
+}
+/* Called only after a successful CREVOKE for the last pages. */
+static inline void pages_commit(struct sublet_block_state *b,
+		unsigned long address, unsigned long bytes, bool refill)
+{
+	unsigned long first = (address - b->address) >> PAGE_SHIFT;
+	unsigned long count = bytes >> PAGE_SHIFT, i;
+	for (i = first; i < first + count; ++i) {
+		if (b->present[i] == refill)
+			continue;
+		b->present[i] = refill;
+		if (refill)
+			++b->mapped;
+		else
+			--b->mapped;
+	}
+	b->ended = !b->mapped;
+}
+static inline int refill_rule(const struct sublet_ref_info *r)
+{
+	return r->live && !r->descendants ? 0 : -EINVAL;
+}
+#endif
