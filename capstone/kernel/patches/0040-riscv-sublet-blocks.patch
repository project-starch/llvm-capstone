+/* The loader holds sublet_lock before the mm is published to the task. */
+int sublet_grant(struct sublet_context *c, const struct sublet_grant *g)
+{
+	struct arena *a;
+	int error;
+
+	mmap_read_lock(c->mm);
+	error = grant_mapped(c, g);
+	if (!error)
+		error = sublet_block_new(c, g, &a);
+	if (!error)
