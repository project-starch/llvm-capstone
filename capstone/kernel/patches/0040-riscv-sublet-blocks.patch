+#ifndef _LINUX_SUBLET_MAPPINGS_H
+#define _LINUX_SUBLET_MAPPINGS_H
+#include <linux/mm.h>
+#include <linux/errno.h>
+struct sublet_move;
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+/* Step 5 resolves a handle to its tagged, aligned kernel slot. It must not
+ * sleep. The slot remains owned by this syscall until it returns. */
+int sublet_handle_ref(unsigned long handle, const unsigned long **ref);
+/* Step 3/5 supplies a non-failing tagged copy into the saved a0 return slot.
+ * address is the cursor to return. The source slot may be cleared on return. */
+void sublet_mapping_return(const unsigned long *ref, unsigned long address) __weak;
+static inline bool sublet_mappings(struct mm_struct *mm)
+{
+	return mm->context.capstone_namespace != NULL;
+}
+unsigned long sublet_mapping_address(struct mm_struct *, unsigned long);
+unsigned long sublet_mmap(struct file *, unsigned long, unsigned long,
+		unsigned long, unsigned long, unsigned long, unsigned long *, struct list_head *);
+int sublet_munmap(struct mm_struct *, unsigned long, unsigned long, struct list_head *);
+int sublet_unmap_commit(struct mm_struct *, unsigned long, unsigned long);
+int sublet_mapping_check(struct mm_struct *, unsigned long, unsigned long,
+		unsigned long, bool);
+unsigned long sublet_mremap(struct mm_struct *, unsigned long, unsigned long,
+		unsigned long, unsigned long, unsigned long, bool *,
