+struct arena *sublet_block_find(struct sublet_context *c, unsigned long address)
+{
+	struct arena *a = arena_below(c, address + 1);
+	return a && address - a->address < a->bytes ? a : NULL;
+}
+struct arena *sublet_block_overlap(struct sublet_context *c, unsigned long address,
+		unsigned long bytes)
+{
+	struct arena *a = arena_below(c, address + bytes);
+	return a && a->address + a->bytes > address ? a : NULL;
+}
+void sublet_block_drop(struct sublet_context *c, struct arena *a)
+{
+	rb_erase(&a->node, &c->arenas);
+	c->registered_bytes -= a->bytes;
+	ref_slot_put(c, a->slot);
+	kvfree(a->state.present);
+	kfree(a);
+}
+void sublet_block_rollback(struct sublet_context *c, struct arena *a)
+{
+	unsigned long flags, old;
+	preempt_disable(); local_irq_save(flags);
+	old = select_root(c);
+	grant_unwind(a->slot);
+	restore_root(old);
+	local_irq_restore(flags); preempt_enable();
+	sublet_block_drop(c, a);
+}
+
+void sublet_ref_inspect(struct sublet_context *c, const unsigned long *slot,
+		struct sublet_ref_info *r)
+{
+	unsigned long type, old, *record, *next;
+
+	memset(r, 0, sizeof(*r));
+	old = select_root(c);
+	ref_read((unsigned long *)slot, &type, &r->id);
+	r->tagged = type == CV_TYPE_NONLIN;
+	if (!r->tagged)
+		goto out;
+	asm volatile(CV_RUN
+		CV_LDC("t0", "%[slot]")
+		CV_LCC("%[base]", "t0", "x3")
+		CV_LCC("%[end]", "t0", "x4")
+		"li t0, 0\n"
+		: [base] "=&r"(r->base), [end] "=&r"(r->end)
+		: [slot] "r"(slot) : "t0", "memory");
+	record = sublet_table_record(c->table, CV_ID_SLOT(r->id));
+	r->live = record && CV_REC_LIVE(record, r->id);
+	if (!r->live)
+		goto out;
+	r->depth = CV_REC_DEPTH(record);
+	if (CV_REC_NEXT(record)) {
+		next = sublet_table_record(c->table, CV_REC_NEXT(record));
+		r->descendants = !next || CV_REC_DEPTH(next) > r->depth;
+	}
+out:
+	restore_root(old);
+}
