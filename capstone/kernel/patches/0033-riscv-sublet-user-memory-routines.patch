+	addi	t5, t5, 1
+	beq	t5, a3, .Lscpy_out
+	li	t2, 1
+2:	INC(t6, t6, t2)
+	j	1b
+.Lscpy_out:
+	sublet_leave t5
+.Lscpy_fault:
+	li	t5, -14
+	sublet_leave t5
+	_asm_extable	1b, .Lscpy_fault
+	_asm_extable	2b, .Lscpy_fault
+ENDPROC(__sublet_strncpy)
+
+/*
+ * long __sublet_strnlen(unsigned long *slot, unsigned long src, long count)
