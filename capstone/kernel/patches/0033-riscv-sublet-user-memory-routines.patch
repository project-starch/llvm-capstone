+ */
+ENTRY(__sublet_clear)
+	mv	t5, a2
+	beqz	t5, .Lclr_out
+	sublet_enter a0, a1, .Lclr_out
+.Lclr_head:
+	andi	t1, a1, 7
+	beqz	t1, .Lclr_words
