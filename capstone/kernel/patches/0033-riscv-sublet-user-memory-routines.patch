+	beqz	t5, .Lin_out
+	sublet_enter a1, a2, .Lin_out
+	xor	t1, a0, a2
+	andi	t1, t1, 7
+	bnez	t1, .Lin_bytes
+.Lin_head:
+	andi	t1, a2, 7
+	beqz	t1, .Lin_words
+1:	lb	t1, 0(t6)
+	sb	t1, 0(a0)
+	addi	a0, a0, 1
+	addi	a2, a2, 1
+	addi	t5, t5, -1
+	beqz	t5, .Lin_out
+	li	t2, 1
+2:	INC(t6, t6, t2)
+	j	.Lin_head
+.Lin_words:
+	li	t2, 8
+	bltu	t5, t2, .Lin_bytes
+3:	ld	t1, 0(t6)
+	sd	t1, 0(a0)
+	addi	a0, a0, 8
+	addi	t5, t5, -8
+	beqz	t5, .Lin_out
+4:	INC(t6, t6, t2)
+	j	.Lin_words
+.Lin_bytes:
+5:	lb	t1, 0(t6)
+	sb	t1, 0(a0)
+	addi	a0, a0, 1
+	addi	t5, t5, -1
+	beqz	t5, .Lin_out
+	li	t2, 1
