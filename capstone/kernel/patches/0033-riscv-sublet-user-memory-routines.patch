+	addi	a1, a1, 1
+	addi	t5, t5, -1
+	beqz	t5, .Lclr_out
+	li	t2, 1
+2:	INC(t6, t6, t2)
+	j	.Lclr_head
+.Lclr_words:
+	li	t2, 8
+	bltu	t5, t2, .Lclr_bytes
+3:	sd	zero, 0(t6)
+	addi	t5, t5, -8
+	beqz	t5, .Lclr_out
+4:	INC(t6, t6, t2)
+	j	.Lclr_words
+.Lclr_bytes:
+5:	sb	zero, 0(t6)
+	addi	t5, t5, -1
+	beqz	t5, .Lclr_out
+	li	t2, 1
+6:	INC(t6, t6, t2)
+	j	.Lclr_bytes
+.Lclr_out:
+	sublet_leave t5
+	_asm_extable	1b, .Lclr_out
+	_asm_extable	2b, .Lclr_out
+	_asm_extable	3b, .Lclr_out
+	_asm_extable	4b, .Lclr_out
+	_asm_extable	5b, .Lclr_out
+	_asm_extable	6b, .Lclr_out
+ENDPROC(__sublet_clear)
+
+/*
+ * long __sublet_strncpy(char *dst, unsigned long *slot, unsigned long src, long count)
