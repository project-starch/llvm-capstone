+++ b/arch/riscv/kernel/sublet/uaccess.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The C side of the routines for user memory of a protected program (plan v5 step 5): find the
+ * kernel slot of the reference a handle names, and call the routine in uaccess-asm.S that
+ * accesses through it. A handle that names no reference fails like a fault at its first byte.
+ */
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <asm/sublet-trap.h>
+#include <asm/sublet-uaccess.h>
+
+unsigned long __sublet_copy_in(void *to, unsigned long *slot, unsigned long from, unsigned long n);
+unsigned long __sublet_copy_out(unsigned long *slot, unsigned long to, const void *from,
+				unsigned long n);
+unsigned long __sublet_clear(unsigned long *slot, unsigned long to, unsigned long n);
+long __sublet_strncpy(char *dst, unsigned long *slot, unsigned long src, long count);
+long __sublet_strnlen(unsigned long *slot, unsigned long src, long count);
+
+unsigned long *sublet_handle_slot(unsigned long handle)
+{
+	unsigned long n = sublet_handle_number(handle);
+	struct sublet_call_refs *refs = current->thread.sublet_refs;
+
+	if (sublet_handle_guarded(handle))
+		return NULL;
+	if (n >= SUBLET_HANDLE_FIRST_ARG && n < SUBLET_HANDLE_FIRST_ARG + SUBLET_HANDLE_ARGS)
+		return sublet_user_slot(current, 10 + n - SUBLET_HANDLE_FIRST_ARG);
+	if (refs && n >= SUBLET_HANDLE_FIRST_LIST && n - SUBLET_HANDLE_FIRST_LIST < refs->count)
+		return refs->slot[n - SUBLET_HANDLE_FIRST_LIST];
+	return NULL;
+}
+
+unsigned long sublet_copy_from_user(void *to, const void __user *from, unsigned long n)
+{
+	unsigned long handle = (__force unsigned long)from, *slot = sublet_handle_slot(handle);
+
+	if (!slot)
+		return n;
+	return __sublet_copy_in(to, slot, sublet_handle_address(handle), n);
+}
+
+unsigned long sublet_copy_to_user(void __user *to, const void *from, unsigned long n)
+{
+	unsigned long handle = (__force unsigned long)to, *slot = sublet_handle_slot(handle);
+
+	if (!slot)
+		return n;
+	return __sublet_copy_out(slot, sublet_handle_address(handle), from, n);
+}
+
+unsigned long sublet_clear_user(void __user *to, unsigned long n)
+{
+	unsigned long handle = (__force unsigned long)to, *slot = sublet_handle_slot(handle);
+
+	if (!slot)
+		return n;
+	return __sublet_clear(slot, sublet_handle_address(handle), n);
+}
+
+long sublet_strncpy_from_user(char *dst, const char __user *src, long count)
+{
+	unsigned long handle = (__force unsigned long)src, *slot = sublet_handle_slot(handle);
+
+	if (count <= 0)
+		return 0;
+	if (!slot)
+		return -EFAULT;
+	return __sublet_strncpy(dst, slot, sublet_handle_address(handle), count);
+}
+
+long sublet_strnlen_user(const char __user *src, long count)
+{
+	unsigned long handle = (__force unsigned long)src, *slot = sublet_handle_slot(handle);
+
+	if (count <= 0 || !slot)
+		return 0;
+	return __sublet_strnlen(slot, sublet_handle_address(handle), count);
+}
+
+/* get_user and put_user go through the copy routines, which split a misaligned value into
+ * bytes. A value of 8 aligned bytes moves in one access. */
+int sublet_get_user(void *value, const void __user *from, unsigned long size)
+{
+	unsigned long left = sublet_copy_from_user(value, from, size);
+
+	if (left) {
+		memset(value, 0, size);
+		return -EFAULT;
+	}
+	return 0;
+}
+
+int sublet_put_user(void __user *to, const void *value, unsigned long size)
+{
+	return sublet_copy_to_user(to, value, size) ? -EFAULT : 0;
+}
+
+/* untagged_addr for RISC-V: the address of a protected task's handle, every other value
+ * unchanged. A handle with a guard bit set stays as it is, so the range checks refuse it. */
+unsigned long sublet_untagged_addr(unsigned long addr)
+{
+	if (!test_thread_flag(TIF_CAPSTONE) || sublet_handle_guarded(addr) || (long)addr < 0)
+		return addr;
+	return sublet_handle_address(addr);
+}
+EXPORT_SYMBOL(sublet_untagged_addr);
+EXPORT_SYMBOL(sublet_copy_from_user);
+EXPORT_SYMBOL(sublet_copy_to_user);
+EXPORT_SYMBOL(sublet_clear_user);
+EXPORT_SYMBOL(sublet_get_user);
+EXPORT_SYMBOL(sublet_put_user);
