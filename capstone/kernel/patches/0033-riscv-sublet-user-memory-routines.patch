+/*
+ * The routines for user memory of a protected program (plan v5 step 5). Each takes the kernel
+ * slot of the reference a handle names and the handle's address, loads the reference into t6
+ * with LDC, moves its address there with CINCOFFSET and accesses through t6, so the processor
+ * checks bounds and lifetime of every access (plan v5 step 1, rule 1). A page fault is an
+ * ordinary fault: the trap frame keeps t6 with its tag, Linux resolves the fault, and the
+ * access runs again. A fault that nothing resolves (no mapping, causes 24 to 30) reaches the
+ * exception table, and the routine returns what it has done so far.
+ *
+ * No routine issues a misaligned access through a reference: doublewords only where the user
+ * address is 8-byte aligned and the kernel address agrees modulo 8, bytes everywhere else. The
+ * string routines read byte by byte, so a string that ends in its object's last byte passes.
+ * No routine moves t6 past the last byte it accesses. Each clears t6 before it returns.
+ *
+ * The code lies in .sublet.uaccess.text, the only code that may hold a reference in t6 across
+ * a trap (assumption A3 of asm/sublet-uaccess.h).
+ */
+#include <linux/linkage.h>
+#include <asm/asm.h>
+#include <asm/csr.h>
+#include <asm/asm-extable.h>
+
+#define LDC(rd, base)		.insn i 0x5b, 3, rd, base, 0
+#define LCC(rd, src, sel)	.insn r 0x5b, 1, 4, rd, src, sel
+#define INC(rd, src, off)	.insn r 0x5b, 1, 0x0c, rd, src, off
+
+/*
+ * Turn on SUM (the page-fault handler expects it for a user address) and load the reference
+ * in the kernel slot \slot into t6 with its address moved to \addr. Branch to \fail if the
+ * slot holds no reference or the move faults. Clobbers t0 and t1.
+ */
+	.macro	sublet_enter slot, addr, fail
+	li	t0, SR_SUM
+	csrs	CSR_STATUS, t0
+	LDC(t6, \slot)
+	LCC(t0, t6, x1)
+	li	t1, 1
+	bne	t0, t1, \fail
+	ld	t0, 0(\slot)
+	slli	t0, t0, 64 - 38
+	srli	t0, t0, 64 - 38
+	sub	t0, \addr, t0
+99:	INC(t6, t6, t0)
+	_asm_extable	99b, \fail
+	.endm
+
+/* Clear t6 and SUM, return \result. */
+	.macro	sublet_leave result
+	li	t6, 0
+	li	t0, SR_SUM
+	csrc	CSR_STATUS, t0
+	mv	a0, \result
+	ret
+	.endm
+
+	.section .sublet.uaccess.text, "ax"
+	.balign	4
+
