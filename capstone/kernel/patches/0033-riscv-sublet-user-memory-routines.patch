+1:	sb	t1, 0(t6)
+	addi	a1, a1, 1
+	addi	a2, a2, 1
+	addi	t5, t5, -1
+	beqz	t5, .Lout_out
+	li	t2, 1
+2:	INC(t6, t6, t2)
+	j	.Lout_head
+.Lout_words:
+	li	t2, 8
+	bltu	t5, t2, .Lout_bytes
+	ld	t1, 0(a2)
+3:	sd	t1, 0(t6)
+	addi	a2, a2, 8
+	addi	t5, t5, -8
+	beqz	t5, .Lout_out
+4:	INC(t6, t6, t2)
+	j	.Lout_words
+.Lout_bytes:
+	lb	t1, 0(a2)
+5:	sb	t1, 0(t6)
+	addi	a2, a2, 1
+	addi	t5, t5, -1
+	beqz	t5, .Lout_out
+	li	t2, 1
+6:	INC(t6, t6, t2)
+	j	.Lout_bytes
+.Lout_out:
+	sublet_leave t5
+	_asm_extable	1b, .Lout_out
+	_asm_extable	2b, .Lout_out
+	_asm_extable	3b, .Lout_out
+	_asm_extable	4b, .Lout_out
+	_asm_extable	5b, .Lout_out
+	_asm_extable	6b, .Lout_out
+ENDPROC(__sublet_copy_out)
+
+/*
+ * unsigned long __sublet_clear(unsigned long *slot, unsigned long to, unsigned long n)
