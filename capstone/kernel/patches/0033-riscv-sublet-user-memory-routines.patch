+ */
+ENTRY(__sublet_strnlen)
+	li	t5, 0
+	sublet_enter a0, a1, .Lslen_fault
+1:	lbu	t1, 0(t6)
+	addi	t5, t5, 1
+	beqz	t1, .Lslen_out
+	beq	t5, a2, .Lslen_long
+	li	t2, 1
+2:	INC(t6, t6, t2)
+	j	1b
+.Lslen_long:
+	addi	t5, t5, 1
+.Lslen_out:
+	sublet_leave t5
+.Lslen_fault:
+	sublet_leave zero
+	_asm_extable	1b, .Lslen_fault
+	_asm_extable	2b, .Lslen_fault
+ENDPROC(__sublet_strnlen)
