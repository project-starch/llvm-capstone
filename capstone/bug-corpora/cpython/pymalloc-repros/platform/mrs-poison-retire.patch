+/*
+ * LOCAL FIX (not upstream): retire poison left on a block that is being
+ * handed out again.
+ *
+ * POISON_ON_FREE marks a freed block so that stale capabilities into it trap.
+ * Nothing in the shipped configuration ever takes that mark off again:
+ * CLEAR_ON_ALLOC only memsets (poison is out-of-band metadata, so zeroing the
+ * payload does not touch it -- and the write would itself trap), the
+ * cclearpoison path lives behind CLEAR_ON_ALLOC_NWZ, and the version-bump
+ * retirement lives behind CLEAR_ON_ALLOC_PVER; neither is defined here.  Only
+ * CLEAR_ON_ALLOC_PVER_INIT is, and it resets the version to 0 -- the same
+ * value the stale poison carries, so the two match and the trap fires on the
+ * NEW owner's first write.
+ *
+ * Measured symptom before this fix: any program that frees a block and then
+ * allocates the same size class again dies with a poison exception, e.g.
+ * feature_present() -> asprintf() -> malloc(128).
+ *
+ * This must run before anything writes into the region.
+ */
+static inline void
+mrs_retire_poison(void *region)
+{
+	if (region == NULL)
+		return;
+	for (size_t i = 0; i < cheri_getlen(region); i += 16)
+		cheri_poison_clear((char *)region + i);
+}
+
 static inline void
 clear_region(void *mem, size_t len)
 {
