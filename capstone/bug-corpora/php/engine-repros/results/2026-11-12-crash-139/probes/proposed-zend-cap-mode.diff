+/* Is this address in a mapping of the heap? The page index heap_access walks, read without
+ * trapping: heap_access itself traps on a page no mapping owns, which gives a pointer PHP never
+ * got from this heap (a static string, CRASH-139) an illegal-instruction fault inside the layer
+ * instead of the refusal by name. */
+static int cap_in_heap(unsigned long a)
+{
+    struct heap_mid *mid;
+    struct heap_leaf *leaf;
+    if (a >> 39) { return 0; }
+    mid = __malloc_page_root[a >> 30];
+    if (!mid) { return 0; }
+    leaf = mid->leaf[(a >> 21) & 511];
+    if (!leaf) { return 0; }
+    return leaf->owner[(a >> 12) & 511] != (void *)0;
+}
