+/* Native capability frontend: callers hold the authorized file and supply a
+ * checked kernel-buffer flock. Reuse Linux's security, lock ownership, wait,
+ * deadlock and close-race behavior, without a user-pointer syscall trampoline. */
+extern int capstone_native_dupfd(unsigned long, struct file *, unsigned, unsigned);
+long capstone_native_fcntl(unsigned int fd, struct file *file, unsigned int cmd,
+                          unsigned long arg, struct flock *lock, unsigned limit)
+{
+	long error;
+	if (file->f_mode & FMODE_PATH && !check_fcntl_cmd(cmd))
+		return -EBADF;
+	switch (cmd) {
+	case F_GETLK: case F_SETLK: case F_SETLKW:
+		if (!lock)
+			return -EFAULT;
+		break;
+	case F_GETFD: case F_SETFD: case F_GETFL: case F_SETFL:
+	case F_DUPFD: case F_DUPFD_CLOEXEC:
+		if (lock)
+			return -EINVAL;
+		break;
+	default:
+		return -EINVAL;
+	}
+	error = security_file_fcntl(file, cmd, arg);
+	if (error)
+		return error;
+	switch (cmd) {
+	case F_GETLK:
+		return fcntl_getlk(file, cmd, lock);
+	case F_SETLK: case F_SETLKW:
+		return fcntl_setlk(fd, file, cmd, lock);
+	case F_DUPFD: case F_DUPFD_CLOEXEC:
+		return capstone_native_dupfd(arg, file,
+			cmd == F_DUPFD_CLOEXEC ? O_CLOEXEC : 0, limit);
+	default:
+		return do_fcntl(fd, cmd, arg, file);
+	}
+}
+EXPORT_SYMBOL_GPL(capstone_native_fcntl);
