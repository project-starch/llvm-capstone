+/* Kernel-buffer frontend for fd-bound metadata changes; normal VFS and LSM
+ * checks remain in the same helpers used by Linux syscalls. */
+int capstone_native_fmetadata(struct file *file, unsigned int op,
+                             unsigned int first, unsigned int second)
+{
+	if (file->f_mode & FMODE_PATH)
+		return -EBADF;
+	switch (op) {
+	case 0: return vfs_fchmod(file, first);
+	case 1: return vfs_fchown(file, first, second);
+	default: return -EINVAL;
+	}
+}
+EXPORT_SYMBOL_GPL(capstone_native_fmetadata);
