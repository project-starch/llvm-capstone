+/* Reserve within the capability frontend's fd namespace before installing.
+ * Allocating an out-of-range duplicate and closing it on failure would release
+ * all of this process's POSIX locks on the inode. */
+int capstone_native_dupfd(unsigned long from, struct file *file,
+                         unsigned flags, unsigned limit)
+{
+	unsigned long nofile = rlimit(RLIMIT_NOFILE);
+	int fd;
+	if (from >= nofile)
+		return -EINVAL;
+	nofile = min_t(unsigned long, nofile, limit);
+	if (from >= nofile)
+		return -EMFILE;
+	fd = alloc_fd(from, nofile, flags);
+	if (fd >= 0) {
+		get_file(file);
+		fd_install(fd, file);
+	}
+	return fd;
+}
