# Inputs of run-evaluation.sh on p13 for the trap route, prebuilt on 14 Nov 2026 under ~/asr-work/eval.
# Source this file, then run
#   bash "$E/tree/capstone/runtime/virtual/run-evaluation.sh" "$E/run-1"
# The kernel is the frozen Image of NL native-kernel-new-qemu 2443072aa6b; QEMU is qemu-1b.
E=$HOME/asr-work/eval
export SUBLET_KERNEL=${SUBLET_KERNEL:-$E/kernel/Image-2443072aa6b}
export SUBLET_FIRMWARE=$HOME/asr-work/del-fw/out/f-keep/fw_jump.elf
export SUBLET_QEMU=$HOME/asr-work/q1b/bin/qemu-1b
export PROTECTED_FAULT=$E/prebuilt/gate/gate-fault.dom   # gate-fault.c: a read after free, must die by SIGSEGV
export PROTECTED_OK=$E/prebuilt/gate/gate-ok.dom         # gate-ok.c: must exit 0 in the same boot
export SDK=$E/prebuilt/sdk
export LLVM_BIN=$HOME/lanes/gatefix/llvm/bin
export JULIET_PREBUILT=$E/prebuilt/juliet
export JULIET_SRC=$E/juliet-src/C
export JULIET_HELPER=$E/prebuilt/juliet-timeout
export CORPUS_ARGS_DIR=$E/prebuilt/corpora
export EVAL_PLAN=$E/tree/capstone/runtime/virtual/tests/trap-platform/eval-plan-p13.txt
export PREBUILT=$E/prebuilt
export CAPSTONE_QEMU_LOCK=$HOME/asr-work/qemu-gate.lock
export CAPSTONE_LLVM_BUILD_DIR=$HOME/lanes/gatefix/llvm
export CAPSTONE_LLVM_BIN=$LLVM_BIN
export CAPSTONE_TMP_ROOT=$E/tmp
