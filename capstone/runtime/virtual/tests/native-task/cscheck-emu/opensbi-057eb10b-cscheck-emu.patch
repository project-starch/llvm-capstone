diff --git a/include/sbi/sbi_capstone_cscheck.h b/include/sbi/sbi_capstone_cscheck.h
new file mode 100644
index 0000000..0f2046c
--- /dev/null
+++ b/include/sbi/sbi_capstone_cscheck.h
@@ -0,0 +1,28 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * MEASUREMENT PROTOTYPE: firmware emulation of Capstone CSCHECKR/CSCHECKW (see sbi_capstone_cscheck.c).
+ */
+#ifndef __SBI_CAPSTONE_CSCHECK_H__
+#define __SBI_CAPSTONE_CSCHECK_H__
+
+#include <sbi/sbi_types.h>
+
+struct sbi_trap_regs;
+
+/* Experimental SBI extension: fid 0 = probe (returns CSC_SBI_MAGIC), fid 1 = counter a0, fid 2 = reset. */
+#define CSC_SBI_EXT		0x08435343UL
+#define CSC_SBI_MAGIC		0x43534301UL
+
+enum {
+	CSC_ENTRIES = 0,	/* every emulated CSCHECKR/W */
+	CSC_OK,			/* rd = 0 */
+	CSC_CAUSE24, CSC_CAUSE25, CSC_CAUSE26, CSC_CAUSE27, CSC_CAUSE28, CSC_CAUSE29,
+	CSC_UNSUPPORTED_TABLE,	/* a liveness query met a table this emulation does not read */
+	CSC_COUNTERS
+};
+
+/* SBI_ENOTSUPP when insn is not CSCHECKR/W; otherwise 0 with rd written and mepc stepped. */
+int sbi_capstone_cscheck_insn(ulong insn, struct sbi_trap_regs *regs);
+
+#endif
