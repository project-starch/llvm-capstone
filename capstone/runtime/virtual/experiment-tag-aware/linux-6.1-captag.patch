diff --git a/arch/riscv/mm/captag.c b/arch/riscv/mm/captag.c
new file mode 100644
index 000000000000..7e46db6feb9d
--- /dev/null
+++ b/arch/riscv/mm/captag.c
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * EXPERIMENT (experiment/tag-aware-mm, never lands): Capstone capability tags follow pages.
+ *
+ * In Capstone's virtual profile a capability's tag is a property of the PHYSICAL granule.
+ * Linux moves and frees pages without knowing that: migration and compaction (folio_copy),
+ * COW (wp_page_copy, fork's copy_present_page), THP collapse and hugetlb copies copy bytes
+ * with scalar stores, so the destination comes out untagged; and a freed page keeps its
+ * tags for its next owner. The pinned capstone_vm module avoids both by pinning every page
+ * a domain can reach and sweeping it at retire. This file is the other design: tags move
+ * with every page copy and are cleared at every page free, so domain pages need no pin.
+ *
+ *  - copy_highpage / copy_user_highpage: copy the bytes, then give the destination exactly
+ *    the source's tags (every user-page copy in mm/ goes through one of the two).
+ *  - arch_free_page: clear the tags of the freed pages (free_pages_prepare, every order).
+ *  - arch_prepare_to_swap: refuse swap-out of a page that holds a tag; the page stays in
+ *    the swap cache, mapped again by the next fault, its tags intact (no swap-side store).
+ *
+ * The moves use the TEST-ONLY tag-move CSRs of capstone-qemu experiment/tag-copy
+ * (0x5c8-0x5cb, present only under x-capstone-test-csrs). They stand in for the raw tag
+ * moves (consensus D1) the ISA does not have: an instruction count prices each at one CSR
+ * access, which is NOT what a real primitive costs. "captag=off" on the command line turns
+ * every hook into the stock behaviour (for a kernel booted on a QEMU without the CSRs).
+ */
+#include <linux/highmem.h>
+#include <linux/init.h>
+#include <linux/jump_label.h>
+#include <linux/mm.h>
+#include <linux/moduleparam.h>
+#include <linux/string.h>
+#include <asm/csr.h>
+
+#define CSR_STAGSRC	0x5c8
+#define CSR_STAGCOPY	0x5c9
+#define CSR_STAGCLR	0x5ca
+#define CSR_STAGANY	0x5cb
+
+static DEFINE_STATIC_KEY_TRUE(captag_on);
+
+/* Counts, for pricing the stand-in: /sys/module/captag/parameters/. One hart. */
+static unsigned long copies, frees, freed_pages, swap_refused;
+module_param(copies, ulong, 0444);
+module_param(frees, ulong, 0444);
+module_param(freed_pages, ulong, 0444);
+module_param(swap_refused, ulong, 0444);
+
+static int __init captag_setup(char *s)
+{
+	if (s && !strcmp(s, "off"))
+		static_branch_disable(&captag_on);
+	return 1;
+}
+__setup("captag=", captag_setup);
+
+static void captag_copy(struct page *to, struct page *from)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	csr_write(CSR_STAGSRC, page_to_phys(from));
+	csr_write(CSR_STAGCOPY, page_to_phys(to));
+	local_irq_restore(flags);
+	++copies;
+}
+
+static bool captag_page_tagged(struct page *page)
+{
+	unsigned long flags, any;
+
+	local_irq_save(flags);
+	csr_write(CSR_STAGSRC, page_to_phys(page));
+	any = csr_read(CSR_STAGANY);
+	local_irq_restore(flags);
+	return any != 0;
+}
+
+void copy_highpage(struct page *to, struct page *from)
+{
+	copy_page(page_address(to), page_address(from));
+	if (static_branch_likely(&captag_on))
+		captag_copy(to, from);
+}
+EXPORT_SYMBOL(copy_highpage);
+
+void copy_user_highpage(struct page *to, struct page *from,
+			unsigned long vaddr, struct vm_area_struct *vma)
+{
+	copy_highpage(to, from);
+}
+EXPORT_SYMBOL(copy_user_highpage);
+
+void arch_free_page(struct page *page, int order)
+{
+	if (!static_branch_likely(&captag_on))
+		return;
+	csr_write(CSR_STAGCLR, page_to_phys(page) | (unsigned long)order);
+	++frees;
+	freed_pages += 1UL << order;
+}
+
+int arch_prepare_to_swap(struct page *page)
+{
+	struct folio *folio = page_folio(page);
+	long i, n = folio_nr_pages(folio);
+
+	if (!static_branch_likely(&captag_on))
+		return 0;
+	for (i = 0; i < n; i++)
+		if (captag_page_tagged(folio_page(folio, i))) {
+			++swap_refused;
+			return -EBUSY;
+		}
+	return 0;
+}
