 EXPORT_SYMBOL(copy_user_highpage);
 
+/* One scalar store per granule clears the tag by rule 1. Contents of a
+ * freed page are dead, so zeroing only the first word is sufficient. */
+static void captag_clear_scalar(struct page *page)
+{
+	void *p = page_address(page);
+	unsigned long n = PAGE_SIZE / 16;
+
+	asm volatile("1: sd zero, 0(%0)\n\taddi %0, %0, 16\n\t"
+		     "addi %1, %1, -1\n\tbnez %1, 1b"
+		     : "+r" (p), "+r" (n) : : "memory");
+}
+
 void arch_free_page(struct page *page, int order)
 {
+	unsigned long i, n = 1UL << order;
+
 	if (!static_branch_likely(&captag_on))
 		return;
-	csr_write(CSR_STAGCLR, page_to_phys(page) | (unsigned long)order);
+	if (free_mode == 2) {
+		csr_write(CSR_STAGCLR, page_to_phys(page) | (unsigned long)order);
+	} else {
+		for (i = 0; i < n; ++i)
+			if (free_mode == 1 || captag_page_tagged(page + i)) {
+				captag_clear_scalar(page + i);
+				++cleared_pages;
+			}
+	}
 	++frees;
-	freed_pages += 1UL << order;
+	freed_pages += n;
 }
 
