 	unsigned long flags, any;
 
@@ -65,6 +65,23 @@ static bool captag_page_tagged(struct page *page)
 	return any != 0;
 }
 
+/* Hardware owns this flag: every capability publication, including a raw
+ * copy, sets it without a software trap. PG_arch_1 is already dcache state.
+ * Scalar writers leave it set; only a verified-empty acknowledgement resets
+ * it. The physical key covers all aliases and carries no access authority. */
+static unsigned long captag_summary(struct page *page, bool ack)
+{
+	unsigned long result, phys = page_to_phys(page);
+
+	if (ack)
+		asm volatile(".insn i 0x0b, 6, %0, %1, 1"
+			     : "=r" (result) : "r" (phys) : "memory");
+	else
+		asm volatile(".insn i 0x0b, 6, %0, %1, 0"
+			     : "=r" (result) : "r" (phys) : "memory");
+	return result;
+}
+
 static void captag_copy_raw(void *to, const void *from)
 {
 	unsigned long flags, count = PAGE_SIZE / 16;
@@ -114,12 +131,15 @@ EXPORT_SYMBOL(copy_user_highpage);
  * freed page are dead, so zeroing only the first word is sufficient. */
 static void captag_clear_scalar(struct page *page)
 {
-	void *p = page_address(page);
-	unsigned long n = PAGE_SIZE / 16;
+	unsigned long *p = page_address(page);
+	unsigned long j;
 
-	asm volatile("1: sd zero, 0(%0)\n\taddi %0, %0, 16\n\t"
-		     "addi %1, %1, -1\n\tbnez %1, 1b"
-		     : "+r" (p), "+r" (n) : : "memory");
+	for (j = 0; j < PAGE_SIZE / sizeof(*p); j += 16) {
+		WRITE_ONCE(p[j], 0UL);      WRITE_ONCE(p[j + 2], 0UL);
+		WRITE_ONCE(p[j + 4], 0UL);  WRITE_ONCE(p[j + 6], 0UL);
+		WRITE_ONCE(p[j + 8], 0UL);  WRITE_ONCE(p[j + 10], 0UL);
+		WRITE_ONCE(p[j + 12], 0UL); WRITE_ONCE(p[j + 14], 0UL);
+	}
 }
 
