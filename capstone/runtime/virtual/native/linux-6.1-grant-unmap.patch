+/* Experimental whole-VMA grant transaction, RISC-V only. Namespace exclusion
+ * is held by the caller throughout; mmap write exclusion covers retirement,
+ * PTE removal and page release. No fallible user copy follows commit. */
+int capstone_grant_unmap(struct mm_struct *mm, unsigned long start,
+                        unsigned long len, int (*commit)(void *),
+                        void *opaque, unsigned int inject);
+int capstone_grant_unmap(struct mm_struct *mm, unsigned long start,
+                        unsigned long len, int (*commit)(void *),
+                        void *opaque, unsigned int inject)
+{
+	struct vm_area_struct *vma;
+	int error;
+	MA_STATE(mas, &mm->mm_mt, start, start);
+
+	if (!IS_ENABLED(CONFIG_RISCV) || mm != current->mm || !commit)
+		return -EOPNOTSUPP;
+	if (!len || ((start | len) & ~PAGE_MASK) ||
+	    start > TASK_SIZE || len > TASK_SIZE - start || inject > 5)
+		return -EINVAL;
+	if (inject == 1 || mmap_write_lock_killable(mm))
+		return -EINTR;
+	vma = mas_find(&mas, start + len - 1);
+	error = -EOPNOTSUPP;
+	if (!vma || vma->vm_start != start || vma->vm_end != start + len ||
+	    !vma_is_anonymous(vma) || vma->vm_ops ||
+	    (vma->vm_flags & (VM_SHARED | VM_SPECIAL | VM_HUGETLB |
+	     VM_LOCKED | VM_LOCKONFAULT | VM_GROWSDOWN | VM_GROWSUP |
+	     VM_UFFD_MISSING | VM_UFFD_WP | VM_UFFD_MINOR)))
+		goto out;
+	if (inject == 2) {
+		error = -EACCES;
+		goto out;
+	}
+	error = do_mas_align_munmap(&mas, vma, mm, start, start + len,
+	                            NULL, false, commit, opaque, inject);
+out:
+	mmap_write_unlock(mm);
+	return error;
+}
+EXPORT_SYMBOL_GPL(capstone_grant_unmap);
+
