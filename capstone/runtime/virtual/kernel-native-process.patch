+
+/* Capability runtime signal classes, not user handler addresses. Caught
+ * handlers require a protected delivery protocol and remain unsupported. */
+int capstone_native_signal_action(unsigned sig, unsigned cls, unsigned flags)
+{
+	struct k_sigaction action = {};
+	if (!valid_signal(sig) || !sig || sig == SIGKILL || sig == SIGSTOP || cls > 2)
+		return -EINVAL;
+	if (cls == 2)
+		return -EOPNOTSUPP;
+	action.sa.sa_handler = cls == 1 ? SIG_IGN : SIG_DFL;
+	action.sa.sa_flags = flags & (SA_NOCLDSTOP | SA_NOCLDWAIT);
+	sigemptyset(&action.sa.sa_mask);
+	return do_sigaction(sig, &action, NULL);
+}
+EXPORT_SYMBOL_GPL(capstone_native_signal_action);
