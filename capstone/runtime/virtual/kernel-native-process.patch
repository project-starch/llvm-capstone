+
+/* Prepare without publishing: the capability frontend installs only after
+ * checked result publication, or releases both reservations and file refs. */
+extern int capstone_native_reserve_fd(unsigned, unsigned);
+int capstone_native_pipe_prepare(int fd[2], struct file *files[2],
+				unsigned flags, unsigned limit)
+{
+	int error;
+	if (flags & ~(O_CLOEXEC | O_NONBLOCK))
+		return -EINVAL;
+	fd[0] = capstone_native_reserve_fd(flags & O_CLOEXEC, limit);
+	if (fd[0] < 0)
+		return fd[0];
+	fd[1] = capstone_native_reserve_fd(flags & O_CLOEXEC, limit);
+	if (fd[1] < 0) {
+		error = fd[1];
+		goto release_read;
+	}
+	error = create_pipe_files(files, flags);
+	if (!error)
+		return 0;
+	put_unused_fd(fd[1]);
+release_read:
+	put_unused_fd(fd[0]);
+	return error;
+}
+EXPORT_SYMBOL_GPL(capstone_native_pipe_prepare);
 
