+/* Reserve inside the capability frontend's descriptor namespace. No install
+ * or close-on-failure: reservations must not release existing POSIX locks. */
+int capstone_native_reserve_fd(unsigned flags, unsigned limit)
+{
+	if (flags & ~O_CLOEXEC)
+		return -EINVAL;
+	return alloc_fd(0, min_t(unsigned long, rlimit(RLIMIT_NOFILE), limit), flags);
+}
