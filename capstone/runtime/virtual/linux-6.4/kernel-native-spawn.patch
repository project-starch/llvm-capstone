diff --git a/arch/riscv/kernel/capstone_spawn.c b/arch/riscv/kernel/capstone_spawn.c
new file mode 100644
--- /dev/null
+++ b/arch/riscv/kernel/capstone_spawn.c
@@ -0,0 +1,170 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/capstone_native_spawn.h>
+#include <linux/completion.h>
+#include <linux/errno.h>
+#include <linux/export.h>
+#include <linux/kref.h>
+#include <linux/pid.h>
+#include <linux/sched/signal.h>
+#include <linux/sched/task.h>
+#include <linux/seccomp.h>
+#include <linux/slab.h>
+#include <asm/capstone_task.h>
+
+struct capstone_native_spawn {
+	struct kref refs;
+	struct completion done;
+	const struct capstone_native_spawn_ops *ops;
+	void *data;
+	struct task_struct *parent, *child;
+	struct pid *pid;
+	int result;
+};
+
+static void capstone_spawn_free(struct kref *refs)
+{
+	struct capstone_native_spawn *s =
+		container_of(refs, struct capstone_native_spawn, refs);
+	s->ops->release(s->data);
+	if (s->child)
+		put_task_struct(s->child);
+	put_pid(s->pid);
+	kfree(s);
+}
+
+/* The parent retains its reference until completion or final reaping. Drop
+ * the child's reference before completing, so no callback outlives spawn(). */
+static void capstone_spawn_done(struct capstone_native_spawn *s, int result)
+{
+	current->thread.capstone_spawn = NULL;
+	s->result = result;
+	kref_put(&s->refs, capstone_spawn_free);
+	complete_all(&s->done);
+}
+
+void capstone_native_spawn_exit(struct task_struct *task)
+{
+	struct capstone_native_spawn *s = task->thread.capstone_spawn;
+	if (s) {
+		WARN_ON_ONCE(task != current);
+		capstone_spawn_done(s, -ENOEXEC);
+	}
+}
+
+void *capstone_native_spawn_data(void)
+{
+	struct capstone_native_spawn *s = current->thread.capstone_spawn;
+	return s ? s->data : NULL;
+}
+EXPORT_SYMBOL_GPL(capstone_native_spawn_data);
+
+static int capstone_spawn_child(void *data)
+{
+	struct capstone_native_spawn *s = data;
+	int ret;
+	if (WARN_ON_ONCE(current->thread.capstone_spawn != s))
+		do_exit(127 << 8);
+	ret = fatal_signal_pending(current) ? -EINTR : s->ops->exec(s->data);
+	/* A successful callback must have installed the native personality. No
+	 * callback return, scalar exec, or failed loader can reach scalar sret. */
+	if (!ret && (!current->thread.capstone ||
+		     current->mm == s->parent->mm ||
+		     !test_thread_flag(TIF_CAPSTONE)))
+		ret = -ENOEXEC;
+	if (ret > 0)
+		ret = -EINVAL;
+	capstone_spawn_done(s, ret);
+	if (ret)
+		do_exit(127 << 8);
+	return 0;
+}
+
+bool capstone_native_spawn_clone(struct task_struct *child,
+				const struct kernel_clone_args *args)
+{
+	struct capstone_native_spawn *s = args->capstone_bootstrap;
+	if (!current->thread.capstone || current->thread.capstone_spawn ||
+	    !s || args->fn != capstone_spawn_child || args->fn_arg != s ||
+	    args->flags != (CLONE_VM | CLONE_UNTRACED) ||
+	    args->exit_signal != SIGCHLD || args->kthread || args->io_thread ||
+	    args->idle || s->parent != current)
+		return false;
+	/* Publish before copy_process makes the child visible to ptrace. */
+	child->thread.capstone_spawn = s;
+	return true;
+}
+
+void capstone_native_spawn_record(const struct kernel_clone_args *args,
+				 struct task_struct *child, struct pid *pid)
+{
+	struct capstone_native_spawn *s = args->capstone_bootstrap;
+	BUG_ON(!s || child->thread.capstone_spawn != s || s->parent != current);
+	get_task_struct(child);
+	s->child = child;
+	s->pid = get_pid(pid);
+}
+
+long capstone_native_spawn(const struct capstone_native_spawn_ops *ops,
+			  void *data, struct pid **child_pid)
+{
+	struct capstone_native_spawn *s;
+	struct kernel_clone_args args = {
+		.flags = CLONE_VM | CLONE_UNTRACED,
+		.exit_signal = SIGCHLD,
+		.fn = capstone_spawn_child,
+	};
+	long ret = -EINVAL;
+	int error;
+	if (child_pid)
+		*child_pid = NULL;
+	if (!ops || !ops->release)
+		return -EINVAL;
+	if (!data || !child_pid || !ops->exec)
+		goto release;
+	ret = -EOPNOTSUPP;
+	if (!current->thread.capstone || current->thread.capstone_spawn ||
+	    current->ptrace || current->seccomp.mode != SECCOMP_MODE_DISABLED ||
+	    riscv_capstone_syscall_work())
+		goto release;
+	ret = -ENOMEM;
+	s = kzalloc(sizeof(*s), GFP_KERNEL);
+	if (!s)
+		goto release;
+	kref_init(&s->refs);
+	kref_get(&s->refs); /* parent and prospective child */
+	init_completion(&s->done);
+	s->ops = ops;
+	s->data = data;
+	s->parent = current;
+	s->result = -ENOEXEC;
+	args.fn_arg = s;
+	args.capstone_bootstrap = s;
+	ret = kernel_clone(&args);
+	if (ret < 0) {
+		kref_put(&s->refs, capstone_spawn_free); /* no child was created */
+		goto put;
+	}
+	/* Exact references were recorded before the child could run or autoreap. */
+	BUG_ON(!s->child || !s->pid);
+	error = wait_for_completion_killable(&s->done);
+	if (error || fatal_signal_pending(current))
+		error = -EINTR;
+	else
+		error = s->result;
+	if (error) {
+		/* Finish cleanup despite the parent's pending fatal signal. The exit
+		 * hook also completes a child which dies inside exec's lifecycle. */
+		capstone_native_cancel(s->pid);
+		wait_for_completion(&s->done);
+		ret = error;
+	} else {
+		*child_pid = get_pid(s->pid);
+	}
+put:
+	kref_put(&s->refs, capstone_spawn_free);
+	return ret;
+release:
+	ops->release(data);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(capstone_native_spawn);
