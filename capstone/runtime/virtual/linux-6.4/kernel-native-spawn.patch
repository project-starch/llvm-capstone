+static int child_wait_callback_uninterruptible(wait_queue_entry_t *wait,
+					      unsigned mode, int sync, void *key)
+{
+	return child_wait_callback(wait, TASK_NORMAL, sync, key);
+}
+
+static long do_wait_state(struct wait_opts *wo, unsigned int state)
 {
 	int retval;
 
 	trace_sched_process_wait(wo->wo_pid);
 
-	init_waitqueue_func_entry(&wo->child_wait, child_wait_callback);
+	init_waitqueue_func_entry(&wo->child_wait, state == TASK_UNINTERRUPTIBLE ?
+		child_wait_callback_uninterruptible : child_wait_callback);
 	wo->child_wait.private = current;
 	add_wait_queue(&current->signal->wait_chldexit, &wo->child_wait);
