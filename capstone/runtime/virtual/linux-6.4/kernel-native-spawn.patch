+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+int capstone_native_exec_file(struct file *file, const char *const *argv,
+			     const char *const *envp)
+{
+	struct file *left;
+	int fd, ret;
+	if (!file || !argv || !envp || !current->thread.capstone_spawn ||
+	    current->thread.capstone)
+		return -EINVAL;
+	/* This descriptor belongs only to the bootstrap child, after its ordered
+	 * file actions. AT_EMPTY_PATH reopens this pinned object with MAY_EXEC,
+	 * noexec and write exclusion checks, including when file was O_PATH. */
+	fd = get_unused_fd_flags(O_CLOEXEC);
+	if (fd < 0)
+		return fd;
+	fd_install(fd, get_file(file));
+	ret = kernel_execveat(fd, "", argv, envp, AT_EMPTY_PATH, true);
+	/* Successful exec closed it. On pre-PONR failure, remove only our exact
+	 * temporary file; never close a descriptor reused by a binary loader. */
+	left = fget_raw(fd);
+	if (left == file)
+		close_fd(fd);
+	if (left)
+		fput(left);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(capstone_native_exec_file);
+#endif
