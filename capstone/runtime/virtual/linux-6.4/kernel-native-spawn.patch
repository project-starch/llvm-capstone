diff --git a/include/linux/capstone_native_spawn.h b/include/linux/capstone_native_spawn.h
new file mode 100644
--- /dev/null
+++ b/include/linux/capstone_native_spawn.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_CAPSTONE_NATIVE_SPAWN_H
+#define _LINUX_CAPSTONE_NATIVE_SPAWN_H
+
+#include <linux/types.h>
+
+struct file;
+struct kernel_clone_args;
+struct pid;
+struct rusage;
+struct task_struct;
+
+struct capstone_native_spawn_ops {
+	/* Runs in the child, with private files/fs/sighand and a temporary shared
+	 * mm. Apply authorized actions, then call capstone_native_exec_file(). */
+	int (*exec)(void *data);
+	void (*release)(void *data);
+};
+
+/* Consumes data on every return when ops->release is valid. The caller keeps
+ * ops/code resident until return. Success gives a held exact child pid; errors
+ * leave no child to reap. A killed setup is cancelled and reaped before return,
+ * which can wait for the child's uninterruptible filesystem operations. */
+long capstone_native_spawn(const struct capstone_native_spawn_ops *ops,
+			  void *data, struct pid **child_pid);
+void *capstone_native_spawn_data(void);
+
+/* Borrows the pinned file and kernel strings. Bootstrap only, native-only
+ * binfmt dispatch; scripts and interpreter chains cannot execute. */
+int capstone_native_exec_file(struct file *file, const char *const *argv,
+			     const char *const *envp);
+
+/* Exact children only. options is zero or WNOHANG; outputs are kernel buffers.
+ * Neither helper consumes the pid reference. cancel kills and reaps. */
+long capstone_native_wait(struct pid *pid, int options, int *status,
+			 struct rusage *usage);
+int capstone_native_cancel(struct pid *pid);
+
+/* Internal hooks: the architecture validates the one trusted bootstrap and
+ * fork records task/pid references before wakeup. Never a generic fn escape. */
+bool capstone_native_spawn_clone(struct task_struct *child,
+				const struct kernel_clone_args *args);
+void capstone_native_spawn_record(const struct kernel_clone_args *args,
+				 struct task_struct *child, struct pid *pid);
+void capstone_native_spawn_exit(struct task_struct *task);
+
+#endif
