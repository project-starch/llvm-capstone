@@ -1609,7 +1620,7 @@ repeat:
 	   (!wo->wo_pid || !pid_has_task(wo->wo_pid, wo->wo_type)))
 		goto notask;
 
-	set_current_state(TASK_INTERRUPTIBLE);
+	set_current_state(state);
 	read_lock(&tasklist_lock);
 
 	if (wo->wo_type == PIDTYPE_PID) {
@@ -1638,7 +1649,7 @@ notask:
 	retval = wo->notask_error;
 	if (!retval && !(wo->wo_flags & WNOHANG)) {
 		retval = -ERESTARTSYS;
-		if (!signal_pending(current)) {
+		if (state == TASK_UNINTERRUPTIBLE || !signal_pending(current)) {
 			schedule();
 			goto repeat;
 		}
@@ -1649,6 +1660,65 @@ end:
 	return retval;
 }
 
+static long do_wait(struct wait_opts *wo)
+{
+	return do_wait_state(wo, TASK_INTERRUPTIBLE);
+}
+
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+/* No user pointer reaches do_wait. Keep Linux child ownership, zombie status,
+ * rusage and autoreaping semantics; only the supported option set is smaller. */
+long capstone_native_wait(struct pid *pid, int options, int *status,
+			 struct rusage *usage)
+{
+	struct wait_opts wo = {
+		.wo_type = PIDTYPE_PID,
+		.wo_pid = pid,
+		.wo_flags = options | WEXITED | __WNOTHREAD,
+		.wo_rusage = usage,
+	};
+	long ret;
+	if (!pid || (options & ~WNOHANG))
+		return -EINVAL;
+	ret = do_wait(&wo);
+	if (ret > 0 && status)
+		*status = wo.wo_stat;
+	return ret == -ERESTARTSYS ? -EINTR : ret;
+}
+EXPORT_SYMBOL_GPL(capstone_native_wait);
+
+int capstone_native_cancel(struct pid *pid)
+{
+	struct task_struct *child;
+	struct wait_opts wo = {
+		.wo_type = PIDTYPE_PID,
+		.wo_pid = pid,
+		.wo_flags = WEXITED | __WNOTHREAD,
+	};
+	long ret;
+	if (!pid)
+		return -EINVAL;
+	read_lock(&tasklist_lock);
+	child = pid_task(pid, PIDTYPE_PID);
+	if (child && child->real_parent != current) {
+		read_unlock(&tasklist_lock);
+		return -ECHILD;
+	}
+	if (child)
+		get_task_struct(child);
+	read_unlock(&tasklist_lock);
+	if (!child)
+		return 0; /* already autoreaped; the held pid cannot be reused */
+	send_sig(SIGKILL, child, 1);
+	put_task_struct(child);
+	/* Cancellation must not strand a child when the parent has SIGKILL
+	 * pending. This final reap may wait for uninterruptible child I/O. */
+	ret = do_wait_state(&wo, TASK_UNINTERRUPTIBLE);
+	return ret > 0 || ret == -ECHILD ? 0 : ret;
+}
+EXPORT_SYMBOL_GPL(capstone_native_cancel);
+#endif
+
