diff --git a/arch/riscv/include/asm/page.h b/arch/riscv/include/asm/page.h
--- a/arch/riscv/include/asm/page.h
+++ b/arch/riscv/include/asm/page.h
@@ -44,17 +44,34 @@
 
 #ifndef __ASSEMBLY__
 
-#ifdef CONFIG_RISCV_ISA_ZICBOZ
-void clear_page(void *page);
-#else
-#define clear_page(pgaddr)			memset((pgaddr), 0, PAGE_SIZE)
-#endif
+/*
+ * 6.4 port: 6.1's clear_page was memset; 6.4 adds a Zicboz clear_page
+ * (arch/riscv/lib/clear_page.S). The Capstone clear keeps 6.1's memset
+ * fallback, so a page clear never uses cbo.zero outside captag_bulk_on.
+ */
+void capstone_clear_page(void *page);
+#define clear_page(pgaddr)			capstone_clear_page(pgaddr)
 #define copy_page(to, from)			memcpy((to), (from), PAGE_SIZE)
 
 #define clear_user_page(pgaddr, vaddr, page)	clear_page(pgaddr)
 #define copy_user_page(vto, vfrom, vaddr, topg) \
 			memcpy((vto), (vfrom), PAGE_SIZE)
 
+/*
+ * Optional Capstone raw transport: capability tags follow physical pages.
+ * See arch/riscv/mm/captag.c. Every page copy also moves the copied page's tags, and every
+ * page free clears the freed pages' tags.
+ */
+struct page;
+struct vm_area_struct;
+#define __HAVE_ARCH_COPY_HIGHPAGE
+void copy_highpage(struct page *to, struct page *from);
+#define __HAVE_ARCH_COPY_USER_HIGHPAGE
+void copy_user_highpage(struct page *to, struct page *from,
+			unsigned long vaddr, struct vm_area_struct *vma);
+#define HAVE_ARCH_FREE_PAGE
+void arch_free_page(struct page *page, int order);
+
 /*
  * Use struct definitions to apply C type checking
  */
diff --git a/arch/riscv/include/asm/pgtable.h b/arch/riscv/include/asm/pgtable.h
--- a/arch/riscv/include/asm/pgtable.h
+++ b/arch/riscv/include/asm/pgtable.h
@@ -894,4 +894,11 @@ extern unsigned long empty_zero_page[PAGE_SIZE / sizeof(unsigned long)];
 
 #endif /* !__ASSEMBLY__ */
 
+#ifndef __ASSEMBLY__
+/* EXPERIMENT experiment/tag-aware-mm: a page that holds capability tags is not swapped out
+ * (there is no swap-side tag store); see arch/riscv/mm/captag.c. */
+#define __HAVE_ARCH_PREPARE_TO_SWAP
+int arch_prepare_to_swap(struct page *page);
+#endif
+
 #endif /* _ASM_RISCV_PGTABLE_H */
