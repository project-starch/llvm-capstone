diff --git a/fs/select.c b/fs/select.c
--- a/fs/select.c
+++ b/fs/select.c
@@ -17,6 +17,9 @@
 
 #include <linux/compat.h>
 #include <linux/kernel.h>
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+#include <linux/capstone_native_time.h>
+#endif
 #include <linux/sched/signal.h>
 #include <linux/sched/rt.h>
 #include <linux/syscalls.h>
@@ -1447,3 +1450,69 @@ COMPAT_SYSCALL_DEFINE5(ppoll_time64, struct pollfd __user *, ufds,
 }
 
 #endif
+
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+/* Kernel-buffer pselect frontend. Reuse Linux's readiness polling and wakeups;
+ * no domain pointer is passed to a user-pointer syscall or retained here. */
+int capstone_native_select(int n, unsigned long *in, unsigned long *out,
+                           unsigned long *ex, struct timespec64 *timeout,
+                           const sigset_t *mask)
+{
+	struct timespec64 end, now, *to = NULL;
+	fd_set_bits fds;
+	sigset_t kmask;
+	void *bits;
+	size_t size, stride;
+	int ret, max_fds;
+	if (n < 0 || n > 1024)
+		return -EINVAL;
+	if (timeout) {
+		to = &end;
+		if (poll_select_set_timeout(to, timeout->tv_sec, timeout->tv_nsec))
+			return -EINVAL;
+	}
+	rcu_read_lock();
+	max_fds = files_fdtable(current->files)->max_fds;
+	rcu_read_unlock();
+	n = min(n, max_fds);
+	size = FDS_BYTES(n);
+	stride = max_t(size_t, size, sizeof(unsigned long));
+	bits = kzalloc(6 * stride, GFP_KERNEL);
+	if (!bits)
+		return -ENOMEM;
+	fds.in = bits;
+	fds.out = bits + stride;
+	fds.ex = bits + 2 * stride;
+	fds.res_in = bits + 3 * stride;
+	fds.res_out = bits + 4 * stride;
+	fds.res_ex = bits + 5 * stride;
+	if (in) memcpy(fds.in, in, size);
+	if (out) memcpy(fds.out, out, size);
+	if (ex) memcpy(fds.ex, ex, size);
+	if (mask) {
+		set_restore_sigmask();
+		current->saved_sigmask = current->blocked;
+		kmask = *mask;
+		set_current_blocked(&kmask);
+	}
+	ret = do_select(n, &fds, to);
+	if (!ret && signal_pending(current))
+		ret = -ERESTARTNOHAND;
+	restore_saved_sigmask_unless(ret == -ERESTARTNOHAND);
+	if (ret >= 0) {
+		if (in) memcpy(in, fds.res_in, size);
+		if (out) memcpy(out, fds.res_out, size);
+		if (ex) memcpy(ex, fds.res_ex, size);
+	}
+	if (timeout && !(current->personality & STICKY_TIMEOUTS) &&
+	    (end.tv_sec || end.tv_nsec)) {
+		ktime_get_ts64(&now);
+		*timeout = timespec64_sub(end, now);
+		if (timeout->tv_sec < 0)
+			timeout->tv_sec = timeout->tv_nsec = 0;
+	}
+	kfree(bits);
+	return ret == -ERESTARTNOHAND ? -EINTR : ret;
+}
+EXPORT_SYMBOL_GPL(capstone_native_select);
+#endif
diff --git a/include/linux/capstone_native_time.h b/include/linux/capstone_native_time.h
new file mode 100644
--- /dev/null
+++ b/include/linux/capstone_native_time.h
@@ -0,0 +1,10 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_CAPSTONE_NATIVE_TIME_H
+#define _LINUX_CAPSTONE_NATIVE_TIME_H
+#include <linux/time64.h>
+#include <linux/signal_types.h>
+/* Admitted private FD table; all arrays are checked kernel snapshots. */
+int capstone_native_select(int n, unsigned long *in, unsigned long *out,
+                           unsigned long *ex, struct timespec64 *timeout,
+                           const sigset_t *mask);
+#endif
