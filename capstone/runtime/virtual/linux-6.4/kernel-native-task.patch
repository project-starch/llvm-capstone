diff --git a/kernel/ptrace.c b/kernel/ptrace.c
--- a/kernel/ptrace.c
+++ b/kernel/ptrace.c
@@ -429,6 +429,14 @@ static int ptrace_attach(struct task_struct *task, long request,
 	if (mutex_lock_interruptible(&task->signal->cred_guard_mutex))
 		goto out;
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	/* Serialize publication by exec with debugger admission. */
+	if (READ_ONCE(task->thread.capstone)) {
+		retval = -EOPNOTSUPP;
+		goto unlock_creds;
+	}
+#endif
+
 	task_lock(task);
 	retval = __ptrace_may_access(task, PTRACE_MODE_ATTACH_REALCREDS);
 	task_unlock(task);
