diff --git a/arch/riscv/include/asm/capstone_task.h b/arch/riscv/include/asm/capstone_task.h
new file mode 100644
--- /dev/null
+++ b/arch/riscv/include/asm/capstone_task.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _ASM_RISCV_CAPSTONE_TASK_H
+#define _ASM_RISCV_CAPSTONE_TASK_H
+#include <linux/types.h>
+struct pt_regs;
+struct task_struct;
+struct riscv_capstone_ops {
+	void (*step)(void *, struct pt_regs *);
+	void (*release)(void *);
+};
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+#include <linux/thread_info.h>
+/*
+ * 6.4 port: 6.1's _TIF_SYSCALL_WORK (trace, tracepoint, audit, seccomp)
+ * moved to generic entry's thread_info->syscall_work. Any bit refuses, which
+ * also covers 6.4-only interception (syscall user dispatch, SYSEMU, exit trap).
+ */
+static inline bool riscv_capstone_syscall_work(void)
+{
+	return READ_ONCE(current_thread_info()->syscall_work) != 0;
+}
+bool riscv_capstone_owns(void *);
+int riscv_capstone_attach(void *, const struct riscv_capstone_ops *);
+void riscv_capstone_release(struct task_struct *);
+void riscv_capstone_return(struct pt_regs *);
+long riscv_capstone_run_user(unsigned long, unsigned long);
+void riscv_capstone_trap_enter(void);
+#else
+static inline void riscv_capstone_release(struct task_struct *task) { }
+#endif
+#endif
diff --git a/arch/riscv/include/asm/entry-common.h b/arch/riscv/include/asm/entry-common.h
--- a/arch/riscv/include/asm/entry-common.h
+++ b/arch/riscv/include/asm/entry-common.h
@@ -8,4 +8,37 @@
 void handle_page_fault(struct pt_regs *regs);
 void handle_break(struct pt_regs *regs);
 
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+#include <asm/capstone_task.h>
+#include <asm/thread_info.h>
+#include <linux/irqflags.h>
+
+/*
+ * 6.4 port of 6.1's entry.S return hook. 6.1 stepped a task with
+ * TIF_CAPSTONE, with IRQs off, only once its work flags held no other
+ * _TIF_WORK_MASK bit, then re-ran ret_from_exception. Generic entry has no
+ * such point, so TIF_CAPSTONE joins EXIT_TO_USER_MODE_WORK: the loop keeps
+ * running while it is set, and the step runs only in an iteration whose
+ * IRQs-off flag read held no other exit work (6.1's priority). The loop
+ * runs this with IRQs on; riscv_capstone_return expects them off.
+ */
+#define ARCH_EXIT_TO_USER_MODE_WORK	_TIF_CAPSTONE
+/* EXIT_TO_USER_MODE_WORK less TIF_CAPSTONE; riscv has no _TIF_PATCH_PENDING
+ * (linux/entry-common.h defines it 0, after this header). */
+#define CAPSTONE_OTHER_EXIT_WORK						\
+	(_TIF_SIGPENDING | _TIF_NOTIFY_RESUME | _TIF_UPROBE |		\
+	 _TIF_NEED_RESCHED | _TIF_NOTIFY_SIGNAL)
+
+static inline void arch_exit_to_user_mode_work(struct pt_regs *regs,
+					       unsigned long ti_work)
+{
+	if (!(ti_work & _TIF_CAPSTONE) || (ti_work & CAPSTONE_OTHER_EXIT_WORK))
+		return;
+	local_irq_disable();
+	riscv_capstone_return(regs);
+	local_irq_enable();
+}
+#define arch_exit_to_user_mode_work arch_exit_to_user_mode_work
+#endif
+
 #endif /* _ASM_RISCV_ENTRY_COMMON_H */
