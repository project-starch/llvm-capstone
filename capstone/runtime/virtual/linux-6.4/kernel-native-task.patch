+
+config RISCV_CAPSTONE_TASK
+	bool "Experimental Capstone native task backend"
+	depends on 64BIT && MMU && !SMP
+	depends on VIRT_CPU_ACCOUNTING_GEN && CONTEXT_TRACKING_USER_FORCE
