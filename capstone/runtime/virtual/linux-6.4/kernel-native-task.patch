diff --git a/arch/riscv/kernel/capstone_task.c b/arch/riscv/kernel/capstone_task.c
new file mode 100644
--- /dev/null
+++ b/arch/riscv/kernel/capstone_task.c
@@ -0,0 +1,109 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#include <linux/context_tracking.h>
+#include <linux/errno.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/slab.h>
+#include <asm/asm-extable.h>
+#include <asm/capstone_task.h>
+#include <asm/ptrace.h>
+
+struct riscv_capstone_task {
+	void *private;
+	const struct riscv_capstone_ops *ops;
+	struct mm_struct *mm; /* backend keeps mm_count, never mm_users */
+};
+
+/* Synchronous callbacks cannot release, transfer or retain private state.
+ * The current task owns its lifetime until the step returns, even across sleep.
+ * Shared-mm and asynchronous providers will need independent references. */
+bool riscv_capstone_owns(void *private)
+{
+	struct riscv_capstone_task *state = current->thread.capstone;
+	return state && state->private == private && state->mm == current->mm;
+}
+
+int riscv_capstone_attach(void *private, const struct riscv_capstone_ops *ops)
+{
+	struct riscv_capstone_task *state;
+	if (!private || !ops || !current->mm || current->thread.capstone ||
+	    current->mm->context.capstone_namespace || !ops->step || !ops->release)
+		return -EINVAL;
+	state = kzalloc(sizeof(*state), GFP_KERNEL);
+	if (!state)
+		return -ENOMEM;
+	/* setup_new_exec has dropped cred_guard_mutex. Publish under the same
+	 * lock as ptrace_attach, checking tracers admitted during image setup. */
+	mutex_lock(&current->signal->cred_guard_mutex);
+	if (current->ptrace || riscv_capstone_syscall_work()) {
+		mutex_unlock(&current->signal->cred_guard_mutex);
+		kfree(state);
+		return -EOPNOTSUPP;
+	}
+	state->private = private;
+	state->ops = ops;
+	state->mm = current->mm;
+	current->mm->context.capstone_namespace = private;
+	current->thread.capstone = state;
+	set_thread_flag(TIF_CAPSTONE);
+	mutex_unlock(&current->signal->cred_guard_mutex);
+	return 0;
+}
+
+/* Called before exit_mm and before irreversible exec changes the old mm. */
+void riscv_capstone_release(struct task_struct *task)
+{
+	struct riscv_capstone_task *state = task->thread.capstone;
+	if (!state)
+		return;
+	WARN_ON_ONCE(task != current || task->thread.capstone_user);
+	task->thread.capstone = NULL;
+	clear_tsk_thread_flag(task, TIF_CAPSTONE);
+	WARN_ON_ONCE(state->mm->context.capstone_namespace != state->private);
+	state->mm->context.capstone_namespace = NULL;
+	state->ops->release(state->private);
+	kfree(state);
+}
+
+/* Entry.S calls with IRQs off, after Linux return-work checks. */
+void riscv_capstone_return(struct pt_regs *regs)
+{
+	struct riscv_capstone_task *state = current->thread.capstone;
+	BUG_ON(!irqs_disabled() || !state || current->mm != state->mm);
+	local_irq_enable();
+	state->ops->step(state->private, regs);
+	local_irq_disable();
+	/* A failure must not return through scalar sret into domain text. */
+	BUG_ON(current->thread.capstone != state);
+}
+
+/* An S-origin admission exception can happen after CT_USER was entered.
+ * Entry.S invokes this before tracing or ordinary exception handling. */
+noinstr void riscv_capstone_trap_enter(void)
+{
+	if (READ_ONCE(current->thread.capstone_user)) {
+		user_exit_irqoff();
+		WRITE_ONCE(current->thread.capstone_user, false);
+	}
+}
+
+/* No frame access, lock, counter or trace instrumentation while in CT_USER.
+ * The admitted model restores caller SIE=0 on normal escape. Refusals use an
+ * exception-table fixup; the early trap hook balances context tracking first. */
+noinstr long riscv_capstone_run_user(unsigned long frame, unsigned long action)
+{
+	long error = 0;
+	WRITE_ONCE(current->thread.capstone_user, true);
+	user_enter_irqoff();
+	asm volatile("1: .insn r 0x5b, 1, 0x24, x0, %1, %2\n\t"
+		     "csrw 0x5c1, zero\n\tj 2f\n"
+		     "3: li %0, -14\n\tcsrw 0x5c1, zero\n2:\n"
+		     _ASM_EXTABLE(1b, 3b)
+		     : "+r"(error) : "r"(frame), "r"(action) : "memory");
+	if (READ_ONCE(current->thread.capstone_user)) {
+		user_exit_irqoff();
+		WRITE_ONCE(current->thread.capstone_user, false);
+	}
+	return error;
+}
diff --git a/arch/riscv/kernel/entry.S b/arch/riscv/kernel/entry.S
--- a/arch/riscv/kernel/entry.S
+++ b/arch/riscv/kernel/entry.S
@@ -77,6 +77,14 @@ _save_context:
 .option norelax
 	la gp, __global_pointer$
 .option pop
+#ifdef CONFIG_RISCV_CAPSTONE_TASK
+	/*
+	 * 6.4 port of 6.1's hook (before __trace_hardirqs_off there): balance
+	 * context tracking for an S-origin admission trap taken in CT_USER,
+	 * before any C handler runs irqentry_enter(). s4 (cause) is callee-saved.
+	 */
+	call riscv_capstone_trap_enter
+#endif
 	move a0, sp /* pt_regs */
 	la ra, ret_from_exception
 
