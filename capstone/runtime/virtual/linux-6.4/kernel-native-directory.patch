+/* Called with a held, confined source path and a locked destination parent
+ * whose mount is write-held. Delegation conflicts return -EWOULDBLOCK. */
+int capstone_native_path_link(const struct path *source, const struct path *parent,
+                             struct dentry *entry)
+{
+	/* 6.4 port: mnt_idmap, as in 6.4's do_linkat (6.1: mnt_user_ns). */
+	struct mnt_idmap *idmap = mnt_idmap(parent->mnt);
+	int error;
+	if (source->mnt != parent->mnt)
+		return -EXDEV;
+	error = may_linkat(idmap, source);
+	if (!error)
+		error = security_path_link(source->dentry, parent, entry);
+	if (!error)
+		error = vfs_link(source->dentry, idmap, d_inode(parent->dentry),
+				 entry, NULL);
+	return error;
+}
+EXPORT_SYMBOL_GPL(capstone_native_path_link);
