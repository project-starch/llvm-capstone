diff --git i/src/vm.c w/src/vm.c
index 148332bd0..f81d7ee7e 100644
--- i/src/vm.c
+++ w/src/vm.c
@@ -184,6 +184,15 @@ mrb_realloc_with_gc_disabled(mrb_state *mrb, void *p, size_t size)
   return p;
 }
 
+#ifdef MD_PROBE_STACK
+/* Capstone bring-up instrument; port/md_probe.c. Takes the callinfo the clear is
+   about to use, not the context, because exec_irep uses a ci it cached before
+   stack_extend ran. BOTH clears are wrapped: instrumenting only mrb_vm_run's
+   produced a healthy reading and a fault four instructions later, and the reason
+   was that the other one exists. */
+extern long md_probe_stack(void *ci, void *stbase, long nregs, long keep);
+#endif
+
 static void
 stack_extend_alloc(mrb_state *mrb, mrb_int room)
 {
@@ -994,6 +1003,10 @@ exec_irep(mrb_state *mrb, mrb_value self, const struct RProc *p)
   }
   else {
     stack_extend(mrb, nregs);
+#ifdef MD_PROBE_STACK
+    /* ci was cached at the top of this function, BEFORE stack_extend ran. */
+    nregs = (mrb_int)md_probe_stack(ci, mrb->c->stbase, (long)nregs, (long)keep);
+#endif
     stack_clear(ci->stack+keep, nregs-keep);
   }
 
@@ -1772,6 +1785,9 @@ mrb_vm_run(mrb_state *mrb, const struct RProc *proc, mrb_value self, mrb_int sta
     }
   }
   stack_extend(mrb, nregs);
+#ifdef MD_PROBE_STACK
+  nregs = (mrb_int)md_probe_stack(c->ci, c->stbase, (long)nregs, (long)stack_keep);
+#endif
   stack_clear(c->ci->stack + stack_keep, nregs - stack_keep);
   c->ci->stack[0] = self;
   mrb_value result = mrb_vm_exec(mrb, proc, irep->iseq);
