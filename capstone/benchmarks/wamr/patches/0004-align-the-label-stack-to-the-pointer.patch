diff --git i/core/iwasm/interpreter/wasm_interp_classic.c w/core/iwasm/interpreter/wasm_interp_classic.c
index 5d23142..91a8569 100644
--- i/core/iwasm/interpreter/wasm_interp_classic.c
+++ w/core/iwasm/interpreter/wasm_interp_classic.c
@@ -6787,6 +6787,20 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
             max_stack_cell_num += eh_size;
 #endif
 
+#if defined(__SIZEOF_POINTER__) && __SIZEOF_POINTER__ > 8
+            /* csp_bottom is (WASMBranchBlock *)frame->sp_boundary, and a branch
+               block is made of pointers. sp_boundary is uint32-granular, so where
+               a pointer is wider than a cell the label stack starts under-aligned
+               and the first store into it faults. Pad the operand stack so the
+               cast lands aligned; the padding cells go into all_cell_num below,
+               so the frame still fits what is written into it. */
+            {
+                uint32 cells = (uint32)(sizeof(void *) / 4);
+                uint32 upto = cur_func->param_cell_num
+                              + cur_func->local_cell_num + max_stack_cell_num;
+                max_stack_cell_num += (cells - upto % cells) % cells;
+            }
+#endif
             cell_num_of_local_stack = cur_func->param_cell_num
                                       + cur_func->local_cell_num
                                       + max_stack_cell_num;
