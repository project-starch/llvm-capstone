Omit module-only float constants when math modules are disabled.

The e and pi singleton objects are only referenced by the math and cmath module tables. A port
that enables core float objects while omitting both modules should not retain those otherwise
unreachable globals. Besides saving data on small ports, this avoids unnecessary global-capability
initialisation entries on Capstone.

diff --git i/py/objfloat.c w/py/objfloat.c
index b0ad70de4..cdbfd01a4 100644
--- i/py/objfloat.c
+++ w/py/objfloat.c
@@ -57,8 +57,10 @@ typedef struct _mp_obj_float_t {
     mp_float_t value;
 } mp_obj_float_t;
 
+#if MICROPY_PY_MATH || MICROPY_PY_CMATH
 const mp_obj_float_t mp_const_float_e_obj = {{&mp_type_float}, (mp_float_t)M_E};
 const mp_obj_float_t mp_const_float_pi_obj = {{&mp_type_float}, (mp_float_t)M_PI};
+#endif
 #if MICROPY_PY_MATH_CONSTANTS
 #ifndef NAN
 #error NAN macro is not defined
