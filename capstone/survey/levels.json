{
  "schema": 1,
  "purpose": "One survey level per ported allocator, recorded on the revision the port pins.",
  "instrument": {
    "repo": "nested-allocators-paper",
    "path": "experiments/a1/hook",
    "header": "a1hook.h",
    "core": "a1core.inc",
    "contract": "A target's wiring defines A1_L1_NAME, optionally A1_L0_NAME, includes a1core.inc, and implements a1_block_* and a1_ctx_*. The wiring is included into the allocator's own translation unit so the build system does not change.",
    "one_custom_level_per_process": true,
    "consequence": "A program with several nested allocators needs one run per allocator, not one run with several levels."
  },
  "workloads": {
    "speedtest1-size100": {
      "program": "SQLite",
      "command": "speedtest1 --size 100",
      "note": "The recorded configuration of the existing survey, kept so the new rows stay comparable with the old ones."
    },
    "pyperformance-regex": {
      "program": "CPython",
      "command": "pyperformance run --benchmarks regex_v8",
      "note": "Summed over the process tree, as the existing CPython row is."
    },
    "pgbench-tpcb": {
      "program": "PostgreSQL",
      "command": "pgbench -b tpcb-like",
      "note": "One backend process is the workload process. The four managers are separate runs of the same workload."
    },
    "tshark-corpus-captures": {
      "program": "Wireshark",
      "command": "tshark -r <capture> -V",
      "note": "The captures attached to the upstream reports the wmem defect corpus names, so the survey exercises the same dissectors the corpus does. New workload: the port has no native recorder, its src/native is a synthetic driver."
    },
    "ffmpeg-decode-300s": {
      "program": "FFmpeg",
      "command": "ffmpeg -i <clip> -f null -",
      "note": "The recorded configuration of the existing survey row."
    },
    "memcached-churn": {
      "program": "memcached",
      "command": "set, get, delete, five rounds",
      "note": "The recorded configuration of the existing survey row."
    },
    "ab-keepalive": {
      "program": "Apache httpd",
      "command": "ab -k",
      "note": "The recorded configuration of the existing survey row. Both APR levels come from the same workload."
    }
  },
  "levels": [
    {
      "id": "sqlite-lookaside",
      "program": "SQLite",
      "allocator": "lookaside",
      "level": "lookaside",
      "below": "memsys5",
      "upstream": {
        "version": "3.53.3",
        "sources": [
          "sqlite3.c"
        ]
      },
      "port": {
        "path": "capstone/ports/sqlite",
        "status": "merged"
      },
      "workload": "speedtest1-size100",
      "container": "the connection's lookaside buffer",
      "seam": {
        "alloc": "a lookaside slot handed out on the sqlite3DbMallocRawNN path",
        "free": "sqlite3DbFree returning a slot to the connection free list",
        "bulk": "connection close releasing the lookaside buffer",
        "evidence": "capstone/ports/sqlite/sublet/README.md"
      },
      "confirmed": "measured",
      "why": "The only level the existing survey records for SQLite. It is kept so the new table can be compared with the old one, and because its level 0 is not libc.",
      "recorded": "results/20260922-sqlite-3530300-lookaside-over-memsys5"
    },
    {
      "id": "sqlite-memsys5",
      "program": "SQLite",
      "allocator": "memsys5",
