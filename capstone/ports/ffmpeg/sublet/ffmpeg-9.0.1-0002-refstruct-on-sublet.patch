 static void pool_free_entry(AVRefStructPool *pool, RefCount *ref)
 {
+#if FF_SUBLET_POOLS
+    /* The pool's end: the entry, already given back, is not given back again -- its block's
+     * revoke at pool_free ends it with every other entry. A callback still gets an alias, through
+     * a new handle that is dropped at once. */
+    ref->obj = ff_sublet_entry_end(&ref->sublet, pool->size ? pool->size : 1,
+                                   pool->free_entry_cb != NULL);
+    if (pool->free_entry_cb)
+        pool->free_entry_cb(pool->opaque, ref->obj);
+    rs_index_del(ref);
+    av_free(ref);
+#else
     if (pool->free_entry_cb)
         pool->free_entry_cb(pool->opaque, get_userdata(ref));
     av_free(ref);
+#endif
 }
 
 static void pool_return_entry(void *ref_)
