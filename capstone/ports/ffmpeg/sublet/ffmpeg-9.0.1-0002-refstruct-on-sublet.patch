Subject: refstruct objects keep their header beside them, and a refstruct pool's entries are carved from Sublet blocks
Upstream: ffmpeg 9.0.1
Upstream-Archive: https://ffmpeg.org/releases/ffmpeg-9.0.1.tar.xz
Upstream-SHA256: cf38e0e28c7e5605942c4a77755349b0145804a397af37eb1fb4c77cb237f635
Build-Variants: the app port's FFAPP_POOL=sublet arm; inert elsewhere (every hunk is guarded by FF_SUBLET_POOLS)
Depends-On: 0001 (ffsublet.h, the level below); the app port's patches/*.patch (none touches this file)
Apply-From: upstream source root, with patch --batch --forward --fuzz=0 -p1

Upstream keeps a refstruct object's RefCount in the object's own allocation, just below the pointer
it hands out, and an AVRefStructPool keeps its freelist link in that header. An object whose storage
is revoked when it goes back can hold neither, so the header becomes an allocation of its own, found
through an index keyed by the object's address -- after the pointer has been read through its own
authority, so a stale pointer faults before it can reach a header that may by now be its next
owner's. A plain object is then the object alone, on the heap, bounded to its size. A pool carves its
entries from blocks the heap lends LINEAR, as 0001 does for AVBufferPool: a get takes the entry's
handle, the last unref gives it back (one revoke) before the freelist can reissue it, and the pool's
end is one revoke per block. The classes of the hunks are in the sibling .classes file.

--- a/libavutil/refstruct.c
+++ b/libavutil/refstruct.c
@@ -21,6 +21,9 @@
 #include <string.h>
 
 #include "refstruct.h"
+#if FF_SUBLET_POOLS
+#include "ffsublet.h"
+#endif
 
 #include "avassert.h"
 #include "error.h"
@@ -65,25 +68,110 @@
 #if REFSTRUCT_CHECKED
     uint64_t cookie;
 #endif
+#if FF_SUBLET_POOLS
+    void            *obj;        /* the object this header belongs to */
+    unsigned long    addr;       /* its address, the index's key */
+    struct RefCount *index_next; /* the address index's chain */
+    FFSubletEntry    sublet;     /* a pool entry's region while free, its handle while out */
+#endif
 } RefCount;
 
+#if FF_SUBLET_POOLS
+/* THE HEADER BESIDE THE OBJECT. Upstream keeps RefCount in the object's own allocation, just
+ * below the pointer it hands out, and a pool's freelist link in it. An object whose storage is
+ * revoked when it goes back cannot hold either, so the header is its own allocation and is found
+ * through an index keyed by the object's address. This build has no threads (--disable-pthreads),
+ * so the index takes no lock. */
+#define RS_INDEX_LOG 12
+static RefCount *rs_index[1 << RS_INDEX_LOG];
+
+static size_t rs_slot(unsigned long addr)
+{
+    return (size_t)(((uint64_t)(addr >> 4) * UINT64_C(0x9E3779B97F4A7C15))
+                    >> (64 - RS_INDEX_LOG));
+}
+
+/* The key is taken while the object is live, so no lookup ever reads a revoked pointer. */
+static void rs_index_add(RefCount *ref)
+{
+    size_t i;
+
+    ref->addr = ff_sublet_addr(ref->obj);
+    i         = rs_slot(ref->addr);
+
+    ref->index_next = rs_index[i];
+    rs_index[i]     = ref;
+}
+
+static void rs_index_del(RefCount *ref)
+{
+    RefCount **link = &rs_index[rs_slot(ref->addr)];
+
+    while (*link != ref) {
+        av_assert0(*link);
+        link = &(*link)->index_next;
+    }
+    *link = ref->index_next;
+}
+
+/* The pointer is read through its own authority before its header is looked up, so a pointer
+ * whose object has been returned faults here, and never reaches a header that may by now belong
+ * to the object's next owner. */
+static RefCount *rs_header(const void *obj)
+{
+    RefCount     *ref;
+    unsigned long addr;
+
+    (void)*(const volatile unsigned char *)obj;
+    addr = ff_sublet_addr(obj);
+    for (ref = rs_index[rs_slot(addr)]; ref; ref = ref->index_next)
+        if (ref->addr == addr)
+            return ref;
+    av_assert0(0 && "refstruct: no header for this object");
+    return NULL;
+}
+
+/* A plain object's end: the object goes back to the heap, which revokes it, and so does its
+ * header. */
+static void rs_free_plain(void *ref_)
+{
+    RefCount *ref = ref_;
+
+    rs_index_del(ref);
+    av_free(ref->obj);
+    av_free(ref);
+}
+#endif
+
 static RefCount *get_refcount(void *obj)
 {
+#if FF_SUBLET_POOLS
+    RefCount *ref = rs_header(obj);
+#else
     RefCount *ref = (RefCount*)((char*)obj - REFCOUNT_OFFSET);
+#endif
     ff_assert(ref->cookie == REFSTRUCT_COOKIE);
     return ref;
 }
 
 static const RefCount *cget_refcount(const void *obj)
 {
+#if FF_SUBLET_POOLS
+    const RefCount *ref = rs_header(obj);
+#else
     const RefCount *ref = (const RefCount*)((const char*)obj - REFCOUNT_OFFSET);
+#endif
     ff_assert(ref->cookie == REFSTRUCT_COOKIE);
     return ref;
 }
 
 static void *get_userdata(void *buf)
 {
+#if FF_SUBLET_POOLS
+    return ((RefCount *)buf)->obj;
+#else
     return (char*)buf + REFCOUNT_OFFSET;
+#endif
 }
 
 static void refcount_init(RefCount *ref, AVRefStructOpaque opaque,
@@ -106,11 +194,27 @@
 
