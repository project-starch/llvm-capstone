  "launcher_domain_stats": "CAPSTONE_VM_STATS=1 (not registered): the launcher's per-domain counters at the domain's exit, on stderr; peak/pages are pinned 4 KiB pages, node_bytes/node_capacity the domain's lifetime table",
  "env": "CAPSTONE_EXEC_DIAGNOSTICS=1 CAPSTONE_VM_STATS=1"
