 /* allocate a new buffer and override its free() callback so that
  * it is returned to the pool on free */
+/* CAPSTONE (FFmpeg app port): a pool buffer's payload is a lease from the pool payload
+ * allocator (buffer-pool port, patch 0002), and it goes back there when the pool frees it.
+ * Only POOL buffers: the replay routed av_buffer_alloc and av_buffer_default_free themselves
+ * through that allocator, which in a whole program also catches every non-pool buffer
+ * (demuxed packets, av_buffer_realloc, av_buffer_create with the default free) and fails on
+ * the first of them. Those stay on the program heap here. */
+static void ff2_pool_payload_free(void *opaque, uint8_t *data)
+{
+    ff2_payload_free(data);
+}
