--- a/libavcodec/mpegpicture.c
+++ b/libavcodec/mpegpicture.c
@@ -67,7 +67,7 @@
 static int av_cold mpv_pic_init(AVRefStructOpaque opaque, void *obj)
 {
     MPVPicture *pic = obj;
-    int ret, init_progress = (uintptr_t)opaque.nc;
+    int ret, init_progress = *(const int *)opaque.c;
 
