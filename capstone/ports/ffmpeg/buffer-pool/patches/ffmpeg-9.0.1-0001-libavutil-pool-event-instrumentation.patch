     if (!pool)
         return NULL;
@@ -271,17 +273,21 @@
 
     pool->size      = size;
     pool->opaque    = opaque;
+    if (alloc || pool_free) ff2_fail(125);
     pool->alloc2    = alloc;
     pool->alloc     = av_buffer_alloc; // fallback
     pool->pool_free = pool_free;
 
     atomic_init(&pool->refcount, 1);
 
+    uint64_t call = ff2_begin(FF2_CREATE, FF2_BUFFER, NULL, size, pool->alloc == av_buffer_allocz, NULL);
+    ff2_end(call, pool);
