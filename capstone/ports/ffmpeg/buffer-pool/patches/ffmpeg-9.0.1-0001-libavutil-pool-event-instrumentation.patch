+    if (alloc && alloc != av_buffer_alloc && alloc != av_buffer_allocz) ff2_fail(126);
     pool->alloc    = alloc ? alloc : av_buffer_alloc;
 
     atomic_init(&pool->refcount, 1);
 
+    uint64_t call = ff2_begin(FF2_CREATE, FF2_BUFFER, NULL, size, pool->alloc == av_buffer_allocz, NULL);
+    ff2_end(call, pool);
