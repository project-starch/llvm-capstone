+    uint64_t call = ff2_callback(FF2_REFSTRUCT, pool, entry, FF2_RESET_CB);
     pool->reset_cb(pool->opaque, entry);
+    ff2_end(call, NULL);
 }
 
 static int refstruct_pool_get_ext(void *datap, AVRefStructPool *pool)
 {
+    FF2_GUARD;
+    uint64_t call = ff2_begin(FF2_GET, FF2_REFSTRUCT, pool, 0, 0, NULL);
     void *ret = NULL;
 
     memcpy(datap, &(void *){ NULL }, sizeof(void*));
@@ -272,8 +300,12 @@
             return AVERROR(ENOMEM);
         ref = get_refcount(ret);
