diff --git a/libavutil/refstruct.c b/libavutil/refstruct.c
--- a/libavutil/refstruct.c
+++ b/libavutil/refstruct.c
@@ -28,6 +28,7 @@
 #include "mem.h"
 #include "mem_internal.h"
 #include "thread.h"
+#include "trace.h"
 
 #ifndef REFSTRUCT_CHECKED
 #ifndef ASSERT_LEVEL
@@ -117,8 +118,11 @@
     return obj;
 }
 
+static uint64_t ff2_unref_begin(RefCount *ref, void *obj);
+
 void av_refstruct_unref(void *objp)
 {
+    FF2_GUARD;
     void *obj;
     RefCount *ref;
 
@@ -129,9 +133,11 @@
 
     ref = get_refcount(obj);
     if (atomic_fetch_sub_explicit(&ref->refcount, 1, memory_order_acq_rel) == 1) {
+        uint64_t call = ff2_unref_begin(ref, obj);
         if (ref->free_cb)
             ref->free_cb(ref->opaque, obj);
         ref->free(ref);
+        if (call) ff2_end(call, NULL);
     }
 
     return;
@@ -205,18 +211,36 @@
     AVMutex mutex;
 };
 
+static void pool_return_entry(void *ref);
+static void pool_unref(void *ref);
+static uint64_t ff2_unref_begin(RefCount *ref, void *obj)
+{
+    if (ref->free == pool_return_entry)
+        return ff2_begin(FF2_RETURN, FF2_REFSTRUCT, ref->opaque.nc, 0, 0, obj);
+    if (ref->free == pool_unref)
+        return ff2_begin(FF2_CLOSE, FF2_REFSTRUCT, obj, 0, 0, NULL);
+    return 0;
+}
+
 static void pool_free(AVRefStructPool *pool)
 {
     ff_mutex_destroy(&pool->mutex);
-    if (pool->free_cb)
+    if (pool->free_cb) {
+        uint64_t call = ff2_callback(FF2_REFSTRUCT, pool, NULL, FF2_FREE_POOL_CB);
         pool->free_cb(pool->opaque);
+        ff2_end(call, NULL);
+    }
     av_free(get_refcount(pool));
 }
 
 static void pool_free_entry(AVRefStructPool *pool, RefCount *ref)
 {
-    if (pool->free_entry_cb)
+    if (pool->free_entry_cb) {
+        uint64_t call = ff2_callback(FF2_REFSTRUCT, pool, get_userdata(ref), FF2_FREE_ENTRY_CB);
         pool->free_entry_cb(pool->opaque, get_userdata(ref));
+        ff2_end(call, NULL);
+    }
+    ff2_drop(FF2_REFSTRUCT, pool, get_userdata(ref));
     av_free(ref);
 }
 
@@ -244,11 +268,15 @@
 {
