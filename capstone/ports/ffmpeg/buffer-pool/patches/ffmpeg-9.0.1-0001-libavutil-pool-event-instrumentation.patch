     buf->opaque = ret->buffer->opaque;
     buf->free   = ret->buffer->free;
@@ -389,6 +406,8 @@
 
 AVBufferRef *av_buffer_pool_get(AVBufferPool *pool)
 {
+    FF2_GUARD;
+    uint64_t call = ff2_begin(FF2_GET, FF2_BUFFER, pool, 0, 0, NULL);
