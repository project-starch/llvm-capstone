set(CMAKE_SYSTEM_NAME FreeBSD)
set(CMAKE_SYSTEM_PROCESSOR riscv64)
if(NOT DEFINED CHERI_SDK OR NOT DEFINED CHERI_SYSROOT)
  message(FATAL_ERROR "Set CHERI_SDK and CHERI_SYSROOT to a matched installed purecap SDK/rootfs")
endif()
set(CMAKE_C_COMPILER "${CHERI_SDK}/bin/clang")
set(CMAKE_C_COMPILER_TARGET riscv64-unknown-freebsd13)
set(CMAKE_SYSROOT "${CHERI_SYSROOT}")
set(CMAKE_C_FLAGS_INIT "-march=rv64imafdcxcheri -mabi=l64pc128d -mno-relax -B${CHERI_SDK}/bin")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_TRY_COMPILE_PLATFORM_VARIABLES CHERI_SDK CHERI_SYSROOT)
set(FFPOOL_CHERI ON CACHE BOOL "CHERI spatial arena backend")
set(FFPOOL_BUILD_DECODERS OFF CACHE BOOL "Decode recordings on the host")
set(BUILD_TESTING OFF CACHE BOOL "Run target binaries through the explicit QEMU runner")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
