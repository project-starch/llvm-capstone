+/* Noninteractive background children need status storage even without the
+ * interactive job-control table. Foreground wait-any may reap them first. */
+struct spawn_background {
+	struct spawn_background *next;
+	pid_t pid;
+	int done, status;
+};
+static struct spawn_background *spawn_backgrounds;
+
+static void spawn_register_background(pid_t pid)
+{
+	struct spawn_background *child = xzalloc(sizeof(*child));
+	child->pid = pid;
+	child->next = spawn_backgrounds;
+	spawn_backgrounds = child;
+}
+
+static void spawn_remember_wait(pid_t pid, int status)
+{
+	struct spawn_background *child;
+	for (child = spawn_backgrounds; child; child = child->next) {
+		if (child->pid == pid) {
+			child->status = status;
+			child->done = 1;
+			return;
+		}
+	}
+}
+
+static int spawn_wait_background(pid_t wanted)
+{
+	struct spawn_background **link = &spawn_backgrounds;
+	struct spawn_background *child;
+	int status;
+	pid_t result;
+	while ((child = *link) != NULL) {
+		if (child->pid == wanted) {
+			if (child->done) {
+				status = child->status;
+				goto collected;
+			}
+			break;
+		}
+		link = &child->next;
+	}
+	do {
+		result = waitpid(wanted, &status, 0);
+	} while (result < 0 && errno == EINTR);
+	if (result < 0) {
+		if (child) {
+			*link = child->next;
+			free(child);
+		}
+		return 127;
+	}
+ collected:
+	if (child) {
+		*link = child->next;
+		free(child);
+	}
+	return WIFSIGNALED(status) ? 128 | WTERMSIG(status) : WEXITSTATUS(status);
+}
 
