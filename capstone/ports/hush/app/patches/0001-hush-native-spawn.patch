+/* Unlike a fork child, the spawning shell retains its descriptors. Normalize
+ * pipe descriptors before temporarily redirecting this single-threaded shell. */
+static void spawn_pipe(int fds[2])
+{
+	int i;
+	xpipe(fds);
+	for (i = 0; i < 2; i++) {
+		if (fds[i] < 3) {
+			int n = fcntl(fds[i], F_DUPFD_CLOEXEC, 3);
+			if (n < 0)
+				bb_simple_perror_msg_and_die("pipe descriptor");
+			close(fds[i]);
+			fds[i] = n;
+		} else {
+			close_on_exec_on(fds[i]);
+		}
+	}
+}
+
+static void spawn_pair(struct fd_pair *pair)
+{
+	int fds[2];
+	spawn_pipe(fds);
+	pair->rd = fds[0];
+	pair->wr = fds[1];
+}
+
+static void spawn_action(int error)
+{
