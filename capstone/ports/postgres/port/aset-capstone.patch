# Two lines that a 16-byte pointer forces on aset.c, and the allocator says so
# itself: StaticAssertDecl(sizeof(AllocFreeListLink) <= (1 << ALLOC_MINBITS)).
# The free list of a size class lives inside the freed chunk, so the smallest
# chunk has to hold a capability. Raising the minimum to 16 doubles the ladder,
# so one size class comes off to keep its top at the 8 KiB chunk limit, which a
# second assertion checks.
#
# This is not Sublet's change and it is not a workaround: any machine whose
# pointers are 16 bytes needs it, and it is the metadata-in-freed-memory class
# that A7 counts. The consequence is real and belongs in the measurement: the
# size classes on a capability machine are 16 to 8192, not 8 to 8192, so the
# sequence of blocks differs from the x86 run and the host gate's exact block
# count does not carry over.
--- aset.c
+++ aset.c
@@ -80,8 +80,10 @@
  *--------------------
  */
 
-#define ALLOC_MINBITS		3	/* smallest chunk size is 8 bytes */
-#define ALLOCSET_NUM_FREELISTS	11
+#define ALLOC_MINBITS		4		/* a capability is 16 bytes, and the free list
+								 * link lives in the freed chunk */
+#define ALLOCSET_NUM_FREELISTS	10	/* one class fewer, because the ladder
+								 * starts at 16 and must still end at 8192 */
 #define ALLOC_CHUNK_LIMIT	(1 << (ALLOCSET_NUM_FREELISTS-1+ALLOC_MINBITS))
 /* Size of largest chunk that we use a fixed size for */
 #define ALLOC_CHUNK_FRACTION	4
