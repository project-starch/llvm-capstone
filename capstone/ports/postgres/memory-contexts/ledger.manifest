# PostgreSQL adaptation inventory: path, bucket, purpose.
# The allocator patch is postgresql-17.0-0003-memory-contexts-sublet-lifetimes.patch.
# ABI patches are separate from the Sublet allocator delta.
examples/client.h                                                     test       common allocator-client interface
examples/allocset.c                                                   test       variable-size buffer and current-context client
examples/generation.c                                                 test       FIFO batch client
examples/slab.c                                                       test       fixed-size job table client
examples/bump.c                                                       test       per-request bulk scratch client
examples/support/native.c                                             test       native client entry point
src/shared/a11trace.h                                                   glue       the record format, shared with the recorder in the paper repository
src/native/replay/printf.c                                              compat     the formatting the manager calls
src/shared/postgres-compat.c                                            compat     backend error reporting and process-state compatibility
src/native/replay/main.c                                                test       the replay driver
src/cheribsd/main.c                                                     test       the replay driver on the capability platforms
examples/contexts.c                                                   test       the link example the shared CheriBSD harness runs
src/shared/replay-engine.c                                              test       shared trace dispatch and payload checks
src/shared/replay-engine.h                                              test       replay interface
patches/postgresql-17.0-0001-allocset-capstone-size-classes.patch       compat     capability ABI alignment and minimum size class
patches/postgresql-17.0-0002-memorychunk-capstone-alignment.patch       compat     capability ABI chunk header
patches/postgresql-17.0-0003-memory-contexts-sublet-lifetimes.patch     allocator  chunks as child lifetimes of their blocks (CDERIVE/CREVOKE)
tests/contexts-workload.h                                              test       common upstream and protected policy and payload workload
tests/contexts-native.c                                                test       native upstream context workload entry
