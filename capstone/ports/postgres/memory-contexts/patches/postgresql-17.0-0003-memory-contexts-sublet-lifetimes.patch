+	SubletBlockAdd(block, block, block->endptr);
 
 	/* Mark unallocated space NOACCESS. */
 	VALGRIND_MAKE_MEM_NOACCESS(block->freeptr,
@@ -1106,6 +1117,7 @@ AllocSetFree(void *pointer)
 #ifdef CLOBBER_FREED_MEMORY
 		wipe_mem(block, block->freeptr - ((char *) block));
 #endif
+		SubletBlockForget(block);
 		free(block);
 	}
 	else
@@ -1225,13 +1237,21 @@ AllocSetRealloc(void *pointer, Size size, int flags)
 		blksize = chksize + ALLOC_BLOCKHDRSZ + ALLOC_CHUNKHDRSZ;
 		oldblksize = block->endptr - ((char *) block);
 
-		block = (AllocBlock) realloc(block, blksize);
-		if (block == NULL)
+		SubletBlockForget(block);
 		{
-			/* Disallow access to the chunk header. */
-			VALGRIND_MAKE_MEM_NOACCESS(chunk, ALLOC_CHUNKHDRSZ);
-			return MemoryContextAllocationFailure(&set->header, size, flags);
+			AllocBlock	oldblock = block;
