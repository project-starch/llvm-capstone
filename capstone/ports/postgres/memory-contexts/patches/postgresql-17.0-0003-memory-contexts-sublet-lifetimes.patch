diff --git a/src/backend/utils/mmgr/sublet.c b/src/backend/utils/mmgr/sublet.c
new file mode 100644
--- /dev/null
+++ b/src/backend/utils/mmgr/sublet.c
@@ -0,0 +1,169 @@
+/*-------------------------------------------------------------------------
+ *
+ * sublet.c
+ *	  Sublet lifetimes for memory-context chunks (CDERIVE / CREVOKE).
+ *
+ * A caller's pointer is bounded to its chunk, so the allocator cannot reach
+ * the chunk's header or block through it. The blocks are kept here by
+ * address: a sorted table, searched on every pfree and repalloc. Each block
+ * has two derived lifetimes below its malloc'd object: life, which carries
+ * MANAGE, and the current generation below it, from which every chunk is
+ * derived.
+ *
+ * src/backend/utils/mmgr/sublet.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include <capstone/capability.h>
+
+#include "utils/memutils_sublet.h"
+
+typedef struct SubletBlock
+{
+	uintptr_t	base;			/* the block's first byte */
+	uintptr_t	end;			/* one past its last */
+	char	   *inside;			/* the allocator's pointer at base */
+	uintptr_t	alloc;			/* where its malloc'd object starts */
+	void	   *life;			/* the block's lifetime, with MANAGE */
+	void	   *generation;		/* the chunks' parent */
+} SubletBlock;
+
+static SubletBlock *blocks;
+static size_t nblocks;
+static size_t maxblocks;
+
+static uintptr_t
+cap_base(const void *p)
+{
+	capstone_cap_slot slot;
+
+	capstone_cap_store(&slot, (void *) p);
+	return capstone_cap_base(&slot);
+}
+
+/* The first entry whose base lies above a. */
+static size_t
+upper(uintptr_t a)
+{
+	size_t		lo = 0,
+				hi = nblocks;
+
+	while (lo < hi)
+	{
+		size_t		mid = (lo + hi) / 2;
+
+		if (blocks[mid].base <= a)
+			lo = mid + 1;
+		else
+			hi = mid;
+	}
+	return lo;
+}
+
+static SubletBlock *
+find(uintptr_t a)
+{
+	size_t		i = upper(a);
+
+	if (i == 0 || a >= blocks[i - 1].end)
+		return NULL;
+	return &blocks[i - 1];
+}
+
+void
+SubletBlockAdd(void *alloc, void *block, void *end)
+{
+	uintptr_t	base = (uintptr_t) block;
+	size_t		i;
+	SubletBlock *b;
+
+	if (nblocks == maxblocks)
+	{
+		size_t		n = maxblocks ? maxblocks * 2 : 64;
+		SubletBlock *grown = realloc(blocks, n * sizeof(SubletBlock));
+
+		if (grown == NULL)
+			elog(FATAL, "out of memory for the Sublet block table");
+		blocks = grown;
+		maxblocks = n;
+	}
+	i = upper(base);
+	memmove(&blocks[i + 1], &blocks[i], (nblocks - i) * sizeof(SubletBlock));
+	nblocks++;
+	b = &blocks[i];
+	b->base = base;
+	b->end = (uintptr_t) end;
+	b->inside = block;
+	b->alloc = (uintptr_t) alloc;
+	b->life = capstone_cap_derive(alloc, base - (uintptr_t) alloc, b->end - base);
+	b->generation = capstone_cap_derive(b->life, 0, b->end - base);
+}
+
+void
+SubletBlockForget(void *block)
+{
+	SubletBlock *b = find((uintptr_t) block);
+	size_t		i;
+
+	if (b == NULL || b->base != (uintptr_t) block)
+		elog(PANIC, "Sublet block %p is not registered", block);
+	i = b - blocks;
+	memmove(&blocks[i], &blocks[i + 1], (nblocks - i - 1) * sizeof(SubletBlock));
+	nblocks--;
+}
+
+void
+SubletBlockRenew(void *block)
+{
+	SubletBlock *b = find((uintptr_t) block);
+
+	if (b == NULL || b->base != (uintptr_t) block)
+		elog(PANIC, "Sublet block %p is not registered", block);
+	capstone_cap_revoke_child(b->life, b->generation);
+	b->generation = capstone_cap_derive(b->life, 0, b->end - b->base);
+}
+
+/* A pointer spanning the whole malloc'd object is the allocator's own. */
+static bool
+is_inside(const void *p, const SubletBlock *b)
+{
+	return cap_base(p) == b->alloc;
+}
+
+void *
+SubletIssue(void *p, Size size)
+{
+	SubletBlock *b;
+
+	if (p == NULL)
+		return NULL;
+	b = find((uintptr_t) p);
+	if (b == NULL || !is_inside(p, b))
+		return p;
+	return capstone_cap_derive(b->generation, (uintptr_t) p - b->base,
+							   size ? size : 1);
+}
+
+void *
+SubletRelease(void *p)
+{
+	SubletBlock *b = find((uintptr_t) p);
+
+	if (b == NULL || is_inside(p, b))
+		return p;
+	/* Faults on a pointer that is not a live chunk of this block. */
+	capstone_cap_revoke_child(b->generation, p);
+	return b->inside + ((uintptr_t) p - b->base);
+}
+
+void *
+SubletInside(const void *p)
+{
+	SubletBlock *b = find((uintptr_t) p);
+
+	if (b == NULL)
+		return (void *) p;
+	return b->inside + ((uintptr_t) p - b->base);
+}
