+#define SUBLET_LEAF_SHIFT	21	/* one leaf maps 2 MiB */
+#define SUBLET_LEAF_PAGES	(1 << (SUBLET_LEAF_SHIFT - SUBLET_PAGE_SHIFT))
+#define SUBLET_LEAVES		1024	/* 2 GiB of distinct 2 MiB regions */
+#define SUBLET_BLOCKS		32768	/* live blocks, entry 0 unused */
