+	for (page = (start >> SUBLET_PAGE_SHIFT) + 1;
+		 page <= (sublet_blocks[id].end - 1) >> SUBLET_PAGE_SHIFT; page++)
+		SubletPageOf(page << SUBLET_PAGE_SHIFT)->cover = 0;
+	sublet_blocks[id].allocation = NULL;
+	sublet_blocks[id].generation = NULL;
+	sublet_blocks[id].next = sublet_blocks_free;
+	sublet_blocks_free = id;
