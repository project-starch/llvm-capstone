@@ -263,4 +271,48 @@ MemoryChunkGetBlock(MemoryChunk *chunk)
 #undef HdrMaskBlockOffset
 #undef HdrMaskCheckMagic
 
+/*
+ * Sublet lifetimes.  Every block has a lifetime derived from its malloc'd
+ * object and a generation below that; the chunks are children of the
+ * generation.  Freeing the block revokes all of them; a reset that keeps the
+ * block revokes the generation and derives a new one.
+ */
+typedef struct SubletBlock
+{
+	void	   *life;
+	void	   *generation;
+} SubletBlock;
+
+/* The block [start, start + size) inside the malloc'd object alloc. */
+static inline void
+SubletBlockInit(SubletBlock *b, void *alloc, void *start, Size size)
+{
+	b->life = capstone_cap_derive(alloc, (char *) start - (char *) alloc, size);
+	b->generation = capstone_cap_derive(b->life, 0, size);
+}
+
+static inline void
+SubletBlockRenew(SubletBlock *b, Size size)
+{
+	capstone_cap_revoke_child(b->life, b->generation);
+	b->generation = capstone_cap_derive(b->life, 0, size);
+}
+
+/* The caller's pointer to [p, p + size), a child of parent. */
+static inline void *
+SubletDerive(void *parent, void *p, Size size)
+{
+	return capstone_cap_derive(parent, (uintptr_t) p -
+							   __builtin_capstone_cap_get_base(parent), size);
+}
+
+/* The caller's pointer to chunk: its header and size bytes, a child of parent. */
+static inline void *
+MemoryChunkIssue(MemoryChunk *chunk, void *parent, Size size)
+{
+	chunk->sublet_parent = parent;
+	return (char *) SubletDerive(parent, chunk, sizeof(MemoryChunk) + size) +
+		sizeof(MemoryChunk);
+}
+
 #endif							/* MEMUTILS_MEMORYCHUNK_H */
