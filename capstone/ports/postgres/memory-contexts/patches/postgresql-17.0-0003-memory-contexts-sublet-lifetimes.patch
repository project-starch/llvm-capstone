diff --git a/src/backend/utils/mmgr/mcxt.c b/src/backend/utils/mmgr/mcxt.c
index b42ecec..c091742 100644
--- a/src/backend/utils/mmgr/mcxt.c
+++ b/src/backend/utils/mmgr/mcxt.c
@@ -232,6 +232,65 @@ GetMemoryChunkHeader(const void *pointer)
 	return header;
 }
 
+/*
+ * Sublet: the managers hand out every chunk as a child of its block's
+ * generation, covering the chunk header, and keep that parent in the header
+ * (MemoryChunkIssue).  An aligned redirect chunk is a view of an ordinary one
+ * and is passed through.
+ */
+
+/* Q-15's over-approximation (memutils_memorychunk.h), one line at exit. */
+unsigned long sublet_q15_chunks, sublet_q15_padded, sublet_q15_pad_total, sublet_q15_pad_max;
+
+static void __attribute__((destructor))
+SubletQ15Report(void)
+{
+	fprintf(stderr, "Q15_PAD chunks=%lu padded=%lu pad_bytes_total=%lu pad_bytes_max=%lu\n",
+			sublet_q15_chunks, sublet_q15_padded, sublet_q15_pad_total, sublet_q15_pad_max);
+}
+
+/* The allocator's pointer at pointer's address, derived from the parent. */
+static void *
+SubletInside(void *pointer)
+{
+	void	   *parent;
+
+	if (GetMemoryChunkMethodID(pointer) == MCTX_ALIGNED_REDIRECT_ID)
+		return pointer;
+	parent = PointerGetMemoryChunk(pointer)->sublet_parent;
+	return (char *) parent +
+		((uintptr_t) pointer - __builtin_capstone_cap_get_base(parent));
+}
+
+/* End the caller's chunk (CREVOKE); faults on a pointer that is not live. */
+static pg_noinline void *
+SubletRelease(void *pointer)
+{
+	MemoryChunk *chunk = PointerGetMemoryChunk(pointer);
+	void	   *inside;
+
+	if (GetMemoryChunkMethodID(pointer) == MCTX_ALIGNED_REDIRECT_ID)
+		return pointer;
+	inside = SubletInside(pointer);
+	capstone_cap_revoke_child(chunk->sublet_parent, chunk);
+	return inside;
+}
+
+/* A chunk realloc kept in place comes back as the allocator's pointer. */
+static void *
+SubletReissue(void *pointer, Size size)
+{
+	MemoryChunk *chunk;
+
+	if (pointer == NULL ||
+		GetMemoryChunkMethodID(pointer) == MCTX_ALIGNED_REDIRECT_ID)
+		return pointer;
+	chunk = PointerGetMemoryChunk(pointer);
+	if (__builtin_capstone_cap_get_base(pointer) == (uintptr_t) chunk)
+		return pointer;			/* moved: the manager issued the new chunk */
+	return MemoryChunkIssue(chunk, chunk->sublet_parent, size);
+}
+
 /*
  * MemoryContextTraverseNext
  *		Helper function to traverse all descendants of a memory context
@@ -706,6 +765,7 @@ MemoryContextAllowInCriticalSection(MemoryContext context, bool allow)
 MemoryContext
 GetMemoryChunkContext(void *pointer)
 {
+	pointer = SubletInside(pointer);
 	return MCXT_METHOD(pointer, get_chunk_context) (pointer);
 }
 
@@ -720,6 +780,7 @@ GetMemoryChunkContext(void *pointer)
 Size
 GetMemoryChunkSpace(void *pointer)
 {
+	pointer = SubletInside(pointer);
 	return MCXT_METHOD(pointer, get_chunk_space) (pointer);
 }
 
@@ -1524,6 +1585,7 @@ pfree(void *pointer)
 	MemoryContext context = GetMemoryChunkContext(pointer);
 #endif
 
+	pointer = SubletRelease(pointer);
 	MCXT_METHOD(pointer, free_p) (pointer);
 
 #ifdef USE_VALGRIND
@@ -1562,7 +1624,8 @@ repalloc(void *pointer, Size size)
 	 * this call, consider making it the responsibility of the 'realloc'
 	 * function instead.
 	 */
-	ret = MCXT_METHOD(pointer, realloc) (pointer, size, 0);
+	pointer = SubletRelease(pointer);
+	ret = SubletReissue(MCXT_METHOD(pointer, realloc) (pointer, size, 0), size);
 
 #ifdef USE_VALGRIND
 	if (method != MCTX_ALIGNED_REDIRECT_ID)
@@ -1600,7 +1663,9 @@ repalloc_extended(void *pointer, Size size, int flags)
 	 * this call, consider making it the responsibility of the 'realloc'
 	 * function instead.
 	 */
-	ret = MCXT_METHOD(pointer, realloc) (pointer, size, flags);
+	/* A NO_OOM failure returns NULL with the old chunk already ended. */
+	pointer = SubletRelease(pointer);
+	ret = SubletReissue(MCXT_METHOD(pointer, realloc) (pointer, size, flags), size);
 	if (unlikely(ret == NULL))
 		return NULL;
 
