diff --git a/src/backend/utils/mmgr/mcxt.c b/src/backend/utils/mmgr/mcxt.c
--- a/src/backend/utils/mmgr/mcxt.c
+++ b/src/backend/utils/mmgr/mcxt.c
@@ -233,6 +233,40 @@
 }
 
 /*
+ * Sublet: the managers hand out every chunk as a child of its block's
+ * generation, covering the chunk header, and keep that parent in the header
+ * (MemoryChunkIssue).  An aligned redirect chunk is a view of an ordinary one
+ * and is passed through.
+ */
+
+/* The allocator's pointer at pointer's address, derived from the parent. */
+static void *
+SubletInside(void *pointer)
+{
+	void	   *parent;
+
+	if (GetMemoryChunkMethodID(pointer) == MCTX_ALIGNED_REDIRECT_ID)
+		return pointer;
+	parent = PointerGetMemoryChunk(pointer)->sublet_parent;
+	return (char *) parent +
+		((uintptr_t) pointer - __builtin_capstone_cap_get_cursor(parent));
+}
+
+/* End the caller's chunk (CREVOKE); faults on a pointer that is not live. */
+static pg_noinline void *
+SubletRelease(void *pointer)
+{
+	MemoryChunk *chunk = PointerGetMemoryChunk(pointer);
+	void	   *inside;
+
+	if (GetMemoryChunkMethodID(pointer) == MCTX_ALIGNED_REDIRECT_ID)
+		return pointer;
+	inside = SubletInside(pointer);
+	capstone_cap_release(chunk);
+	return inside;
+}
+
+/*
  * MemoryContextTraverseNext
  *		Helper function to traverse all descendants of a memory context
  *		without recursion.
@@ -706,6 +740,7 @@
 MemoryContext
 GetMemoryChunkContext(void *pointer)
 {
+	pointer = SubletInside(pointer);
 	return MCXT_METHOD(pointer, get_chunk_context) (pointer);
 }
 
@@ -720,6 +755,7 @@
 Size
 GetMemoryChunkSpace(void *pointer)
 {
+	pointer = SubletInside(pointer);
 	return MCXT_METHOD(pointer, get_chunk_space) (pointer);
 }
 
@@ -1524,6 +1560,7 @@
