 #undef HdrMaskBlockOffset
 #undef HdrMaskCheckMagic
 
+/*
+ * Sublet lifetimes.  Every block has a lifetime derived from its malloc'd
+ * object and a generation below that; the chunks are children of the
+ * generation.  Freeing the block revokes all of them; a reset that keeps the
+ * block revokes the generation and derives a new one.
+ */
+typedef struct SubletBlock
+{
+	void	   *life;
+	void	   *generation;
+	void	   *raw;			/* what malloc returned: free() and realloc() take this */
+} SubletBlock;
+
+/* The block [start, start + size) inside the malloc'd object alloc. */
+static inline void
+SubletBlockInit(SubletBlock *b, void *alloc, void *start, Size size)
+{
+	b->raw = alloc;
+	b->life = capstone_cap_derive(alloc, (char *) start - (char *) alloc, size);
+	b->generation = capstone_cap_derive(b->life, 0, size);
+}
+
+static inline void
+SubletBlockRenew(SubletBlock *b, Size size)
+{
+	capstone_cap_revoke_child(b->life, b->generation);
+	b->generation = capstone_cap_derive(b->life, 0, size);
+}
+
+/* The caller's pointer to [p, p + size), a child of parent. */
+static inline void *
+SubletDerive(void *parent, void *p, Size size)
+{
+	return capstone_cap_derive(parent, (uintptr_t) p -
+							   __builtin_capstone_cap_get_base(parent), size);
+}
+
+/*
+ * Q-15: on the compact bounds format (vp2, and capstone-qemu without exact
+ * bounds) CDERIVE refuses (29) a child it cannot hold exactly; from 4 KiB up
+ * its base and length must be multiples of the granule 2^(msb(len)-9)
+ * (capstone/representable.h).  A child is padded at its TAIL only: its base
+ * never moves below the chunk, so the block header and a neighbour stay out of
+ * the caller's reach.  Chunks inside ordinary blocks are already representable
+ * (at most 8 KiB, 16-byte multiples); a dedicated block for one large chunk is
+ * PLACED instead: malloc SubletLargeMallocSize() bytes and put the block where
+ * SubletLargePlace() says, so that the chunk after the block header starts on
+ * its granule.  The counts are the over-approximation, reported at exit by
+ * mcxt.c.
+ */
+extern unsigned long sublet_q15_chunks, sublet_q15_padded,
+			sublet_q15_pad_total, sublet_q15_pad_max;
+
+/* The malloc size for a dedicated block: hdr bytes of block header, then a chunk of clen bytes. */
+static inline Size
+SubletLargeMallocSize(Size hdr, Size clen)
+{
+	Size		cr = capstone_repr_round(clen);
+	Size		lmax = capstone_repr_round(hdr + capstone_repr_granule(cr) + cr);
+
+	return lmax + capstone_repr_granule(lmax);
+}
+
+/*
+ * Inside raw (SubletLargeMallocSize(hdr, clen) bytes from malloc): the block
+ * address, and the representable region [*start, *start + *len) its lifetimes
+ * cover.  The chunk at block + hdr starts on the granule of its rounded length.
+ */
+static inline void *
+SubletLargePlace(void *raw, Size hdr, Size clen, char **start, Size *len)
+{
+	Size		cr = capstone_repr_round(clen);
+	Size		gc = capstone_repr_granule(cr);
+	Size		gr = capstone_repr_granule(capstone_repr_round(hdr + gc + cr));
+	uintptr_t	r = (uintptr_t) raw;
+	uintptr_t	a = (r + gr - 1) & ~(uintptr_t) (gr - 1);
+	uintptr_t	chunk = (a + hdr + gc - 1) & ~(uintptr_t) (gc - 1);
+
+	*start = (char *) raw + (a - r);
+	*len = capstone_repr_round(chunk + cr - a);
+	return (char *) raw + (chunk - hdr - r);
+}
+
+/* A representable child length for len bytes: the tail pad, counted. */
+static inline Size
+SubletPadded(Size len)
+{
+	Size		r = capstone_repr_round(len);
+
+	sublet_q15_chunks++;
+	if (r != len)
+	{
+		sublet_q15_padded++;
+		sublet_q15_pad_total += r - len;
+		if (r - len > sublet_q15_pad_max)
+			sublet_q15_pad_max = r - len;
+	}
+	return r;
+}
+
+/*
+ * The caller's pointer to chunk: its header and MAXALIGN(size) bytes, a child
+ * of parent.  MAXALIGN and not size: PostgreSQL's own code reads whole
+ * aligned words past a string's terminator (fasthash_accum_cstring_aligned).
+ */
+static inline void *
+MemoryChunkIssue(MemoryChunk *chunk, void *parent, Size size)
+{
+	chunk->sublet_parent = parent;
+	return (char *) SubletDerive(parent, chunk,
+								 SubletPadded(sizeof(MemoryChunk) + MAXALIGN(size))) +
+		sizeof(MemoryChunk);
+}
+
 #endif							/* MEMUTILS_MEMORYCHUNK_H */
