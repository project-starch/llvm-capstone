+
+/* Keep the malloc reference for allocator accesses. Derive lazily so reset
+ * needs no new table slot and cannot fail halfway through reclaiming a block. */
+static inline void
+SubletBlockInit(SubletBlock *b, void *alloc, void *start, Size size)
+{
+	b->allocation = (char *) alloc + ((char *) start - (char *) alloc);
+	b->size = size;
+	b->generation = NULL;
+}
 
+static inline void
+SubletBlockRenew(SubletBlock *b)
+{
+	if (b->generation)
+		capstone_cap_release(b->generation);
+	b->generation = NULL;
+}
+
+/*
+ * The child of parent over the smallest representable range that holds
+ * [p, p + size), with its cursor at p, or NULL.  Below 4 KiB the range is
+ * exact.  Above, the bounds format rounds both edges to a granule, and the
+ * allocator keeps its own placement: the child then also covers the granule
+ * slack around the range.  NULL when that range leaves the parent, or when
+ * CDERIVE finds no free slot in the lifetime table.
+ */
+static inline void *
+SubletDeriveCover(void *parent, void *p, Size size)
+{
+	uintptr_t	start = (uintptr_t) p;
+	uintptr_t	base;
+	Size		len = capstone_repr_round(size);
+	char	   *child;
+
+	for (;;)
+	{
+		base = capstone_repr_base_down(start, len);
+		if (base + len >= start + size)
+			break;
+		len = capstone_repr_round(len + 1);
+	}
+	if (base < __builtin_capstone_cap_get_base(parent) ||
+		base + len > __builtin_capstone_cap_get_end(parent))
+		return NULL;
+	child = capstone_cap_derive(parent,
+		base - __builtin_capstone_cap_get_base(parent), len);
+	if (!child)
+		return NULL;
+	return child + (start - base);
+}
+
+/* Both failures leave the block reusable. Do not retain a new generation
+ * when the first chunk cannot be issued. */
+static inline void *
+SubletDerive(SubletBlock *b, void *p, Size size)
+{
+	bool		fresh = b->generation == NULL;
+	void	   *child;
+
+	if (fresh)
+	{
+		b->generation = SubletDeriveCover(b->allocation, b->allocation, b->size);
+		if (!b->generation)
+			return NULL;
+	}
+	child = SubletDeriveCover(b->generation, p, size);
+	if (!child && fresh)
+		SubletBlockRenew(b);
+	return child;
+}
+
+static inline void *
+MemoryChunkIssue(MemoryChunk *chunk, SubletBlock *b, Size size)
+{
+	void *child = SubletDerive(b, chunk, sizeof(MemoryChunk) + MAXALIGN(size));
+	if (!child)
+		return NULL;
+	chunk->sublet_parent = b->allocation;
+	return (char *) child + sizeof(MemoryChunk);
+}
+
+static inline void *
+MemoryChunkInside(void *pointer)
+{
+	void *parent = PointerGetMemoryChunk(pointer)->sublet_parent;
+	return (char *) parent + ((uintptr_t) pointer -
+		__builtin_capstone_cap_get_cursor(parent));
+}
+
+/* Replace an in-place chunk only after its new reference exists. */
+static inline void *
+MemoryChunkReplace(MemoryChunk *chunk, SubletBlock *b, void *issued,
+				   MemoryContext context, Size size, int flags)
+{
+	void *fresh = MemoryChunkIssue(chunk, b, size);
+	if (!fresh)
+		return MemoryContextAllocationFailure(context, size, flags);
+	capstone_cap_release(issued);
+	return fresh;
+}
+
 #endif							/* MEMUTILS_MEMORYCHUNK_H */
