 	 */
+	/*
+	 * Sublet: the block generation this chunk is a child of (CDERIVE).  The
+	 * caller's capability covers this header, so pfree can find the parent
+	 * and revoke the chunk (CREVOKE) with nothing but the pointer.
+	 */
+	void	   *sublet_parent;
 	uint64		capstone_pad;
