+typedef struct SubletBlock
+{
+	void	   *allocation;		/* the block's malloc reference, cursor at
+								 * the block */
+	void	   *generation;		/* parent of the block's chunks, or NULL */
+	uintptr_t	start;			/* the block is [start, end) */
+	uintptr_t	end;
+	uint32		next;			/* next block that starts in the same page */
+} SubletBlock;
