+	SubletBlockAdd(block, block, block->endptr);
 
 	chunk = (MemoryChunk *) (((char *) block) + ALLOC_BLOCKHDRSZ);
 
@@ -929,6 +939,7 @@ AllocSetAllocFromNewBlock(MemoryContext context, Size size, int flags,
