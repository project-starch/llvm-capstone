+/*-------------------------------------------------------------------------
+ *
+ * memutils_sublet.h
+ *	  Sublet lifetimes for memory-context chunks (CDERIVE / CREVOKE).
+ *
+ * Every chunk handed to a caller is a child lifetime of its block, bounded
+ * to the request; pfree revokes it, so every copy of the caller's pointer
+ * dies. The context methods keep working on the allocator's own pointers,
+ * which span the whole malloc'd object: mcxt.c issues on the way out and
+ * revokes on the way back in, and the context types only report their
+ * blocks. A block's lifetime ends with its malloc'd object; a block a reset
+ * keeps gets a fresh generation of chunks instead.
+ *
+ * src/include/utils/memutils_sublet.h
+ *
+ *-------------------------------------------------------------------------
+ */
+#ifndef MEMUTILS_SUBLET_H
+#define MEMUTILS_SUBLET_H
+
+/* The block [block, end) lies in the malloc'd object alloc. */
+extern void SubletBlockAdd(void *alloc, void *block, void *end);
+extern void SubletBlockForget(void *block);
+/* A reset keeps the block: end every chunk handed out from it. */
+extern void SubletBlockRenew(void *block);
+
+/* The caller's chunk of size bytes at the allocator's pointer p. */
+extern void *SubletIssue(void *p, Size size);
+/* End the caller's chunk; the allocator's pointer at the same address. */
+extern void *SubletRelease(void *p);
+/* The allocator's pointer at p's address, without ending anything. */
+extern void *SubletInside(const void *p);
+
+#endif							/* MEMUTILS_SUBLET_H */
