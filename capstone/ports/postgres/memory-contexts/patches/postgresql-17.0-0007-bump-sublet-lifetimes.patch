Subject: [PATCH] Port bump lifetimes to Sublet context pools
Upstream: postgresql 17.0
Upstream-Archive: https://ftp.postgresql.org/pub/source/v17.0/postgresql-17.0.tar.bz2
Upstream-SHA256: 7e276131c0fdd6b62588dbad9b3bb24b8c3498d5009328dba59af16e819109de
Build-Variants: Sublet Capstone replay
Depends-On: postgresql-17.0-0003-memorychunk-sublet-metadata-indices.patch
Apply-From: upstream source root, with patch --batch --forward --fuzz=0 -p1

Preserve allocation policy, keep context/block metadata outside revoked bytes,
and mint allocation authority from the actual block carve. Production-layout
builds only; debug configurations that walk dead chunks are explicitly refused.

diff --git a/src/backend/utils/mmgr/bump.c b/src/backend/utils/mmgr/bump.c
index c60c9c1..ec05356 100644
--- a/src/backend/utils/mmgr/bump.c
+++ b/src/backend/utils/mmgr/bump.c
@@ -39,13 +39,19 @@
 #include "postgres.h"
 
 #include "lib/ilist.h"
+#include "pg_subpool.h"
+
+#if defined(MEMORY_CONTEXT_CHECKING) || defined(CLOBBER_FREED_MEMORY)
+#error "Sublet Bump requires the release-layout manager configuration"
+#endif
 #include "port/pg_bitutils.h"
 #include "utils/memdebug.h"
 #include "utils/memutils.h"
 #include "utils/memutils_memorychunk.h"
 #include "utils/memutils_internal.h"
 
-#define Bump_BLOCKHDRSZ	MAXALIGN(sizeof(BumpBlock))
+#define Bump_BLOCKHDRSZ 64 /* upstream capstone64 block geometry */
+#define Bump_CONTEXTSZ 192 /* upstream capstone64 context geometry */
 
 /* No chunk header unless built with MEMORY_CONTEXT_CHECKING */
 #ifdef MEMORY_CONTEXT_CHECKING
@@ -57,8 +63,7 @@
 #define Bump_CHUNK_FRACTION	8
 
 /* The keeper block is allocated in the same allocation as the set */
-#define KeeperBlock(set) ((BumpBlock *) ((char *) (set) + \
-			MAXALIGN(sizeof(BumpContext))))
+#define KeeperBlock(set) ((set)->keeper)
 #define IsKeeperBlock(set, blk) (KeeperBlock(set) == (blk))
 
 typedef struct BumpBlock BumpBlock; /* forward reference */
@@ -75,6 +80,8 @@ typedef struct BumpContext
 
 	dlist_head	blocks;			/* list of blocks with the block currently
 								 * being filled at the head */
+	pg_subpool *pool;
+	BumpBlock *keeper;
 } BumpContext;
 
 /*
@@ -85,12 +92,13 @@ typedef struct BumpContext
  */
 struct BumpBlock
 {
+	pg_block *backing;
 	dlist_node	node;			/* doubly-linked list of blocks */
 #ifdef MEMORY_CONTEXT_CHECKING
 	BumpContext *context;		/* pointer back to the owning context */
 #endif
-	char	   *freeptr;		/* start of free space in this block */
-	char	   *endptr;			/* end of space in this block */
+	uintptr_t	freeptr;		/* start of free space in this block */
+	uintptr_t	endptr;			/* end of space in this block */
 };
 
 /*
@@ -117,6 +125,22 @@ static inline Size BumpBlockFreeBytes(BumpBlock *block);
 static inline void BumpBlockFree(BumpContext *set, BumpBlock *block);
 
 
+StaticAssertDecl(sizeof(BumpContext) <= PG_HEADER_BYTES, "context header slot");
+StaticAssertDecl(sizeof(BumpBlock) <= sizeof(((pg_block *) 0)->manager), "block sidecar");
+StaticAssertDecl(sizeof(void *) == 16, "Capstone block geometry");
+
+static BumpBlock *
+BumpNewBlock(BumpContext *set, Size bytes)
+{
+	pg_block *b = pg_subpool_managed_block(set->pool, bytes, Bump_BLOCKHDRSZ);
+	BumpBlock *block;
+	if (!b)
+		return NULL;
+	block = (BumpBlock *) b->manager;
+	block->backing = b;
+	return block;
+}
+
 /*
 * BumpContextCreate
 *		Create a new Bump context.
@@ -163,7 +187,7 @@ BumpContextCreate(MemoryContext parent, const char *name, Size minContextSize,
 	Assert(maxBlockSize <= MEMORYCHUNK_MAX_BLOCKOFFSET);
 
 	/* Determine size of initial block */
-	allocSize = MAXALIGN(sizeof(BumpContext)) + Bump_BLOCKHDRSZ +
+	allocSize = Bump_CONTEXTSZ + Bump_BLOCKHDRSZ +
 		Bump_CHUNKHDRSZ;
 	if (minContextSize != 0)
 		allocSize = Max(allocSize, minContextSize);
@@ -174,7 +198,7 @@ BumpContextCreate(MemoryContext parent, const char *name, Size minContextSize,
 	 * Allocate the initial block.  Unlike other bump.c blocks, it starts with
 	 * the context header and its block header follows that.
 	 */
-	set = (BumpContext *) malloc(allocSize);
+	set = (BumpContext *) pg_subpool_header(sizeof(BumpContext));
 	if (set == NULL)
 	{
 		MemoryContextStats(TopMemoryContext);
@@ -189,12 +213,23 @@ BumpContextCreate(MemoryContext parent, const char *name, Size minContextSize,
 	 * Avoid writing code that can fail between here and MemoryContextCreate;
 	 * we'd leak the header and initial block if we ereport in this stretch.
 	 */
+	set->pool = pg_subpool_create();
+	if (!set->pool)
+	{
+		pg_subpool_header_free(set);
+		elog(ERROR, "Sublet context pool exhausted");
+	}
 	dlist_init(&set->blocks);
 
 	/* Fill in the initial block's block header */
-	block = KeeperBlock(set);
-	/* determine the block size and initialize it */
-	firstBlockSize = allocSize - MAXALIGN(sizeof(BumpContext));
+	firstBlockSize = allocSize - Bump_CONTEXTSZ;
+	block = set->keeper = BumpNewBlock(set, firstBlockSize);
+	if (!block)
+	{
+		pg_subpool_destroy(set->pool);
+		pg_subpool_header_free(set);
+		elog(ERROR, "Sublet keeper allocation failed");
+	}
 	BumpBlockInit(set, block, firstBlockSize);
 
 	/* add it to the doubly-linked list of blocks */
@@ -243,31 +278,16 @@ void
 BumpReset(MemoryContext context)
 {
 	BumpContext *set = (BumpContext *) context;
-	dlist_mutable_iter miter;
-
-	Assert(BumpIsValid(set));
-
-#ifdef MEMORY_CONTEXT_CHECKING
-	/* Check for corruption and leaks before freeing */
-	BumpCheck(context);
-#endif
-
-	dlist_foreach_modify(miter, &set->blocks)
-	{
-		BumpBlock  *block = dlist_container(BumpBlock, node, miter.cur);
-
-		if (IsKeeperBlock(set, block))
-			BumpBlockMarkEmpty(block);
-		else
-			BumpBlockFree(set, block);
-	}
-
-	/* Reset block size allocation sequence, too */
+	Size bytes = set->keeper->backing->endptr - set->keeper->backing->base;
+	pg_subpool_reset(set->pool);
+	dlist_init(&set->blocks);
+	set->keeper = BumpNewBlock(set, bytes);
+	if (!set->keeper)
+		elog(ERROR, "Sublet keeper allocation failed");
+	BumpBlockInit(set, set->keeper, bytes);
+	dlist_push_head(&set->blocks, &set->keeper->node);
 	set->nextBlockSize = set->initBlockSize;
-
-	/* Ensure there is only 1 item in the dlist */
-	Assert(!dlist_is_empty(&set->blocks));
-	Assert(!dlist_has_next(&set->blocks, dlist_head_node(&set->blocks)));
+	context->mem_allocated = Bump_CONTEXTSZ + bytes;
 }
 
 /*
@@ -277,10 +297,9 @@ BumpReset(MemoryContext context)
 void
 BumpDelete(MemoryContext context)
 {
-	/* Reset to release all releasable BumpBlocks */
-	BumpReset(context);
-	/* And free the context header and keeper block */
-	free(context);
+	BumpContext *set = (BumpContext *) context;
+	pg_subpool_destroy(set->pool);
+	pg_subpool_header_free(set);
 }
 
 /*
@@ -314,14 +333,22 @@ BumpAllocLarge(MemoryContext context, Size size, int flags)
 	required_size = chunk_size + Bump_CHUNKHDRSZ;
 	blksize = required_size + Bump_BLOCKHDRSZ;
 
-	block = (BumpBlock *) malloc(blksize);
+	block = BumpNewBlock(set, blksize);
 	if (block == NULL)
 		return NULL;
 
 	context->mem_allocated += blksize;
 
 	/* the block is completely full */
-	block->freeptr = block->endptr = ((char *) block) + blksize;
+	unsigned int slot = pg_subpool_carve(block->backing, required_size);
+	if (!slot)
+	{
+		context->mem_allocated -= blksize;
+		pg_subpool_managed_free(block->backing);
+		return MemoryContextAllocationFailure(context, size, flags);
+	}
+	void *allocated = pg_subpool_hand(slot);
+	block->freeptr = block->endptr = block->backing->endptr;
 
 #ifdef MEMORY_CONTEXT_CHECKING
 	/* block with a single (used) chunk */
@@ -359,7 +386,7 @@ BumpAllocLarge(MemoryContext context, Size size, int flags)
 
 	return MemoryChunkGetPointer(chunk);
 #else
-	return (void *) (((char *) block) + Bump_BLOCKHDRSZ);
+	return allocated;
 #endif
 }
 
@@ -369,7 +396,7 @@ BumpAllocLarge(MemoryContext context, Size size, int flags)
  */
 static inline void *
 BumpAllocChunkFromBlock(MemoryContext context, BumpBlock *block, Size size,
-						Size chunk_size)
+						Size chunk_size, int flags)
 {
 #ifdef MEMORY_CONTEXT_CHECKING
 	MemoryChunk *chunk;
@@ -384,7 +411,13 @@ BumpAllocChunkFromBlock(MemoryContext context, BumpBlock *block, Size size,
 #ifdef MEMORY_CONTEXT_CHECKING
 	chunk = (MemoryChunk *) block->freeptr;
 #else
-	ptr = (void *) block->freeptr;
+	/* A zero-byte result is a non-dereferenceable address, consumes no bytes. */
+	if (chunk_size == 0)
+		return (void *) block->freeptr;
+	unsigned int slot = pg_subpool_carve(block->backing, chunk_size);
+	if (!slot)
+		return MemoryContextAllocationFailure(context, size, flags);
+	ptr = pg_subpool_hand(slot);
 #endif
 
 	/* point the freeptr beyond this chunk */
@@ -450,7 +483,7 @@ BumpAllocFromNewBlock(MemoryContext context, Size size, int flags,
 	if (blksize < required_size)
 		blksize = pg_nextpower2_size_t(required_size);
 
-	block = (BumpBlock *) malloc(blksize);
+	block = BumpNewBlock(set, blksize);
 
 	if (block == NULL)
 		return MemoryContextAllocationFailure(context, size, flags);
@@ -463,7 +496,7 @@ BumpAllocFromNewBlock(MemoryContext context, Size size, int flags,
 	/* add it to the doubly-linked list of blocks */
 	dlist_push_head(&set->blocks, &block->node);
 
-	return BumpAllocChunkFromBlock(context, block, size, chunk_size);
+	return BumpAllocChunkFromBlock(context, block, size, chunk_size, flags);
 }
 
 /*
@@ -523,7 +556,7 @@ BumpAlloc(MemoryContext context, Size size, int flags)
 		return BumpAllocFromNewBlock(context, size, flags, chunk_size);
 
 	/* The current block has space, so just allocate chunk there. */
-	return BumpAllocChunkFromBlock(context, block, size, chunk_size);
+	return BumpAllocChunkFromBlock(context, block, size, chunk_size, flags);
 }
 
 /*
@@ -537,8 +570,8 @@ BumpBlockInit(BumpContext *context, BumpBlock *block, Size blksize)
 #ifdef MEMORY_CONTEXT_CHECKING
 	block->context = context;
 #endif
-	block->freeptr = ((char *) block) + Bump_BLOCKHDRSZ;
-	block->endptr = ((char *) block) + blksize;
+	block->freeptr = block->backing->freeptr;
+	block->endptr = block->backing->endptr;
 
 	/* Mark unallocated space NOACCESS. */
 	VALGRIND_MAKE_MEM_NOACCESS(block->freeptr, blksize - Bump_BLOCKHDRSZ);
@@ -552,7 +585,7 @@ static inline bool
 BumpBlockIsEmpty(BumpBlock *block)
 {
 	/* it's empty if the freeptr has not moved */
-	return (block->freeptr == ((char *) block + Bump_BLOCKHDRSZ));
+	return (block->freeptr == block->backing->base + Bump_BLOCKHDRSZ);
 }
 
 /*
@@ -562,19 +595,8 @@ BumpBlockIsEmpty(BumpBlock *block)
 static inline void
 BumpBlockMarkEmpty(BumpBlock *block)
 {
-#if defined(USE_VALGRIND) || defined(CLOBBER_FREED_MEMORY)
-	char	   *datastart = ((char *) block) + Bump_BLOCKHDRSZ;
-#endif
-
-#ifdef CLOBBER_FREED_MEMORY
-	wipe_mem(datastart, block->freeptr - datastart);
-#else
-	/* wipe_mem() would have done this */
-	VALGRIND_MAKE_MEM_NOACCESS(datastart, block->freeptr - datastart);
-#endif
-
-	/* Reset the block, but don't return it to malloc */
-	block->freeptr = ((char *) block) + Bump_BLOCKHDRSZ;
+	pg_subpool_managed_reset(block->backing, Bump_BLOCKHDRSZ);
+	block->freeptr = block->backing->freeptr;
 }
 
 /*
@@ -600,13 +622,13 @@ BumpBlockFree(BumpContext *set, BumpBlock *block)
 	/* release the block from the list of blocks */
 	dlist_delete(&block->node);
 
-	((MemoryContext) set)->mem_allocated -= ((char *) block->endptr - (char *) block);
+	((MemoryContext) set)->mem_allocated -= (block->backing->endptr - block->backing->base);
 
 #ifdef CLOBBER_FREED_MEMORY
-	wipe_mem(block, ((char *) block->endptr - (char *) block));
+	wipe_mem(block, (block->backing->endptr - block->backing->base));
 #endif
 
-	free(block);
+	pg_subpool_managed_free(block->backing);
 }
 
 /*
@@ -701,7 +723,7 @@ BumpStats(MemoryContext context, MemoryStatsPrintFunc printfunc,
 		BumpBlock  *block = dlist_container(BumpBlock, node, iter.cur);
 
 		nblocks++;
-		totalspace += (block->endptr - (char *) block);
+		totalspace += (block->backing->endptr - block->backing->base);
 		freespace += (block->endptr - block->freeptr);
 	}
