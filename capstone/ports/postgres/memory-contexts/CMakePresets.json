{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {"name": "cheribsd", "inherits": "base", "toolchainFile": "${sourceDir}/../../common/cmake/toolchains/cheribsd.cmake", "cacheVariables": {"BUILD_TESTING": false}},
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "/tmp/capstone/postgres-memory-contexts/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "native",
      "inherits": "base",
      "displayName": "Native PostgreSQL manager replay",
      "description": "Host compiler; override the external build directory with -B or CMakeUserPresets.json.",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "capstone-application",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/../../common/cmake/toolchains/capstone-application.cmake",
      "cacheVariables": {
        "BUILD_TESTING": false
      }
    }
  ],
  "buildPresets": [
    {"name": "cheribsd", "configurePreset": "cheribsd", "jobs": 2},
    {
      "name": "native",
      "configurePreset": "native",
      "jobs": 4
    },
    {
      "name": "capstone-application",
      "configurePreset": "capstone-application",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
