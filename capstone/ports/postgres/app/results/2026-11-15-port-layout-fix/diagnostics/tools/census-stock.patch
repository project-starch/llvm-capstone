@@ -51,6 +51,40 @@
 #include "utils/memutils.h"
 #include "utils/memutils_internal.h"
 #include "utils/memutils_memorychunk.h"
+
+#ifdef EXP_REUSE_GAP
+/* Reuse diagnostic (scratch): block census per manager path and context name. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#define EXP_BLK_SLOTS 256
+static struct { const char *path, *name; unsigned long long blocks, bytes; } exp_blk[EXP_BLK_SLOTS];
+static int exp_blk_used, exp_blk_overflow;
+static void exp_blk_report(void)
+{
+	for (int i = 0; i < exp_blk_used; i++)
+		fprintf(stderr, "EXP-BLOCKS path=%s name=%s blocks=%llu bytes=%llu\n", exp_blk[i].path,
+				exp_blk[i].name, exp_blk[i].blocks, exp_blk[i].bytes);
+	fprintf(stderr, "EXP-BLOCKS-END slots=%d overflow=%d\n", exp_blk_used, exp_blk_overflow);
+}
+void exp_blk_count(const char *path, const char *name, size_t bytes)
+{
+	int i;
+	if (!name) name = "?";
+	for (i = 0; i < exp_blk_used; i++)
+		if (exp_blk[i].path == path && strcmp(exp_blk[i].name, name) == 0) break;
+	if (i == exp_blk_used)
+	{
+		if (exp_blk_used == EXP_BLK_SLOTS) { exp_blk_overflow++; return; }
+		if (exp_blk_used == 0) atexit(exp_blk_report);
+		exp_blk[i].path = path;
+		exp_blk[i].name = name;
+		exp_blk_used++;
+	}
+	exp_blk[i].blocks++;
+	exp_blk[i].bytes += bytes;
+}
+#endif
 
