+#ifdef __SIZEOF_INTCAP__
+		/* capstone: hash the value, not the capability's metadata half */
+		uint64		v = (uint64) value;
+
+		result = hash_bytes((unsigned char *) &v, SIZEOF_DATUM);
+#else
 		result = hash_bytes((unsigned char *) &value, sizeof(Datum));
+#endif
+	}
 	else if (typLen > 0)
 		result = hash_bytes((unsigned char *) DatumGetPointer(value), typLen);
 	else if (typLen == -1)
