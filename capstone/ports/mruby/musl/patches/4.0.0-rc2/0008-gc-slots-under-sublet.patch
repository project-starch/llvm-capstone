   RVALUE objects[MRB_HEAP_PAGE_SIZE];
 } mrb_heap_page;
+#else
+/* Capstone: every object slot issued and revoked on its own (Sublet), after
+   docs/design/mruby-gc-sublet-port-plan.md. The slots live in a region the GC
+   holds linearly, carved from the program's region 1; this struct is the page's
+   SIDECAR, from mrb_malloc, and nothing in it lies inside a slot. A free slot is
+   never read or written: its state is obj[i] == NULL, its free-list link is
+   next_free[i], and cap[i] holds its region, linear, until the next take. */
+#include <stdio.h>
+#include <stdlib.h>
+#include "sublet.h"
+#define GCS_NIL 0xFFFFu
+#define GCS_PAGE_BYTES ((unsigned long)MRB_HEAP_PAGE_SIZE * sizeof(RVALUE))
+typedef struct mrb_heap_page {
+  struct mrb_heap_page *next;
+  struct mrb_heap_page *free_next;
+  mrb_bool old:1;
+  mrb_bool region:1;             /* never set: the arm refuses mrb_gc_add_region */
+  uint16_t free_head;            /* first free slot, GCS_NIL when the page is full */
+  unsigned long base;            /* slot 0's address, an integer: heap_p derives nothing */
+  sublet_cap handle;             /* senior to every slot's node */
+  sublet_cap cap[MRB_HEAP_PAGE_SIZE];   /* slot i: region while free, handle while live */
+  RVALUE *obj[MRB_HEAP_PAGE_SIZE];      /* slot i's alias while live, NULL while free */
+  uint16_t next_free[MRB_HEAP_PAGE_SIZE];
+} mrb_heap_page;
+mrb_static_assert(sizeof(RVALUE) % 16 == 0);  /* a Sublet region is whole capabilities */
+mrb_static_assert(MRB_HEAP_PAGE_SIZE <= GCS_NIL);
+
+void *__capstone_region(unsigned index);
+static sublet_cap gcs_grant;     /* what is left of region 1, linear */
+static int gcs_granted;
+static unsigned long gcs_pages, gcs_issued, gcs_released;
+
+/* What the arm spent, for the program to report (the port's domain entry prints
+   it as MRBD-GC): pages carved, slots issued and revoked, and this file's own
+   Sublet primitive counts, which sublet.h keeps per translation unit. */
+void
+mrb_capstone_gc_sublet_stats(unsigned long out[7])
+{
+  out[0] = gcs_pages;
+  out[1] = gcs_issued;
+  out[2] = gcs_released;
+  out[3] = sublet_stats.split;
+  out[4] = sublet_stats.mrev;
+  out[5] = sublet_stats.delin;
+  out[6] = sublet_stats.revoke;
+}
+
+static void
+gcs_take_grant(void)
+{
+  if (gcs_granted) return;
+  void *r = __capstone_region(1);
+  if (r == NULL) {
+    fputs("mruby: MRB_CAPSTONE_GC_SUBLET needs the program's region 1 (the host's second grant)\n", stderr);
+    abort();
+  }
+  sublet_store(&gcs_grant, r);
+  gcs_granted = 1;
+}
+
+/* The page's slots, carved from the grant: a handle senior to the whole region
+   first, then the region split into its slots, each slot's region in cap[i]. */
+static int
+gcs_page_carve(mrb_heap_page *page)
+{
+  gcs_take_grant();
+  unsigned long start = sublet_base(&gcs_grant);
+  if (sublet_end(&gcs_grant) - start < GCS_PAGE_BYTES) return 0;
+  sublet_carve(&gcs_grant, start + GCS_PAGE_BYTES, &page->cap[0]);
+  sublet_handle(&page->cap[0], &page->handle);
+  for (int i = 0; i + 1 < MRB_HEAP_PAGE_SIZE; i++)
+    sublet_split(&page->cap[i], start + (unsigned long)(i + 1) * sizeof(RVALUE), &page->cap[i + 1]);
+  page->base = start;
+  gcs_pages++;
+  return 1;
+}
+
+/* Slot i goes out: its handle stays in cap[i], the GC keeps the alias. */
+static RVALUE*
+gcs_issue(mrb_heap_page *page, uint16_t i)
+{
+  RVALUE *p = (RVALUE*)sublet_take(&page->cap[i]);
+  page->obj[i] = p;
+  gcs_issued++;
+  return p;
+}
+
+/* Slot i comes back: one revoke, after which every copy of its alias is dead,
+   the GC's own included. */
+static void
+gcs_release(mrb_heap_page *page, uint16_t i)
+{
+  page->obj[i] = NULL;
+  sublet_give(&page->cap[i]);
+  gcs_released++;
+  page->next_free[i] = page->free_head;
+  page->free_head = i;
+}
+
+/* The GC's alias of the live object in the slot an address falls in, or NULL
+   when the slot is free: for a caller holding a pointer that may be dead. */
+static mrb_heap_page* gcs_locate(mrb_gc *gc, const void *object, uint16_t *index);
+static struct RBasic*
+gcs_live_alias(mrb_gc *gc, const void *object)
+{
+  uint16_t i;
+  mrb_heap_page *page = gcs_locate(gc, object, &i);
+  return page && page->obj[i] ? &page->obj[i]->as.basic : NULL;
+}
+
+/* The page and slot an address falls in, from integers only. */
+static mrb_heap_page*
+gcs_locate(mrb_gc *gc, const void *object, uint16_t *index)
+{
+  unsigned long addr = (unsigned long)(uintptr_t)object;
+  for (mrb_heap_page *page = gc->heaps; page; page = page->next) {
+    if (addr - page->base < GCS_PAGE_BYTES) {
+      *index = (uint16_t)((addr - page->base) / sizeof(RVALUE));
+      return page;
+    }
+  }
+  return NULL;
+}
+#endif
 
 typedef struct mrb_heap_region {
   struct mrb_heap_region *next;
