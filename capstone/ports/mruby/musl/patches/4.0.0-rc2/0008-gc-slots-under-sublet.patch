+     revoked ones in one heap would measure neither. Refused: no pages added. */
+  (void)mrb; (void)start; (void)size;
+  return 0;
+#else
   mrb_gc *gc = &mrb->gc;
   uint8_t *base = (uint8_t*)start;
   mrb_heap_region *region;
@@ -400,6 +557,7 @@ mrb_gc_add_region(mrb_state *mrb, void *start, size_t size)
