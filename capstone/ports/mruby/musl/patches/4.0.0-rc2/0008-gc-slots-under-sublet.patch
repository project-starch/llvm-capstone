 static void
 add_heap(mrb_state *mrb, mrb_gc *gc)
 {
   mrb_heap_page *page = (mrb_heap_page*)mrb_calloc(mrb, 1, sizeof(mrb_heap_page));
+#ifdef MRB_CAPSTONE_GC_SUBLET
+  if (!gcs_page_carve(page)) {
+    mrb_free(mrb, page);
+    mrb_raise_nomemory(mrb);
+  }
+  for (int i = 0; i < MRB_HEAP_PAGE_SIZE; i++)
+    page->next_free[i] = (uint16_t)(i + 1 < MRB_HEAP_PAGE_SIZE ? i + 1 : GCS_NIL);
+  page->free_head = 0;
+#else
   init_heap_page(page);
+#endif
   link_heap_page(gc, page);
 }
 
