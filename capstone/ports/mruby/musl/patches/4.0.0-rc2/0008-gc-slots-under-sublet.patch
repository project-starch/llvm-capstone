 MRB_API mrb_bool
 mrb_object_dead_p(mrb_state *mrb, struct RBasic *object)
 {
   mrb_gc *gc = &mrb->gc;
+#ifdef MRB_CAPSTONE_GC_SUBLET
+  /* The object may be dead already, its slot revoked: answer from the sidecar,
+     and read the object only through the GC's own alias of a live slot. */
+  uint16_t i;
+  mrb_heap_page *page = gcs_locate(gc, object, &i);
+  if (page == NULL || page->obj[i] == NULL) return TRUE;
+  return is_dead(gc, &page->obj[i]->as.basic);
+#else
   if (!heap_p(gc, object)) return TRUE;
   return is_dead(gc, object);
+#endif
 }
 
