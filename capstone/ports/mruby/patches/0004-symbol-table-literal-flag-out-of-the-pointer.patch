-/* Check if symbol is literal by testing LSB */
+/* THE LITERAL FLAG LIVES IN sym_flags[], NOT IN THE POINTER.
+ *
+ * Upstream packs it into the pointer's LSB:
+ *     (uintptr_t)ptr | 1   to set,   & ~1   to read back.
+ * On a capability target that round trip is lossy in a way it is not on a flat
+ * one: the cast to uintptr_t drops the capability, the OR produces a plain
+ * integer, and casting back yields an address with no tag. Masking the bit off
+ * again restores the address and cannot restore the tag, so the next dereference
+ * raises "requires capability". Measured: mrb_open_core dies in sym_check ->
+ * mrb_packed_int_decode reading `lb` through exactly such a word.
+ *
+ * mruby already keeps a per-symbol byte array for SYM_FL_DYNAMIC and SYM_FL_MARK
+ * and grows it alongside symtbl, so the flag has a home that costs nothing new.
+ * Same class as the packing proc.h does, which MRB_USE_METHOD_T_STRUCT already
+ * exists to avoid; the symbol table had no equivalent switch.
+ */
 static inline mrb_bool
-symtbl_is_literal(const char *tagged_ptr)
+sym_is_literal(mrb_state *mrb, mrb_sym i)
 {
-  return ((uintptr_t)tagged_ptr & SYMTBL_LITERAL_FLAG) != 0;
-}
-
-/* Create tagged pointer for literal string - with alignment verification */
-static inline const char*
-symtbl_tag_literal(const char *ptr)
