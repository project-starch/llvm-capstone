-mrb_alignas(8)
+mrb_alignas(_Alignof(struct RProc) > 8 ? _Alignof(struct RProc) : 8)
 static const struct RProc neq_proc = {
   NULL, MRB_TT_PROC, MRB_GC_RED, MRB_OBJ_IS_FROZEN, MRB_PROC_SCOPE | MRB_PROC_STRICT,
