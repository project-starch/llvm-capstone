gc.c: Q-15 placement for patch 0008's page lifetime: objects[] on its bounds granule, so the CDERIVE is exact (MRB_CAPSTONE_SUBLET).

0008 derives each heap page's lifetime over page->objects. On a compact-bounds platform (vp2; capstone-qemu
without exact bounds) CDERIVE refuses a child whose bounds are not exactly representable, with cause 29, so the
virtual-nested-pools image faulted in mrb_gc_init before running anything. objects[] is 1024 * sizeof(RVALUE) =
81920 bytes (granule 128, a multiple) but sat at offset 16464 in the page (16464 mod 128 = 80), so its base could
never be on the granule.

Under MRB_CAPSTONE_SUBLET, objects[] is aligned to the granule of its own length (capstone/representable.h's rule
as a constant expression; at least 16), so it lands at offset 16512 and the page is 98432 bytes, a granule
multiple; add_heap allocates the page with posix_memalign at that alignment (free() releases it as before) and
mrb_gc_add_region aligns region pages the same way. init_heap_page checks capstone_repr_ok on objects[] before the
derive and aborts with a message rather than letting the derive refuse at an unrelated-looking pc. The padding is
inside the page, between the header and objects[]; no object moves outside its page.

Without the define the preprocessed file is unchanged.

--- a/src/gc.c
+++ b/src/gc.c
@@ -170,6 +170,18 @@
 #include <capstone/capability.h>
 #endif
 
+#ifdef MRB_CAPSTONE_SUBLET
+#include <stdio.h>
+#include <stdlib.h>
+#include <capstone/representable.h>
+/* The bounds granule of objects[]: 2^(msb(len) - 9) for len >= 4 KiB (capstone/representable.h,
+   capstone_repr_granule, as a constant expression), and at least a capability's 16 bytes. */
+#define MRB_CAPSTONE_PAGE_OBJ_LEN (sizeof(RVALUE) * MRB_HEAP_PAGE_SIZE)
+#define MRB_CAPSTONE_PAGE_ALIGN \
+  (MRB_CAPSTONE_PAGE_OBJ_LEN < 4096UL ? 16UL : \
+   ((1UL << (63 - __builtin_clzl(MRB_CAPSTONE_PAGE_OBJ_LEN) - 9)) < 16UL ? 16UL : \
+    (1UL << (63 - __builtin_clzl(MRB_CAPSTONE_PAGE_OBJ_LEN) - 9))))
+#endif
 typedef struct mrb_heap_page {
   RVALUE *freelist;
   struct mrb_heap_page *next;
@@ -181,9 +193,20 @@
      the child each live object was handed out as; NULL for a free slot. */
   void *life;
   struct RBasic *issued[MRB_HEAP_PAGE_SIZE];
-#endif
+  /* Q-15 placement: the page's lifetime is CDERIVEd over objects[], and a compact-bounds platform (vp2, and
+     capstone-qemu without exact bounds) refuses a child whose bounds are not exactly representable (cause 29).
+     The length, MRB_HEAP_PAGE_SIZE slots, is a multiple of its granule; the BASE must be too, so objects[] is
+     aligned to that granule inside the page, and the page itself is allocated at it (add_heap, and region pages
+     in mrb_gc_add_region). The padding lies between the header and objects[], inside the page. */
+  RVALUE objects[MRB_HEAP_PAGE_SIZE] __attribute__((aligned(MRB_CAPSTONE_PAGE_ALIGN)));
+#else
   RVALUE objects[MRB_HEAP_PAGE_SIZE];
+#endif
 } mrb_heap_page;
+#ifdef MRB_CAPSTONE_SUBLET
+_Static_assert(sizeof(((mrb_heap_page*)0)->objects) % MRB_CAPSTONE_PAGE_ALIGN == 0,
+               "the page lifetime's length must be a multiple of its granule");
+#endif
 
 typedef struct mrb_heap_region {
   struct mrb_heap_region *next;
@@ -414,6 +437,13 @@
   }
