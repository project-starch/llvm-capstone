 #ifdef MRB_CAPSTONE_SUBLET
+  /* The placement must hold at run time too: a page from an allocator that ignored the alignment would make the
+     derive below refuse with 29 at an unrelated-looking pc; say so here instead. */
+  if (!capstone_repr_ok(__builtin_capstone_cap_get_cursor(page->objects), sizeof(page->objects))) {
+    fprintf(stderr, "mruby: heap page objects at %#lx are not on their %lu-byte bounds granule\n",
+            (unsigned long)__builtin_capstone_cap_get_cursor(page->objects), (unsigned long)MRB_CAPSTONE_PAGE_ALIGN);
+    abort();
+  }
   page->life = capstone_cap_derive(page,
       __builtin_capstone_cap_get_cursor(page->objects) - __builtin_capstone_cap_get_base(page),
       sizeof(page->objects));
@@ -423,7 +453,14 @@
 static void
 add_heap(mrb_state *mrb, mrb_gc *gc)
 {
+#ifdef MRB_CAPSTONE_SUBLET
+  /* at objects[]'s granule (Q-15 placement); mrb_free's free() releases it as any malloc'd page */
+  mrb_heap_page *page = NULL;
+  if (posix_memalign((void**)&page, MRB_CAPSTONE_PAGE_ALIGN, sizeof(mrb_heap_page)) != 0) mrb_raise_nomemory(mrb);
+  memset(page, 0, sizeof(mrb_heap_page));
+#else
   mrb_heap_page *page = (mrb_heap_page*)mrb_calloc(mrb, 1, sizeof(mrb_heap_page));
+#endif
   init_heap_page(page);
   link_heap_page(gc, page);
 }
