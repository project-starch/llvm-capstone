   RVALUE *freelist;
   struct mrb_heap_page *next;
   struct mrb_heap_page *free_next;
   mrb_bool old:1;
   mrb_bool region:1;             /* from contiguous region, not malloc */
+#ifdef MRB_CAPSTONE_SUBLET
+  /* Sublet: the child each live object was handed out as; NULL for a free slot. */
+  struct RBasic *issued[MRB_HEAP_PAGE_SIZE];
+#endif
   RVALUE objects[MRB_HEAP_PAGE_SIZE];
 } mrb_heap_page;
 
@@ -321,11 +329,67 @@
