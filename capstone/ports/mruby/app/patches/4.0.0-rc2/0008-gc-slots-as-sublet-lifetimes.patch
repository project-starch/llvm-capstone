+#ifdef MRB_CAPSTONE_SUBLET
+/* Sublet lifetimes. Every object is handed out as a child of its page,
+   bounded to its slot (CDERIVE), and the sweep revokes that child when it
+   frees the object (CREVOKE), so every copy of the object's pointer dies
+   with it. The GC itself works on its own pointers, derived from the page.
+   A pointer the GC is asked about may be dead, so it is never read through:
+   the slot is found by address. */
+static mrb_heap_page*
+gc_page_of(mrb_gc *gc, const RVALUE *p)
+{
+  mrb_heap_page *page;
+
+  for (page = gc->heaps; page; page = page->next) {
+    if ((uintptr_t)p - (uintptr_t)page->objects <= (MRB_HEAP_PAGE_SIZE - 1) * sizeof(RVALUE))
+      return page;
+  }
+  return NULL;
+}
+
+/* The GC's own pointer to the slot holding object, or NULL. */
+static struct RBasic*
+gc_inside(mrb_gc *gc, const struct RBasic *object)
+{
+  mrb_heap_page *page = gc_page_of(gc, (const RVALUE*)object);
+
+  if (!page) return NULL;
+  return &page->objects[((uintptr_t)object - (uintptr_t)page->objects) / sizeof(RVALUE)].as.basic;
+}
+
+/* The slot as a child of the page's own pointer. CDERIVE takes the offset from
+   that pointer's base, where a page carved from a region need not begin. */
+static struct RBasic*
+gc_issue(mrb_heap_page *page, RVALUE *p)
+{
+  size_t i = p - page->objects;
+  size_t offset = __builtin_capstone_cap_get_cursor(p) - __builtin_capstone_cap_get_base(page);
+
+  page->issued[i] = (struct RBasic*)capstone_cap_derive(page, offset, sizeof(RVALUE));
+  return page->issued[i];
+}
+
+static void
+gc_retire(mrb_heap_page *page, RVALUE *p)
+{
+  size_t i = p - page->objects;
+
+  capstone_cap_release(page->issued[i]);
+  page->issued[i] = NULL;
+}
+#endif
+
 MRB_API mrb_bool
 mrb_object_dead_p(mrb_state *mrb, struct RBasic *object)
 {
   mrb_gc *gc = &mrb->gc;
+#ifdef MRB_CAPSTONE_SUBLET
+  object = gc_inside(gc, object);
+  if (!object) return TRUE;
+#else
   if (!heap_p(gc, object)) return TRUE;
+#endif
   return is_dead(gc, object);
 }
 
