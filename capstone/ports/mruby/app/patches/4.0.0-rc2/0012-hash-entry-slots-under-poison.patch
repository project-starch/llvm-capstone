+#ifdef MRB_POISONCAP_HASH
+/* ---------------------------------------------------------------------------
+ * The same entry-array slots as patch 0010, invalidated with PoisonCap instead
+ * of a sub-let, so the two mechanisms can be measured against one defect set.
+ *
+ * The level is the same and so is the event: entry_delete() vacates a slot and a
+ * later ea_set() refills it with nothing released to the allocator in between, so
+ * revocation keyed to free() has nothing to fire on. Measured on CheriBSD purecap
+ * at this pin, with libc revocation both off and on, the three reuse-not-free
+ * defects (a54353ecf, 08a0432d1, eb7693857) reproduce unchanged.
+ *
+ * What differs from 0010 is only HOW a slot is taken back:
+ *
+ *   0010  sublet_take / sublet_give on a node split out of a linear region
+ *   here  an exactly-bounded alias, and at slot death cpoison over the slot's
+ *         16-byte lines, one synchronous sweep, cclearpoison, zero
+ *
+ * Three things this shares with 0010, and they are what make it work:
+ *
+ * 1. THE ARRAY'S STORAGE IS THE SPAN. ea_resize() and ea_dup() map it, so there
+ *    is one array rather than an malloc'd block with a shadow beside it.
+ * 2. A FREE SLOT IS NEVER READ. Its state is obj[i] == NULL in the sidecar, which
+ *    is why ea_deleted_p() takes an INDEX. base is an address-only pointer, never
+ *    dereferenced -- the same untagged identity key 0010 uses -- so a sweep has
+ *    nothing to take from it and every real access goes through obj[i].
+ * 3. BOTH SHAPES ARE COVERED: the indexed shape's entry array is the same
+ *    hash_entry[] reached through ht_ea(), and all three defects build 20-key
+ *    hashes, so the array shape alone would have left every one of them out.
+ *
+ * Why per-slot poison is sound where a whole-span poison would not be: a slot's
+ * alias is bounded to its own sizeof(hash_entry) bytes, so poisoning slot i and
+ * sweeping intersects slot i's alias and no other. Surviving slots keep theirs,
+ * which is why nothing has to be re-published and the hash never has to re-fetch
+ * its array pointer -- the difference from the APR node adapter, which poisons a
+ * whole node and republishes it.
+ *
+ * MRB_POISON_MODE selects the arm: 0 publishes exact bounds and invalidates
+ * nothing (the spatial control -- upstream behaviour under CHERI bounds), 1
+ * invalidates at slot death. MRB_POISON_REPORT=1 prints the counters at exit.
+ * ------------------------------------------------------------------------- */
+#include <cheri/cheric.h>
+#include <cheri/revoke.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#ifndef CHERI_PERM_POISON
+#error "MRB_POISONCAP_HASH requires the PoisonCap SDK"
+#endif
+
+#define XP_MAX 64                 /* live entry arrays tracked at once */
+#define XP_SLOTS 64               /* slots per span; see 0010's note on both shapes */
+#define XP_AUTH (CHERI_PERM_POISON | CHERI_PERM_SW_VMEM)
+#define XP_PAGE 4096UL
+mrb_static_assert(sizeof(hash_entry) % 16 == 0);  /* poison works in 16-byte lines */
+
+typedef struct xp_arr {
+  hash_entry *base;               /* address-only identity key; never dereferenced */
+  void *region;                   /* the manager's cap: poison + mapping authority */
+  size_t mapped;
+  uint32_t capa;
+  hash_entry *obj[XP_SLOTS];      /* slot i's alias; NULL while free in mode 1 only */
+  unsigned char live[XP_SLOTS];   /* liveness, so mode 0 need not NULL an alias */
+} xp_arr;
+
+static xp_arr xp_tab[XP_MAX];
+static unsigned xp_mode, xp_ready;
+static unsigned long xp_spans, xp_issued, xp_released, xp_sweeps, xp_poisoned;
+
+static void
+xp_refuse(const char *why)
+{
+  fprintf(stderr, "MRB_POISONCAP_HASH refused: %s\n", why);
+  exit(1);
+}
+
+static void
+xp_report(void)
+{
+  fprintf(stderr, "MRB_POISONCAP_HASH mode=%u spans=%lu issued=%lu released=%lu "
+          "sweeps=%lu poison_bytes=%lu entry_bytes=%lu pointer_bytes=%lu\n",
+          xp_mode, xp_spans, xp_issued, xp_released, xp_sweeps, xp_poisoned,
+          (unsigned long)sizeof(hash_entry), (unsigned long)sizeof(void*));
+  fflush(stderr);
+}
+
+static void
+xp_init(void)
+{
+  const char *m;
+  if (xp_ready) return;
+  xp_ready = 1;
+  if (!feature_present("cheri_caprevoke_poison"))
+    xp_refuse("platform lacks cheri_caprevoke_poison");
+  m = getenv("MRB_POISON_MODE");
+  if (!m || (m[0] != '0' && m[0] != '1') || m[1])
+    xp_refuse("set MRB_POISON_MODE to 0 (control) or 1 (invalidate at slot death)");
+  xp_mode = (unsigned)(m[0] - '0');
+  if (getenv("MRB_POISON_REPORT")) atexit(xp_report);
+}
+
+/* Exact bounds over one slot, neither poison nor mapping authority: revocable by
+   a sweep, and unable to poison anything itself. */
+static void *
+xp_publish(void *manager, size_t n)
+{
+  void *bounded = cheri_setboundsexact(manager, n);
+  if (!cheri_gettag(bounded))
+    xp_refuse("unrepresentable bounds");        /* slots are 16-byte multiples */
+  return cheri_clearperm(bounded, XP_AUTH);
+}
+
+/* Poison, sweep and clear are separate so a drop of many slots pays ONE sweep;
+   revocation is still complete before the caller returns. */
+static void
+xp_poison(void *p, size_t n)
+{
+  if ((cheri_getaddress(p) & 15) || (n & 15) ||
+      (cheri_getperm(p) & XP_AUTH) != XP_AUTH)
+    xp_refuse("poison geometry or authority");
+  for (size_t i = 0; i < n; i += 16) {
+    void *q = (unsigned char *)p + i;
+    __asm__ volatile("cpoison %0, 0(%0)" : : "C"(q) : "memory");
+  }
+  xp_poisoned += n;
+}
+
+static void
+xp_sweep(void)
+{
+  struct cheri_revoke_syscall_info info = {0};
+  if (cheri_revoke(CHERI_REVOKE_LAST_PASS | CHERI_REVOKE_IGNORE_START |
+                   CHERI_REVOKE_TAKE_STATS, 0, &info))
+    xp_refuse("sweep failed; the slot cannot be reused");
+  xp_sweeps++;
+}
+
+static void
+xp_clear(void *p, size_t n)
+{
+  for (size_t i = 0; i < n; i += 16) {
+    void *q = (unsigned char *)p + i;
+    __asm__ volatile("cclearpoison %0, 0(%0)" : : "C"(q) : "memory");
+  }
+  memset(p, 0, n);  /* clearing access state does not erase a capability in memory */
+}
+
+static void *
+xp_slot(xp_arr *a, uint32_t index)
+{
+  return (unsigned char *)a->region + (size_t)index * sizeof(hash_entry);
+}
+
+static xp_arr *
+xp_find(const hash_entry *ea)
+{
+  if (!ea) return NULL;
+  for (int i = 0; i < XP_MAX; i++)
+    if (xp_tab[i].base &&
+        cheri_getaddress(xp_tab[i].base) == cheri_getaddress(ea))
+      return &xp_tab[i];
+  return NULL;
+}
+
+/* the slot a pointer names. entry_delete() keeps its signature, so the slot is
+   found by searching the live spans; a functional arm would pass the index. */
+static xp_arr *
+xp_find_slot(const hash_entry *e, uint32_t *index)
+{
+  for (int i = 0; i < XP_MAX; i++) {
+    xp_arr *a = &xp_tab[i];
+    if (!a->base) continue;
+    for (uint32_t k = 0; k < a->capa; k++)
+      if (a->live[k] && cheri_getaddress(a->obj[k]) == cheri_getaddress(e)) {
+        *index = k;
+        return a;
+      }
+  }
+  return NULL;
+}
+
+/* A dropped span keeps its mapping and is reused, which bounds the process at
+   XP_MAX pages. Reuse is safe because a drop revokes every slot in it. */
+static xp_arr *
+xp_new(uint32_t capa)
+{
+  size_t bytes, need;
+  xp_init();                      /* mode must be known before a slot is published */
+  if (capa == 0 || capa > XP_SLOTS) return NULL;
+  bytes = (size_t)capa * sizeof(hash_entry);
+  need = (bytes + XP_PAGE - 1) & ~(XP_PAGE - 1);
+  for (int i = 0; i < XP_MAX; i++) {
+    xp_arr *a = &xp_tab[i];
+    if (a->base) continue;
+    if (a->region == NULL) {
+      void *region = mmap(NULL, need, PROT_READ | PROT_WRITE,
+                          MAP_PRIVATE | MAP_ANON, -1, 0);
+      if (region == MAP_FAILED) return NULL;
+      if ((cheri_getperm(region) & XP_AUTH) != XP_AUTH)
+        xp_refuse("mapping lacks poison authority");
+      a->region = region;
+      a->mapped = need;
+    }
+    else if (a->mapped < need) continue;      /* too small; try another record */
+    a->capa = capa;
+    a->base = (hash_entry *)(uintptr_t)cheri_getaddress(a->region);
+    for (uint32_t k = 0; k < capa; k++) {
+      /* BOTH modes publish every slot, and NEITHER ever stores a NULL here. That is
+         what makes the pair measure one variable. A NULL alias would fault on
+         dereference exactly as a revoked one does -- same SIGPROT, same message --
+         so a mode-1 fault could not be attributed to revocation, and mode 0 would
+         fault on two defects that pristine purecap runs to completion. Liveness
+         lives in live[] instead, so mode 0 hands back a VALID alias for a vacated
+         slot (upstream behaviour, under per-slot bounds) and mode 1 hands back the
+         same alias after the sweep has REVOKED it. */
+      a->obj[k] = (hash_entry *)xp_publish(xp_slot(a, k), sizeof(hash_entry));
+      a->live[k] = 0;
+    }
+    xp_spans++;
+    return a;
+  }
+  return NULL;                    /* the table is full; the caller falls back to malloc */
+}
+
+static hash_entry *
+xp_issue(xp_arr *a, uint32_t index)
+{
+  if (!a->live[index]) {         /* slot birth: the sweep left the old alias untagged */
+    a->obj[index] = (hash_entry *)xp_publish(xp_slot(a, index), sizeof(hash_entry));
+    a->live[index] = 1;
+    xp_issued++;
+  }
+  return a->obj[index];
+}
+
+/* Slot death. In mode 1 every stale copy of this slot's alias is dead when this
+   returns; in mode 0 nothing is revoked, which is the control. */
+static void
+xp_release(xp_arr *a, uint32_t index)
+{
+  if (!a->live[index]) return;
+  a->live[index] = 0;
+  xp_released++;
+  if (!xp_mode) return;          /* the control leaves the alias valid */
+  xp_poison(xp_slot(a, index), sizeof(hash_entry));
+  xp_sweep();
+  xp_clear(xp_slot(a, index), sizeof(hash_entry));
+}
+
+/* Every live slot at once, for ONE sweep rather than one per slot. */
+static void
+xp_release_range(xp_arr *a, uint32_t from, uint32_t to)
+{
+  uint32_t n = 0;
+  if (to > a->capa) to = a->capa;
+  for (uint32_t k = from; k < to; k++) {
+    if (!a->live[k]) continue;
+    a->live[k] = 0;
+    xp_released++;
+    if (!xp_mode) continue;
+    xp_poison(xp_slot(a, k), sizeof(hash_entry));
+    n++;
+  }
+  if (!n) return;
+  xp_sweep();
+  for (uint32_t k = from; k < to; k++) xp_clear(xp_slot(a, k), sizeof(hash_entry));
+}
+
+static void
+xp_drop(xp_arr *a)
+{
+  xp_release_range(a, 0, a->capa);
+  a->base = NULL;                 /* the mapping is kept for the next span */
+}
+#endif  /* MRB_POISONCAP_HASH */
+
