string.c: one alias per sharer, revoked at the un-share, under MRB_CAPSTONE_STR_SUBLET (4.0.0-rc2).

The level above the hash's entry array (patch 0010), and a different KIND of site rather
than a fourth copy of the same one.

base[1..-1] gives two RStrings one buffer with an mrb_shared_string refcount, and
str_lstrip_bang and its siblings cached RSTR_PTR(s) BEFORE mrb_str_modify() -- which is
precisely what un-shares -- so every write after it went through the stale pointer into
the parent's buffer (1c57532b2).

Measured on the reproducer, that write is IN BOUNDS at every granularity: the parent is 45
bytes, the view occupies parent offsets 1..44, and the corruption spans 1..37. No bounds
check at any granularity sees it, and revoke-on-free sees nothing either, because
str_decref frees the buffer only when the LAST reference goes and the parent still holds
it. The only handle is revocation at an OWNERSHIP TRANSFER rather than at a free. That is
why this patch exists and why it is not shaped like 0008 or 0010: the revocation point is
str_unshare_buffer(), not a release.

Three sites, as in 0010:

- str_init_shared(), first sharing: the buffer becomes a carved span out of the program's
  region 3, because a sub-let needs a linear region and an mrb_malloc'd buffer is not one
  -- the lesson 0010's first attempt paid for. Each sharer then gets an alias of its own.
- str_unshare_buffer(), the refcnt > 1 arm: the view's alias is revoked BEFORE the new
  buffer is installed, so a pointer cached across mrb_str_modify() is dead however it is
  later used.
- str_decref() at refcount zero: the span is dropped rather than mrb_free'd.

Without the define the preprocessed file is identical to before: mrbtest is Total 1527,
OK 1527, KO 0, Crash 0 with the defines off, and the string case still reproduces natively
(parent corrupted), so the arm is measuring the defect that is there rather than one the
patch introduced.

Limits, stated. Sharers are tracked in a fixed table (SS_MAX 128) keyed on the RString,
because struct RString is a GC object of fixed size and cannot carry the alias itself;
beyond it a string shares without an alias and this level is simply not covered for it.
The grant is carved forward only, as 0008's is, so a dropped span is not returned -- which
bounds a program to the region's size and is why the region is granted separately
(MRBD_STR_REGION_BYTES).

diff --git c/src/string.c w/src/string.c
--- c/src/string.c
+++ w/src/string.c
@@ -105,6 +105,134 @@
   return s;
 }
 
+
+#ifdef MRB_CAPSTONE_STR_SUBLET
+/* ---------------------------------------------------------------------------
+ * The shared string buffer, one alias per sharer, revoked at the un-share.
+ *
+ * The level above the hash's entry array (patch 0010). base[1..-1] gives two RStrings
+ * one buffer with an mrb_shared_string refcount, and str_lstrip_bang and its siblings
+ * cached RSTR_PTR(s) BEFORE mrb_str_modify() -- which is precisely what un-shares, so
+ * every write after it went through the stale pointer into the parent's buffer
+ * (1c57532b2; capstone/bug-corpora/mruby/gc-slot-repros/CANDIDATES.md).
+ *
+ * Measured, that write is IN BOUNDS at every granularity: the parent is 45 bytes, the
+ * view occupies parent offsets 1..44, and the corruption spans 1..37. So no bounds check
+ * sees it and revoke-on-free sees nothing either, because str_decref frees the buffer
+ * only when the LAST reference goes and the parent still holds it. The only handle is
+ * revocation at an OWNERSHIP TRANSFER rather than at a free, which is what this does and
+ * what makes it a different kind of site from 0008 and 0010 rather than a fourth copy.
+ *
+ * The buffer's storage becomes a carved span when a string is first shared, since a
+ * sub-let needs a linear region and an mrb_malloc'd buffer is not one -- the same lesson
+ * 0010's first attempt paid for. Each sharer gets an alias into the span; the alias is
+ * revoked in str_unshare_buffer(), before the new buffer is installed.
+ * ------------------------------------------------------------------------- */
+#include "sublet.h"
+void *__capstone_region(unsigned index);
+
+#define SS_MAX 128                /* sharers tracked at once */
+
+typedef struct ss_sharer {
+  const struct RString *owner;    /* the RString holding this alias */
+  mrb_shared_string *shared;      /* the buffer it shares */
+  sublet_cap cap;                 /* its alias; the handle side stays in ss_span */
+} ss_sharer;
+
+typedef struct ss_span {
+  mrb_shared_string *shared;
+  char *base;
+  mrb_int bytes;
+  sublet_cap handle;              /* senior to every sharer's alias */
+} ss_span;
+
+static ss_sharer ss_tab[SS_MAX];
+static ss_span ss_spans[SS_MAX];
+static sublet_cap ss_grant;
+static int ss_granted;
+static unsigned long ss_carved, ss_issued, ss_revoked;
+
+static ss_span *
+ss_span_of(const mrb_shared_string *sh)
+{
+  for (int i = 0; i < SS_MAX; i++) if (ss_spans[i].shared == sh) return &ss_spans[i];
+  return NULL;
+}
+
+static ss_sharer *
+ss_sharer_of(const struct RString *s)
+{
+  for (int i = 0; i < SS_MAX; i++) if (ss_tab[i].owner == s) return &ss_tab[i];
+  return NULL;
+}
+
+/* carve a span for a buffer that is becoming shared, and copy the bytes in */
+static ss_span *
+ss_carve(mrb_state *mrb, mrb_shared_string *sh, const char *src, mrb_int bytes)
+{
+  if (bytes <= 0) return NULL;
+  if (!ss_granted) { sublet_store(&ss_grant, __capstone_region(3)); ss_granted = 1; }
+  if (sublet_type(&ss_grant) != SUBLET_TYPE_LIN) return NULL;
+  unsigned long start = sublet_base(&ss_grant);
+  unsigned long want = ((unsigned long)bytes + 15UL) & ~15UL;   /* a span is whole capabilities */
+  if (sublet_end(&ss_grant) - start < want) return NULL;
+  for (int i = 0; i < SS_MAX; i++) {
+    if (ss_spans[i].shared) continue;
+    ss_span *sp = &ss_spans[i];
+    sublet_cap first;
+    sublet_carve(&ss_grant, start + want, &first);
+    sublet_handle(&first, &sp->handle);
+    char *dst = (char*)sublet_take(&first);
+    for (mrb_int k = 0; k < bytes; k++) dst[k] = src[k];
+    sublet_give(&first);                  /* the bytes are in; sharers get their own */
+    sp->shared = sh; sp->base = (char*)start; sp->bytes = bytes;
+    ss_carved++;
+    return sp;
+  }
+  return NULL;
+}
+
+/* s starts sharing sh: give it an alias of its own into the span */
+static char *
+ss_issue(mrb_shared_string *sh, struct RString *s)
+{
+  ss_span *sp = ss_span_of(sh);
+  if (!sp) return NULL;
+  for (int i = 0; i < SS_MAX; i++) {
+    if (ss_tab[i].owner) continue;
+    ss_sharer *sr = &ss_tab[i];
+    sublet_cap tmp = sp->handle;
+    sublet_store(&sr->cap, sublet_take(&tmp));
+    sp->handle = tmp;
+    sr->owner = s; sr->shared = sh;
+    ss_issued++;
+    return (char*)sublet_base(&sr->cap);
+  }
+  return NULL;
+}
+
+/* THE point of this level: s stops sharing, so its alias dies -- before the new buffer
+   is installed, so a pointer cached across mrb_str_modify() is dead however it is used */
+static void
+ss_revoke(const struct RString *s)
+{
+  ss_sharer *sr = ss_sharer_of(s);
+  if (!sr) return;
+  sublet_give(&sr->cap);
+  sr->owner = NULL; sr->shared = NULL;
+  ss_revoked++;
+}
+
+static void
+ss_drop(const mrb_shared_string *sh)
+{
+  for (int i = 0; i < SS_MAX; i++)
+    if (ss_tab[i].shared == sh) { sublet_give(&ss_tab[i].cap); ss_tab[i].owner = NULL; ss_tab[i].shared = NULL; }
+  ss_span *sp = ss_span_of(sh);
+  if (sp) sp->shared = NULL;      /* the grant is carved forward only, as 0008's is */
+}
+#endif  /* MRB_CAPSTONE_STR_SUBLET */
+
 static struct RString*
 str_init_shared(mrb_state *mrb, const struct RString *orig, struct RString *s, mrb_shared_string *shared)
 {
@@ -116,7 +244,27 @@
     shared->refcnt = 1;
     shared->ptr = orig->as.heap.ptr;
     shared->capa = orig->as.heap.aux.capa;
+#ifdef MRB_CAPSTONE_STR_SUBLET
+    /* first sharing: the buffer becomes a span, because a sub-let needs a linear
+       region and an mrb_malloc'd buffer is not one */
+    {
+      ss_span *sp = ss_carve(mrb, shared, orig->as.heap.ptr, orig->as.heap.aux.capa + 1);
+      if (sp) { mrb_free(mrb, shared->ptr); shared->ptr = sp->base; }
+    }
+#endif
+  }
+#ifdef MRB_CAPSTONE_STR_SUBLET
+  {
+    char *alias = ss_issue(shared, s);
+    if (alias) {
+      s->as.heap.ptr = alias + (orig->as.heap.ptr - shared->ptr);
+      s->as.heap.len = orig->as.heap.len;
+      s->as.heap.aux.shared = shared;
+      RSTR_SET_TYPE(s, SHARED);
+      return s;
+    }
   }
+#endif
   s->as.heap.ptr = orig->as.heap.ptr;
   s->as.heap.len = orig->as.heap.len;
   s->as.heap.aux.shared = shared;
@@ -265,6 +413,9 @@
 {
   shared->refcnt--;
   if (shared->refcnt == 0) {
+#ifdef MRB_CAPSTONE_STR_SUBLET
+    if (ss_span_of(shared)) { ss_drop(shared); mrb_free(mrb, shared); return; }
+#endif
     mrb_free(mrb, shared->ptr);
     mrb_free(mrb, shared);
   }
@@ -283,6 +434,11 @@
       mrb_free(mrb, shared);
     }
     else {
+#ifdef MRB_CAPSTONE_STR_SUBLET
+      /* the un-share is the ownership transfer: s's alias dies HERE, before the new
+         buffer is installed, so a pointer cached across mrb_str_modify() is dead */
+      ss_revoke(s);
+#endif
       str_init_modifiable(mrb, s, s->as.heap.ptr, s->as.heap.len);
       str_decref(mrb, shared);
     }
