#!/usr/bin/perl
use strict;
use warnings;
$| = 1;
my ($tests, $failed) = (0, 0);
sub check {
    my ($ok, $name) = @_;
    ++$tests;
    ++$failed unless $ok;
    print($ok ? 'ok ' : 'not ok ', "$tests - $name\n");
}
sub rejected {
    my ($format, $bytes, $name) = @_;
    my $ok = eval { my $value = unpack($format, $bytes); 1 };
    check(!$ok && $@ =~ /provenance/, $name);
}
sub identity { return $_[0] }
my $target = "foo\0bar";
my $width = length(pack('p', $target));
for my $format ('p', 'p<', 'p>') {
    my $packed = pack($format, $target);
    check(unpack($format, $packed) eq 'foo', "$format roundtrip");
    my $copy = $packed;
    check(unpack($format, $copy) eq 'foo', "$format assignment");
    my @array = ($packed);
    my %hash = (value => $packed);
    check(unpack($format, $array[0]) eq 'foo', "$format array value");
    check(unpack($format, $hash{value}) eq 'foo', "$format hash value");
    check(unpack($format, identity($packed)) eq 'foo', "$format return value");
    utf8::upgrade($copy);
    check(unpack($format, $copy) eq 'foo', "$format utf8 upgrade");
    utf8::downgrade($copy);
    check(unpack($format, $copy) eq 'foo', "$format utf8 downgrade");
    my $prefix = "x" . $packed;
    check(unpack("x$format", $prefix) eq 'foo', "$format concatenation");
    my $slice = substr($prefix, 1, $width);
    check(unpack($format, $slice) eq 'foo', "$format whole-field substring");
    my $suffix = $packed . 'x';
    check(unpack($format, $suffix) eq 'foo', "$format suffix append");
    my $append = $packed;
    $append .= 'x';
    check(unpack($format, $append) eq 'foo', "$format in-place append");
    $append .= "\x{100}";
    check(unpack($format, $append) eq 'foo', "$format in-place UTF8 append");
    my $wide = "\x{100}" . $packed;
    check((unpack("a1$format", $wide))[-1] eq 'foo', "$format UTF8 prefix concat");
    my $repeat = $packed x 2;
    check(join(',', unpack("($format)2", $repeat)) eq 'foo,foo', "$format repetition");
    my $both = $packed . $packed;
    my @values = unpack("($format)2", $both);
    check(join(',', @values) eq 'foo,foo', "$format duplicate concat");
    my $joined = join('', 'x', $packed, 'y');
    check(unpack("x$format", $joined) eq 'foo', "$format join");
    my $repacked = pack('a*', $packed);
    check(unpack($format, $repacked) eq 'foo', "$format pack a copy");
    my $unpacked = unpack('a*', $packed);
    check(unpack($format, $unpacked) eq 'foo', "$format unpack a copy");
    my $insert = 'xy';
    substr($insert, 1, 0) = $packed;
    check(unpack("x$format", $insert) eq 'foo', "$format substring insertion");
    my $alias_target = 'xy';
    my $alias = \substr($alias_target, 1, 1);
    $$alias = $packed;
    my $alias_value = eval { unpack("x$format", $alias_target) };
    check(defined($alias_value) && $alias_value eq 'foo', "$format lvalue alias insertion");
    my $sibling = $packed;
    my $damaged = $packed;
    vec($damaged, 0, 8) ^= 1;
    rejected($format, $damaged, "$format damaged vec");
    check(unpack($format, $sibling) eq 'foo', "$format independent sibling");
    my $same = $packed;
    substr($same, 0, 1) = substr($same, 0, 1);
    rejected($format, $same, "$format same-byte partial overwrite");
    my $raw = pack('H*', unpack('H*', $packed));
    rejected($format, $raw, "$format numeric byte reconstruction");
    $damaged = $raw;
    rejected($format, $damaged, "$format overwrite and restore raw bytes");
    my $null = pack($format, undef);
    check(!defined(unpack($format, $null)), "$format null");
}
my $plain = pack('p', $target);
my $big = pack('p>', $target);
check($big eq reverse($plain), 'big endian preserves reversed payload');
check(unpack('P7', $plain) eq $target, 'p to P fixed-length interpretation');
check(unpack('p', pack('P', $target)) eq 'foo', 'P to p interpretation');
check(unpack('xp>', pack('xp>', $target)) eq 'foo', 'unaligned endian pointer');
check(unpack('p', pack('pa*', $target, "\x{100}")) eq 'foo', 'pack marked UTF8 upgrade');
check((unpack('a1p', pack('a*p', "\x{100}", $target)))[-1] eq 'foo', 'UTF8 prefix and pointer');
my $bad_endian = pack('p>', $target);
rejected('p<', $bad_endian, 'incompatible endian interpretation');
my $raw = pack('H*', unpack('H*', $big));
my $overlap = pack('p>X['.$width.']a*', $target, $raw);
rejected('p>', $overlap, 'pack truncate and byte restoration');
open my $file, '>', 'pointer-provenance.tmp' or die $!;
binmode $file;
print {$file} $big;
close $file or die $!;
my $readback = $big;
open $file, '<', 'pointer-provenance.tmp' or die $!;
binmode $file;
read($file, $readback, $width) == $width or die $!;
close $file;
unlink 'pointer-provenance.tmp';
rejected('p>', $readback, 'file read replaces original SV authority');
my $cached = "\xf8\xf9\xfa";
utf8::upgrade($cached);
my $cache_length = length($cached);
my $cache_index = index($cached, "\xf9");
pos($cached) = 1;
$cached = pack('p>', $target);
utf8::upgrade($cached);
check(unpack('p>', $cached) eq 'foo', 'assignment over UTF8 and regex position caches');
for (1..1000) {
    my $temporary = pack('p>', $target);
    my $copy = $temporary;
    $temporary = 'discard';
    die 'copy lifetime' unless unpack('p>', $copy) eq 'foo';
    eval { my $value = unpack('p>', pack('H*', unpack('H*', $copy))) };
    die 'missing rejection' unless $@ =~ /provenance/;
}
check(1, '1000 copy/reassign/croak lifetimes');
print "1..$tests\n";
print "POINTER_PROVENANCE:checks=$tests:failures=$failed\n";
exit($failed ? 1 : 0);
