+/* Keep saved regex pointers in pointer-typed slots. A UV cannot carry a
+ * capability tag when pointers are wider than integers. */
+typedef struct {
+    char *copied_subbeg;
+    UV nparens;
+#ifdef PERL_ANY_COW
+    SV *saved_copy;
+#endif
+    char *subbeg;
+    UV sublen;
+    UV suboffset;
+    UV subcoffset;
+    UV offsets[];
+} rxres_state;
