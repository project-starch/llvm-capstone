diff --git i/sv.h w/sv.h
index 7b21e71..6c0b6a5 100644
--- i/sv.h
+++ w/sv.h
@@ -359,10 +359,47 @@ perform the upgrade if necessary.  See C<L</svtype>>.
 
 #define SVTYPEMASK	0xff
+#ifdef PERL_SV_HEAD_ADAPTER
+/* A freed head's type is SVTYPEMASK, and the core reads it through pointers
+   that may be stale by design: a COP's stash, PL_curstash, PL_last_in_gv
+   restored by SAVESPTR, GvIO's own test. With released heads revoked or
+   poisoned, every type probe first asks the lifetime adapter (see
+   SvIS_FREED below) and reports SVTYPEMASK for a released head, which is
+   what upstream reads there. The argument is evaluated once, as in
+   upstream's macro. */
+int perl_svh_released(const void *head);
+PERL_STATIC_INLINE svtype
+S_svh_type(const struct STRUCT_SV *sv)
+{
+    return perl_svh_released(sv) ? (svtype)SVTYPEMASK
+                                 : (svtype)(sv->sv_flags & SVTYPEMASK);
+}
+#  define SvTYPE(sv)	S_svh_type((const struct STRUCT_SV *)(sv))
+#else
 #define SvTYPE(sv)	((svtype)((sv)->sv_flags & SVTYPEMASK))
+#endif
 
 /* Sadly there are some parts of the core that have pointers to already-freed
    SV heads, and rely on being able to tell that they are now free. So mark
    them all by using a consistent macro.  */
+#ifdef PERL_SV_HEAD_ADAPTER
+/* Study build (capstone/ports/perl/sv-heads). SV heads are issued and
+   released by an external lifetime adapter instead of being carved from
+   arenas and chained through their own bytes. A released head may already be
+   revoked (Capstone Sublet) or poisoned (PoisonCap), so a pointer that may
+   name one is first checked against the adapter's record, by address and
+   current lease, and the head is read only when it is still live.
+   SvTYPE above makes the same test for type probes. */
+#  ifdef DEBUG_LEAKING_SCALARS
+#    error "DEBUG_LEAKING_SCALARS walks the SV arenas, which PERL_SV_HEAD_ADAPTER replaces"
+#  endif
+void *perl_svh_new(size_t bytes, size_t per_page);
+void perl_svh_del(void *head, int reusable);
+size_t perl_svh_extent(void);
+void *perl_svh_next(size_t *cursor, size_t limit);
+#  define SvIS_FREED(sv)	UNLIKELY(perl_svh_released((const void *)(sv)) \
+                                 || ((sv)->sv_flags == SVTYPEMASK))
+#else
 #define SvIS_FREED(sv)	UNLIKELY(((sv)->sv_flags == SVTYPEMASK))
+#endif
 
 /* this is defined in this peculiar way to avoid compiler warnings.
