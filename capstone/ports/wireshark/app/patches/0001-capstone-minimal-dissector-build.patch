--- a/epan/dissectors/CMakeLists.txt
+++ b/epan/dissectors/CMakeLists.txt
@@ -2234,6 +2234,20 @@
 	${CORBA_IDL_DISSECTOR_SRC}
 )
 
+# CAPSTONE (tshark app port): build and register only a whitelist of dissectors, one file name
+# per line. The registration file (dissectors.c) is generated from the same list, so a
+# dissector that is not listed is neither compiled into `dissectors` nor registered.
+if(CAPSTONE_DISSECTOR_WHITELIST)
+	file(STRINGS ${CAPSTONE_DISSECTOR_WHITELIST} _capstone_wl REGEX "^[^#]")
+	set(DISSECTOR_FILES)
+	foreach(_f ${_capstone_wl})
+		list(APPEND DISSECTOR_FILES ${CMAKE_CURRENT_SOURCE_DIR}/${_f})
+	endforeach()
+	set(ALL_DISSECTOR_SRC ${DISSECTOR_FILES})
+	set(DISSECTOR_SUPPORT_SRC ${CMAKE_CURRENT_SOURCE_DIR}/errno.c)
+	set(DISSECTOR_LEX)
+endif()
+
