{
  "version": 6,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "/tmp/capstone/wireshark-wmem/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": true
      }
    },
    {
      "name": "native",
      "inherits": "base"
    },
    {
      "name": "capstone-domain",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/../../common/cmake/toolchains/capstone-domain.cmake",
      "cacheVariables": {
        "PORT_HEADER_PROVIDER": "musl"
      }
    },
    {
      "name": "capstone-application",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/../../common/cmake/toolchains/capstone-application.cmake",
      "cacheVariables": {
        "BUILD_TESTING": false
      }
    },
    {
      "name": "linux-guest",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/../../common/cmake/toolchains/linux-guest.cmake"
    },
    {
      "name": "cheribsd",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/../../common/cmake/toolchains/cheribsd.cmake",
      "cacheVariables": {
        "BUILD_TESTING": false,
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "jobs": 4
    },
    {
      "name": "capstone-domain",
      "configurePreset": "capstone-domain",
      "jobs": 4
    },
    {
      "name": "linux-guest",
      "configurePreset": "linux-guest",
      "jobs": 4
    },
    {
      "name": "cheribsd",
      "configurePreset": "cheribsd",
      "jobs": 2
    },
    {
      "name": "capstone-application",
      "configurePreset": "capstone-application",
      "jobs": 4
    }
  ],
  "testPresets": [
    {
      "name": "native",
      "configurePreset": "native",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    }
  ]
}
