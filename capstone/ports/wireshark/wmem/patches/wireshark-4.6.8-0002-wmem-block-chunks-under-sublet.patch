+
+/* A chunk header of block, not yet at any address. */
+static wmem_block_chunk_t *
+wm_chunk_new(wmem_block_hdr_t *block)
+{
+    wmem_block_chunk_t *chunk;
+
+    if (!wm_spare_chunks) {
+        wmem_block_chunk_t *slab = wm_meta_alloc(WM_SLAB * sizeof *slab);
+        for (unsigned i = 0; i < WM_SLAB; ++i) {
+            slab[i].index_next = wm_spare_chunks;
+            wm_spare_chunks = &slab[i];
+        }
+    }
+    chunk = wm_spare_chunks;
+    wm_spare_chunks = chunk->index_next;
+    chunk->index_next = NULL;
+    chunk->block = block;
+    chunk->left = chunk->right = NULL;
+    chunk->free.prev = chunk->free.next = NULL;
+    return chunk;
+}
+
+/* Put a chunk header at an address, and in the index under it. */
+static void
+wm_chunk_place(wmem_block_chunk_t *chunk, size_t addr)
+{
+    size_t i;
+
+    if (!wm_index) {
+        wm_index = wm_meta_alloc(((size_t)1 << WM_INDEX_LOG) * sizeof *wm_index);
+    }
+    chunk->addr = addr;
+    i = wm_index_of(addr);
+    chunk->index_next = wm_index[i];
+    wm_index[i] = chunk;
+}
+
+static wmem_block_chunk_t *
+wm_chunk_at(size_t addr)
+{
+    wmem_block_chunk_t *chunk;
+
+    if (!wm_index) {
+        return NULL;
+    }
+    for (chunk = wm_index[wm_index_of(addr)]; chunk; chunk = chunk->index_next) {
+        if (chunk->addr == addr) {
+            return chunk;
+        }
+    }
+    return NULL;
+}
+
+static void
+wm_chunk_unplace(wmem_block_chunk_t *chunk)
+{
+    wmem_block_chunk_t **link = &wm_index[wm_index_of(chunk->addr)];
+
+    while (*link && *link != chunk) {
+        link = &(*link)->index_next;
+    }
+    if (!*link) {
+        wm_fail(261);
+    }
+    *link = chunk->index_next;
+}
+
+/* A chunk header goes back to the pool. Its authority is dead or has moved. */
+static void
+wm_chunk_delete(wmem_block_chunk_t *chunk)
+{
+    wm_chunk_unplace(chunk);
+    wm_chunk_forget(&chunk->auth);
+    chunk->index_next = wm_spare_chunks;
+    wm_spare_chunks = chunk;
+}
+
+static size_t
+wm_chunk_count(wmem_block_hdr_t *block)
+{
+    wmem_block_chunk_t *chunk;
+    size_t n = 0;
+
+    for (chunk = block->first; chunk; chunk = WMEM_CHUNK_NEXT(chunk)) {
+        ++n;
+    }
+    return n;
