+            slab[i].next = wm_spare_blocks;
+            wm_spare_blocks = &slab[i];
+        }
+    }
+    block = wm_spare_blocks;
+    wm_spare_blocks = block->next;
+    block->prev = block->next = NULL;
+    block->first = NULL;
+    return block;
+}
+
+static void
+wm_block_delete(wmem_block_hdr_t *block)
+{
+    wm_block_forget(&block->auth);
+    block->next = wm_spare_blocks;
+    wm_spare_blocks = block;
+}
