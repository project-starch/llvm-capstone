Subject: [PATCH 1/1] wmem objects as Sublet lifetimes (CDERIVE/CREVOKE)
Upstream: wireshark 4.6.8
Upstream-Archive: https://www.wireshark.org/download/src/all-versions/wireshark-4.6.8.tar.xz
Upstream-SHA256: c0f1ccf217bc0d3b51a9c03ea178b0f7df682e475da26a2d21cd4a1bdd9579d0
Build-Variants: sublet (capstone-application, WM_SUBLET=ON)
Depends-On: none
Apply-From: upstream source root, with patch --batch --forward --fuzz=0 -p1

Every object the two nested allocators hand out, block and block_fast, is a
child lifetime of its block, bounded to the request; freeing or reallocating
it, or the reset that ends its pool, revokes it, so every copy of the
caller's pointer dies with it. simple and strict are untouched: every object
of theirs is its own malloc'd object, which the system allocator bounds and
retires itself.

# Two instructions do the work. CDERIVE makes a child capability of a
# non-linear parent, bounded to a sub-range and carrying MANAGE over its own
# children; CREVOKE(parent, child) ends a direct child and everything below
# it, and faults when the child is not a live direct child.
#
# Every block carries two lifetimes in its header: life, derived from the
# malloc'd object, and the generation below it (wmem_allocator.h). Each
# allocator's consumer functions stay upstream's and work on the allocator's
# own pointers; three wrappers registered in their place hand out and take
# back the callers': alloc derives the caller's pointer from the generation
# of the block that holds the chunk, free revokes it and passes upstream's
# free the allocator's pointer at the same address, and realloc does both.
# The block is found by address in the allocator's block lists, so the
# caller's pointer covers its request only: not the chunk header, not the
# block header and its lifetimes. block_fast's free stays a no-op.
#
# Freeing a block revokes the system allocator's lifetime of it, and every
# object lies below. A reset that keeps a block (block's free_all keeps
# them all, block_fast's keeps the first) revokes its generation and derives
# a new one. A pointer found in no block faults on a load through it, as a
# stale one does once its block went back to the system allocator.
#
# block keeps its free-list links inside free chunks, and they carry the
# whole block's bounds. A chunk handed out is cleared of them over the
# caller's range, and so is the range a realloc grows into. block_fast keeps
# nothing in its chunks.
#
# Q-15 (the compact bounds format, vp2's, and capstone-qemu without exact
# bounds): CDERIVE refuses (29) a child it cannot hold exactly, and from 4 KiB
# up that means a base and a length on the granule 2^(msb(len)-9)
# (capstone/representable.h).  Every derive here is exact.  A caller's child
# is padded at its TAIL only, to capstone_repr_round of its request, and never
# reaches a chunk header, a block header or a neighbour.  Up to 16 KiB the
# granule is at most 16, which the 16-byte chunk alignment already meets; from
# 16 KiB the child is PLACED on its granule inside a chunk served that much
# larger, with its offset kept below it.  A realloc moves a placed object's
# bytes back to the chunk's data for the allocator's own copy and up again to
# the new placement.  A dedicated (jumbo) block is malloc'd at
# capstone_repr_round of its size and its life and generation cover that
# length.  The pad is counted; the corpus driver prints it (Q15_PAD).
# WMEM_SUBLET_Q15_PLANT_UNPADDED_JUMBO restores the unrounded jumbo block, for
# the planted negative control only.
--- a/wsutil/wmem/wmem_allocator.h
+++ b/wsutil/wmem/wmem_allocator.h
@@ -16,6 +16,9 @@
 #include <glib.h>
 #include <string.h>
 
+#include <capstone/capability.h>
+#include <capstone/representable.h>
+
 #ifdef __cplusplus
 extern "C" {
 #endif /* __cplusplus */
@@ -44,6 +47,193 @@
     bool                         in_scope;
 };
 
+/*
+ * Sublet lifetimes.  Every block the block and block_fast allocators take
+ * from the system allocator carries two lifetimes in its header: life,
+ * derived from the malloc'd object, and the generation below it.  Every
+ * object is handed out as a child of its block's generation (CDERIVE),
+ * bounded to the request; freeing or reallocating it revokes that child
+ * (CREVOKE).  Freeing the block revokes the system allocator's lifetime of
+ * it, and every object lies below; a reset that keeps the block revokes its
+ * generation and derives a new one.
+ */
+typedef struct _wmem_sublet_block_t {
+    void *life;
+    void *generation;
+} wmem_sublet_block_t;
+
+/* The block is the malloc'd object block, size bytes. */
+static inline void
+wmem_sublet_block_init(wmem_sublet_block_t *s, void *block, size_t size)
+{
+    s->life = capstone_cap_derive(block, 0, size);
+    s->generation = capstone_cap_derive(s->life, 0, size);
+}
+
+static inline void
+wmem_sublet_block_renew(wmem_sublet_block_t *s, size_t size)
+{
+    capstone_cap_revoke_child(s->life, s->generation);
+    s->generation = capstone_cap_derive(s->life, 0, size);
+}
+
+/* Whether ptr's address lies in the block. */
+static inline bool
+wmem_sublet_block_holds(const wmem_sublet_block_t *s, const void *ptr)
+{
+    unsigned long at = __builtin_capstone_cap_get_cursor((void *)ptr);
+
+    return at >= __builtin_capstone_cap_get_base(s->life) &&
+           at < __builtin_capstone_cap_get_end(s->life);
+}
+
+/*
+ * Q-15.  On the compact bounds format (vp2's, and capstone-qemu without exact
+ * bounds) CDERIVE refuses (29) a child it cannot hold exactly: from 4 KiB up,
+ * a base and a length on the granule 2^(msb(len)-9) (capstone/representable.h).
+ * Every derive here is made exact, and a child is padded at its TAIL only, so
+ * it never reaches a chunk header, a block header or a neighbour:
+ *
+ *  - a caller's child is [at, at + capstone_repr_round(size)).  Up to 16 KiB
+ *    the granule is at most 16, which the allocators' 16-byte chunk alignment
+ *    already meets, so at is the chunk's data and the allocator serves the
+ *    rounded length (wmem_sublet_request).  From 16 KiB the child is PLACED:
+ *    the allocator serves granule + WMEM_SUBLET_Q15_SLACK bytes more, at is the
+ *    first granule boundary at least WMEM_SUBLET_Q15_SLACK bytes into the data,
+ *    and the offset back to the data is kept in the 8 bytes below at, which the
+ *    child does not cover;
+ *  - a block's life and generation cover a representable length: a dedicated
+ *    (jumbo) block is malloc'd at capstone_repr_round of its size
+ *    (wmem_sublet_block_size), and the system allocator's own exact object puts
+ *    its base on that length's granule.
+ *
+ * The over-approximation is counted (wmem_sublet_q15_counts) and the corpus
+ * driver prints it, as "Q15_PAD chunks=N padded=N pad_bytes_total=N
+ * pad_bytes_max=N".  WMEM_SUBLET_Q15_PLANT_UNPADDED_JUMBO restores the
+ * unrounded jumbo block, for the planted negative control only.
+ */
+#define WMEM_SUBLET_Q15_ALIGN 16UL     /* the allocators' chunk data alignment */
+#define WMEM_SUBLET_Q15_SLACK 16UL     /* below a placed child: its offset */
+
+extern unsigned long wmem_sublet_q15_chunks, wmem_sublet_q15_padded,
+                     wmem_sublet_q15_pad_total, wmem_sublet_q15_pad_max;
+void wmem_sublet_q15_counts(unsigned long out[4]);
+
+/* Whether a child of len bytes is placed past the chunk's data. */
+static inline bool
+wmem_sublet_placed(size_t len)
+{
+    return capstone_repr_granule(len) > WMEM_SUBLET_Q15_ALIGN;
+}
+
+/* The bytes the allocator must serve for a caller's size bytes. */
+static inline size_t
+wmem_sublet_request(size_t size)
+{
+    size_t n = size < 4096 ? size : capstone_repr_round(size);
+
+    return wmem_sublet_placed(n) ?
+        n + capstone_repr_granule(n) + WMEM_SUBLET_Q15_SLACK : n;
+}
+
+/* The length a dedicated block of size bytes is malloc'd at and its
+ * lifetimes cover. */
+static inline size_t
+wmem_sublet_block_size(size_t size)
+{
+#ifdef WMEM_SUBLET_Q15_PLANT_UNPADDED_JUMBO
+    return size;
+#else
+    return capstone_repr_round(size);
+#endif
+}
+
+/* The caller's pointer to its size bytes in the chunk whose data is ptr (the
+ * allocator's pointer, wmem_sublet_request(size) bytes): a child of the
+ * generation, [at, at + capstone_repr_round(size)), that reaches neither the
+ * chunk header nor the block header.  *at_out is the allocator's pointer at at.
+ * A realloc passes move, the bytes it kept at the chunk's data, and a placed
+ * child gets them moved up to at BEFORE its offset is written below at. */
+static inline void *
+wmem_sublet_issue_at(const wmem_sublet_block_t *s, void *ptr, size_t size,
+                     uint8_t **at_out, size_t move)
+{
+    size_t   n = size < 4096 ? size : capstone_repr_round(size);
+    uint8_t *at = (uint8_t *)ptr;
+
+    if (n != size) {
+        wmem_sublet_q15_padded++;
+        wmem_sublet_q15_pad_total += n - size;
+        if (n - size > wmem_sublet_q15_pad_max)
+            wmem_sublet_q15_pad_max = n - size;
+    }
+    wmem_sublet_q15_chunks++;
+    if (wmem_sublet_placed(n)) {
+        unsigned long c = __builtin_capstone_cap_get_cursor(ptr);
+        unsigned long g = capstone_repr_granule(n);
+        unsigned long a = (c + WMEM_SUBLET_Q15_SLACK + g - 1) & ~(g - 1);
+
+        at += a - c;
+        if (move)
+            memmove(at, ptr, move < n ? move : n);
+        *(uint64_t *)(at - 8) = a - c;
+    }
+    if (at_out)
+        *at_out = at;
+    return capstone_cap_derive(s->generation,
+            __builtin_capstone_cap_get_cursor(at) -
+            __builtin_capstone_cap_get_base(s->generation), n);
+}
+
+static inline void *
+wmem_sublet_issue(const wmem_sublet_block_t *s, void *ptr, size_t size)
+{
+    return wmem_sublet_issue_at(s, ptr, size, NULL, 0);
+}
+
+/* End the caller's object (CREVOKE), which faults unless ptr is a live
+ * object of this block, and return the allocator's pointer to the chunk's
+ * data.  A placed object's bytes are moved back to the chunk's data first,
+ * so the allocator's own realloc copies them from where it expects them;
+ * *len_out is the child's length. */
+static inline void *
+wmem_sublet_release_len(const wmem_sublet_block_t *s, void *block, void *ptr,
+                        size_t *len_out, bool move_back)
+{
+    size_t   len = __builtin_capstone_cap_get_end(ptr) -
+                   __builtin_capstone_cap_get_base(ptr);
+    uint8_t *at;
+
+    capstone_cap_revoke_child(s->generation, ptr);
+    at = (uint8_t *)block + (__builtin_capstone_cap_get_cursor(ptr) -
+            __builtin_capstone_cap_get_base(block));
+    if (wmem_sublet_placed(len)) {
+        uint64_t off = *(uint64_t *)(at - 8);
+
+        if (move_back)
+            memmove(at - off, at, len);
+        at -= off;
+    }
+    if (len_out)
+        *len_out = len;
+    return at;
+}
+
+static inline void *
+wmem_sublet_release(const wmem_sublet_block_t *s, void *block, void *ptr)
+{
+    return wmem_sublet_release_len(s, block, ptr, NULL, false);
+}
+
+/* A pointer in no block of the allocator: a stale one faults on this load,
+ * since its block went back to the system allocator. */
+static inline void
+wmem_sublet_refuse(const void *ptr)
+{
+    (void)*(const volatile uint8_t *)ptr;
+    g_assert_not_reached();
+}
+
 #ifdef __cplusplus
 }
 #endif /* __cplusplus */
