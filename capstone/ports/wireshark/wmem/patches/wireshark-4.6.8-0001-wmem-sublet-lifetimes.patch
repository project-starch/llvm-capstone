+/* SUBLET: the consumer functions above work on the allocator's own pointers;
+ * these hand out and take back the callers'. */
+
+static wmem_block_hdr_t *
+wmem_block_sublet_find(wmem_block_allocator_t *allocator, const void *ptr)
+{
+    wmem_block_hdr_t *cur;
+
+    for (cur = allocator->block_list; cur; cur = cur->next) {
+        if (wmem_sublet_block_holds(&cur->sublet, ptr)) {
+            return cur;
+        }
+    }
+    wmem_sublet_refuse(ptr);
+    return NULL;
+}
+
+static void *
+wmem_block_sublet_issue(wmem_block_allocator_t *allocator, void *ptr,
+                        const size_t size)
+{
+    return wmem_sublet_issue(&wmem_block_sublet_find(allocator, ptr)->sublet,
+                             ptr, size);
+}
+
+static void *
+wmem_block_sublet_release(wmem_block_allocator_t *allocator, void *ptr)
+{
+    wmem_block_hdr_t *block = wmem_block_sublet_find(allocator, ptr);
+
+    return wmem_sublet_release(&block->sublet, block, ptr);
+}
+
+/* A free chunk holds its free-list links, pointers with the whole block's
+ * bounds; the caller's bytes are cleared of them before it gets the chunk. */
+static void *
+wmem_block_sublet_alloc(void *private_data, const size_t size)
+{
+    void *ptr = wmem_block_alloc(private_data, size);
+
+    memset(ptr, 0, size < sizeof(wmem_block_free_t) ? size : sizeof(wmem_block_free_t));
+    return wmem_block_sublet_issue((wmem_block_allocator_t*) private_data,
+                                   ptr, size);
+}
+
+static void
+wmem_block_sublet_free(void *private_data, void *ptr)
+{
+    wmem_block_free(private_data, wmem_block_sublet_release(
+                (wmem_block_allocator_t*) private_data, ptr));
+}
+
+static void *
+wmem_block_sublet_realloc(void *private_data, void *ptr, const size_t size)
+{
+    wmem_block_allocator_t *allocator = (wmem_block_allocator_t*) private_data;
+    size_t                  had;
+
+    /* The caller's object is bounded to its request; bytes past it, which a
+     * grow brings in, may hold free-list links and are cleared. */
+    had = __builtin_capstone_cap_get_end(ptr) -
+          __builtin_capstone_cap_get_base(ptr);
+    ptr = wmem_block_realloc(private_data,
+                             wmem_block_sublet_release(allocator, ptr), size);
+    if (size > had) {
+        memset((uint8_t *)ptr + had, 0, size - had);
+    }
+    return wmem_block_sublet_issue(allocator, ptr, size);
+}
+
 void
