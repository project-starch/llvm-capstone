+/* SUBLET: the consumer functions above work on the allocator's own pointers;
+ * these hand out and take back the callers'.  free stays a no-op: an object
+ * lives until the reset, or until realloc replaces it. */
+
+static wmem_sublet_block_t *
+wmem_block_fast_sublet_find(wmem_block_fast_allocator_t *allocator,
+                            const void *ptr, void **block)
+{
+    wmem_block_fast_hdr_t   *cur;
+    wmem_block_fast_jumbo_t *cur_jum;
+
+    for (cur = allocator->block_list; cur; cur = cur->next) {
+        if (wmem_sublet_block_holds(&cur->sublet, ptr)) {
+            *block = cur;
+            return &cur->sublet;
+        }
+    }
+    for (cur_jum = allocator->jumbo_list; cur_jum; cur_jum = cur_jum->next) {
+        if (wmem_sublet_block_holds(&cur_jum->sublet, ptr)) {
+            *block = cur_jum;
+            return &cur_jum->sublet;
+        }
+    }
+    wmem_sublet_refuse(ptr);
+    return NULL;
+}
+
+static void *
+wmem_block_fast_sublet_issue(wmem_block_fast_allocator_t *allocator,
+                             void *ptr, const size_t size)
+{
+    void *block;
+
+    return wmem_sublet_issue(wmem_block_fast_sublet_find(allocator, ptr, &block),
+                             ptr, size);
+}
+
+static void *
+wmem_block_fast_sublet_alloc(void *private_data, const size_t size)
+{
+    return wmem_block_fast_sublet_issue(
+            (wmem_block_fast_allocator_t*) private_data,
+            wmem_block_fast_alloc(private_data, size), size);
+}
+
+static void *
+wmem_block_fast_sublet_realloc(void *private_data, void *ptr, const size_t size)
+{
+    wmem_block_fast_allocator_t *allocator = (wmem_block_fast_allocator_t*) private_data;
+    wmem_sublet_block_t         *sublet;
+    void                        *block;
+
+    sublet = wmem_block_fast_sublet_find(allocator, ptr, &block);
+    ptr = wmem_sublet_release(sublet, block, ptr);
+    return wmem_block_fast_sublet_issue(allocator,
+            wmem_block_fast_realloc(private_data, ptr, size), size);
+}
+
 void
 wmem_block_fast_allocator_init(wmem_allocator_t *allocator)
 {
