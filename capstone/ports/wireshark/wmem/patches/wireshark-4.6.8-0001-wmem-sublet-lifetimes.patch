+/* SUBLET: the consumer functions above work on the allocator's own pointers;
+ * these hand out and take back the callers'. */
+
+/* Q-15's over-approximation, for both nested allocators (wmem_allocator.h). */
+unsigned long wmem_sublet_q15_chunks, wmem_sublet_q15_padded,
+              wmem_sublet_q15_pad_total, wmem_sublet_q15_pad_max;
+
+void
+wmem_sublet_q15_counts(unsigned long out[4])
+{
+    out[0] = wmem_sublet_q15_chunks;
+    out[1] = wmem_sublet_q15_padded;
+    out[2] = wmem_sublet_q15_pad_total;
+    out[3] = wmem_sublet_q15_pad_max;
+}
+
+static wmem_block_hdr_t *
+wmem_block_sublet_find(wmem_block_allocator_t *allocator, const void *ptr)
+{
+    wmem_block_hdr_t *cur;
+
+    for (cur = allocator->block_list; cur; cur = cur->next) {
+        if (wmem_sublet_block_holds(&cur->sublet, ptr)) {
+            return cur;
+        }
+    }
+    wmem_sublet_refuse(ptr);
+    return NULL;
+}
+
+static void *
+wmem_block_sublet_issue(wmem_block_allocator_t *allocator, void *ptr,
+                        const size_t size)
+{
+    return wmem_sublet_issue(&wmem_block_sublet_find(allocator, ptr)->sublet,
+                             ptr, size);
+}
+
+static void *
+wmem_block_sublet_release(wmem_block_allocator_t *allocator, void *ptr)
+{
+    wmem_block_hdr_t *block = wmem_block_sublet_find(allocator, ptr);
+
+    return wmem_sublet_release(&block->sublet, block, ptr);
+}
+
+/* For realloc: the object's bytes go back to the chunk's data, and its
+ * length is returned. */
+static void *
+wmem_block_sublet_release_len(wmem_block_allocator_t *allocator, void *ptr,
+                              size_t *len)
+{
+    wmem_block_hdr_t *block = wmem_block_sublet_find(allocator, ptr);
+
+    return wmem_sublet_release_len(&block->sublet, block, ptr, len, true);
+}
+
+/* A free chunk holds its free-list links, pointers with the whole block's
+ * bounds; the caller's bytes are cleared of them before it gets the chunk. */
+static void *
+wmem_block_sublet_alloc(void *private_data, const size_t size)
+{
+    size_t request = wmem_sublet_request(size);
+    void  *ptr = wmem_block_alloc(private_data, request);
+
+    memset(ptr, 0, request < sizeof(wmem_block_free_t) ? request : sizeof(wmem_block_free_t));
+    return wmem_block_sublet_issue((wmem_block_allocator_t*) private_data,
+                                   ptr, size);
+}
+
+static void
+wmem_block_sublet_free(void *private_data, void *ptr)
+{
+    wmem_block_free(private_data, wmem_block_sublet_release(
+                (wmem_block_allocator_t*) private_data, ptr));
+}
+
+static void *
+wmem_block_sublet_realloc(void *private_data, void *ptr, const size_t size)
+{
+    wmem_block_allocator_t *allocator = (wmem_block_allocator_t*) private_data;
+    size_t                  had, n;
+    uint8_t                *at;
+    void                   *issued;
+
+    /* The caller's object is bounded to its request; bytes past it, which a
+     * grow brings in, may hold free-list links and are cleared.  The old
+     * object's bytes are at the chunk's data for the allocator's copy, and
+     * the issue moves them up to a placed child. */
+    ptr = wmem_block_realloc(private_data,
+                             wmem_block_sublet_release_len(allocator, ptr, &had),
+                             wmem_sublet_request(size));
+    issued = wmem_sublet_issue_at(&wmem_block_sublet_find(allocator, ptr)->sublet,
+                                  ptr, size, &at, had);
+    n = size < 4096 ? size : capstone_repr_round(size);
+    if (n > had) {
+        memset(at + had, 0, n - had);
+    }
+    return issued;
+}
+
