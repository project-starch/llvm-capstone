statement ok
CREATE TABLE s6(a INTEGER, b INTEGER, c INTEGER, d INTEGER, e INTEGER)

statement ok
CREATE TABLE s7(a INTEGER, b INTEGER, c INTEGER, d INTEGER, e INTEGER)

query I nosort
SELECT x0.a FROM s0 AS x0, s1 AS y0
----

