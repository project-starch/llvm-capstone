+SQLITE_API void sqlite3_sublet_grant(void *pLinear){
+  capstone_cap_store(&memsys5Grant, pLinear);
+}
+SQLITE_API void sqlite3_sublet_pool(unsigned long *pBase, unsigned long *pEnd){
+  if( capstone_cap_type(&memsys5Grant)==7 ){ *pBase = *pEnd = 0; return; }
+  *pBase = capstone_cap_base(&memsys5Grant);
+  *pEnd = capstone_cap_end(&memsys5Grant);
+}
+SQLITE_API void sqlite3_sublet_stats(unsigned long *aOut){
+  aOut[0] = sublet_stats.split;
+  aOut[1] = sublet_stats.mrev;
+  aOut[2] = sublet_stats.delin;
+  aOut[3] = sublet_stats.revoke;
+  aOut[4] = sublet_stats.init;
