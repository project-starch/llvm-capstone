+/* CAPSTONE_Q15_TRACE=1 in the environment prints every padded derive as it
+** happens, so a case that faults still shows which pads it had: a case with
+** none cannot be pad-masked.  Read once; inert when unset. */
+static void capstoneQ15Note(u64 pad){
+  static int trace = -1;
+  mem5.q15Items++;
+  if( pad ){
+    mem5.q15Padded++;
+    mem5.q15PadBytes += pad;
+    if( mem5.q15PadMax<pad ) mem5.q15PadMax = pad;
+    if( trace<0 ){
+      const char *z = getenv("CAPSTONE_Q15_TRACE");
+      trace = z && z[0]=='1';
+    }
+    if( trace ){
+      fprintf(stderr, "Q15_PADDED item=%llu pad=%llu\n",
+              (unsigned long long)mem5.q15Items, (unsigned long long)pad);
+    }
+  }
+}
+/* items, padded, pad_bytes_total, pad_bytes_max: the Q15_PAD line's fields */
+SQLITE_API void sqlite3CapstoneQ15Pad(unsigned long *aOut){
+  aOut[0] = mem5.q15Items; aOut[1] = mem5.q15Padded;
+  aOut[2] = mem5.q15PadBytes; aOut[3] = mem5.q15PadMax;
+}
 
