+#ifdef SQLITE_STUDY_ORACLE
+/* FNV-1a over every SQL result cell, with row, column and NULL delimiters.
+ * Main does not use upstream --verify as a SQL-result oracle. */
+static unsigned long long study_hash;
+static unsigned long long study_rows;
+static int study_phase;
+static void study_byte(unsigned char c){
+  study_hash = (study_hash ^ c) * 1099511628211ULL;
+}
+static void study_cell(const char *z){
+  const unsigned char *p = (const unsigned char *)z;
+  if( !p ){ study_byte(0); return; }
+  study_byte(1);
+  while( *p ) study_byte(*p++);
+  study_byte(0);
+}
+static int study_exec_row(void *unused, int n, char **values, char **names){
+  int i;
+  (void)unused; (void)names;
+  study_byte(0xff);
+  study_byte((unsigned char)n);
+  for(i=0; i<n; i++) study_cell(values[i]);
+  study_rows++;
+  return 0;
+}
+#endif
+
