Subject: [PATCH 3/3] pymalloc blocks as Sublet child lifetimes (CDERIVE/CREVOKE)
Upstream: CPython 3.13.7
Upstream-Archive: https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tgz
Upstream-SHA256: 6c9d80839cfa20024f34d9a6dd31ae2a9cd97ff5e980e969209746037a5153b2
Build-Variants: Capstone application, PYMALLOC_SUBLET=ON (prepare-source.py --variant protected)
Depends-On: cpython-3.13.7-0002-capability-provenance.patch
Apply-From: upstream source root, with patch --batch --forward --fuzz=0 -p1

The protection is two instructions where obmalloc hands a block out and takes
it back (capstone/docs/design/virtual-capstone/isa.md); the interpreter's
patch 0014 makes the same changes in the full tree:

- new_arena derives a child of the arena (arena_life), at the arena's own
  address within the capability the arena allocator returned.
- pymalloc_alloc returns a child of arena_life bounded to the request.
- The arena release in insert_to_freepool ends arena_life (CREVOKE) before
  it gives the arena back, so every block still issued from the arena ends
  with it: the port's arena allocator hands the same memory out again.
- pymalloc_free ends that child's lifetime (CREVOKE, one operand), which
  faults on a stale reference, and continues with obmalloc's own pointer.
  POOL_ADDR (0002) resolves the pool by address, so no client pointer is
  dereferenced.
- pymalloc_realloc replaces the client's child when the block stays, and
  copies only the issued length when it moves. The new child begins before
  the old one ends.

When the lifetime table has no slot left and cannot grow, CDERIVE returns an
untagged 0. new_arena then gives the arena back and fails, pymalloc_alloc
gives the block back to its pool and returns NULL, and the in-place realloc
returns NULL with the old block intact: obmalloc's own out-of-memory paths.

--- a/Include/internal/pycore_obmalloc.h
+++ b/Include/internal/pycore_obmalloc.h
@@ -273,6 +273,9 @@
      * allocated arena.
      */
     uintptr_t address;
+    /* Sublet: the arena's child lifetime (CDERIVE). Every block handed out
+     * is derived from it, so every block lies below it. */
+    void *arena_life;
 
     /* Pool-aligned pointer to the next pool to be carved off. */
     pymem_block* pool_address;
--- a/Objects/obmalloc.c
+++ b/Objects/obmalloc.c
@@ -2,6 +2,7 @@
 
 #ifdef PYMALLOC_PORT
 #include "pymalloc-compat.h"
+#include <capstone/capability.h>  /* Sublet: CDERIVE, CREVOKE */
 #else
 #include "Python.h"
 #include "pycore_code.h"          // stats
@@ -1903,6 +1904,24 @@
         unused_arena_objects = arenaobj;
         return NULL;
     }
+    {
+        /* The arena's child, at its own address within whatever capability
+           the arena allocator returned. Without a lifetime left (CDERIVE's
+           untagged 0) the arena goes back as when the allocation fails. */
+        capstone_cap_slot slot;
+        capstone_cap_store(&slot, address);
+        arenaobj->arena_life = capstone_cap_derive(
+            address, (uintptr_t)address - capstone_cap_base(&slot), ARENA_SIZE);
+    }
+    if (arenaobj->arena_life == NULL) {
+#if WITH_PYMALLOC_RADIX_TREE
+        arena_map_mark_used(state, (uintptr_t)address, 0);
+#endif
+        _PyObject_Arena.free(_PyObject_Arena.ctx, address, ARENA_SIZE);
+        arenaobj->nextarena = unused_arena_objects;
+        unused_arena_objects = arenaobj;
+        return NULL;
+    }
     arenaobj->address = (uintptr_t)address;
 
     ++narenas_currently_allocated;
@@ -2181,8 +2200,31 @@
     pool->freeblock = bp + size;
     *(pymem_block **)(pool->freeblock) = NULL;
     return bp;
+}
+
+/* Sublet: a block handed out to a client is a child lifetime of its arena,
+ * bounded to the request. */
+static void *
+block_issue(OMState *state, pymem_block *bp, size_t nbytes)
+{
+    struct arena_object *ao = &allarenas[POOL_ADDR(bp)->arenaindex];
+    return capstone_cap_derive(ao->arena_life, (uintptr_t)bp - ao->address,
+                               nbytes ? nbytes : 1);
 }
 
+/* Sublet: link obmalloc's own pointer P back into its pool, as pymalloc_free
+ * does once the client's lifetime of the block has ended. */
+static int pymalloc_give_back(OMState *state, pymem_block *p);
+
+/* Sublet: the length a client's block was issued with. */
+static size_t
+block_requested(void *p)
+{
+    capstone_cap_slot slot;
+    capstone_cap_store(&slot, p);
+    return capstone_cap_end(&slot) - capstone_cap_base(&slot);
+}
+
 /* pymalloc allocator
 
    Return a pointer to newly allocated memory if pymalloc allocated memory.
@@ -2235,7 +2277,18 @@
         bp = allocate_from_new_pool(state, size);
     }
 
-    return (void *)bp;
+    /* No arena could be had: NULL, as upstream. */
+    if (UNLIKELY(bp == NULL)) {
+        return NULL;
+    }
+    void *issued = block_issue(state, bp, nbytes);
+    if (UNLIKELY(issued == NULL)) {
+        /* The table has no lifetime left (CDERIVE's untagged 0): the block
+           goes back to its pool, and the request fails as when no arena can
+           be had. */
+        pymalloc_give_back(state, bp);
+    }
+    return issued;
 }
 
 
@@ -2380,7 +2433,10 @@
         arena_map_mark_used(state, ao->address, 0);
 #endif
 
-        /* Free the entire arena. */
+        /* Free the entire arena. Sublet: end arena_life first, and with it
+           every block still issued from this arena: the arena allocator may
+           hand the same memory out again. */
+        capstone_cap_release(ao->arena_life);
         _PyObject_Arena.free(_PyObject_Arena.ctx,
                              pym_arena_pointer(ao->address), ARENA_SIZE);
         ao->address = 0;                        /* mark unassociated */
@@ -2478,8 +2534,20 @@
     if (UNLIKELY(!address_in_range(state, p, pool))) {
         return 0;
     }
-    /* We allocated this address. */
+    /* We allocated this address. End the client's lifetime of the block;
+       CREVOKE faults on a stale reference, so a double free stops here.
+       POOL_ADDR resolved the pool by address, so obmalloc continues with its
+       own pointer. */
+    capstone_cap_release(p);
+    return pymalloc_give_back(
+        state, (pymem_block *)pool + ((uintptr_t)p - (uintptr_t)pool));
+}
 
+static int
+pymalloc_give_back(OMState *state, pymem_block *p)
+{
+    poolp pool = POOL_ADDR(p);
+
     /* Link p to the start of the pool's freeblock list.  Since
      * the pool had at least the p block outstanding, the pool
      * wasn't empty (so it's already in a usedpools[] list, or
@@ -2592,11 +2660,25 @@
            The compromise here is to copy on shrink only if at least 25% of
            size can be shaved off. */
         if (4 * nbytes > 3 * size) {
-            /* It's the same, or shrinking and new/old > 3/4. */
-            *newptr_p = p;
+            /* It's the same, or shrinking and new/old > 3/4. The block stays;
+               its client lifetime is replaced by one of the new length. The
+               new one begins before the old one ends, so that without a
+               lifetime left the realloc fails with the old block intact. */
+            void *issued = block_issue(
+                state, (pymem_block *)pool + ((uintptr_t)p - (uintptr_t)pool), nbytes);
+            if (UNLIKELY(issued == NULL)) {
+                *newptr_p = NULL;
+                return 1;
+            }
+            capstone_cap_release(p);
+            *newptr_p = issued;
             return 1;
         }
         size = nbytes;
+    }
+    /* Only the issued length is the client's. */
+    if (size > block_requested(p)) {
+        size = block_requested(p);
     }
 
     bp = _PyObject_Malloc(ctx, nbytes);
