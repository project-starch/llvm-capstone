+/* Sublet: a block handed out to a client is a child lifetime of its arena,
+ * bounded to the request. */
+static void *
+block_issue(OMState *state, pymem_block *bp, size_t nbytes)
+{
+    struct arena_object *ao = &allarenas[POOL_ADDR(bp)->arenaindex];
+    return capstone_cap_derive(ao->arena_life, (uintptr_t)bp - ao->address,
+                               nbytes ? nbytes : 1);
+}
+
+/* Sublet: the length a client's block was issued with. */
+static size_t
+block_requested(void *p)
+{
+    capstone_cap_slot slot;
+    capstone_cap_store(&slot, p);
+    return capstone_cap_end(&slot) - capstone_cap_base(&slot);
+}
+
