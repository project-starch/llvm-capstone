Subject: [PATCH 0009] Derive pymalloc's pools from the arena pointer, and align pointers without a round trip
Upstream: CPython 3.13.7
Upstream-Archive: https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tgz
Upstream-SHA256: 6c9d80839cfa20024f34d9a6dd31ae2a9cd97ff5e980e969209746037a5153b2
Build-Variants: capstone64 domain (musl)
Apply-From: upstream source root, with patch --batch --forward --fuzz=0 -p1

obmalloc keeps each arena as uintptr_t address and rebuilt pointers from it:
pool_address = (pymem_block *)address in new_arena, the arena free in two
places, and the pool walks in the statistics functions. Where a pointer is a
capability each of those is an untagged pointer; the first pool carved from a
new arena, which is the first small allocation of all, would trap.

- struct arena_object keeps the pointer malloc returned beside the address,
  arena_ptr, read through _Py_ARENA_PTR(); every pointer into the arena is
  derived from it. _Py_ARENA_KEEPS_POINTER selects it on any platform (tested
  on x86-64 with 0008's switch, same suites as 0008).
- _Py_ALIGN_DOWN/_Py_ALIGN_UP (pymacro.h) become clang's __builtin_align_down
  and __builtin_align_up there, which move the address and keep the
  capability. They serve POOL_ADDR, which finds the pool of every block freed,
  stringlib's fastsearch and pyarena. The compiler lowers them through
  llvm.ptrmask, which it can do since C-51.
- _PyMem_FreeDelayed and _PyObject_FreeDelayed free at once, without the
  uintptr_t round trip, where the GIL is not disabled; free_delayed already
  did exactly that there.

What is not changed: arena_map_get and arena_map_mark_used are handed a
pointer rebuilt from an address, but use only its address bits to index the
radix tree and never dereference it.

--- a/Include/pymacro.h
+++ b/Include/pymacro.h
@@ -121,11 +121,21 @@
 /* Round up size "n" to be a multiple of "a". */
 #define _Py_SIZE_ROUND_UP(n, a) (((size_t)(n) + \
         (size_t)((a) - 1)) & ~(size_t)((a) - 1))
+#if defined(_Py_SIZEOF_ADDRESS) && _Py_SIZEOF_ADDRESS < SIZEOF_VOID_P
+/* Where a pointer is a capability, a round trip through uintptr_t keeps only
+   the address and the result traps when used. clang's alignment builtins move
+   the address and keep the capability; on an integer they are the plain
+   rounding. The result has the argument's type rather than void *; every
+   caller casts it or passes an integer. */
+#  define _Py_ALIGN_DOWN(p, a) __builtin_align_down((p), (a))
+#  define _Py_ALIGN_UP(p, a) __builtin_align_up((p), (a))
+#else
 /* Round pointer "p" down to the closest "a"-aligned address <= "p". */
 #define _Py_ALIGN_DOWN(p, a) ((void *)((uintptr_t)(p) & ~(uintptr_t)((a) - 1)))
 /* Round pointer "p" up to the closest "a"-aligned address >= "p". */
 #define _Py_ALIGN_UP(p, a) ((void *)(((uintptr_t)(p) + \
         (uintptr_t)((a) - 1)) & ~(uintptr_t)((a) - 1)))
+#endif
 /* Check if pointer "p" is aligned to "a"-bytes boundary. */
 #define _Py_IS_ALIGNED(p, a) (!((uintptr_t)(p) & (uintptr_t)((a) - 1)))
 
--- a/Include/internal/pycore_obmalloc.h
+++ b/Include/internal/pycore_obmalloc.h
@@ -273,6 +273,19 @@
      * allocated arena.
      */
     uintptr_t address;
+#if _Py_SIZEOF_ADDRESS < SIZEOF_VOID_P && !defined(_Py_ARENA_KEEPS_POINTER)
+#  define _Py_ARENA_KEEPS_POINTER 1
+#endif
+#ifdef _Py_ARENA_KEEPS_POINTER
+    /* Where a pointer is a capability, the arena as the allocator returned
+     * it: address above is only its address, and a pointer rebuilt from it
+     * traps when used. Every pointer into the arena is derived from this.
+     * Defining _Py_ARENA_KEEPS_POINTER selects it anywhere, for testing. */
+    pymem_block *arena_ptr;
+#  define _Py_ARENA_PTR(ao) ((ao)->arena_ptr)
+#else
+#  define _Py_ARENA_PTR(ao) ((pymem_block *)(ao)->address)
+#endif
 
     /* Pool-aligned pointer to the next pool to be carved off. */
     pymem_block* pool_address;
