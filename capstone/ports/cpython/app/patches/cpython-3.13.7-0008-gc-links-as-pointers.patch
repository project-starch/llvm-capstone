Subject: [PATCH 0008] Keep the GC list links as pointers where a pointer is a capability
Upstream: CPython 3.13.7
Upstream-Archive: https://www.python.org/ftp/python/3.13.7/Python-3.13.7.tgz
Upstream-SHA256: 6c9d80839cfa20024f34d9a6dd31ae2a9cd97ff5e980e969209746037a5153b2
Build-Variants: capstone64 domain (musl)
Apply-From: upstream source root, with patch --batch --forward --fuzz=0 -p1

PyGC_Head links every tracked object into its generation's list through two
words, _gc_next and _gc_prev, declared uintptr_t, with flag bits in the low
bits of the address and, during a collection, a reference count in the upper
bits of _gc_prev. Where a pointer is a capability an integer holds only its
address: the link was lost at the store, the pointer read back from it was
untagged, and the first list operation that followed one (gc_list_remove, in
every untrack) would trap. That is before any collection, so no interpreter
can start without this.

In capability builds the words become char *, and every operation on them
goes through four helpers in pycore_gc.h that are pointer arithmetic on the
address: _PyGCWord_BITS reads the bits, _PyGCWord_MAKE builds a word from a
pointer (whose capability it takes) and flag bits, _PyGCWord_SETBITS replaces
bits and keeps the word's capability, _PyGCWord_PTR strips flags. A count in
_gc_prev is a word no one dereferences; _PyGCHead_SET_PREV therefore takes the
capability from the new pointer and only the flag bits from the old word.
Elsewhere the helpers expand to exactly the upstream expressions.

_Py_GC_WORD_AS_POINTER selects the pointer representation on any platform.
Measured on x86-64 with it defined: test_gc, test_weakref, test_finalization
and 17 more suites pass (patches 0001-0009, 4952 tests). The check fires: with
_PyGCWord_PTR made to keep the flag bits, the build's own _freeze_module
segfaults.

PyGC_Head grows from 16 to 32 bytes on capstone64, two capabilities, and
keeps the object behind it on the 16-byte boundary a capability needs.

--- a/Include/internal/pycore_gc.h
+++ b/Include/internal/pycore_gc.h
@@ -10,15 +10,54 @@
 
 #include "pycore_freelist.h"   // _PyFreeListState
 
+/* A GC word holds a pointer to another GC head with flag bits in the low bits
+ * of its address, or, during a collection, a count in the upper bits.
+ *
+ * Upstream stores it as uintptr_t. Where a pointer is a capability (capstone64:
+ * uintptr_t is the 8-byte address of a 16-byte capability) an integer cannot
+ * hold the pointer at all: what is stored is the address, and the pointer read
+ * back from it is untagged and traps when used. There the word is a char *
+ * instead, and every flag or count operation is pointer arithmetic on its
+ * address, which keeps the capability. _Py_GC_WORD_AS_POINTER selects that
+ * representation on any platform, so the capability path can be tested where
+ * the tests run.
+ *
+ * The helpers:
+ *   _PyGCWord_BITS(w)           the address bits, for tests and counts
+ *   _PyGCWord_MAKE(p, bits)     a word pointing at p, with bits (flags that are
+ *                               clear in p's address) set; the capability is p's
+ *   _PyGCWord_SETBITS(w, m, v)  w with the bits in mask m replaced by v; the
+ *                               capability stays w's
+ *   _PyGCWord_PTR(w, m)         the pointer in w, with the flag bits m cleared
+ */
+#if _Py_SIZEOF_ADDRESS < SIZEOF_VOID_P && !defined(_Py_GC_WORD_AS_POINTER)
+#  define _Py_GC_WORD_AS_POINTER 1
+#endif
+#ifdef _Py_GC_WORD_AS_POINTER
+typedef char *_PyGCWord;
+#  define _PyGCWord_BITS(w) ((uintptr_t)(w))
+#  define _PyGCWord_MAKE(p, bits) ((char *)(p) + (bits))
+#  define _PyGCWord_SETBITS(w, m, v) \
+    ((w) + (Py_ssize_t)((uintptr_t)(v) - ((uintptr_t)(w) & (uintptr_t)(m))))
+#  define _PyGCWord_PTR(w, m) ((void *)((w) - ((uintptr_t)(w) & (uintptr_t)(m))))
+#else
+typedef uintptr_t _PyGCWord;
+#  define _PyGCWord_BITS(w) ((uintptr_t)(w))
+#  define _PyGCWord_MAKE(p, bits) ((uintptr_t)(p) | (uintptr_t)(bits))
+#  define _PyGCWord_SETBITS(w, m, v) \
+    (((w) & ~(uintptr_t)(m)) | (uintptr_t)(v))
+#  define _PyGCWord_PTR(w, m) ((void *)((w) & ~(uintptr_t)(m)))
+#endif
+
 /* GC information is stored BEFORE the object structure. */
 typedef struct {
     // Pointer to next object in the list.
     // 0 means the object is not tracked
-    uintptr_t _gc_next;
+    _PyGCWord _gc_next;
 
     // Pointer to previous object in the list.
     // Lowest two bits are used for flags documented later.
-    uintptr_t _gc_prev;
+    _PyGCWord _gc_prev;
 } PyGC_Head;
 
 #define _PyGC_Head_UNUSED PyGC_Head
@@ -172,22 +211,22 @@
 // Lowest bit of _gc_next is used for flags only in GC.
 // But it is always 0 for normal code.
 static inline PyGC_Head* _PyGCHead_NEXT(PyGC_Head *gc) {
-    uintptr_t next = gc->_gc_next;
-    return (PyGC_Head*)next;
+    return (PyGC_Head*)_PyGCWord_PTR(gc->_gc_next, 0);
 }
 static inline void _PyGCHead_SET_NEXT(PyGC_Head *gc, PyGC_Head *next) {
-    gc->_gc_next = (uintptr_t)next;
+    gc->_gc_next = _PyGCWord_MAKE(next, 0);
 }
 
 // Lowest two bits of _gc_prev is used for _PyGC_PREV_MASK_* flags.
 static inline PyGC_Head* _PyGCHead_PREV(PyGC_Head *gc) {
-    uintptr_t prev = (gc->_gc_prev & _PyGC_PREV_MASK);
-    return (PyGC_Head*)prev;
+    return (PyGC_Head*)_PyGCWord_PTR(gc->_gc_prev, ~_PyGC_PREV_MASK);
 }
 static inline void _PyGCHead_SET_PREV(PyGC_Head *gc, PyGC_Head *prev) {
-    uintptr_t uprev = (uintptr_t)prev;
-    assert((uprev & ~_PyGC_PREV_MASK) == 0);
-    gc->_gc_prev = ((gc->_gc_prev & ~_PyGC_PREV_MASK) | uprev);
+    // The pointer, and so the capability, is prev's; only the flag bits are
+    // carried over from the old word, which may hold a count, not a pointer.
+    assert(((uintptr_t)prev & ~_PyGC_PREV_MASK) == 0);
+    gc->_gc_prev = _PyGCWord_MAKE(
+        prev, _PyGCWord_BITS(gc->_gc_prev) & ~_PyGC_PREV_MASK);
 }
 
