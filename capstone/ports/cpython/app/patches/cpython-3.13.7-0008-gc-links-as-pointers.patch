@@ -203,7 +242,8 @@
     _PyObject_SET_GC_BITS(op, _PyGC_BITS_FINALIZED);
 #else
     PyGC_Head *gc = _Py_AS_GC(op);
-    gc->_gc_prev |= _PyGC_PREV_MASK_FINALIZED;
+    gc->_gc_prev = _PyGCWord_SETBITS(gc->_gc_prev, _PyGC_PREV_MASK_FINALIZED,
+                                     _PyGC_PREV_MASK_FINALIZED);
 #endif
 }
 static inline void _PyGC_CLEAR_FINALIZED(PyObject *op) {
@@ -211,7 +251,7 @@
     _PyObject_CLEAR_GC_BITS(op, _PyGC_BITS_FINALIZED);
 #else
     PyGC_Head *gc = _Py_AS_GC(op);
-    gc->_gc_prev &= ~_PyGC_PREV_MASK_FINALIZED;
+    gc->_gc_prev = _PyGCWord_SETBITS(gc->_gc_prev, _PyGC_PREV_MASK_FINALIZED, 0);
 #endif
 }
 
