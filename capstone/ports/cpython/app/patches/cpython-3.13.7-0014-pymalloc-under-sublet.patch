+/* The Sublet lifetime adapter (ports/cpython/pymalloc/src/allocators/sublet/).
+   obmalloc's arena, pool and block transitions go through these; the adapter
+   holds every capability in a slot and hands out a freshly derived alias, so
+   that no capability spans an arena while its children are checked out. The
+   declarations live here rather than in a new header because obmalloc.c is the
+   only consumer and the patch must stand on its own. The mode -- spatial or
+   sublet -- is chosen at run time by pym_set_mode(), so one image carries both
+   arms of a matched pair. */
+void *pym_arena_alloc(void *, size_t);
+void pym_arena_free(void *, void *, size_t);
+uintptr_t pym_arena_address(void *);
+void *pym_arena_pointer(uintptr_t);
+void *pym_pool_create(uintptr_t, size_t);
+void *pym_pool_pointer(const void *);
+void pym_pool_reclass(void *, size_t, size_t);
+void *pym_block_pointer(void *, size_t);
+void *pym_issue(void *, size_t);
+void *pym_release(void *);
+void *pym_resize(void *, size_t);
+size_t pym_requested(void *);
+void pym_validate(void *);
+void *pym_user_raw_malloc(size_t);
+void pym_user_raw_free(void *);
+void *pym_user_raw_realloc(void *, size_t);
+
 typedef unsigned int pymem_uint;  /* assuming >= 16 bits */
 
 #undef  uint
@@ -275,7 +300,7 @@
     uintptr_t address;
 
     /* Pool-aligned pointer to the next pool to be carved off. */
-    pymem_block* pool_address;
+    uintptr_t pool_address;
 
     /* The number of available pools in the arena:  free pools + never-
      * allocated pools.
@@ -311,7 +336,12 @@
 #define DUMMY_SIZE_IDX          0xffff  /* size class of newly cached pools */
 
 /* Round pointer P down to the closest pool-aligned address <= P, as a poolp */
-#define POOL_ADDR(P) ((poolp)_Py_ALIGN_DOWN((P), POOL_SIZE))
+/* The pool of a block comes from the adapter's record, not from aligning the
+   block's own pointer down: the pool's header and its body are carved as
+   SEPARATE capabilities, so arithmetic on a block's alias cannot reach the
+   header at all -- it is outside that alias's bounds. This is the one line of
+   the component port's provenance patch that the interpreter arm needs too. */
+#define POOL_ADDR(P) ((poolp)pym_pool_pointer(P))
 
 /* Return total number of blocks in pool of size index I, as a uint. */
 #define NUMBLOCKS(I) ((pymem_uint)(POOL_SIZE - POOL_OVERHEAD) / INDEX2SIZE(I))
--- a/Include/pymacro.h
+++ b/Include/pymacro.h
@@ -121,11 +121,21 @@
 /* Round up size "n" to be a multiple of "a". */
 #define _Py_SIZE_ROUND_UP(n, a) (((size_t)(n) + \
         (size_t)((a) - 1)) & ~(size_t)((a) - 1))
+#if defined(_Py_SIZEOF_ADDRESS) && _Py_SIZEOF_ADDRESS < SIZEOF_VOID_P
+/* Where a pointer is a capability, a round trip through uintptr_t keeps only
+   the address and the result traps when used. clang's alignment builtins move
+   the address and keep the capability; on an integer they are the plain
+   rounding. The result has the argument's type rather than void *; every
+   caller casts it or passes an integer. */
+#  define _Py_ALIGN_DOWN(p, a) __builtin_align_down((p), (a))
+#  define _Py_ALIGN_UP(p, a) __builtin_align_up((p), (a))
+#else
 /* Round pointer "p" down to the closest "a"-aligned address <= "p". */
 #define _Py_ALIGN_DOWN(p, a) ((void *)((uintptr_t)(p) & ~(uintptr_t)((a) - 1)))
 /* Round pointer "p" up to the closest "a"-aligned address >= "p". */
 #define _Py_ALIGN_UP(p, a) ((void *)(((uintptr_t)(p) + \
         (uintptr_t)((a) - 1)) & ~(uintptr_t)((a) - 1)))
+#endif
 /* Check if pointer "p" is aligned to "a"-bytes boundary. */
 #define _Py_IS_ALIGNED(p, a) (!((uintptr_t)(p) & (uintptr_t)((a) - 1)))
 
