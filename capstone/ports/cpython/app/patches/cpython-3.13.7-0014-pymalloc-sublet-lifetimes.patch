+/* Sublet: the arena P lies in, or NULL. P may be a client's pointer, which
+ * is bounded to its block and so cannot reach the pool header. */
+static struct arena_object *
+arena_map_arena(OMState *state, pymem_block *p)
+{
+    arena_map_bot_t *n = arena_map_get(state, p, 0);
+    if (n == NULL) {
+        return NULL;
+    }
+    int i3 = MAP_BOT_INDEX(p);
+    int32_t tail = (int32_t)(AS_UINT(p) & ARENA_SIZE_MASK);
+    arena_coverage_t *c = &n->arenas[i3];
+    uint32_t index = (c->tail_hi != 0 && tail >= c->tail_hi) ? c->arena_hi
+                   : (tail < c->tail_lo) ? c->arena_lo : 0;
+    return index ? &allarenas[index - 1] : NULL;
+}
+
+/* Sublet: obmalloc's own pointer at P's address, from the arena's
+ * capability; it outlives every block the arena hands out. */
+static pymem_block *
+arena_inside(struct arena_object *ao, void *p)
+{
+    return _Py_ARENA_PTR(ao) + (AS_UINT(p) - ao->address);
+}
+
+/* Sublet: a block handed out to a client is a child lifetime of its arena,
+ * bounded to the request. */
+static void *
+block_issue(OMState *state, pymem_block *bp, size_t nbytes)
+{
+    struct arena_object *ao = &allarenas[POOL_ADDR(bp)->arenaindex];
+    return capstone_cap_derive(ao->arena_life, AS_UINT(bp) - ao->address,
+                               nbytes ? nbytes : 1);
+}
