+static void
+pym_publish_free(void *owner, void *p)
+{
+    OMState *state = owner;
+    if (UNLIKELY(!pymalloc_free(state, NULL, p))) {
+        pym_user_raw_free(p);
+        raw_allocated_blocks--;
+    }
+}
