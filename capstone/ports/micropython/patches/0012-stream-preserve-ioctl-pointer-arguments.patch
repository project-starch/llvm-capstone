diff --git i/py/stream.h w/py/stream.h
index df5e6d0cd..c9691c2f3 100644
--- i/py/stream.h
+++ w/py/stream.h
@@ -65,6 +65,18 @@ struct mp_stream_seek_t {
     int whence;
 };

+// Stream ioctl requests use the third argument for either an integer or a pointer, with the
+// request code discriminating between them. Ports whose pointers carry data that uintptr_t
+// cannot retain may override the carrier type with a pointer type.
+#ifndef MICROPY_STREAM_IOCTL_ARG_TYPE
+#define MICROPY_STREAM_IOCTL_ARG_TYPE uintptr_t
+#endif
+typedef MICROPY_STREAM_IOCTL_ARG_TYPE mp_stream_ioctl_arg_t;
+#define MP_STREAM_IOCTL_ARG_FROM_UINT(arg) ((mp_stream_ioctl_arg_t)(uintptr_t)(arg))
+#define MP_STREAM_IOCTL_ARG_TO_UINT(arg) ((uintptr_t)(arg))
+#define MP_STREAM_IOCTL_ARG_FROM_PTR(arg) ((mp_stream_ioctl_arg_t)(arg))
+#define MP_STREAM_IOCTL_ARG_TO_PTR(type, arg) ((type)(arg))
+
 // seek ioctl "whence" values
 #define MP_SEEK_SET (0)
 #define MP_SEEK_CUR (1)
@@ -80,6 +92,6 @@ typedef struct _mp_stream_p_t {
     // ioctl returns without raising, an OSError with the errcode will raised.
     mp_uint_t (*read)(mp_obj_t obj, void *buf, mp_uint_t size, int *errcode);
     mp_uint_t (*write)(mp_obj_t obj, const void *buf, mp_uint_t size, int *errcode);
-    mp_uint_t (*ioctl)(mp_obj_t obj, mp_uint_t request, uintptr_t arg, int *errcode);
+    mp_uint_t (*ioctl)(mp_obj_t obj, mp_uint_t request, mp_stream_ioctl_arg_t arg, int *errcode);
     mp_uint_t is_text : 1; // default is bytes, set this for text stream
 } mp_stream_p_t;
