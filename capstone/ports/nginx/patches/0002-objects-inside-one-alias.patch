+#if (NGX_SUBLET_BLOCK)
+
+/*
+ * THE WEAKER DISCIPLINE, and the whole point of this arm. The block is still linear and still dies
+ * in one revocation, so a pointer into a destroyed pool still faults. What it no longer does is
+ * give each object its own bounds: the block behind its header is taken ONCE as a single alias,
+ * and the objects are offsets inside it. That is plain pointer arithmetic, and per R-12 only SPLIT
+ * and MREV allocate a revocation node, so an object now costs none.
+ *
+ * What is given up is named rather than hidden. An overrun from one object into the next INSIDE
+ * one pool is invisible again, exactly as it is upstream. What is kept is the claim this paper
+ * makes, that a pool's contents die together.
+ *
+ * The sixteen byte rounding stays, although nothing on this path needs it, so that the only
+ * difference measured between the two arms is the per object carve.
+ */
+static void
+ngx_pool_body(ngx_uint_t n)
+{
+    ngx_pool_slot_t  *sl = &ngx_pool_slots[n];
+    sublet_cap        whole;
+
+    sl->span = sl->left = (size_t) (sublet_end(&sl->region) - sublet_base(&sl->region));
+    /* a carve that reaches exactly to the end is a move and not a split, so this is one mrev and
+       one delin per BLOCK where the other arm spends them per object */
+    sublet_carve(&sl->region, sublet_end(&sl->region), &whole);
+    sl->body = sublet_take(&whole);
+    if (sl->body == NULL) {
+        sl->span = sl->left = 0;
+    }
+}
+
+static void *
+ngx_pool_carve(ngx_uint_t n, size_t size)
+{
+    ngx_pool_slot_t  *sl = &ngx_pool_slots[n];
+    u_char           *p;
+
+    size = (size + 15) & ~(size_t) 15;
+    if (size == 0) {
+        size = 16;
+    }
+
+    if (sl->body == NULL || sl->left < size) {
+        return NULL;
+    }
+
+    p = sl->body + (sl->span - sl->left);
+    sl->left -= size;
+
+    return p;
+}
+
+#else
+
+static void *
+ngx_pool_carve(ngx_uint_t n, size_t size)
+{
+    return ngx_pool_carve_one(n, size);
+}
+
+#endif
