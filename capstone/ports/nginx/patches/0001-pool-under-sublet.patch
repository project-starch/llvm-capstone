+/*
+ * A block's capabilities live OUTSIDE the block, and they have to. The handle must survive the
+ * revocation it performs, and the region it restores must be written somewhere that revocation
+ * did not just invalidate. So a block keeps an index here and nothing else.
+ *
+ * Two handles per block, not one. The outer is senior to the whole block and is what destroy
+ * uses. The inner is taken after the header has been carved off the front, so it is senior to
+ * every object and to nothing else, and it is what reset uses. Without the inner one, a reset
+ * would revoke the header its caller is holding, and every ngx_reset_pool call site in nginx
+ * would have had to change.
+ *
+ * The cost is this table, 64 bytes per block. Against nginx's 16 KiB default pool that is 0.4
+ * per cent, and it is per BLOCK rather than per object because a pool's objects share one
+ * revocation.
+ */
+#define NGX_POOL_SLOTS    256
+#define NGX_POOL_NO_SLOT  ((ngx_uint_t) -1)
+
+typedef struct {
+    sublet_cap   region;
+    sublet_cap   handle;
+    sublet_cap   inner;
+    size_t       bytes;
+    size_t       left;
+    ngx_uint_t   used;
+} ngx_pool_slot_t;
+
+static ngx_pool_slot_t  ngx_pool_slots[NGX_POOL_SLOTS];
+
+ngx_uint_t  ngx_pool_slots_live;
+ngx_uint_t  ngx_pool_slots_peak;
+
+
+static ngx_uint_t
+ngx_pool_slot_get(size_t bytes)
+{
+    ngx_uint_t  n;
+
+    for (n = 0; n < NGX_POOL_SLOTS; n++) {
+        if (ngx_pool_slots[n].used) {
+            continue;
+        }
+
+        if (!ngx_subpool_block(bytes, &ngx_pool_slots[n].region,
+                               &ngx_pool_slots[n].handle))
+        {
+            return NGX_POOL_NO_SLOT;
+        }
+
+        ngx_pool_slots[n].bytes = bytes;
+        /* what is left comes from the REGION and not from the request. The level below rounds a
+           block up to a whole number of capabilities, so a request of 4280 gets 4288, and a left
+           set from the request would refuse the very object the block was taken for. Real nginx
+           asks for 4280 six times in two hundred thousand calls, and each was refused. */
+        ngx_pool_slots[n].left =
+            (size_t) (sublet_end(&ngx_pool_slots[n].region) - sublet_base(&ngx_pool_slots[n].region));
+        ngx_pool_slots[n].used = 1;
+
+        if (++ngx_pool_slots_live > ngx_pool_slots_peak) {
+            ngx_pool_slots_peak = ngx_pool_slots_live;
+        }
+
+        return n;
+    }
+
+    return NGX_POOL_NO_SLOT;
+}
+
+
+static void
+ngx_pool_slot_put(ngx_uint_t n)
+{
+    ngx_subpool_release(&ngx_pool_slots[n].region, &ngx_pool_slots[n].handle);
+    ngx_pool_slots[n].used = 0;
+    ngx_pool_slots_live--;
+}
+
+
+/*
+ * One object out of a block. The size is rounded to 16 because a capability is 16 bytes and must
+ * be 16 aligned, which is also why ngx_align_ptr has nothing left to do on this path: a carve
+ * from a 16 aligned block in 16 byte steps is aligned by construction.
+ *
+ * What is left is COUNTED, not asked of the region. A carve that reaches exactly to the end of a
+ * region moves the whole of it out and leaves the slot empty, and asking an empty slot for its
+ * base is an untagged operand, cause 24. A 1024 byte pool has 896 bytes behind its header and
+ * hands out exactly fourteen 64 byte objects, so the fifteenth request faulted rather than
+ * chaining a block. A count can be read when a slot cannot.
+ */
+static void *
+ngx_pool_carve(ngx_uint_t n, size_t size)
+{
+    sublet_cap        obj;
+    ngx_pool_slot_t  *sl;
+
+    sl = &ngx_pool_slots[n];
+    size = (size + 15) & ~(size_t) 15;
+
+    /*
+     * A REQUEST FOR NOTHING still costs a capability. nginx asks for zero bytes, and upstream
+     * answers with the bump pointer where it stands, which is a pointer to no bytes and is legal
+     * because a pointer has no length. A capability has one, and a carve of zero length is a
+     * split at the region's own base, which the hardware refuses as degenerate. So the smallest
+     * object is sixteen bytes even when nothing was asked for.
+     *
+     * This is a cost of the discipline and not a detail of this port, and no driver I wrote found
+     * it: a trace of real nginx did, at the first zero-length allocation of two hundred thousand
+     * calls.
+     */
+    if (size == 0) {
+        size = 16;
+    }
+
+    if (sl->left < size) {
+        return NULL;
+    }
+
+    sublet_carve(&sl->region, sublet_base(&sl->region) + size, &obj);
+    sl->left -= size;
+
+    return sublet_take(&obj);
+}
+
+
+/*
+ * An object aligned harder than a capability. ngx_pmemalign is asked for ngx_pagesize by the
+ * radix tree and for the direct IO alignment by the output chain, so refusing anything above 16
+ * would have taken two real call sites out of nginx rather than costing a comment.
+ *
+ * A block starts wherever the level below cut it, so the padding is carved off and let go. It
+ * comes back when the block does, at the revocation, which is the one place it can come back.
+ * The caller asks the level below for size plus alignment so that an aligned start is certain to
+ * lie inside.
+ */
+static void *
+ngx_pool_carve_aligned(ngx_uint_t n, size_t size, size_t alignment)
+{
+    unsigned long   base, want;
+    size_t          pad;
+
+    base = sublet_base(&ngx_pool_slots[n].region);
+    want = (base + alignment - 1) & ~(unsigned long) (alignment - 1);
+    pad = (size_t) (want - base);
+
+    if (pad != 0 && ngx_pool_carve(n, pad) == NULL) {
+        return NULL;
+    }
+
+    return ngx_pool_carve(n, size);
+}
