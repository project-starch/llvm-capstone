+#ifdef ZEND_CAP_SUBLET
+/* THE CAPABILITY SEAM. One Sublet-managed block per emalloc, split so that no capability spans
+ * the 48-byte header and the payload: the payload is revoked on every efree while the header
+ * stays live, so this file keeps its control flow byte for byte -- the cache park below still
+ * reads p->size and writes p->cached after the logical free, and REMOVE_POINTER_FROM_LIST still
+ * walks neighbour headers, all of which are alive. See
+ * capstone/ports/php/zend-alloc/sublet/zend-cap-port.h.
+ *
+ * EVERY HUNK IN THIS FILE IS BEHIND THIS DEFINE. With it absent the three macros below expand
+ * to exactly the arithmetic they replace and the file compiles to the same object as the
+ * pristine source, which the build asserts with cmp rather than trusting. */
+# include "zend-cap-port.h"
+# undef ZEND_DO_MALLOC
+# undef ZEND_DO_FREE
+# undef ZEND_DO_REALLOC
+# define ZEND_DO_MALLOC(size)       zend_cap_block_alloc(size)
+# define ZEND_DO_FREE(ptr)          zend_cap_block_free(ptr)
+# define ZEND_DO_REALLOC(ptr, size) zend_cap_block_realloc(ptr, size)
+/* p -> the caller's object, and ptr -> the header, by LOOKUP rather than arithmetic: a
+ * capability that spanned both would have to die with the payload. */
+# define ZEND_CAP_PAYLOAD(p, size)  zend_cap_payload((p), (size))
+# define ZEND_CAP_HEADER(ptr)       ((zend_mem_header *) zend_cap_header(ptr))
+/* The payload's lifetime ends here, before the branch, so one hunk covers both the AG(cache)
+ * park and the real free. */
+# define ZEND_CAP_RETIRE(p)         zend_cap_retire(p)
+#else
+# define ZEND_CAP_PAYLOAD(p, size)  ((void *)((char *)(p) + sizeof(zend_mem_header) + MEM_HEADER_PADDING))
+# define ZEND_CAP_HEADER(ptr)       ((zend_mem_header *) ((char *)(ptr) - sizeof(zend_mem_header) - MEM_HEADER_PADDING))
+# define ZEND_CAP_RETIRE(p)         ((void)0)
+#endif
+
