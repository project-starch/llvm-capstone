+/* ---- ZPROBE: does a Zend release reach libc, or stop in AG(cache)? ------
+ * Writes one unbuffered line per release to $ZPROBE_OUT, or nothing at all
+ * when that variable is unset, so the build is the stock allocator unless a
+ * run asks for the probe. Unbuffered on purpose: these cases crash, and a
+ * buffered tail is exactly the evidence that would be lost. */
+#include <stdio.h>
+#include <stdlib.h>
+#include <unistd.h>
+#include <fcntl.h>
+static int zprobe_fd = -2;              /* -2 not set up yet, -1 off */
+static void zprobe_setup(void) {
+	const char *zp = getenv("ZPROBE_OUT");
+	zprobe_fd = -1;
+	if (zp && *zp) {
+		zprobe_fd = open(zp, O_WRONLY | O_CREAT | O_APPEND, 0644);
+		if (zprobe_fd >= 0) {
+			/* This build is a PIE, so a logged return address is load base plus
+			 * offset. Emit the runtime address of a function in this very file;
+			 * the base is that minus the same symbol's address in the binary,
+			 * and every other address resolves after subtracting it. */
+			char hb[96];
+			int hn = snprintf(hb, sizeof(hb), "ZPBASE\t%p\n", (void *) &zprobe_setup);
+			if (hn > 0) { ssize_t hw = write(zprobe_fd, hb, (size_t) hn); (void) hw; }
+		}
+	}
+}
+#define ZPROBE_EMIT(kind, sz, idx, cnt, ptr, ra) do {                     \
+	if (zprobe_fd == -2) zprobe_setup();                                  \
+	if (zprobe_fd >= 0) {                                                 \
+		char zb[192];                                                     \
+		int zn = snprintf(zb, sizeof(zb), "ZP\t%s\t%u\t%d\t%d\t%p\t%p\n", \
+		                  (kind), (unsigned)(sz), (int)(idx),             \
+		                  (int)(cnt), (void *)(ptr), (void *)(ra));       \
+		if (zn > 0) { ssize_t zw = write(zprobe_fd, zb, (size_t)zn); (void)zw; } \
+	}                                                                     \
+} while (0)
+
 
