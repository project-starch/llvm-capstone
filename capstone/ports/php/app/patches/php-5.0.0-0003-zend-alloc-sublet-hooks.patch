+#ifdef ZEND_CAP_SUBLET
+/* THE CAPABILITY SEAM. The caller's pointer is a CDERIVE child of the malloc'd block, bounded to
+ * its own object, so no capability spans the 48-byte header and the payload. _efree ends that
+ * child through the libc's reclaim, which hands back the block's own reference at the header, so
+ * everything below the first line of _efree -- p->size, p->cached, the AG(cache) park,
+ * REMOVE_POINTER_FROM_LIST -- runs on live memory exactly as upstream. The arm (PHP_CAP_MODE),
+ * the counters and the three calls live in zend-cap-mode.h; there is no state per block.
+ *
+ * EVERY HUNK IN THIS FILE IS BEHIND THIS DEFINE. With it absent the three macros below expand
+ * to exactly the arithmetic they replace and the file compiles to the same object as the
+ * pristine source, which the build asserts with cmp rather than trusting. */
+# include "zend-cap-mode.h"
+# undef ZEND_DO_MALLOC
+# undef ZEND_DO_FREE
+# define ZEND_DO_MALLOC(size)       zend_cap_block(size)
+# define ZEND_DO_FREE(ptr)          zend_cap_release(ptr)
+# define ZEND_CAP_HDR               (sizeof(zend_mem_header) + MEM_HEADER_PADDING)
+/* p -> the caller's child over the payload; ptr -> the block, by RECLAIM rather than arithmetic:
+ * the caller's capability cannot reach the header, and ends in that same call. */
+# define ZEND_CAP_PAYLOAD(p, size)  zend_cap_issue((p), ZEND_CAP_HDR, (size))
+# define ZEND_CAP_HEADER(ptr)       ((zend_mem_header *) zend_cap_reclaim((ptr), ZEND_CAP_HDR))
+#else
+# define ZEND_CAP_PAYLOAD(p, size)  ((void *)((char *)(p) + sizeof(zend_mem_header) + MEM_HEADER_PADDING))
+# define ZEND_CAP_HEADER(ptr)       ((zend_mem_header *) ((char *)(ptr) - sizeof(zend_mem_header) - MEM_HEADER_PADDING))
+#endif
+
