+#ifdef ZEND_CAP_SUBLET
+/* THE CAPABILITY SEAM. The caller's pointer is bounded to its own object in every arm -- a
+ * CDERIVE child of the malloc'd block with a lifetime of its own in the revoking arms -- so no
+ * capability the caller holds spans the 48-byte header. _efree ends that child through the
+ * libc's reclaim, which hands back the block's own reference at the header, so everything below
+ * the first line of _efree -- p->size, p->cached, the AG(cache) park, REMOVE_POINTER_FROM_LIST --
+ * runs on live memory exactly as upstream. _erealloc recovers the block without ending anything,
+ * takes a fresh block, and releases the old one only once the copy is made. The arm
+ * (PHP_CAP_MODE), the counters and the calls live in zend-cap-mode.h; there is no state per block.
+ *
+ * EVERY HUNK IN THIS FILE IS BEHIND THIS DEFINE. With it absent the macros below expand to
+ * exactly the arithmetic they replace and the file compiles to the same object as the pristine
+ * source, which the build asserts with cmp rather than trusting. */
+# include "zend-cap-mode.h"
+# undef ZEND_DO_MALLOC
+# undef ZEND_DO_FREE
+# undef ZEND_DO_REALLOC
+# define ZEND_CAP_HDR               (sizeof(zend_mem_header) + MEM_HEADER_PADDING)
+# define ZEND_DO_MALLOC(size)       zend_cap_block(size)
+# define ZEND_DO_FREE(ptr)          zend_cap_release(ptr)
+/* The old block's request is still in p->size when _erealloc reallocates: the copy length. */
+# define ZEND_DO_REALLOC(ptr, size) zend_cap_reblock((ptr), (size), ZEND_CAP_HDR + ((zend_mem_header *)(ptr))->size)
+/* p -> the caller's pointer over the payload; ptr -> the block, by LOOKUP rather than arithmetic,
+ * since the caller's capability cannot reach the header. _efree's lookup also ENDS the caller's
+ * lifetime (RECLAIM); _erealloc's and _mem_block_check's do not (HEADER). */
+# define ZEND_CAP_PAYLOAD(p, size)  zend_cap_issue((p), ZEND_CAP_HDR, (size))
+# define ZEND_CAP_HEADER(ptr)       ((zend_mem_header *) zend_cap_header((ptr), ZEND_CAP_HDR))
+# define ZEND_CAP_RECLAIM(ptr)      ((zend_mem_header *) zend_cap_reclaim((ptr), ZEND_CAP_HDR))
+#else
+# define ZEND_CAP_PAYLOAD(p, size)  ((void *)((char *)(p) + sizeof(zend_mem_header) + MEM_HEADER_PADDING))
+# define ZEND_CAP_HEADER(ptr)       ((zend_mem_header *) ((char *)(ptr) - sizeof(zend_mem_header) - MEM_HEADER_PADDING))
+# define ZEND_CAP_RECLAIM(ptr)      ZEND_CAP_HEADER(ptr)
+#endif
+
