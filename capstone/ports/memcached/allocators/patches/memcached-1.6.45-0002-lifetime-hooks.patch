         chunk->prev = 0;
     } else {
         // header with no attached chunk
@@ -484,9 +501,10 @@
     item_chunk *next_chunk;
     while (chunk) {
         assert(chunk->it_flags == ITEM_CHUNK);
-        chunk->it_flags = ITEM_SLABBED;
         p = &slabclass[chunk->slabs_clsid];
         next_chunk = chunk->next;
+        chunk = mcp_chunk_release(chunk, chunk->slabs_clsid);
+        chunk->it_flags = ITEM_SLABBED;
 
         chunk->prev = 0;
         chunk->next = p->slots;
@@ -513,6 +531,9 @@
 
     it = (item *)ptr;
     if ((it->it_flags & ITEM_CHUNKED) == 0) {
+        /* The item's alias has been read for the last time; the free list
+         * writes its links through the one the adapter hands back. */
+        it = mcp_chunk_release(it, id);
         it->it_flags = ITEM_SLABBED;
         it->slabs_clsid = id;
         it->prev = 0;
@@ -621,7 +642,7 @@
 
     if (mem_base == NULL) {
