 static void slabs_preallocate (const unsigned int maxslabs);
 
+#ifdef MC_CAPSTONE_SUBLET
+#include <capstone/capability.h>
+#include <capstone/representable.h>
+
+/* Q-15: on the compact bounds format (vp2, and capstone-qemu without exact bounds) CDERIVE refuses
+ * (29) any child it cannot hold exactly: from 4 KiB up its base and length must be multiples of the
+ * granule 2^(msb(len)-9). slabs_init rounds each class size up to its granule (capstone_repr_round),
+ * so the items at page + i * size are representable by construction; the pad is at the TAIL only,
+ * never over the item header or a neighbour. q15_pad[] is that pad per class, and the totals below
+ * are the over-approximation this costs, read by slabs_q15_counts() (the allocator build has no
+ * usable stdio, so the caller prints them). */
+static unsigned int q15_pad[MAX_NUMBER_OF_SLAB_CLASSES];
+static unsigned long q15_items, q15_padded, q15_pad_total, q15_pad_max;
+void slabs_q15_counts(unsigned long out[4]) {
+    out[0] = q15_items; out[1] = q15_padded; out[2] = q15_pad_total; out[3] = q15_pad_max;
+}
+/* cache.c's objects, counted beside the slab items (cache.c calls it through a weak reference). */
+void slabs_q15_note(unsigned long pad) {
+    q15_items++;
+    if (pad) {
+        q15_padded++;
+        q15_pad_total += pad;
+        if (pad > q15_pad_max) q15_pad_max = pad;
+    }
+}
+
+/* Sublet: a CDERIVE child of parent, starting at p. */
+static inline void *sublet_derive(void *parent, const void *p, size_t size) {
+    return capstone_cap_derive(parent,
+            (uintptr_t)p - __builtin_capstone_cap_get_base(parent), size);
+}
+
+/* Sublet: end the caller's chunk (CREVOKE), which faults on a reference that
+ * is not a live chunk, and return the allocator's pointer at its address. */
+static void *slabs_take_back(void *ptr) {
+    void *gen = ((item *)ptr)->sublet_parent;
+    capstone_cap_revoke_child(gen, ptr);
+    return (char *)gen + ((uintptr_t)ptr - __builtin_capstone_cap_get_base(gen));
+}
+#endif
