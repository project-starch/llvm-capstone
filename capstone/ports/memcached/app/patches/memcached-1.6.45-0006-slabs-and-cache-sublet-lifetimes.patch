 static void slabs_preallocate (const unsigned int maxslabs);
 
+#ifdef MC_CAPSTONE_SUBLET
+#include <capstone/capability.h>
+#include <capstone/representable.h>
+
+/* Sublet: a CDERIVE child of parent over [p, p + size), with its cursor at p.
+ * The compact bounds format holds a range of 4 KiB or more only on its
+ * granule (capstone/representable.h), and CDERIVE refuses any other range
+ * (cause 29). A range that is not representable therefore gets the smallest
+ * representable range around it: a large chunk reaches less than one granule
+ * (at most 1/512 of its length) into its neighbours, and a generation into
+ * the slack at the end of its page. */
+static inline void *sublet_derive(void *parent, const void *p, size_t size) {
+    unsigned long base = (uintptr_t)p, end = base + size;
+    while (!capstone_repr_ok(base, end - base)) {
+        unsigned long g = capstone_repr_granule(end - base);
+        base -= base % g;
+        end += (g - end % g) % g;
+    }
+    char *child = capstone_cap_derive(parent,
+            base - __builtin_capstone_cap_get_base(parent), end - base);
+    return child == NULL ? NULL : child + ((uintptr_t)p - base);
+}
+
+/* Sublet: end the caller's chunk (CREVOKE), which faults on a reference that
+ * is not live, and return the allocator's pointer at its address. */
+static void *slabs_take_back(void *ptr) {
+    void *gen = ((item *)ptr)->sublet_parent;
+    capstone_cap_release(ptr);
+    return (char *)gen + ((uintptr_t)ptr - (uintptr_t)gen);
+}
+
+/* Sublet: undo memory_allocate of the page ptr, len bytes, when the page gets
+ * no lifetime. */
+static void memory_unallocate(void *ptr, size_t len) {
+    if (mem_base == NULL) {
+        free(ptr);
+    } else {
+        if (len % CHUNK_ALIGN_BYTES)
+            len += CHUNK_ALIGN_BYTES - (len % CHUNK_ALIGN_BYTES);
+        mem_current = ptr;
+        mem_avail += len;
+    }
+    mem_malloced -= len;
+}
+#endif
