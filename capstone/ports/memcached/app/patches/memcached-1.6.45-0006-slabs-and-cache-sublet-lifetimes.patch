+#ifdef MC_CAPSTONE_SUBLET
+    /* Sublet: the generation of this chunk's page. The chunk is handed out as
+     * a CDERIVE child of it, and slabs_free reaches the chunk through it. */
+    void            *sublet_parent;
+#endif
