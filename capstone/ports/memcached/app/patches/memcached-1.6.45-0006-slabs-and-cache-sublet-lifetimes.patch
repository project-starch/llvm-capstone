 static void slabs_preallocate (const unsigned int maxslabs);
+
+#ifdef MC_CAPSTONE_SUBLET
+#include <capstone/capability.h>
+#include <capstone/representable.h>
+
+static char *slabs_page_holding(uintptr_t addr, unsigned int id);
+static char *slabs_class_page(const slabclass_t *p, uintptr_t addr);
+
+/* Sublet: a CDERIVE child of parent over [p, p + size), with its cursor at p.
+ * The compact bounds format holds a range of 4 KiB or more only on its
+ * granule (capstone/representable.h), and CDERIVE refuses any other range
+ * (cause 29). A range that is not representable therefore gets the smallest
+ * representable range around it: a large chunk reaches less than one granule
+ * (at most 1/512 of its length) into its neighbours. */
+static inline void *sublet_derive(void *parent, const void *p, size_t size) {
+    unsigned long base = (uintptr_t)p, end = base + size;
+    while (!capstone_repr_ok(base, end - base)) {
+        unsigned long g = capstone_repr_granule(end - base);
+        base -= base % g;
+        end += (g - end % g) % g;
+    }
+    char *child = capstone_cap_derive(parent,
+            base - __builtin_capstone_cap_get_base(parent), end - base);
+    return child == NULL ? NULL : child + ((uintptr_t)p - base);
+}
+
+/* Sublet: end the caller's chunk (CREVOKE), which faults on a reference that
+ * is not live, and return the allocator's pointer at its address: the page
+ * reference that slab_list keeps for the chunk's page, moved to the chunk.
+ * Nothing is read through the caller's reference. */
+static void *slabs_take_back(void *ptr, unsigned int id) {
+    uintptr_t addr = (uintptr_t)ptr;
+    capstone_cap_release(ptr);
+
+    char *page = slabs_page_holding(addr, id);
+    if (page == NULL) {
+        fprintf(stderr, "slabs: no slab page holds the freed chunk at %#lx\n",
+                (unsigned long)addr);
+        exit(1);
+    }
+    return page + (addr - (uintptr_t)page);
+}
+
+/* Sublet: the page that holds addr, as slab_list keeps it. The search tries
+ * class id first and then every class, because a chunked item's header comes
+ * from a class other than the one its owner passes to slabs_free. */
+static char *slabs_page_holding(uintptr_t addr, unsigned int id) {
+    char *page = NULL;
+    if (id >= POWER_SMALLEST && id <= (unsigned int)power_largest)
+        page = slabs_class_page(&slabclass[id], addr);
+    for (int c = POWER_SMALLEST; page == NULL && c <= power_largest; c++)
+        page = slabs_class_page(&slabclass[c], addr);
+    return page;
+}
+
+/* Sublet: the page of class p whose chunks cover addr, or NULL. */
+static char *slabs_class_page(const slabclass_t *p, uintptr_t addr) {
+    for (unsigned int i = 0; i < p->slabs; i++) {
+        char *page = p->slab_list[i];
+        if (addr - (uintptr_t)page < (uintptr_t)p->size * p->perslab)
+            return page;
+    }
+    return NULL;
+}
+#endif
 
