+#ifdef MC_CAPSTONE_SLAB_SUBLET
+        /* By number: a pointer stepped past its own chunk is not the next chunk's alias. */
+        do_slabs_free(mcs_chunk_at(ptr, x), id);
+#else
         do_slabs_free(ptr, id);
