+#ifdef MC_CAPSTONE_SLAB_SUBLET
+        /* Element-wise, not a byte copy: the list holds page aliases. */
+        void *new_list = mcs_meta_grow_pointers(p->slab_list, p->list_size, new_size);
+#else
         void *new_list = realloc(p->slab_list, new_size * sizeof(void *));
+#endif
         if (new_list == 0) return 0;
         p->list_size = new_size;
