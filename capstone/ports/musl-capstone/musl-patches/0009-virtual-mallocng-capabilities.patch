+/* The common small path keeps mallocng's placement. Large requests need space
+ * and alignment for representable bounds; aligned_alloc uses the raw allocator
+ * above, so it does not create and immediately revoke an intermediate child. */
+void *malloc(size_t n)
+{
+	if (size_overflows(n)) return 0;
+	if (n >= 4096) return aligned_alloc(heap_granule(heap_round(n)), n);
+	return heap_alloc_issue(__malloc_alloc(n), n);
+}
