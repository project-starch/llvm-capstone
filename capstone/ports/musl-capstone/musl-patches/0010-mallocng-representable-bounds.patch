+#ifdef CAPSTONE_MUSL_MALLOC
+	/* Option (iii): the capability the runtime derives over this object must have a
+	 * granule-aligned BASE, because the compressed encoder truncates an unaligned base
+	 * downward and the object would gain authority below itself. The user pointer is
+	 * p + UNIT*off, so only offsets that keep it a granule multiple are usable. Step DOWN to
+	 * the nearest such offset -- never up, which could exceed slack and overrun the slot.
+	 * For a granule of UNIT or less (every length below 8 KiB) every offset qualifies and
+	 * this is a no-op, so the double-free offset cycling is untouched there; above it the
+	 * cycle keeps 1 offset in granule/UNIT. The slot's own base is granule-aligned by the
+	 * seven raised stride entries plus the group's granule-sized header. */
+	{
+		size_t cap_g = capstone_repr_granule(n);
+		if (cap_g > UNIT) {
+			uintptr_t want = (uintptr_t)p + UNIT*(size_t)off;
+			size_t back = (size_t)(want & (cap_g - 1));
+			off -= (int)(back / UNIT);
+			if (off < 0) off = 0;
+			assert(off <= (int)slack);
+		}
+	}
+#endif
