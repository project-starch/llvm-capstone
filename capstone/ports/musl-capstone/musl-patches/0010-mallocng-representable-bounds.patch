+#ifdef CAPSTONE_MUSL_MALLOC
+/* Option (iii): a slot's base must be a multiple of its own bounds granule, or the capability the
+ * runtime derives over an object in it is not exactly representable -- the compressed encoder
+ * truncates an unaligned base DOWNWARD and the object gains authority below itself. The seven
+ * raised stride entries make `stride*idx` a granule multiple; what is left is the group header,
+ * which upstream makes exactly UNIT. This pads it to the granule.
+ *
+ * It costs NOTHING. alloc_group computes `needed = size*cnt + UNIT` and then rounds UP to a page
+ * (malloc.c: `needed += -needed & (pagesize-1)`), so there is already slack after the last slot;
+ * measured over every class and every reachable cnt, that slack is always at least this pad. The
+ * margin is exact in places -- class 36 at cnt 7 has 16 bytes of slack for a 16-byte pad -- so
+ * cap_hdr_fits() asserts it rather than trusting it, and a future table or cnt change fails loudly
+ * instead of overrunning the group.
+ */
+static inline size_t cap_hdr_pad(size_t stride)
+{
+	size_t gr = capstone_repr_granule(stride > IB ? stride - IB : 1);
+	return gr > UNIT ? gr - UNIT : 0;
+}
+static inline int cap_hdr_fits(size_t size, int cnt, size_t pagesize)
+{
+	size_t needed = size*(size_t)cnt + UNIT;
+	size_t slack = -needed & (pagesize-1);
+	return slack >= cap_hdr_pad(size);
+}
+#else
+#define cap_hdr_pad(stride) ((size_t)0)
+#endif
+
 static inline void *enframe(struct meta *g, int idx, size_t n, int ctr)
 {
 	size_t stride = get_stride(g);
 	size_t slack = (stride-IB-n)/UNIT;
-	unsigned char *p = g->mem->storage + stride*idx;
+	unsigned char *p = g->mem->storage + cap_hdr_pad(stride) + stride*idx;
 #ifdef CAPSTONE_MUSL_MALLOC
 	p = __capstone_malloc_slot_take(&g->cap_slots[idx]);
 #endif
